@model List<Travel.Web.DTOs.AboutStorySectionDtos.AboutStorySectionResultDto>

@{
    ViewData["Title"] = "Hikayemiz";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>

    .page-intro {
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            font-weight: 700;
            font-size: 1.7rem;
            color: var(--navy);
            margin: .15rem 0 .3rem;
        }

        .page-intro p {
            color: var(--muted);
            margin: 0;
            font-size: .94rem;
        }

    .crumb {
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

        .crumb a {
            color: var(--muted);
            text-decoration: none;
        }

            .crumb a:hover {
                color: var(--teal-dark);
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600;
        }

    .story-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
    }

    .story-card-header {
        padding: 1rem 1.1rem;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

        .story-card-header h5 {
            margin: 0;
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: .95rem;
        }

        .story-card-header span {
            color: var(--muted);
            font-size: .82rem;
        }

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .65rem 1.1rem;
        font-size: .85rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        text-decoration: none;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            box-shadow: 0 10px 22px rgba(15,163,163,.25);
        }

    .table-wrapper {
        overflow-x: auto;
    }

    .story-table {
        width: 100%;
        border-collapse: collapse;
    }

        .story-table thead th {
            background: #fafbfb;
            color: var(--muted);
            font-size: .76rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .03em;
            padding: .9rem 1rem;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        .story-table tbody td {
            color: var(--navy);
            font-size: .85rem;
            padding: 1rem;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
        }

        .story-table tbody tr:last-child td {
            border-bottom: none;
        }

        .story-table tbody tr:hover {
            background: #fcfdfd;
        }

    .story-image {
        width: 78px;
        height: 55px;
        object-fit: cover;
        border-radius: 9px;
        border: 1px solid var(--line);
        background: #f5f6f6;
    }

    .title-cell {
        min-width: 200px;
    }

        .title-cell strong {
            display: block;
            color: var(--navy);
            font-weight: 700;
            margin-bottom: .25rem;
        }

    .description-cell {
        max-width: 350px;
        color: var(--muted) !important;
        line-height: 1.45;
    }

    .badge-story {
        display: inline-flex;
        align-items: center;
        padding: .35rem .65rem;
        border-radius: 999px;
        background: rgba(15,163,163,.08);
        color: var(--teal-dark);
        font-size: .75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .date-cell {
        white-space: nowrap;
        color: var(--muted) !important;
        font-size: .8rem !important;
    }

    .action-group {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: .45rem;
    }

    .btn-action {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s;
        border: 1px solid var(--line);
        background: #fff;
    }

    .btn-edit {
        color: var(--teal-dark);
    }

        .btn-edit:hover {
            background: rgba(15,163,163,.08);
            border-color: rgba(15,163,163,.25);
        }

    .btn-delete {
        color: #dc3545;
        cursor: pointer;
    }

        .btn-delete:hover {
            background: rgba(220,53,69,.06);
            border-color: rgba(220,53,69,.2);
        }

    .empty-state {
        padding: 3rem 1.5rem;
        text-align: center;
    }

    .empty-state-icon {
        width: 54px;
        height: 54px;
        margin: 0 auto 1rem;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(15,163,163,.08);
        color: var(--teal-dark);
    }

    .empty-state h5 {
        color: var(--navy);
        font-weight: 700;
        margin-bottom: .4rem;
    }

    .empty-state p {
        color: var(--muted);
        font-size: .85rem;
        margin-bottom: 1rem;
    }

</style>

<div class="content">

    <div class="crumb">

        <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index">
            Dashboard
        </a>

        /

        <span class="cur">
            Hikayemiz
        </span>

    </div>

    <div class="page-intro">

        <h1>
            Hikayemiz
        </h1>

        <p>
            Hakkımızda sayfasında yer alan hikayemiz bölümünün içeriklerini yönetin.
        </p>

    </div>

    <div class="story-card">

        <div class="story-card-header">

            <div>

                <h5>
                    Hikayemiz İçeriği
                </h5>

                <span>
                    Hikayemiz bölümünde gösterilen başlık, açıklama, görsel ve buton bilgileri.
                </span>

            </div>

            <a asp-area="Admin"
                   asp-controller="AboutStorySection"
                   asp-action="Create"
                   class="btn-teal">

                <svg width="16"
                     height="16"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <line x1="12"
                          y1="5"
                          x2="12"
                          y2="19" />

                    <line x1="5"
                          y1="12"
                          x2="19"
                          y2="12" />

                </svg>

                Yeni İçerik Ekle

            </a>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-wrapper">

                <table class="story-table">

                    <thead>

                        <tr>

                            <th>
                                Görsel
                            </th>

                            <th>
                                Üst Başlık
                            </th>

                            <th>
                                Başlık
                            </th>

                            <th>
                                Açıklama
                            </th>

                            <th>
                                Oluşturulma
                            </th>

                            <th class="text-end">
                                İşlemler
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Title"
                                             class="story-image" />
                                    }
                                    else
                                    {
                                        <div class="story-image d-flex align-items-center justify-content-center">

                                            <svg width="20"
                                                 height="20"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="1.8"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <rect x="3"
                                                      y="3"
                                                      width="18"
                                                      height="18"
                                                      rx="2"
                                                      ry="2" />

                                                <circle cx="8.5"
                                                        cy="8.5"
                                                        r="1.5" />

                                                <polyline points="21 15 16 10 5 21" />

                                            </svg>

                                        </div>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.Badge))
                                    {
                                        <span class="badge-story">
                                            @item.Badge
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>

                                <td class="title-cell">

                                    <strong>
                                        @item.Title
                                    </strong>

                                </td>

                                <td class="description-cell">

                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        @(item.Description.Length > 100
                                            ? item.Description.Substring(0, 100) + "..."
                                            : item.Description)
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </td>

                                <td class="date-cell">

                                    @if (item.CreatedAt.HasValue)
                                    {
                                        @item.CreatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                    }
                                    else
                                    {
                                        <span>
                                            -
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="action-group">

                                        <a asp-area="Admin"
                                               asp-controller="AboutStorySection"
                                               asp-action="Update"
                                               asp-route-id="@item.Id"
                                               class="btn-action btn-edit"
                                               title="Güncelle">

                                            <svg width="16"
                                                 height="16"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <path d="M12 20h9" />

                                                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />

                                            </svg>

                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="AboutStorySection"
                                              asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              onsubmit="return confirm('Bu hikayemiz içeriğini silmek istediğinize emin misiniz?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn-action btn-delete"
                                                    title="Sil">

                                                <svg width="16"
                                                     height="16"
                                                     viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="2"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round">

                                                    <polyline points="3 6 5 6 21 6" />

                                                    <path d="M19 6l-1 14H6L5 6" />

                                                    <path d="M10 11v6" />

                                                    <path d="M14 11v6" />

                                                    <path d="M9 6V4h6v2" />

                                                </svg>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-state-icon">

                    <svg width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />

                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />

                    </svg>

                </div>

                <h5>
                    Henüz içerik bulunmuyor
                </h5>

                <p>
                    Hikayemiz bölümünü oluşturmak için ilk içeriği ekleyebilirsiniz.
                </p>

                <a asp-area="Admin"
                       asp-controller="AboutStorySection"
                       asp-action="Create"
                       class="btn-teal">

                    Yeni İçerik Ekle

                </a>

            </div>
        }

    </div>

</div>