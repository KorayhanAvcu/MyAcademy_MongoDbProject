@model List<Travel.Web.Entities.AppUser>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "~/Views/AdminLayout/Layout.cshtml";

    var totalUser = Model?.Count ?? 0;
    var confirmedUser = Model?.Count(x => x.EmailConfirmed) ?? 0;
    var unconfirmedUser = totalUser - confirmedUser;
}

<style>

    /* =========================
               USER INDEX
               ========================= */

    .crumb {
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

        .crumb a {
            color: var(--muted);
            text-decoration: none;
        }

            .crumb a:hover {
                color: var(--teal-dark);
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600;
        }


    /* =========================
               PAGE INTRO
               ========================= */

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            font-weight: 700;
            font-size: 1.7rem;
            color: var(--navy);
            margin: .15rem 0 .3rem;
        }

        .page-intro p {
            color: var(--muted);
            margin: 0;
            font-size: .94rem;
            max-width: 60ch;
        }


    /* =========================
               KPI
               ========================= */

    .kpi {
        display: flex;
        align-items: center;
        gap: .85rem;
    }

        .kpi .ic {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            flex: none;
        }

        .kpi .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--navy);
            line-height: 1;
        }

        .kpi .lab {
            font-size: .82rem;
            color: var(--muted);
            margin-top: .15rem;
        }


    /* =========================
               USER CARD
               ========================= */

    .user-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
    }

    .user-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid var(--line);
    }

        .user-card-header h5 {
            margin: 0;
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: .95rem;
        }

        .user-card-header span {
            color: var(--muted);
            font-size: .82rem;
        }


    /* =========================
               TABLE
               ========================= */

    .tbl-wrap {
        overflow-x: auto;
    }

    .user-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }

        .user-table th {
            padding: .9rem 1rem;
            background: #fafbfb;
            color: var(--muted);
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .02em;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        .user-table td {
            padding: .9rem 1rem;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
            color: var(--navy);
            font-size: .88rem;
        }

        .user-table tbody tr {
            transition: .2s;
        }

            .user-table tbody tr:hover {
                background: #fcfefe;
            }

            .user-table tbody tr:last-child td {
                border-bottom: none;
            }


    /* =========================
               USER INFO
               ========================= */

    .user-info {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .user-avatar {
        width: 42px;
        height: 42px;
        min-width: 42px;
        border-radius: 12px;
        background: rgba(15,163,163,.1);
        color: var(--teal-dark);
        display: grid;
        place-items: center;
        font-family: 'Sora';
        font-weight: 800;
        font-size: .9rem;
    }

    .user-name {
        font-family: 'Sora';
        font-weight: 600;
        color: var(--navy);
        margin-bottom: .15rem;
    }

    .user-id {
        color: var(--muted);
        font-size: .7rem;
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    /* =========================
               USERNAME
               ========================= */

    .username {
        font-weight: 600;
        color: var(--navy);
    }


    /* =========================
               EMAIL
               ========================= */

    .email {
        color: var(--muted);
        max-width: 230px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    /* =========================
               PHONE
               ========================= */

    .phone {
        color: var(--navy);
        white-space: nowrap;
    }


    /* =========================
               STATUS
               ========================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border-radius: 999px;
        padding: .38rem .7rem;
        font-size: .74rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-active {
        color: #13795b;
        background: rgba(25, 135, 84, .1);
    }

    .status-passive {
        color: #6c757d;
        background: rgba(108, 117, 125, .1);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }


    /* =========================
               TERMS
               ========================= */

    .terms-accepted {
        color: #13795b;
        background: rgba(25, 135, 84, .1);
    }

    .terms-not-accepted {
        color: #b02a37;
        background: rgba(220, 53, 69, .1);
    }


    /* =========================
               ACTIONS
               ========================= */

    .actions {
        display: flex;
        gap: .45rem;
        flex-wrap: wrap;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        background: #fff;
        transition: .2s;
        text-decoration: none;
    }

        .action-btn.edit {
            color: var(--teal-dark);
        }

            .action-btn.edit:hover {
                background: rgba(15,163,163,.08);
                border-color: var(--teal);
            }

        .action-btn.delete {
            color: var(--cancel-fg);
        }

            .action-btn.delete:hover {
                background: var(--cancel-bg);
                border-color: var(--cancel-fg);
            }


    /* =========================
               EMPTY STATE
               ========================= */

    .empty {
        text-align: center;
        padding: 4rem 1rem;
    }

        .empty .eic {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            margin: 0 auto 1rem;
        }

        .empty h3 {
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: 1.2rem;
            margin-bottom: .4rem;
        }

        .empty p {
            color: var(--muted);
            margin: 0;
        }


    /* =========================
               RESPONSIVE
               ========================= */

    @@media (max-width: 768px) {

        .page-intro {
            align-items: flex-start;
            flex-direction: column;
        }

        .user-card-header {
            align-items: flex-start;
            gap: .5rem;
        }
    }

</style>


<!-- =========================
     CONTENT
     ========================= -->

<div class="content">


    <!-- =========================
         BREADCRUMB
         ========================= -->

    <div class="crumb">

        <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index">

            Dashboard

        </a>

        /

        <span class="cur">
            Kullanıcılar
        </span>

    </div>


    <!-- =========================
         PAGE INTRO
         ========================= -->

    <div class="page-intro">

        <div>

            <h1>
                Kullanıcı Yönetimi
            </h1>

            <p>
                Travelio sisteminde kayıtlı kullanıcıları
                görüntüleyebilir ve kullanıcı bilgilerini yönetebilirsiniz.
            </p>

        </div>

    </div>


    <!-- =========================
         KPI
         ========================= -->

    <div class="row g-3 mb-4">


        <!-- TOTAL -->

        <div class="col-12 col-md-4">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />

                        <circle cx="9"
                                cy="7"
                                r="4" />

                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />

                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @totalUser
                    </div>

                    <div class="lab">
                        Toplam Kullanıcı
                    </div>

                </div>

            </div>

        </div>


        <!-- CONFIRMED -->

        <div class="col-12 col-md-4">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />

                        <polyline points="22 4 12 14.01 9 11.01" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @confirmedUser
                    </div>

                    <div class="lab">
                        Email Onaylı
                    </div>

                </div>

            </div>

        </div>


        <!-- UNCONFIRMED -->

        <div class="col-12 col-md-4">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12"
                                cy="12"
                                r="10" />

                        <line x1="15"
                              y1="9"
                              x2="9"
                              y2="15" />

                        <line x1="9"
                              y1="9"
                              x2="15"
                              y2="15" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @unconfirmedUser
                    </div>

                    <div class="lab">
                        Email Onaysız
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         USER CARD
         ========================= -->

    <div class="user-card">


        <!-- HEADER -->

        <div class="user-card-header">

            <div>

                <h5>
                    Kullanıcı Listesi
                </h5>

                <span>
                    Identity sisteminde kayıtlı kullanıcılar
                </span>

            </div>

            <span>
                @totalUser kayıt
            </span>

        </div>


        @if (Model != null && Model.Any())
        {

            <!-- =========================
                 TABLE
                 ========================= -->

            <div class="tbl-wrap">

                <table class="user-table">

                    <thead>

                        <tr>

                            <th style="width:70px;">
                                #
                            </th>

                            <th>
                                Kullanıcı
                            </th>

                            <th>
                                Kullanıcı Adı
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Telefon
                            </th>

                            <th>
                                Email Durumu
                            </th>

                            <th>
                                Şartlar
                            </th>

                            <th style="width:110px;">
                                İşlemler
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int count = 0;
                        }

                        @foreach (var user in Model)
                        {
                            count++;

                            var firstName = user.FirstName?.Trim() ?? "";
                            var lastName = user.LastName?.Trim() ?? "";

                            var initials = "";

                            if (!string.IsNullOrWhiteSpace(firstName))
                            {
                                initials += firstName.Substring(0, 1).ToUpper();
                            }

                            if (!string.IsNullOrWhiteSpace(lastName))
                            {
                                initials += lastName.Substring(0, 1).ToUpper();
                            }

                            if (string.IsNullOrWhiteSpace(initials))
                            {
                                initials = "?";
                            }

                            var fullName =
                                $"{firstName} {lastName}".Trim();

                            if (string.IsNullOrWhiteSpace(fullName))
                            {
                                fullName = "İsimsiz Kullanıcı";
                            }

                            <tr>


                                <!-- NUMBER -->

                                <td>

                                    <span style="font-weight:700;">
                                        @count
                                    </span>

                                </td>


                                <!-- USER -->

                                <td>

                                    <div class="user-info">

                                        <div class="user-avatar">
                                            @initials
                                        </div>

                                        <div>

                                            <div class="user-name">
                                                @fullName
                                            </div>

                                            <div class="user-id"
                                                 title="@user.Id">

                                                ID: @user.Id

                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- USERNAME -->

                                <td>

                                    <span class="username">
                                        @(string.IsNullOrWhiteSpace(user.UserName)
                                            ? "-"
                                            : user.UserName)
                                    </span>

                                </td>


                                <!-- EMAIL -->

                                <td>

                                    <div class="email"
                                         title="@user.Email">

                                        @(string.IsNullOrWhiteSpace(user.Email)
                                            ? "-"
                                            : user.Email)

                                    </div>

                                </td>


                                <!-- PHONE -->

                                <td>

                                    <div class="phone">

                                        @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                            ? "-"
                                            : user.PhoneNumber)

                                    </div>

                                </td>


                                <!-- EMAIL STATUS -->

                                <td>

                                    @if (user.EmailConfirmed)
                                    {

                                        <span class="status-badge status-active">

                                            <span class="status-dot"></span>

                                            Onaylı

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="status-badge status-passive">

                                            <span class="status-dot"></span>

                                            Onaysız

                                        </span>

                                    }

                                </td>


                                <!-- TERMS -->

                                <td>

                                    @if (user.TermsAccepted)
                                    {

                                        <span class="status-badge terms-accepted">

                                            <span class="status-dot"></span>

                                            Kabul edildi

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="status-badge terms-not-accepted">

                                            <span class="status-dot"></span>

                                            Kabul edilmedi

                                        </span>

                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="actions">


                                        <!-- UPDATE -->

                                        <a asp-area="Admin"
                                               asp-controller="User"
                                               asp-action="Update"
                                               asp-route-id="@user.Id"
                                               class="action-btn edit"
                                               title="Düzenle">

                                            <svg width="16"
                                                 height="16"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />

                                                <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />

                                            </svg>

                                        </a>


                                        <!-- DELETE -->

                                        <form asp-area="Admin"
                                              asp-controller="User"
                                              asp-action="Delete"
                                              method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="action-btn delete"
                                                    title="Sil"
                                                    style="cursor:pointer;">

                                                <svg width="16"
                                                     height="16"
                                                     viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="2"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round">

                                                    <polyline points="3 6 5 6 21 6" />

                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />

                                                    <path d="M10 11v6" />

                                                    <path d="M14 11v6" />

                                                </svg>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {

            <!-- =========================
                 EMPTY STATE
                 ========================= -->

            <div class="empty">

                <div class="eic">

                    <svg width="26"
                         height="26"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />

                        <circle cx="9"
                                cy="7"
                                r="4" />

                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />

                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />

                    </svg>

                </div>


                <h3>
                    Henüz kullanıcı bulunmuyor
                </h3>


                <p>
                    Sistemde henüz kayıtlı bir kullanıcı bulunmamaktadır.
                </p>

            </div>

        }

    </div>

</div>