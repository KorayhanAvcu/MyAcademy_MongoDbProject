@model Travel.Web.DTOs.AboutTeamMemberDtos.AboutTeamMemberUpdateDto

@{
    ViewData["Title"] = "Ekip Üyesi Düzenle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    :root {
        --navy: #0e2a3b;
        --teal: #0fa3a3;
        --teal-dark: #0b7f80;
        --white: #ffffff;
        --muted: #64748b;
        --line: #e5e7eb;
    }

    .page-header {
        margin-bottom: 1.5rem;
    }

    .breadcrumb-custom {
        color: var(--muted);
        font-size: .88rem;
        margin-bottom: .45rem;
    }

        .breadcrumb-custom span {
            color: var(--navy);
            font-weight: 600;
        }

    .page-title {
        color: var(--navy);
        font-family: 'Sora', sans-serif;
        font-weight: 800;
        margin: 0;
    }

    .page-description {
        color: var(--muted);
        margin-top: .5rem;
    }

    .form-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 1.75rem;
    }

    .section-title {
        color: var(--navy);
        font-family: 'Sora', sans-serif;
        font-weight: 700;
        font-size: 1.05rem;
        margin-bottom: 1.25rem;
    }

    .form-label {
        color: var(--navy);
        font-weight: 600;
        font-size: .88rem;
        margin-bottom: .45rem;
    }

    .form-control {
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: .75rem .9rem;
        color: #334155;
    }

        .form-control:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 .2rem rgba(15, 163, 163, .12);
        }

    textarea.form-control {
        min-height: 140px;
        resize: vertical;
    }

    .field-validation-error {
        color: #dc2626;
        font-size: .8rem;
        margin-top: .3rem;
        display: block;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        margin-top: 2rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
    }

    .btn-cancel {
        border: 1px solid var(--line);
        color: var(--navy);
        background: var(--white);
        border-radius: 999px;
        padding: .7rem 1.25rem;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-save {
        border: none;
        background: var(--teal);
        color: var(--white);
        border-radius: 999px;
        padding: .7rem 1.35rem;
        font-weight: 600;
    }

        .btn-save:hover {
            background: var(--teal-dark);
            color: var(--white);
        }

    .current-image {
        width: 90px;
        height: 90px;
        border-radius: 14px;
        object-fit: cover;
        border: 1px solid var(--line);
        margin-top: .75rem;
    }
</style>

<div class="container-fluid">

    <div class="page-header">

        <div class="breadcrumb-custom">
            Dashboard / Hakkımızda / Ekip /
            <span>Ekip Üyesi Düzenle</span>
        </div>

        <h1 class="page-title">
            Ekip Üyesi Düzenle
        </h1>

        <p class="page-description">
            Mevcut ekip üyesinin bilgilerini güncelleyin.
        </p>

    </div>

    <div class="form-card">

        <form asp-area="Admin"
              asp-controller="AboutTeamMember"
              asp-action="Update"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="section-title">
                Ekip Üyesi Bilgileri
            </div>

            <div class="row g-4">

                <div class="col-md-6">

                    <label asp-for="Name"
                           class="form-label">
                        Ad Soyad
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="field-validation-error">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Role"
                           class="form-label">
                        Görev / Pozisyon
                    </label>

                    <input asp-for="Role"
                           class="form-control" />

                    <span asp-validation-for="Role"
                          class="field-validation-error">
                    </span>

                </div>

                <div class="col-12">

                    <label asp-for="ImageUrl"
                           class="form-label">
                        Fotoğraf URL
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control" />

                    <span asp-validation-for="ImageUrl"
                          class="field-validation-error">
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.Name"
                             class="current-image" />
                    }

                </div>

                <div class="col-12">

                    <label asp-for="MemberDescription"
                           class="form-label">
                        Açıklama
                    </label>

                    <textarea asp-for="MemberDescription"
                              class="form-control"></textarea>

                    <span asp-validation-for="MemberDescription"
                          class="field-validation-error">
                    </span>

                </div>

            </div>

            <div class="form-actions">

                <a asp-area="Admin"
                       asp-controller="AboutTeamMember"
                       asp-action="Index"
                       class="btn-cancel">
                    Vazgeç
                </a>

                <button type="submit"
                        class="btn-save">
                    Güncelle
                </button>

            </div>

        </form>

    </div>

</div>