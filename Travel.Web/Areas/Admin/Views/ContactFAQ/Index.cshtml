@model List<Travel.Web.DTOs.ContactFAQDtos.ResultContactFAQDto>

@{
    ViewData["Title"] = "İletişim SSS";
    Layout = "~/Views/AdminLayout/Layout.cshtml";

    var totalFaq = Model?.Count ?? 0;
}

<style>
    :root {
        --navy: #0e2a3b;
        --navy-2: #12384c;
        --teal: #0fa3a3;
        --teal-dark: #0b7f80;
        --muted: #6b7b86;
        --line: #e5e9ec;
        --white: #ffffff;
        --bg: #f7f9fa;
    }

    .content {
        padding: 28px 32px;
    }

    .crumb {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 8px;
    }

        .crumb a {
            color: var(--teal);
            text-decoration: none;
            font-weight: 600;
        }

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 28px;
    }

        .page-intro h1 {
            margin: 0;
            color: var(--navy);
            font-size: 28px;
            font-weight: 800;
        }

        .page-intro p {
            margin: 8px 0 0;
            color: var(--muted);
            font-size: 14px;
        }

    .btn-teal {
        background: var(--teal);
        border: 1px solid var(--teal);
        color: var(--white);
        border-radius: 8px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: .2s ease;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            border-color: var(--teal-dark);
            color: var(--white);
        }

    .kpi-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .kpi {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 18px 20px;
        box-shadow: 0 3px 12px rgba(14, 42, 59, .04);
    }

    .kpi-label {
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 6px;
    }

    .kpi-value {
        color: var(--navy);
        font-size: 25px;
        font-weight: 800;
    }

    .contact-faq-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(14, 42, 59, .05);
    }

    .form-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--line);
        background: #fbfcfd;
    }

        .form-header h3 {
            margin: 0;
            color: var(--navy);
            font-size: 17px;
            font-weight: 800;
        }

        .form-header p {
            margin: 5px 0 0;
            color: var(--muted);
            font-size: 13px;
        }

    .form-body {
        padding: 0;
    }

    .faq-table {
        margin: 0;
    }

        .faq-table thead th {
            background: #f8fafb;
            color: var(--navy);
            border-bottom: 1px solid var(--line);
            border-top: 0;
            padding: 14px 20px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .4px;
            white-space: nowrap;
        }

        .faq-table tbody td {
            padding: 17px 20px;
            border-bottom: 1px solid var(--line);
            color: #334955;
            font-size: 14px;
            vertical-align: middle;
        }

        .faq-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .faq-table tbody tr:hover {
            background: #fbfdfd;
        }

    .question-text {
        color: var(--navy);
        font-weight: 700;
        line-height: 1.5;
    }

    .answer-text {
        color: #526570;
        line-height: 1.6;
    }

    .action-buttons {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .btn-action {
        border-radius: 7px;
        padding: 7px 11px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s ease;
    }

    .btn-edit {
        color: var(--teal-dark);
        border: 1px solid #b8dede;
        background: #f3fbfb;
    }

        .btn-edit:hover {
            color: var(--white);
            background: var(--teal);
            border-color: var(--teal);
        }

    .btn-delete {
        color: #b42318;
        border: 1px solid #f0c4c1;
        background: #fff7f6;
    }

        .btn-delete:hover {
            color: var(--white);
            background: #c0392b;
            border-color: #c0392b;
        }

    .empty-state {
        padding: 60px 25px;
        text-align: center;
    }

    .empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #eaf7f7;
        color: var(--teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .empty-state h4 {
        color: var(--navy);
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .empty-state p {
        color: var(--muted);
        font-size: 14px;
        margin: 0;
    }

    .info-box {
        margin: 20px 24px 24px;
        padding: 14px 16px;
        background: #f1fafa;
        border: 1px solid #cce8e8;
        border-radius: 9px;
        color: #365b63;
        font-size: 13px;
        line-height: 1.6;
    }

    @@media (max-width: 900px) {
        .content

    {
        padding: 22px 18px;
    }

    .page-intro {
        align-items: flex-start;
        flex-direction: column;
    }

    .kpi-row {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 700px) {
        .faq-table

    {
        min-width: 760px;
    }

    .form-body {
        overflow-x: auto;
    }

    }
</style>

<div class="content">

    <div class="crumb">
        <a href="/Admin">Admin</a>
        <span> / İletişim SSS</span>
    </div>

    <div class="page-intro">

        <div>
            <h1>Sıkça Sorulan Sorular</h1>

            <p>
                İletişim sayfasındaki SSS içeriklerini yönetin.
            </p>
        </div>

        <a asp-action="Create" class="btn-teal">
            <span>+</span>
            Yeni Soru
        </a>

    </div>

    <div class="kpi-row">

        <div class="kpi">
            <div class="kpi-label">
                Toplam Soru
            </div>

            <div class="kpi-value">
                @totalFaq
            </div>
        </div>

        <div class="kpi">
            <div class="kpi-label">
                İçerik Durumu
            </div>

            <div class="kpi-value">
                @(totalFaq > 0 ? "Aktif" : "Boş")
            </div>
        </div>

        <div class="kpi">
            <div class="kpi-label">
                Yönetim
            </div>

            <div class="kpi-value">
                SSS
            </div>
        </div>

    </div>

    <div class="contact-faq-card">

        <div class="form-header">

            <h3>SSS Listesi</h3>

            <p>
                İletişim sayfasında ziyaretçilere gösterilecek soru ve cevapları buradan yönetebilirsiniz.
            </p>

        </div>

        <div class="form-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table faq-table align-middle">

                        <thead>
                            <tr>
                                <th width="35%">Soru</th>
                                <th width="45%">Cevap</th>
                                <th width="20%">İşlemler</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="question-text">
                                            @item.Question
                                        </div>
                                    </td>

                                    <td>
                                        <div class="answer-text">
                                            @item.Answer
                                        </div>
                                    </td>

                                    <td>

                                        <div class="action-buttons">

                                            <a asp-action="Update"
                                               asp-route-id="@item.Id"
                                               class="btn-action btn-edit">
                                                Düzenle
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Bu soruyu silmek istediğinize emin misiniz?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn-action btn-delete">
                                                    Sil
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        ?
                    </div>

                    <h4>Henüz SSS kaydı bulunmuyor</h4>

                    <p>
                        İletişim sayfasında gösterilecek ilk soruyu ekleyerek başlayabilirsiniz.
                    </p>

                    <div class="mt-4">

                        <a asp-action="Create"
                           class="btn-teal">
                            <span>+</span>
                            Yeni Soru Ekle
                        </a>

                    </div>

                </div>
            }

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="info-box">
                <strong>Bilgi:</strong>
                Buradaki soru ve cevaplar iletişim sayfasındaki
                <strong>Sıkça Sorulan Sorular</strong> bölümünde ziyaretçilere gösterilir.
            </div>
        }

    </div>

</div>