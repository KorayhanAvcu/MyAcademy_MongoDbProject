@using System.Globalization
@model List<Travel.Web.DTOs.TourDtos.TourListItemDto>

@{
    ViewData["Title"] = "Tur Yönetimi";
    Layout = "~/Views/AdminLayout/Layout.cshtml";

    var totalTours = Model.Count;
    var activeTours = Model.Count(x => x.Status == "Active");
    var passiveTours = Model.Count(x => x.Status == "Passive");
    var draftTours = Model.Count(x => x.Status == "Draft");

    var totalCapacity = Model.Sum(x => x.MaxCapacity);
    var totalReservations = Model.Sum(x => x.ReservationCount);
}

<style>
    :root {
        --muted: #718096;
        --teal-dark: #0b6f70;
        --navy: #0e2a3b;
        --teal: #0b7f80;
        --line: #e7ecef;
        --cream: #f7faf9;
        --cancel-fg: #b42318;
        --cancel-bg: #fff1f0;
    }

    .tour-page {
        padding-bottom: 2rem;
    }

    /* =========================
           BREADCRUMB
        ========================= */

    .crumb {
        display: flex;
        align-items: center;
        gap: .45rem;
        margin-bottom: 1.25rem;
        font-size: .86rem;
        color: var(--muted);
    }

        .crumb a {
            color: var(--muted);
            text-decoration: none;
            transition: .2s ease;
        }

            .crumb a:hover {
                color: var(--teal);
            }

    .crumb-current {
        color: var(--navy);
        font-weight: 700;
    }

    /* =========================
           PAGE INTRO
        ========================= */

    .page-intro {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            margin: 0;
            color: var(--navy);
            font-family: "Sora", sans-serif;
            font-size: 1.7rem;
            font-weight: 800;
            letter-spacing: -.02em;
        }

        .page-intro p {
            margin: .35rem 0 0;
            color: var(--muted);
            font-size: .92rem;
        }

    .btn-teal {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        padding: .7rem 1.3rem;
        border: 0;
        border-radius: 999px;
        background: var(--teal);
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: .9rem;
        white-space: nowrap;
        transition: .2s ease;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(11, 127, 128, .18);
        }

    /* =========================
           KPI
        ========================= */

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .kpi {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: 1rem 1.05rem;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
    }

    .kpi-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: rgba(11, 127, 128, .10);
        color: var(--teal);
        font-size: 1.15rem;
    }

    .kpi-number {
        color: var(--navy);
        font-family: "Sora", sans-serif;
        font-size: 1.25rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .kpi-label {
        margin-top: .2rem;
        color: var(--muted);
        font-size: .78rem;
    }

    /* =========================
           FILTER
        ========================= */

    .filter-card {
        margin-bottom: 1rem;
        padding: 1rem;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
    }

    .filter-label {
        display: block;
        margin-bottom: .4rem;
        color: var(--navy);
        font-size: .78rem;
        font-weight: 700;
    }

    .form-control,
    .form-select {
        min-height: 42px;
        border-color: var(--line);
        border-radius: 10px;
        color: var(--navy);
        font-size: .86rem;
        box-shadow: none !important;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(11, 127, 128, .08) !important;
        }

    .btn-filter {
        min-height: 42px;
        padding: 0 1rem;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fff;
        color: var(--navy);
        font-size: .84rem;
        font-weight: 600;
        transition: .2s ease;
    }

        .btn-filter:hover {
            border-color: var(--teal);
            color: var(--teal);
            background: #fff;
        }

    /* =========================
           TOUR CARD
        ========================= */

    .tour-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
    }

    .tour-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid var(--line);
    }

        .tour-card-header h2 {
            margin: 0;
            color: var(--navy);
            font-family: "Sora", sans-serif;
            font-size: 1rem;
            font-weight: 700;
        }

    .tour-count {
        color: var(--muted);
        font-size: .8rem;
    }

    /* =========================
           TABLE
        ========================= */

    .tbl-wrap {
        overflow-x: auto;
    }

    .tour-table {
        width: 100%;
        min-width: 1200px;
        border-collapse: collapse;
    }

        .tour-table th {
            padding: .8rem 1rem;
            background: #fbfcfc;
            border-bottom: 1px solid var(--line);
            color: var(--muted);
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .tour-table td {
            padding: .9rem 1rem;
            border-bottom: 1px solid var(--line);
            color: var(--navy);
            font-size: .84rem;
            vertical-align: middle;
        }

        .tour-table tbody tr {
            transition: background .15s ease;
        }

            .tour-table tbody tr:hover {
                background: #fbfdfd;
            }

            .tour-table tbody tr:last-child td {
                border-bottom: 0;
            }

    /* =========================
           TOUR
        ========================= */

    .tour-main {
        display: flex;
        align-items: center;
        gap: .8rem;
        min-width: 280px;
    }

    .tour-image {
        width: 90px;
        height: 62px;
        flex-shrink: 0;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: #f3f5f5;
    }

    .tour-image-placeholder {
        width: 90px;
        height: 62px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: #f3f5f5;
        color: var(--muted);
        font-size: 1.2rem;
    }

    .tour-title {
        max-width: 230px;
        margin-bottom: .2rem;
        color: var(--navy);
        font-family: "Sora", sans-serif;
        font-size: .85rem;
        font-weight: 700;
        line-height: 1.35;
    }

    .tour-description {
        max-width: 240px;
        overflow: hidden;
        color: var(--muted);
        font-size: .75rem;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    /* =========================
           CATEGORY / DESTINATION
        ========================= */

    .category-text {
        font-weight: 600;
        white-space: nowrap;
    }

    .destination-text {
        color: var(--muted);
        white-space: nowrap;
    }

    /* =========================
           DURATION
        ========================= */

    .duration-box {
        white-space: nowrap;
    }

    .duration-number {
        font-weight: 700;
        color: var(--navy);
    }

    .duration-text {
        color: var(--muted);
        font-size: .75rem;
    }

    /* =========================
           PRICE
        ========================= */

    .price {
        color: var(--teal-dark);
        font-family: "Sora", sans-serif;
        font-size: .85rem;
        font-weight: 800;
        white-space: nowrap;
    }

    /* =========================
           DATE
        ========================= */

    .date-box {
        white-space: nowrap;
    }

    .date-value {
        font-weight: 600;
    }

    .date-empty {
        color: var(--muted);
        font-size: .78rem;
    }

    /* =========================
           CAPACITY
        ========================= */

    .capacity-box {
        min-width: 75px;
    }

    .capacity-number {
        font-weight: 700;
    }

    .capacity-label {
        color: var(--muted);
        font-size: .72rem;
    }

    /* =========================
           RESERVATION
        ========================= */

    .reservation-count {
        font-weight: 700;
        white-space: nowrap;
    }

    /* =========================
           STATUS
        ========================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .38rem .65rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .status-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .status-active {
        color: #087443;
        background: #ecfdf3;
    }

    .status-passive {
        color: #a15c00;
        background: #fff7e6;
    }

    .status-draft {
        color: #667085;
        background: #f2f4f7;
    }

    /* =========================
           ACTIONS
        ========================= */

    .actions {
        display: flex;
        align-items: center;
        gap: .5rem;
        white-space: nowrap;
    }

    .action-btn {
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        padding: 0 .75rem;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fff;
        text-decoration: none;
        font-size: .76rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
    }

        .action-btn i {
            font-size: .9rem;
        }

        .action-btn:hover {
            transform: translateY(-1px);
        }

        /* Düzenle */

        .action-btn.edit {
            color: var(--teal);
        }

            .action-btn.edit:hover {
                border-color: var(--teal);
                background: rgba(11, 127, 128, .07);
                box-shadow: 0 4px 12px rgba(11, 127, 128, .10);
            }

        /* Sil */

        .action-btn.delete {
            color: var(--cancel-fg);
        }

            .action-btn.delete:hover {
                border-color: #f0aaa5;
                background: var(--cancel-bg);
                box-shadow: 0 4px 12px rgba(180, 35, 24, .08);
            }

    /* =========================
           EMPTY STATE
        ========================= */

    .empty-state {
        padding: 4rem 1rem;
        text-align: center;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        display: grid;
        place-items: center;
        margin: 0 auto 1rem;
        border-radius: 16px;
        background: rgba(11, 127, 128, .09);
        color: var(--teal);
        font-size: 1.5rem;
    }

    .empty-state h3 {
        margin-bottom: .4rem;
        color: var(--navy);
        font-family: "Sora", sans-serif;
        font-size: 1rem;
        font-weight: 700;
    }

    .empty-state p {
        margin-bottom: 1.1rem;
        color: var(--muted);
        font-size: .84rem;
    }

    /* =========================
           FOOTER
        ========================= */

    .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .9rem 1rem;
        border-top: 1px solid var(--line);
    }

    .table-info {
        color: var(--muted);
        font-size: .78rem;
    }

    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 1200px) {

        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {

        .page-intro {
            align-items: flex-start;
            flex-direction: column;
        }

            .page-intro .btn-teal {
                width: 100%;
                justify-content: center;
            }

        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .table-footer {
            align-items: flex-start;
            flex-direction: column;
        }

        .action-btn span {
            display: none;
        }

        .action-btn {
            width: 36px;
            padding: 0;
        }
    }
</style>


<div class="tour-page">

    <!-- =========================
         BREADCRUMB
    ========================== -->

    <div class="crumb">

        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index">

            Dashboard

        </a>

        <i class="bi bi-chevron-right"></i>

        <span class="crumb-current">
            Turlar
        </span>

    </div>


    <!-- =========================
         PAGE INTRO
    ========================== -->

    <div class="page-intro">

        <div>

            <h1>
                Tur Yönetimi
            </h1>

            <p>
                Travelio üzerindeki turlarınızı yönetin,
                düzenleyin ve yeni turlar oluşturun.
            </p>

        </div>


        <a asp-area="Admin"
           asp-controller="Tour"
           asp-action="TourCreate"
           class="btn-teal">

            <i class="bi bi-plus-lg"></i>

            Yeni Tur Ekle

        </a>

    </div>


    <!-- =========================
         KPI
    ========================== -->

    <div class="kpi-grid">

        <!-- Total -->

        <div class="kpi">

            <div class="kpi-icon">
                <i class="bi bi-map"></i>
            </div>

            <div>

                <div class="kpi-number">
                    @totalTours
                </div>

                <div class="kpi-label">
                    Toplam Tur
                </div>

            </div>

        </div>


        <!-- Active -->

        <div class="kpi">

            <div class="kpi-icon">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>

                <div class="kpi-number">
                    @activeTours
                </div>

                <div class="kpi-label">
                    Yayındaki Tur
                </div>

            </div>

        </div>


        <!-- Capacity -->

        <div class="kpi">

            <div class="kpi-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div>

                <div class="kpi-number">
                    @totalCapacity.ToString(
                    "N0",
                                        CultureInfo.GetCultureInfo("tr-TR"))
                </div>

                <div class="kpi-label">
                    Toplam Kontenjan
                </div>

            </div>

        </div>


        <!-- Reservations -->

        <div class="kpi">

            <div class="kpi-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>

                <div class="kpi-number">
                    @totalReservations.ToString(
                                        "N0",
                                        CultureInfo.GetCultureInfo("tr-TR"))
                </div>

                <div class="kpi-label">
                    Toplam Rezervasyon
                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         FILTER
    ========================== -->

    <div class="filter-card">

        <div class="row g-3 align-items-end">

            <!-- Search -->

            <div class="col-lg-4 col-md-6">

                <label class="filter-label">
                    Tur Ara
                </label>

                <input type="text"
                       id="tourSearch"
                       class="form-control"
                       placeholder="Tur adı veya açıklama..." />

            </div>


            <!-- Category -->

            <div class="col-lg-2 col-md-6">

                <label class="filter-label">
                    Kategori
                </label>

                <select id="categoryFilter"
                        class="form-select">

                    <option value="">
                        Tüm Kategoriler
                    </option>

                    @foreach (var category in Model
                                        .Where(x => !string.IsNullOrWhiteSpace(x.CategoryName))
                                        .Select(x => x.CategoryName!)
                                        .Distinct()
                                        .OrderBy(x => x))
                    {
                        <option value="@category">
                            @category
                        </option>
                    }

                </select>

            </div>


            <!-- Status -->

            <div class="col-lg-2 col-md-6">

                <label class="filter-label">
                    Durum
                </label>

                <select id="statusFilter"
                        class="form-select">

                    <option value="">
                        Tüm Durumlar
                    </option>

                    <option value="Active">
                        Aktif
                    </option>

                    <option value="Passive">
                        Pasif
                    </option>

                    <option value="Draft">
                        Taslak
                    </option>

                </select>

            </div>


            <!-- Sort -->

            <div class="col-lg-2 col-md-6">

                <label class="filter-label">
                    Sıralama
                </label>

                <select id="sortFilter"
                        class="form-select">

                    <option value="default">
                        Varsayılan
                    </option>

                    <option value="priceAsc">
                        Fiyat ↑
                    </option>

                    <option value="priceDesc">
                        Fiyat ↓
                    </option>

                    <option value="nameAsc">
                        İsim A-Z
                    </option>

                    <option value="nameDesc">
                        İsim Z-A
                    </option>

                </select>

            </div>


            <!-- Clear -->

            <div class="col-lg-2 col-md-12">

                <button type="button"
                        id="clearFilters"
                        class="btn-filter w-100">

                    <i class="bi bi-x-circle me-1"></i>

                    Temizle

                </button>

            </div>

        </div>

    </div>


    <!-- =========================
         TOUR CARD
    ========================== -->

    <div class="tour-card">

        <div class="tour-card-header">

            <div>

                <h2>
                    Tur Listesi
                </h2>

            </div>

            <div class="tour-count">

                <span id="visibleCount">
                    @Model.Count
                </span>

                tur

            </div>

        </div>


        @if (Model.Any())
        {
            <div class="tbl-wrap">

                <table class="tour-table">

                    <thead>

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Tur
                            </th>

                            <th>
                                Kategori
                            </th>

                            <th>
                                Destinasyon
                            </th>

                            <th>
                                Süre
                            </th>

                            <th>
                                Fiyat
                            </th>

                            <th>
                                Yaklaşan Tarih
                            </th>

                            <th>
                                Kontenjan
                            </th>

                            <th>
                                Rezervasyon
                            </th>

                            <th>
                                Durum
                            </th>

                            <th>
                                İşlemler
                            </th>

                        </tr>

                    </thead>


                    <tbody id="tourTableBody">

                        @for (var i = 0; i < Model.Count; i++)
                        {
                            var tour = Model[i];

                            var statusClass =
                            tour.Status == "Active"
                            ? "status-active"
                            : tour.Status == "Passive"
                            ? "status-passive"
                            : "status-draft";

                            var statusText =
                            tour.Status == "Active"
                            ? "Aktif"
                            : tour.Status == "Passive"
                            ? "Pasif"
                            : "Taslak";

                            <tr class="tour-row"
                                data-name="@tour.Name"
                                data-description="@tour.ShortDescription"
                                data-category="@tour.CategoryName"
                                data-status="@tour.Status"
                                data-price="@tour.Price">


                                <!-- # -->

                                <td>
                                    @(i + 1)
                                </td>


                                <!-- TUR -->

                                <td>

                                    <div class="tour-main">

                                        @if (!string.IsNullOrWhiteSpace(tour.CoverImageUrl))
                                        {
                                            <img src="@tour.CoverImageUrl"
                                                 alt="@tour.Name"
                                                 class="tour-image" />
                                        }
                                        else
                                        {
                                            <div class="tour-image-placeholder">

                                                <i class="bi bi-image"></i>

                                            </div>
                                        }


                                        <div>

                                            <div class="tour-title">
                                                @tour.Name
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(tour.ShortDescription))
                                            {
                                                <div class="tour-description">
                                                    @tour.ShortDescription
                                                </div>
                                            }

                                    </div>

                                </div>

                            </td>


                            <!-- KATEGORİ -->

                            <td>

                                <span class="category-text">

                                    @(string.IsNullOrWhiteSpace(tour.CategoryName)
                                                                    ? "-"
                                                                    : tour.CategoryName)

                                </span>

                            </td>


                            <!-- DESTİNASYON -->

                            <td>

                                <span class="destination-text">

                                    @(string.IsNullOrWhiteSpace(tour.DestinationName)
                                                                    ? "-"
                                                                    : tour.DestinationName)

                            </span>

                                </td>


                                <!-- SÜRE -->

                                <td>

                                    <div class="duration-box">

                                        <span class="duration-number">
                                            @tour.DurationDays
                                        </span>

                                        <span class="duration-text">
                                            gün
                                        </span>


                                @if (tour.DurationNights > 0)
                                        {
                                            <div>

                                                <span class="duration-number">
                                                    @tour.DurationNights
                                                </span>

                                                <span class="duration-text">
                                                    gece
                                                </span>

                                            </div>
                                        }

                                    </div>

                                </td>


                                <!-- FİYAT -->

                                <td>

                                    <div class="price">

                                        @tour.Price.ToString(
                                        "N2",
                                                                CultureInfo.GetCultureInfo("tr-TR")) ₺

                            </div>

                        </td>


                        <!-- YAKLAŞAN TARİH -->

                        <td>

                            <div class="date-box">

                                @if (tour.UpcomingDate.HasValue)
                                    {
                                        <span class="date-value">

                                            @tour.UpcomingDate.Value.ToString(
                                            "dd.MM.yyyy",
                                                                        CultureInfo.GetCultureInfo("tr-TR"))

                                </span>
                                                                }
                                    else
                                    {
                                        <span class="date-empty">
                                            Tarih yok
                                        </span>
                                    }

                                </div>

                            </td>


                            <!-- KONTENJAN -->

                            <td>

                                <div class="capacity-box">

                                    <div class="capacity-number">

                                        @tour.MaxCapacity.ToString(
                                        "N0",
                                                                        CultureInfo.GetCultureInfo("tr-TR"))

                                </div>

                                <div class="capacity-label">
                                    kişi
                                </div>

                            </div>

                        </td>


                        <!-- REZERVASYON -->

                        <td>

                            <span class="reservation-count">

                                @tour.ReservationCount

                            </span>

                        </td>


                        <!-- DURUM -->

                        <td>

                            <span class="status-badge @statusClass">

                                @statusText

                            </span>

                        </td>


                        <!-- İŞLEMLER -->

                        <td>

                            <div class="actions">

                                <!-- DÜZENLE -->

                                <a asp-area="Admin"
                                   asp-controller="Tour"
                                   asp-action="TourUpdate"
                                   asp-route-id="@tour.Id"
                                   class="action-btn edit"
                                   title="Tur Düzenle">

                                    <i class="bi bi-pencil-square"></i>

                                    <span>
                                        Düzenle
                                    </span>

                                </a>


                                <!-- SİL -->

                                <form asp-area="Admin"
                                      asp-controller="Tour"
                                      asp-action="Delete"
                                      asp-route-id="@tour.Id"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Bu turu silmek istediğinize emin misiniz?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="action-btn delete"
                                            title="Tur Sil">

                                        <i class="bi bi-trash3"></i>

                                        <span>
                                            Sil
                                        </span>

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>
                                        }

                </tbody>

            </table>

        </div>


        <!-- TABLE FOOTER -->

        <div class="table-footer">

            <div class="table-info">

                Toplam

                <strong id="footerCount">
                    @Model.Count
                </strong>

                tur gösteriliyor.

            </div>

        </div>
                }
                else
        {
            <!-- EMPTY STATE -->

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-map"></i>

                </div>

                <h3>
                    Henüz tur bulunmuyor
                </h3>

                <p>
                    Travelio için ilk turunuzu oluşturarak başlayabilirsiniz.
                </p>

                <a asp-area="Admin"
                   asp-controller="Tour"
                   asp-action="TourCreate"
                   class="btn-teal">

                    <i class="bi bi-plus-lg"></i>

                    Yeni Tur Ekle

                </a>

            </div>
        }

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("tourSearch");

        const categoryFilter =
            document.getElementById("categoryFilter");

        const statusFilter =
            document.getElementById("statusFilter");

        const sortFilter =
            document.getElementById("sortFilter");

        const clearFilters =
            document.getElementById("clearFilters");

        const tableBody =
            document.getElementById("tourTableBody");

        const visibleCount =
            document.getElementById("visibleCount");

        const footerCount =
            document.getElementById("footerCount");


        if (!tableBody) {
            return;
        }


        /* =========================
           FILTER
        ========================== */

        function applyFilters() {

            const search =
                searchInput.value
                    .toLowerCase()
                    .trim();

            const category =
                categoryFilter.value
                    .toLowerCase()
                    .trim();

            const status =
                statusFilter.value
                    .toLowerCase()
                    .trim();


            const rows =
                Array.from(
                    tableBody.querySelectorAll(".tour-row")
                );


            let visibleRows = [];


            rows.forEach(function (row) {

                const name =
                    (row.dataset.name || "")
                        .toLowerCase();

                const description =
                    (row.dataset.description || "")
                        .toLowerCase();

                const rowCategory =
                    (row.dataset.category || "")
                        .toLowerCase();

                const rowStatus =
                    (row.dataset.status || "")
                        .toLowerCase();


                const matchesSearch =
                    !search ||
                    name.includes(search) ||
                    description.includes(search);


                const matchesCategory =
                    !category ||
                    rowCategory === category;


                const matchesStatus =
                    !status ||
                    rowStatus === status;


                const isVisible =
                    matchesSearch &&
                    matchesCategory &&
                    matchesStatus;


                row.style.display =
                    isVisible ? "" : "none";


                if (isVisible) {

                    visibleRows.push(row);

                }

            });


            applySort(visibleRows);


            if (visibleCount) {

                visibleCount.textContent =
                    visibleRows.length;

            }


            if (footerCount) {

                footerCount.textContent =
                    visibleRows.length;

            }

        }


        /* =========================
           SORT
        ========================== */

        function applySort(rows) {

            const sort =
                sortFilter.value;


            if (sort === "default") {
                return;
            }


            rows.sort(function (a, b) {

                if (sort === "priceAsc") {

                    return Number(a.dataset.price || 0)
                         - Number(b.dataset.price || 0);

                }


                if (sort === "priceDesc") {

                    return Number(b.dataset.price || 0)
                         - Number(a.dataset.price || 0);

                }


                if (sort === "nameAsc") {

                    return (a.dataset.name || "")
                        .localeCompare(
                            b.dataset.name || "",
                            "tr"
                        );

                }


                if (sort === "nameDesc") {

                    return (b.dataset.name || "")
                        .localeCompare(
                            a.dataset.name || "",
                            "tr"
                        );

                }


                return 0;

            });


            rows.forEach(function (row) {

                tableBody.appendChild(row);

            });

        }


        /* =========================
           EVENTS
        ========================== */

        searchInput.addEventListener(
            "input",
            applyFilters
        );


        categoryFilter.addEventListener(
            "change",
            applyFilters
        );


        statusFilter.addEventListener(
            "change",
            applyFilters
        );


        sortFilter.addEventListener(
            "change",
            applyFilters
        );


        /* =========================
           CLEAR
        ========================== */

        clearFilters.addEventListener(
            "click",
            function () {

                searchInput.value = "";

                categoryFilter.value = "";

                statusFilter.value = "";

                sortFilter.value = "default";

                applyFilters();

            }
        );

    });

</script>