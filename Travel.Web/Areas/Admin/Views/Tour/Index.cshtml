@using System.Globalization
@model List<Travel.Web.DTOs.TourDtos.TourListItemDto>

@{
    ViewData["Title"] = "Tur Yönetimi";
    Layout = "~/Views/AdminLayout/Layout.cshtml";


var totalTours = Model?.Count ?? 0;
    var activeTours = Model?.Count(x => x.Status == "Active") ?? 0;
    var passiveTours = Model?.Count(x => x.Status == "Passive") ?? 0;
    var totalCapacity = Model?.Sum(x => x.Capacity) ?? 0;


}

<style>
    /* ============ INDEX / TOUR LIST ============ */

    /* PAGE */
    .crumb {
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

        .crumb a {
            color: var(--muted);
        }

            .crumb a:hover {
                color: var(--teal-dark);
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600;
        }

    .page-intro h1 {
        font-weight: 700;
        font-size: 1.7rem;
        color: var(--navy);
        margin: .15rem 0 .3rem;
    }

    .page-intro p {
        color: var(--muted);
        margin: 0;
        font-size: .94rem;
        max-width: 60ch;
    }

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .7rem 1.3rem;
        font-size: .9rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        white-space: nowrap;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            box-shadow: 0 12px 26px rgba(15,163,163,.3);
        }

    /* KPI MINI */
    .kpi {
        display: flex;
        align-items: center;
        gap: .85rem;
    }

        .kpi .ic {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            flex: none;
        }

            .kpi .ic.gray {
                background: rgba(106,124,136,.12);
                color: var(--muted);
            }

            .kpi .ic.warn {
                background: rgba(169,116,26,.12);
                color: #a9741a;
            }

        .kpi .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--navy);
            line-height: 1;
        }

        .kpi .lab {
            font-size: .82rem;
            color: var(--muted);
            margin-top: .15rem;
        }

    /* FILTER BAR */
    .filter-bar {
        padding: 1rem 1.1rem;
    }

    .f-search {
        position: relative;
    }

        .f-search svg {
            position: absolute;
            left: .85rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
        }

        .f-search input {
            width: 100%;
            border: 1px solid var(--line);
            background: var(--cream);
            border-radius: 11px;
            padding: .62rem .9rem .62rem 2.3rem;
            font-size: .9rem;
            outline: none;
            color: var(--navy);
        }

            .f-search input:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.1);
            }

    .f-select {
        width: 100%;
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 11px;
        padding: .62rem 2rem .62rem .9rem;
        font-size: .88rem;
        font-weight: 500;
        color: var(--navy);
        outline: none;
        cursor: pointer;
    }

        .f-select:focus {
            border-color: var(--teal);
        }

    .btn-clear {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 11px;
        padding: .62rem 1rem;
        font-size: .86rem;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        transition: .2s;
        white-space: nowrap;
        width: 100%;
    }

        .btn-clear:hover {
            border-color: var(--cancel-fg);
            color: var(--cancel-fg);
        }

    /* RESULT */
    .result-line {
        font-size: .86rem;
        color: var(--muted);
        margin: .2rem 0 1rem;
        padding: 0 .2rem;
    }

        .result-line b {
            color: var(--navy);
            font-weight: 600;
        }

    /* BULK BAR */
    .bulk-bar {
        display: none;
        align-items: center;
        gap: .8rem;
        background: var(--navy);
        color: #fff;
        border-radius: 12px;
        padding: .6rem 1rem;
        margin-bottom: 1rem;
    }

        .bulk-bar.show {
            display: flex;
        }

        .bulk-bar b {
            font-family: 'Sora';
            font-size: .9rem;
        }

        .bulk-bar .bulk-btn {
            margin-left: auto;
            background: rgba(255,255,255,.12);
            border: none;
            color: #fff;
            border-radius: 999px;
            padding: .35rem .9rem;
            font-size: .82rem;
            font-weight: 600;
            cursor: pointer;
            transition: .2s;
        }

            .bulk-bar .bulk-btn + .bulk-btn {
                margin-left: .5rem;
            }

            .bulk-bar .bulk-btn:hover {
                background: rgba(255,255,255,.22);
            }

            .bulk-bar .bulk-btn.danger:hover {
                background: var(--cancel-fg);
            }

    /* TABLE */
    table.tx {
        min-width: 1020px;
    }

        table.tx th.sortable {
            cursor: pointer;
            user-select: none;
        }

            table.tx th.sortable:hover {
                color: var(--teal-dark);
            }

        table.tx th .sar {
            opacity: .4;
            margin-left: .2rem;
        }

        table.tx th.sorted .sar {
            opacity: 1;
            color: var(--teal-dark);
        }

        table.tx th {
            white-space: nowrap;
        }

        table.tx td {
            vertical-align: middle;
        }

    .chk {
        width: 17px;
        height: 17px;
        accent-color: var(--teal-dark);
        cursor: pointer;
    }

    /* TOUR */
    .tour-cell {
        display: flex;
        align-items: center;
        gap: .7rem;
        min-width: 220px;
    }

        .tour-cell img {
            width: 52px;
            height: 52px;
            border-radius: 11px;
            object-fit: cover;
            flex: none;
        }

        .tour-cell b {
            font-family: 'Sora';
            font-weight: 600;
            font-size: .9rem;
            color: var(--navy);
            display: block;
            line-height: 1.25;
        }

        .tour-cell span {
            font-size: .78rem;
            color: var(--teal-dark);
            font-weight: 500;
        }

    .cat-pill {
        font-size: .76rem;
        color: var(--navy);
        background: var(--cream);
        border: 1px solid var(--line);
        padding: .22rem .6rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .muted-cell {
        color: var(--muted);
        white-space: nowrap;
    }

    /* CAPACITY */
    .cap {
        min-width: 96px;
    }

        .cap .cap-top {
            font-size: .84rem;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: .28rem;
        }

            .cap .cap-top .full {
                color: var(--cancel-fg);
            }

    .cap-track {
        height: 5px;
        background: var(--line-2);
        border-radius: 999px;
        overflow: hidden;
    }

    .cap-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--teal);
    }

        .cap-fill.high {
            background: #e0a83d;
        }

        .cap-fill.full {
            background: var(--cancel-fg);
        }

    /* STATUS */
    .badge-x {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

    .b-pasif {
        background: var(--cancel-bg);
        color: var(--cancel-fg);
    }

    .b-taslak {
        background: var(--wait-bg);
        color: var(--wait-fg);
    }

    /* ACTION DROPDOWN */
    .act-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid var(--line);
        display: grid;
        place-items: center;
        color: var(--muted);
        cursor: pointer;
        transition: .2s;
    }

        .act-btn:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    .dropdown-menu {
        border: 1px solid var(--line);
        border-radius: 12px;
        box-shadow: var(--shadow-md);
        padding: .4rem;
        font-size: .88rem;
        min-width: 180px;
    }

    .dropdown-item {
        border-radius: 8px;
        padding: .5rem .7rem;
        font-weight: 500;
        color: var(--navy);
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .dropdown-item:hover {
            background: var(--cream);
            color: var(--teal-dark);
        }

        .dropdown-item svg {
            color: var(--muted);
        }

        .dropdown-item:hover svg {
            color: var(--teal-dark);
        }

        .dropdown-item.danger {
            color: var(--cancel-fg);
        }

            .dropdown-item.danger svg {
                color: var(--cancel-fg);
            }

            .dropdown-item.danger:hover {
                background: var(--cancel-bg);
            }

    /* PAGINATION */
    .pager-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1rem 1.1rem;
    }

    .pager {
        display: flex;
        gap: .35rem;
    }

        .pager a {
            min-width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: #fff;
            border: 1px solid var(--line);
            color: var(--navy);
            font-weight: 600;
            font-size: .88rem;
            transition: .2s;
            padding: 0 .3rem;
        }

            .pager a:hover {
                border-color: var(--teal);
                color: var(--teal-dark);
            }

            .pager a.active {
                background: var(--navy);
                color: #fff;
                border-color: var(--navy);
            }

            .pager a.disabled {
                opacity: .45;
                pointer-events: none;
            }

    .per-page {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .85rem;
        color: var(--muted);
    }

        .per-page select {
            border: 1px solid var(--line);
            border-radius: 9px;
            padding: .35rem 1.6rem .35rem .6rem;
            font-size: .85rem;
            font-weight: 600;
            color: var(--navy);
            outline: none;
            cursor: pointer;
        }

    /* EMPTY */
    .empty {
        text-align: center;
        padding: 3.5rem 1rem;
    }

        .empty .eic {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            margin: 0 auto 1rem;
        }

        .empty h3 {
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: 1.2rem;
        }

        .empty p {
            color: var(--muted);
            margin: .3rem 0 1.2rem;
        }

    /* RESPONSIVE */
    @@media (max-width: 768px) {

        .page-intro {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 1rem;
        }

            .page-intro .btn-teal {
                width: 100%;
                justify-content: center;
            }

        .bulk-bar {
            flex-wrap: wrap;
        }

            .bulk-bar .bulk-btn {
                margin-left: 0;
            }

                .bulk-bar .bulk-btn + .bulk-btn {
                    margin-left: 0;
                }

        .pager-row {
            justify-content: center;
        }
    }
</style>

<div class="content">

    
    <!-- BREADCRUMB -->

    <div class="crumb">

        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index">
            Dashboard
        </a>

        /

        <span class="cur">
            Turlar
        </span>

    </div>


    <!-- INTRO -->

    <div class="page-intro d-flex justify-content-between align-items-end mb-4">

        <div>

            <h1>
                Tur Yönetimi
            </h1>

            <p>
                Travelio'daki tüm turları görüntüleyebilir, filtreleyebilir ve yönetebilirsiniz.
            </p>

        </div>

        <a asp-area="Admin"
           asp-controller="Tour"
           asp-action="TourCreate"
           class="btn-teal">

            <svg width="17"
                 height="17"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />

            </svg>

            Yeni Tur Ekle

        </a>

    </div>


    <!-- KPI -->

    <div class="row g-3 mb-4">

        <!-- TOTAL -->

        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M3 7h18v12H3z" />
                        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @totalTours
                    </div>

                    <div class="lab">
                        Toplam Tur
                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIVE -->

        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <polyline points="20 6 9 17 4 12" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @activeTours
                    </div>

                    <div class="lab">
                        Aktif Tur
                    </div>

                </div>

            </div>

        </div>


        <!-- PASSIVE -->

        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic gray">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12" cy="12" r="10" />
                        <line x1="8" y1="12" x2="16" y2="12" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @passiveTours
                    </div>

                    <div class="lab">
                        Pasif Tur
                    </div>

                </div>

            </div>

        </div>


        <!-- CAPACITY -->

        <div class="col-6 col-lg-3">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @totalCapacity.ToString("N0")
                    </div>

                    <div class="lab">
                        Toplam Kontenjan
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- FILTER BAR -->

    <div class="card-x filter-bar mb-3">

        <div class="row g-2 align-items-center">

            <!-- SEARCH -->

            <div class="col-lg-4 col-md-6">

                <div class="f-search">

                    <svg width="16"
                         height="16"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />

                    </svg>

                    <input type="text"
                           id="fSearch"
                           placeholder="Tur adı veya destinasyon ara...">

                </div>

            </div>


            <!-- DESTINATION -->

            <div class="col-lg-3 col-md-6">

                <select class="f-select"
                        id="fDest">

                    <option value="">
                        Tüm Destinasyonlar
                    </option>

                    @foreach (var destination in Model
                                        .Where(x => !string.IsNullOrWhiteSpace(x.DestinationName))
                                        .Select(x => x.DestinationName)
                                        .Distinct()
                                        .OrderBy(x => x))
                    {
                        <option value="@destination">
                            @destination
                        </option>
                    }

                </select>

            </div>


            <!-- CATEGORY -->

            <div class="col-lg-2 col-md-4">

                <select class="f-select"
                        id="fCat">

                    <option value="">
                        Tüm Kategoriler
                    </option>

                    @foreach (var category in Model
                                        .Where(x => !string.IsNullOrWhiteSpace(x.CategoryName))
                                        .Select(x => x.CategoryName)
                                        .Distinct()
                                        .OrderBy(x => x))
                    {
                        <option value="@category">
                            @category
                        </option>
                    }

                </select>

            </div>


            <!-- STATUS -->

            <div class="col-lg-2 col-md-4">

                <select class="f-select"
                        id="fStatus">

                    <option value="">
                        Tüm Durumlar
                    </option>

                    <option value="Active">
                        Aktif
                    </option>

                    <option value="Passive">
                        Pasif
                    </option>

                    <option value="Draft">
                        Taslak
                    </option>

                </select>

            </div>


            <!-- CLEAR -->

            <div class="col-lg-1 col-md-4">

                <button class="btn-clear"
                        type="button"
                        onclick="clearFilters()">

                    Temizle

                </button>

            </div>

        </div>

    </div>


    <!-- RESULT -->

    <div class="result-line">

        <b id="resultCount">
            @totalTours
        </b>

        tur listeleniyor

    </div>


    <!-- BULK BAR -->

    <div class="bulk-bar"
         id="bulkBar">

        <b id="bulkCount">
            0 tur seçildi
        </b>

        <button class="bulk-btn"
                type="button"
                onclick="bulkStatus('Active')">

            Aktif Yap

        </button>

        <button class="bulk-btn"
                type="button"
                onclick="bulkStatus('Passive')">

            Pasif Yap

        </button>

        <button class="bulk-btn danger"
                type="button"
                onclick="bulkDelete()">

            Sil

        </button>

    </div>


    <!-- TABLE -->

    <div class="card-x mb-3">

        <div class="tbl-wrap">

            <table class="tx">

                <thead>

                    <tr>

                        <th style="width:36px">

                            <input type="checkbox"
                                   class="chk"
                                   id="checkAll"
                                   onchange="toggleAll(this)">

                        </th>

                        <th class="sortable"
                            data-sort="title">

                            Tur

                            <span class="sar">
                                ↕
                            </span>

                        </th>

                        <th>
                            Kategori
                        </th>

                        <th>
                            Süre
                        </th>

                        <th class="sortable"
                            data-sort="price">

                            Fiyat

                            <span class="sar">
                                ↕
                            </span>

                        </th>

                        <th class="sortable"
                            data-sort="date">

                            Yaklaşan Tarih

                            <span class="sar">
                                ↕
                            </span>

                        </th>

                        <th>
                            Kontenjan
                        </th>

                        <th class="sortable"
                            data-sort="res">

                            Rezervasyon

                            <span class="sar">
                                ↕
                            </span>

                        </th>

                        <th>
                            Durum
                        </th>

                        <th style="width:56px">
                            İşlemler
                        </th>

                    </tr>

                </thead>


                <tbody id="tourRows">

                    @foreach (var tour in Model)
                    {
                        var capacity = tour.Capacity;
                        var remaining = tour.RemainingCapacity;
                        var reservationCount = tour.ReservationCount;

                        var usedCapacity =
                        Math.Max(
                        0,
                        capacity - remaining
                        );

                        var percentage =
                        capacity > 0
                        ? Math.Min(
                        100,
                        (int)Math.Round(
                        (double)usedCapacity / capacity * 100
                        )
                        )
                        : 0;

                        var capacityClass =
                        percentage >= 100
                        ? "full"
                        : percentage >= 85
                        ? "high"
                        : "";

                        var statusText =
                        tour.Status switch
                        {
                            "Active" => "Aktif",
                            "Passive" => "Pasif",
                            "Draft" => "Taslak",
                            _ => tour.Status
                        };

                        var statusClass =
                        tour.Status switch
                        {
                            "Active" => "b-ok",
                            "Passive" => "b-pasif",
                            "Draft" => "b-taslak",
                            _ => ""
                        };

                        var imageUrl =
                        string.IsNullOrWhiteSpace(tour.CoverImageUrl)
                        ? "https://placehold.co/160x120?text=Tour"
                        : tour.CoverImageUrl;

                        <tr data-id="@tour.Id"
                            data-title="@tour.Name"
                            data-destination="@tour.DestinationName"
                            data-category="@tour.CategoryName"
                            data-status="@tour.Status"
                            data-price="@tour.Price"
                            data-date="@(tour.UpcomingDate?.ToString("yyyy-MM-dd") ?? "")"
                            data-res="@tour.ReservationCount">

                            <!-- CHECKBOX -->

                            <td>

                                <input type="checkbox"
                                       class="chk row-chk"
                                       value="@tour.Id"
                                       onchange="updateBulk()">

                            </td>


                            <!-- TOUR -->

                            <td>

                                <div class="tour-cell">

                                    <img src="@imageUrl"
                                         alt="@tour.Name">

                                    <div>

                                        <b>
                                            @tour.Name
                                        </b>

                                        <span>
                                            @tour.DestinationName
                                        </span>

                                    </div>

                                </div>

                            </td>


                            <!-- CATEGORY -->

                            <td>

                                <span class="cat-pill">

                                    @(string.IsNullOrWhiteSpace(tour.CategoryName)
                                                                    ? "-"
                                                                    : tour.CategoryName)

                            </span>

                            </td>


                            <!-- DURATION -->

                            <td class="muted-cell">

                                @tour.DurationDays Gün
                                /
                                @tour.DurationNights Gece

                            </td>


                            <!-- PRICE -->

                            <td>

                                <span class="amount">

                                    @tour.Price.ToString(
                                                                "N0",
                                                                new CultureInfo("tr-TR")
                                                                ) TL

                            </span>

                        </td>


                        <!-- DATE -->

                        <td class="muted-cell">

                            @if (tour.UpcomingDate.HasValue)
                                {
                                    @tour.UpcomingDate.Value.ToString(
                                    "dd MMMM yyyy",
                                                        new CultureInfo("tr-TR")
                                                        )
                                                        }
                                else
                                {
                                    <span>-</span>
                                }

                            </td>


                            <!-- CAPACITY -->

                            <td>

                                <div class="cap">

                                    <div class="cap-top">

                                        @usedCapacity / @capacity

                                        @if (percentage >= 100)
                                        {
                                            <span class="full">
                                                · Dolu
                                            </span>
                                        }

                                    </div>

                                    <div class="cap-track">

                                        <div class="cap-fill @capacityClass"
                                             style="width:@percentage%">
                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- RESERVATION -->

                            <td style="font-weight:600">

                                @reservationCount

                            </td>


                            <!-- STATUS -->

                            <td>

                                <span class="badge-x @statusClass">

                                    @statusText

                                </span>

                            </td>


                            <!-- ACTIONS -->

                            <td>

                                <div class="dropdown">

                                    <button class="act-btn"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-label="İşlemler">

                                        <svg width="18"
                                             height="18"
                                             viewBox="0 0 24 24"
                                             fill="currentColor">

                                            <circle cx="12"
                                                    cy="5"
                                                    r="1.7" />

                                            <circle cx="12"
                                                    cy="12"
                                                    r="1.7" />

                                            <circle cx="12"
                                                    cy="19"
                                                    r="1.7" />

                                        </svg>

                                    </button>


                                    <ul class="dropdown-menu dropdown-menu-end">

                                        <!-- VIEW -->

                                        <li>

                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Tour"
                                               asp-action="TourUpdate"
                                               asp-route-id="@tour.Id">

                                                <svg width="15"
                                                     height="15"
                                                     viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="2"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round">

                                                    <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" />

                                                    <circle cx="12"
                                                            cy="12"
                                                            r="3" />

                                                </svg>

                                                Görüntüle

                                            </a>

                                        </li>


                                        <!-- EDIT -->

                                        <li>

                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Tour"
                                               asp-action="TourUpdate"
                                               asp-route-id="@tour.Id">

                                                <svg width="15"
                                                     height="15"
                                                     viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="2"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round">

                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />

                                                    <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />

                                                </svg>

                                                Düzenle

                                            </a>

                                        </li>


                                        <!-- DELETE -->

                                        <li>

                                            <form asp-area="Admin"
                                                  asp-controller="Tour"
                                                  asp-action="Delete"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@tour.Id" />

                                                <button type="submit"
                                                        class="dropdown-item danger"
                                                        style="width:100%;border:none;background:transparent;"
                                                        onclick="return confirm('Bu turu silmek istediğinize emin misiniz?');">

                                                    <svg width="15"
                                                         height="15"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round"
                                                         stroke-linejoin="round">

                                                        <polyline points="3 6 5 6 21 6" />

                                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />

                                                    </svg>

                                                    Sil

                                                </button>

                                            </form>

                                        </li>

                                    </ul>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- EMPTY -->

        <div id="emptyState"
             style="display:none">

            <div class="empty">

                <div class="eic">

                    <svg width="26"
                         height="26"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="11"
                                cy="11"
                                r="8" />

                        <line x1="21"
                              y1="21"
                              x2="16.65"
                              y2="16.65" />

                    </svg>

                </div>

                <h3>
                    Tur bulunamadı
                </h3>

                <p>
                    Arama veya filtre kriterlerinizi değiştirerek tekrar deneyebilirsiniz.
                </p>

                <button class="btn-teal"
                        style="margin:0 auto"
                        type="button"
                        onclick="clearFilters()">

                    Filtreleri Temizle

                </button>

            </div>

        </div>


        <!-- PAGINATION -->

        <div class="pager-row"
             id="pagerRow">

            <div class="per-page">

                Sayfa başına

                <select id="perPage">

                    <option value="10">
                        10
                    </option>

                    <option value="25">
                        25
                    </option>

                    <option value="50">
                        50
                    </option>

                </select>

            </div>

            <div class="pager">

                <a href="#"
                   class="disabled">
                    Önceki
                </a>

                <a href="#"
                   class="active">
                    1
                </a>

                <a href="#">
                    2
                </a>

                <a href="#">
                    3
                </a>

                <a href="#">
                    4
                </a>

                <a href="#">
                    Sonraki
                </a>

            </div>

        </div>

    </div>
    

</div>

<!-- DELETE MODAL -->

<div class="modal fade"
     id="delModal"
     tabindex="-1">

    
    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-body text-center p-4">

                <div style="width:56px;height:56px;border-radius:16px;background:var(--cancel-bg);color:var(--cancel-fg);display:grid;place-items:center;margin:0 auto 1rem">

                    <svg width="26"
                         height="26"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <polyline points="3 6 5 6 21 6" />

                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />

                        <path d="M10 11v6M14 11v6" />

                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />

                    </svg>

                </div>

                <h5 style="font-family:'Sora';font-weight:700;color:var(--navy)">
                    Turu Sil
                </h5>

                <p style="color:var(--muted);font-size:.92rem;margin-bottom:.2rem"
                   id="delMsg">
                </p>

                <p style="color:var(--muted);font-size:.82rem">
                    Bu işlem geri alınamaz.
                </p>

                <div class="d-flex gap-2 justify-content-center mt-3">

                    <button class="btn-clear"
                            style="width:auto;padding:.6rem 1.3rem"
                            data-bs-dismiss="modal">

                        Vazgeç

                    </button>

                </div>

            </div>

        </div>

    </div>
    

</div>

<script>

    /* ==========================================
       FILTER
    ========================================== */

    function filterTours() {

        const search =
            document
                .getElementById("fSearch")
                .value
                .trim()
                .toLowerCase();

        const destination =
            document
                .getElementById("fDest")
                .value
                .toLowerCase();

        const category =
            document
                .getElementById("fCat")
                .value
                .toLowerCase();

        const status =
            document
                .getElementById("fStatus")
                .value
                .toLowerCase();

        const rows =
            document.querySelectorAll("#tourRows tr");

        let visibleCount = 0;

        rows.forEach(row => {

            const title =
                (row.dataset.title || "")
                    .toLowerCase();

            const rowDestination =
                (row.dataset.destination || "")
                    .toLowerCase();

            const rowCategory =
                (row.dataset.category || "")
                    .toLowerCase();

            const rowStatus =
                (row.dataset.status || "")
                    .toLowerCase();

            const searchMatch =
                !search ||
                title.includes(search) ||
                rowDestination.includes(search);

            const destinationMatch =
                !destination ||
                rowDestination === destination;

            const categoryMatch =
                !category ||
                rowCategory === category;

            const statusMatch =
                !status ||
                rowStatus === status;

            const visible =
                searchMatch &&
                destinationMatch &&
                categoryMatch &&
                statusMatch;

            row.style.display =
                visible ? "" : "none";

            if (visible) {
                visibleCount++;
            }

        });

        document
            .getElementById("resultCount")
            .textContent = visibleCount;

        updateEmptyState(visibleCount);

    }


    /* ==========================================
       EMPTY STATE
    ========================================== */

    function updateEmptyState(count) {

        const empty =
            document.getElementById("emptyState");

        const table =
            document.querySelector(".tbl-wrap");

        const pager =
            document.getElementById("pagerRow");

        if (count === 0) {

            table.style.display = "none";
            empty.style.display = "block";
            pager.style.display = "none";

        }
        else {

            table.style.display = "block";
            empty.style.display = "none";
            pager.style.display = "flex";

        }

    }


    /* ==========================================
       CLEAR FILTERS
    ========================================== */

    function clearFilters() {

        document.getElementById("fSearch").value = "";
        document.getElementById("fDest").value = "";
        document.getElementById("fCat").value = "";
        document.getElementById("fStatus").value = "";

        filterTours();

    }


    /* ==========================================
       BULK SELECTION
    ========================================== */

    function toggleAll(checkbox) {

        const rows =
            document.querySelectorAll("#tourRows tr");

        rows.forEach(row => {

            if (row.style.display === "none") {
                return;
            }

            const rowCheckbox =
                row.querySelector(".row-chk");

            if (rowCheckbox) {
                rowCheckbox.checked = checkbox.checked;
            }

        });

        updateBulk();

    }


    function selectedIds() {

        return [
            ...document.querySelectorAll(".row-chk:checked")
        ].map(x => x.value);

    }


    function updateBulk() {

        const ids =
            selectedIds();

        const bar =
            document.getElementById("bulkBar");

        bar.classList.toggle(
            "show",
            ids.length > 0
        );

        document.getElementById(
            "bulkCount"
        ).textContent =
            ids.length + " tur seçildi";

        updateCheckAllState();

    }


    function updateCheckAllState() {

        const checkAll =
            document.getElementById("checkAll");

        const visibleRows =
            [
                ...document.querySelectorAll("#tourRows tr")
            ].filter(row =>
                row.style.display !== "none"
            );

        const checkedRows =
            visibleRows.filter(row => {

                const checkbox =
                    row.querySelector(".row-chk");

                return checkbox && checkbox.checked;

            });

        if (visibleRows.length === 0) {

            checkAll.checked = false;
            checkAll.indeterminate = false;
            return;

        }

        checkAll.checked =
            checkedRows.length === visibleRows.length;

        checkAll.indeterminate =
            checkedRows.length > 0 &&
            checkedRows.length < visibleRows.length;

    }


    /* ==========================================
       BULK STATUS
    ========================================== */

    function bulkStatus(status) {

        alert(
            "Toplu durum güncelleme işlemi için controller endpoint'i eklenmelidir."
        );

    }


    /* ==========================================
       BULK DELETE
    ========================================== */

    function bulkDelete() {

        alert(
            "Toplu silme işlemi için controller endpoint'i eklenmelidir."
        );

    }


    /* ==========================================
       FILTER EVENTS
    ========================================== */

    document
        .getElementById("fSearch")
        .addEventListener(
            "input",
            filterTours
        );

    document
        .getElementById("fDest")
        .addEventListener(
            "change",
            filterTours
        );

    document
        .getElementById("fCat")
        .addEventListener(
            "change",
            filterTours
        );

    document
        .getElementById("fStatus")
        .addEventListener(
            "change",
            filterTours
        );


    /* ==========================================
       SORT
    ========================================== */

    let currentSort = null;
    let currentDirection = 1;

    document
        .querySelectorAll("th.sortable")
        .forEach(th => {

            th.addEventListener(
                "click",
                function () {

                    const key =
                        this.dataset.sort;

                    if (currentSort === key) {

                        currentDirection *= -1;

                    }
                    else {

                        currentSort = key;
                        currentDirection = 1;

                    }

                    document
                        .querySelectorAll("th.sortable")
                        .forEach(item =>
                            item.classList.remove("sorted")
                        );

                    this.classList.add("sorted");

                    sortRows(
                        key,
                        currentDirection
                    );

                    updateCheckAllState();

                }
            );

        });


    function sortRows(key, direction) {

        const tbody =
            document.getElementById("tourRows");

        const rows =
            [...tbody.querySelectorAll("tr")];

        rows.sort(
            (a, b) => {

                let aValue;
                let bValue;

                if (key === "title") {

                    aValue =
                        a.dataset.title || "";

                    bValue =
                        b.dataset.title || "";

                    return (
                        aValue.localeCompare(
                            bValue,
                            "tr"
                        ) * direction
                    );

                }

                if (key === "price") {

                    aValue =
                        parseFloat(
                            a.dataset.price || "0"
                        );

                    bValue =
                        parseFloat(
                            b.dataset.price || "0"
                        );

                }

                if (key === "res") {

                    aValue =
                        parseInt(
                            a.dataset.res || "0"
                        );

                    bValue =
                        parseInt(
                            b.dataset.res || "0"
                        );

                }

                if (key === "date") {

                    aValue =
                        a.dataset.date || "";

                    bValue =
                        b.dataset.date || "";

                    return (
                        aValue.localeCompare(
                            bValue
                        ) * direction
                    );

                }

                return (
                    (aValue - bValue) * direction
                );

            }
        );

        rows.forEach(row =>
            tbody.appendChild(row)
        );

    }


    /* ==========================================
       ROW CHECKBOX EVENTS
    ========================================== */

    document
        .querySelectorAll(".row-chk")
        .forEach(checkbox => {

            checkbox.addEventListener(
                "change",
                updateBulk
            );

        });


    /* ==========================================
       INITIAL
    ========================================== */

    filterTours();

</script>
