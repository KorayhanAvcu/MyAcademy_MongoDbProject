@model Travel.Web.DTOs.TourDtos.TourCreateDto

@{
    ViewData["Title"] = "Yeni Tur Oluştur";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    :root {
        --navy: #122033;
        --muted: #7b8794;
        --line: #e8edf2;
        --line-2: #dce3ea;
        --teal: #12a594;
        --teal-dark: #087f72;
        --cream: #f7fafb;
        --r: 14px;
        --shadow-sm: 0 2px 8px rgba(18,32,51,.05);
        --shadow-md: 0 10px 30px rgba(18,32,51,.08);
        --cancel-fg: #8b4b4b;
        --cancel-bg: #fff4f4;
        --wait-fg: #946b00;
        --wait-bg: #fff8df;
    }

    * {
        box-sizing: border-box;
    }

    .content {
        width: 100%;
        max-width: none;
        padding: 24px 28px 35px;
    }

    .tour-form-shell {
        width: 100%;
        max-width: none;
    }

    /* PAGE HEADER */

    .page-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }

    .page-title {
        margin: 0;
        color: var(--navy);
        font-size: 30px;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -.4px;
    }

    .page-subtitle {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
    }

    .head-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    /* BUTTONS */

    .btn-ui {
        min-height: 42px;
        padding: 0 16px;
        border-radius: 10px;
        border: 1px solid var(--line-2);
        background: #fff;
        color: var(--navy);
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        transition: .2s ease;
    }

        .btn-ui:hover {
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

    .btn-primary-ui {
        border-color: var(--teal);
        background: var(--teal);
        color: #fff;
    }

        .btn-primary-ui:hover {
            border-color: var(--teal-dark);
            background: var(--teal-dark);
            color: #fff;
        }

    .btn-secondary-ui {
        background: #fff;
        color: var(--navy);
    }

    .btn-danger-ui {
        border-color: #f1d5d5;
        background: var(--cancel-bg);
        color: var(--cancel-fg);
    }

    /* CARD */

    .form-card {
        width: 100%;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        margin-bottom: 18px;
    }

    .card-head {
        padding: 20px 22px;
        border-bottom: 1px solid var(--line);
        background: linear-gradient(180deg, #fff, #fbfcfd);
    }

    .card-title {
        margin: 0;
        color: var(--navy);
        font-size: 17px;
        font-weight: 800;
    }

    .card-description {
        margin: 5px 0 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.55;
    }

    .card-body {
        padding: 22px;
    }

    /* GRID */

    .section-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .section-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .full {
        grid-column: 1 / -1;
    }

    /* FORM */

    .form-group {
        min-width: 0;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        color: var(--navy);
        font-size: 13px;
        font-weight: 700;
    }

        .form-label .required {
            color: #d64545;
            margin-left: 2px;
        }

    .form-control,
    .form-select {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
        border: 1px solid var(--line-2);
        border-radius: 10px;
        background: #fff;
        color: var(--navy);
        font-size: 13px;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--teal);
        box-shadow: 0 0 0 3px rgba(18,165,148,.10);
    }

    .form-help {
        margin-top: 6px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.45;
    }

    .field-validation-error,
    .text-danger {
        display: block;
        margin-top: 5px;
        color: #d64545;
        font-size: 11px;
    }

    .input-group-ui {
        display: flex;
        align-items: stretch;
    }

        .input-group-ui .form-control {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

    .input-suffix {
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--line-2);
        border-left: 0;
        border-radius: 0 10px 10px 0;
        background: var(--cream);
        color: var(--muted);
        font-size: 12px;
        font-weight: 700;
    }

    /* IMAGE PREVIEW */

    .cover-preview {
        margin-top: 12px;
        width: 100%;
        min-height: 170px;
        border: 1px dashed var(--line-2);
        border-radius: 12px;
        background: var(--cream);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .cover-preview img {
            display: block;
            width: 100%;
            max-height: 260px;
            object-fit: cover;
        }

    .preview-placeholder {
        color: var(--muted);
        font-size: 12px;
        padding: 20px;
        text-align: center;
    }

    /* GALLERY */

    .gallery-input-wrap {
        display: flex;
        gap: 10px;
    }

        .gallery-input-wrap .form-control {
            flex: 1;
        }

    .gallery-items {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-top: 14px;
    }

    .gallery-item {
        position: relative;
        min-height: 150px;
        border: 1px solid var(--line);
        border-radius: 12px;
        overflow: hidden;
        background: var(--cream);
    }

        .gallery-item img {
            width: 100%;
            height: 150px;
            display: block;
            object-fit: cover;
        }

    .gallery-remove {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 30px;
        height: 30px;
        border: 0;
        border-radius: 50%;
        background: rgba(18,32,51,.82);
        color: #fff;
        cursor: pointer;
        font-size: 15px;
        line-height: 1;
    }

    /* DYNAMIC ROW */

    .dynamic-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .dynamic-row {
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 16px;
        background: #fcfdfd;
    }

    .dynamic-row-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
    }

    .row-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: rgba(18,165,148,.10);
        color: var(--teal-dark);
        font-size: 12px;
        font-weight: 800;
    }

    .dynamic-row-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--navy);
        font-size: 13px;
        font-weight: 800;
    }

    .remove-row {
        min-width: 82px;
        height: 40px;
        padding: 0 13px;
        border: 1px solid #f1d5d5;
        background: var(--cancel-bg);
        color: var(--cancel-fg);
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        transition: .2s ease;
        flex-shrink: 0;
    }

        .remove-row i {
            font-size: 12px;
        }

        .remove-row:hover {
            background: #d64545;
            border-color: #d64545;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(214,69,69,.16);
        }

        .remove-row:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px rgba(214,69,69,.12);
        }

    /* ADD BUTTON */

    .add-button {
        width: 100%;
        min-height: 42px;
        margin-top: 14px;
        border: 1px dashed #b7dcd6;
        border-radius: 10px;
        background: #f6fbfa;
        color: var(--teal-dark);
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s ease;
    }

        .add-button:hover {
            background: #edf8f6;
            border-color: var(--teal);
        }

    /* SIMPLE LIST */

    .simple-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .simple-list-item {
        display: flex;
        gap: 14px;
        align-items: center;
    }

        .simple-list-item .form-control {
            flex: 1;
            min-width: 0;
        }

    .list-remove {
        flex: 0 0 82px;
        width: 82px;
        height: 42px;
        border: 1px solid #f1d5d5;
        border-radius: 9px;
        background: var(--cancel-bg);
        color: var(--cancel-fg);
        cursor: pointer;
        font-size: 12px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        white-space: nowrap;
        transition: .2s ease;
    }

        .list-remove i {
            font-size: 12px;
        }

        .list-remove:hover {
            background: #d64545;
            border-color: #d64545;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(214,69,69,.16);
        }

        .list-remove:focus-visible {
            outline: none;
            box-shadow: 0 0 0 3px rgba(214,69,69,.12);
        }

    /* STATUS */

    .status-options {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .status-option {
        position: relative;
    }

        .status-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .status-label {
        display: block;
        padding: 15px;
        border: 1px solid var(--line-2);
        border-radius: 11px;
        cursor: pointer;
        transition: .2s ease;
        background: #fff;
    }

    .status-name {
        display: block;
        color: var(--navy);
        font-size: 13px;
        font-weight: 800;
    }

    .status-desc {
        display: block;
        margin-top: 4px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.4;
    }

    .status-option input:checked + .status-label {
        border-color: var(--teal);
        background: #f3fbf9;
        box-shadow: 0 0 0 3px rgba(18,165,148,.08);
    }

    /* SWITCHES */

    .switch-list {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .switch-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: 11px;
        background: #fff;
    }

    .switch-text strong {
        display: block;
        color: var(--navy);
        font-size: 12px;
        font-weight: 800;
    }

    .switch-text span {
        display: block;
        margin-top: 3px;
        color: var(--muted);
        font-size: 10px;
    }

    .switch {
        position: relative;
        width: 42px;
        height: 24px;
        flex-shrink: 0;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        inset: 0;
        border-radius: 20px;
        background: #d8dee5;
        cursor: pointer;
        transition: .2s ease;
    }

        .slider:before {
            content: "";
            position: absolute;
            width: 18px;
            height: 18px;
            left: 3px;
            top: 3px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 1px 4px rgba(0,0,0,.15);
            transition: .2s ease;
        }

    .switch input:checked + .slider {
        background: var(--teal);
    }

        .switch input:checked + .slider:before {
            transform: translateX(18px);
        }

    /* VALIDATION */

    .validation-box {
        display: none;
        margin-bottom: 18px;
        padding: 15px 18px;
        border: 1px solid #f1d5d5;
        border-radius: 12px;
        background: var(--cancel-bg);
    }

        .validation-box.show {
            display: block;
        }

        .validation-box strong {
            display: block;
            margin-bottom: 8px;
            color: #8b4b4b;
            font-size: 13px;
        }

        .validation-box ul {
            margin: 0;
            padding-left: 20px;
            color: #8b4b4b;
            font-size: 12px;
            line-height: 1.7;
        }

    /* BOTTOM ACTIONS */

    .bottom-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 18px 0 4px;
    }

    .bottom-left,
    .bottom-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* TOAST */

    .toast-ui {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 9999;
        min-width: 280px;
        max-width: 420px;
        padding: 14px 16px;
        border-radius: 11px;
        background: var(--navy);
        color: #fff;
        box-shadow: var(--shadow-md);
        font-size: 12px;
        font-weight: 700;
        opacity: 0;
        visibility: hidden;
        transform: translateY(15px);
        transition: .25s ease;
    }

        .toast-ui.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

    /* RESPONSIVE */

    @@media (max-width: 1100px) {
        .gallery-items {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .switch-list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .section-grid-3 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .status-options {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .content {
            padding: 20px 18px 30px;
        }

        .page-head {
            flex-direction: column;
        }

        .head-actions {
            width: 100%;
        }

        .section-grid,
        .section-grid-3 {
            grid-template-columns: 1fr;
        }

        .gallery-items {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .switch-list {
            grid-template-columns: 1fr;
        }

        .bottom-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .bottom-left,
        .bottom-right {
            width: 100%;
        }

            .bottom-right .btn-ui,
            .bottom-left .btn-ui {
                flex: 1;
            }
    }

    @@media (max-width: 575px) {
        .dynamic-row-head {
            align-items: flex-start;
        }

        .remove-row {
            min-width: 74px;
            height: 38px;
            padding: 0 10px;
        }

        .simple-list-item {
            gap: 8px;
        }

        .list-remove {
            flex: 0 0 74px;
            width: 74px;
            height: 40px;
        }

        .content {
            padding: 16px 12px 25px;
        }

        .card-head,
        .card-body {
            padding: 16px;
        }

        .page-title {
            font-size: 24px;
        }

        .gallery-items {
            grid-template-columns: 1fr;
        }

        .gallery-input-wrap {
            flex-direction: column;
        }

        .head-actions,
        .bottom-left,
        .bottom-right {
            flex-direction: column;
        }

            .head-actions .btn-ui,
            .bottom-left .btn-ui,
            .bottom-right .btn-ui {
                width: 100%;
            }
    }
</style>

<div class="content">
    <div class="tour-form-shell">

        <!-- HEADER -->
        <div class="page-head">
            <div>
                <h1 class="page-title">Yeni Tur Oluştur</h1>
                <p class="page-subtitle">
                    Yeni bir tur oluşturun ve tur bilgilerini, tarihleri, günlük programı ve görselleri yönetin.
                </p>
            </div>

            <div class="head-actions">
                <a href="@Url.Action("Index", "Tour", new { area = "Admin" })"
                   class="btn-ui btn-secondary-ui">
                    ← Turlara Dön
                </a>
            </div>
        </div>

        <div id="validationBox" class="validation-box">
            <strong>Lütfen aşağıdaki alanları kontrol edin:</strong>
            <ul id="validationList"></ul>
        </div>

        <form id="tourForm"
              asp-area="Admin"
              asp-controller="Tour"
              asp-action="TourCreate"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Status" id="statusValue" />

            <!-- TEMEL BİLGİLER -->
            <div class="form-card">
                <div class="card-head">
                    <h2 class="card-title">Temel Bilgiler</h2>
                    <p class="card-description">
                        Turun temel bilgilerini ve açıklamalarını girin.
                    </p>
                </div>

                <div class="card-body">
                    <div class="section-grid">

                        <div class="form-group">
                            <label asp-for="Name" class="form-label">
                                Tur Adı <span class="required">*</span>
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Örn. Kapadokya Balon ve Kültür Turu" />

                            <span asp-validation-for="Name"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="TourType" class="form-label">
                                Tur Tipi
                            </label>

                            <select asp-for="TourType" class="form-select">
                                <option value="">Tur tipi seçiniz</option>
                                <option value="Kültür">Kültür</option>
                                <option value="Yurtdışı">Yurtdışı</option>
                                <option value="Yurtiçi">Yurtiçi</option>
                                <option value="Doğa">Doğa</option>
                                <option value="Deniz">Deniz</option>
                                <option value="Macera">Macera</option>
                                <option value="Gastronomi">Gastronomi</option>
                            </select>

                            <span asp-validation-for="TourType"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="CategoryId" class="form-label">
                                Kategori <span class="required">*</span>
                            </label>

                            <select asp-for="CategoryId" class="form-select">
                                <option value="">Kategori seçiniz</option>

                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var category in ViewBag.Categories)
                                    {
                                        <option value="@category.Id">
                                            @category.Name
                                        </option>
                                    }
                                }
                            </select>

                            <span asp-validation-for="CategoryId"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="DestinationId" class="form-label">
                                Destinasyon <span class="required">*</span>
                            </label>

                            <select asp-for="DestinationId" class="form-select">
                                <option value="">Destinasyon seçiniz</option>

                                @if (ViewBag.Destinations != null)
                                {
                                    foreach (var destination in ViewBag.Destinations)
                                    {
                                        <option value="@destination.Id">
                                            @destination.City - @destination.Country
                                        </option>
                                    }
                                }
                            </select>

                            <span asp-validation-for="DestinationId"></span>
                        </div>

                        <div class="form-group full">
                            <label asp-for="ShortDescription" class="form-label">
                                Kısa Açıklama
                            </label>

                            <textarea asp-for="ShortDescription"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Tur kartlarında ve kısa tanıtımlarda kullanılacak açıklama..."></textarea>

                            <span asp-validation-for="ShortDescription"></span>
                        </div>

                        <div class="form-group full">
                            <label asp-for="Description" class="form-label">
                                Detaylı Açıklama
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="7"
                                      placeholder="Tur hakkında detaylı açıklama..."></textarea>

                            <span asp-validation-for="Description"></span>
                        </div>

                        <div class="form-group full">
                            <label asp-for="RouteId" class="form-label">
                                Rota
                            </label>

                            <input asp-for="RouteId"
                                   class="form-control"
                                   placeholder="Örn. İstanbul → Ankara → Kapadokya → Konya → İstanbul" />

                            <span asp-validation-for="RouteId"></span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- SÜRE / FİYAT / KAPASİTE -->
            <div class="form-card">
                <div class="card-head">
                    <h2 class="card-title">Süre, Fiyat ve Kapasite</h2>
                    <p class="card-description">
                        Turun ücret, süre, kapasite ve ulaşım bilgilerini belirleyin.
                    </p>
                </div>

                <div class="card-body">
                    <div class="section-grid-3">

                        <div class="form-group">
                            <label asp-for="Price" class="form-label">
                                Fiyat <span class="required">*</span>
                            </label>

                            <div class="input-group-ui">
                                <input asp-for="Price"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00" />

                                <span class="input-suffix">₺</span>
                            </div>

                            <span asp-validation-for="Price"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="DurationDays" class="form-label">
                                Gün Sayısı <span class="required">*</span>
                            </label>

                            <div class="input-group-ui">
                                <input asp-for="DurationDays"
                                       class="form-control"
                                       type="number"
                                       min="1"
                                       placeholder="1" />

                                <span class="input-suffix">Gün</span>
                            </div>

                            <span asp-validation-for="DurationDays"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="DurationNights" class="form-label">
                                Gece Sayısı
                            </label>

                            <div class="input-group-ui">
                                <input asp-for="DurationNights"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       placeholder="0" />

                                <span class="input-suffix">Gece</span>
                            </div>

                            <span asp-validation-for="DurationNights"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="MaxCapacity" class="form-label">
                                Maksimum Kapasite <span class="required">*</span>
                            </label>

                            <div class="input-group-ui">
                                <input asp-for="MaxCapacity"
                                       class="form-control"
                                       type="number"
                                       min="1"
                                       placeholder="20" />

                                <span class="input-suffix">Kişi</span>
                            </div>

                            <span asp-validation-for="MaxCapacity"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="MinParticipants" class="form-label">
                                Minimum Katılımcı <span class="required">*</span>
                            </label>

                            <div class="input-group-ui">
                                <input asp-for="MinParticipants"
                                       class="form-control"
                                       type="number"
                                       min="1"
                                       placeholder="2" />

                                <span class="input-suffix">Kişi</span>
                            </div>

                            <span asp-validation-for="MinParticipants"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="DepartureCity" class="form-label">
                                Kalkış Şehri
                            </label>

                            <input asp-for="DepartureCity"
                                   class="form-control"
                                   placeholder="Örn. İstanbul" />

                            <span asp-validation-for="DepartureCity"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Transportation" class="form-label">
                                Ulaşım
                            </label>

                            <select asp-for="Transportation" class="form-select">
                                <option value="">Ulaşım seçiniz</option>
                                <option value="Uçak">Uçak</option>
                                <option value="Otobüs">Otobüs</option>
                                <option value="Tren">Tren</option>
                                <option value="Gemi">Gemi</option>
                                <option value="Özel Araç">Özel Araç</option>
                                <option value="Karma">Karma</option>
                            </select>

                            <span asp-validation-for="Transportation"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Accommodation" class="form-label">
                                Konaklama
                            </label>

                            <input asp-for="Accommodation"
                                   class="form-control"
                                   placeholder="Örn. 4★ Otel" />

                            <span asp-validation-for="Accommodation"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="GuideLanguage" class="form-label">
                                Rehber Dili
                            </label>

                            <input asp-for="GuideLanguage"
                                   class="form-control"
                                   placeholder="Örn. Türkçe / İngilizce" />

                            <span asp-validation-for="GuideLanguage"></span>
                        </div>

                        <div class="form-group full">
                            <label asp-for="VisaInfo" class="form-label">
                                Vize Bilgisi
                            </label>

                            <textarea asp-for="VisaInfo"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Vize gereksinimleri hakkında bilgi..."></textarea>

                            <span asp-validation-for="VisaInfo"></span>
                        </div>

                    </div>
                </div>
            </div>

            <!-- GÖRSELLER -->
            <div class="form-card">
                <div class="card-head">
                    <h2 class="card-title">Görseller</h2>
                    <p class="card-description">
                        Turun kapak ve galeri görsellerini URL üzerinden ekleyin.
                    </p>
                </div>

                <div class="card-body">

                    <div class="form-group">
                        <label asp-for="CoverImageUrl" class="form-label">
                            Kapak Görseli
                        </label>

                        <input asp-for="CoverImageUrl"
                               id="coverImageUrl"
                               class="form-control"
                               placeholder="https://example.com/cover.jpg" />

                        <span asp-validation-for="CoverImageUrl"></span>

                        <div id="coverPreview" class="cover-preview">
                            <div class="preview-placeholder">
                                Kapak görseli URL'si girildiğinde önizleme burada görünecek.
                            </div>
                        </div>
                    </div>

                    <div style="height:22px;"></div>

                    <div class="form-group">
                        <label class="form-label">
                            Galeri Görselleri
                        </label>

                        <div class="gallery-input-wrap">
                            <input id="galleryImages"
                                   type="text"
                                   class="form-control"
                                   placeholder="Görsel URL'sini yazın ve Enter'a basın..." />

                            <button type="button"
                                    class="btn-ui btn-primary-ui"
                                    id="addGalleryButton">
                                + Görsel Ekle
                            </button>
                        </div>

                        <div class="form-help">
                            Her URL'yi ekledikten sonra galeriye ayrı bir görsel olarak kaydedilir.
                        </div>

                        <div id="galleryItems" class="gallery-items"></div>
                    </div>

                </div>
            </div>

            <!-- TUR TARİHLERİ -->
            <div class="form-card">
                <div class="card-head">
                    <h2 class="card-title">Tur Tarihleri</h2>
                    <p class="card-description">
                        Turun gerçekleşeceği tarihleri ve her tarih için kapasiteyi belirleyin.
                    </p>
                </div>

                <div class="card-body">
                    <div id="tourDatesContainer" class="dynamic-list"></div>

                    <button type="button"
                            class="add-button"
                            onclick="addTourDate()">
                        + Yeni Tur Tarihi Ekle
                    </button>
                </div>
            </div>

            <!-- GÜN PROGRAMI -->
            <div class="form-card">
                <div class="card-head">
                    <h2 class="card-title">Günlük Program</h2>
                    <p class="card-description">
                        Turun her günü için program detaylarını oluşturun.
                    </p>
                </div>

                <div class="card-body">
                    <div id="dayProgramsContainer" class="dynamic-list"></div>

                    <button type="button"
                            class="add-button"
                            onclick="addDayProgram()">
                        + Yeni Gün Ekle
                    </button>
                </div>
            </div>

            <!-- DAHİL OLANLAR / OLMAYANLAR -->
            <div class="form-card">
                <div class="card-head">
                    <h2 class="card-title">Tur İçeriği</h2>
                    <p class="card-description">
                        Fiyata dahil olan, olmayan ve turun öne çıkan özelliklerini ekleyin.
                    </p>
                </div>

                <div class="card-body">
                    <div class="section-grid">

                        <div class="form-group">
                            <label class="form-label">
                                Fiyata Dahil Olanlar
                            </label>

                            <div id="includesContainer" class="simple-list"></div>

                            <button type="button"
                                    class="add-button"
                                    onclick="addListItem('includes')">
                                + Dahil Olan Ekle
                            </button>
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Fiyata Dahil Olmayanlar
                            </label>

                            <div id="excludesContainer" class="simple-list"></div>

                            <button type="button"
                                    class="add-button"
                                    onclick="addListItem('excludes')">
                                + Dahil Olmayan Ekle
                            </button>
                        </div>

                        <div class="form-group full">
                            <label class="form-label">
                                Öne Çıkanlar
                            </label>

                            <div id="highlightsContainer" class="simple-list"></div>

                            <button type="button"
                                    class="add-button"
                                    onclick="addListItem('highlights')">
                                + Öne Çıkan Özellik Ekle
                            </button>
                        </div>

                    </div>
                </div>
            </div>

            <!-- DURUM -->
            <div class="form-card">
                <div class="card-head">
                    <h2 class="card-title">Yayın Durumu</h2>
                    <p class="card-description">
                        Turun sistemdeki durumunu ve öne çıkarılma seçeneklerini belirleyin.
                    </p>
                </div>

                <div class="card-body">

                    <div class="status-options">

                        <div class="status-option">
                            <input type="radio"
                                   name="statusRadio"
                                   id="statusDraft"
                                   value="Draft"
                                   checked />

                            <label for="statusDraft" class="status-label">
                                <span class="status-name">Taslak</span>
                                <span class="status-desc">
                                    Tur henüz yayına hazır değil.
                                </span>
                            </label>
                        </div>

                        <div class="status-option">
                            <input type="radio"
                                   name="statusRadio"
                                   id="statusActive"
                                   value="Active" />

                            <label for="statusActive" class="status-label">
                                <span class="status-name">Aktif</span>
                                <span class="status-desc">
                                    Tur kullanıcılar tarafından görüntülenebilir.
                                </span>
                            </label>
                        </div>

                        <div class="status-option">
                            <input type="radio"
                                   name="statusRadio"
                                   id="statusPassive"
                                   value="Passive" />

                            <label for="statusPassive" class="status-label">
                                <span class="status-name">Pasif</span>
                                <span class="status-desc">
                                    Tur sistemde tutulur ancak yayında değildir.
                                </span>
                            </label>
                        </div>

                    </div>

                    <div style="height:18px;"></div>

                    <div class="switch-list">

                        <div class="switch-item">
                            <div class="switch-text">
                                <strong>Öne Çıkan</strong>
                                <span>Ana sayfada öne çıkar</span>
                            </div>

                            <label class="switch">
                                <input asp-for="IsFeatured" type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="switch-item">
                            <div class="switch-text">
                                <strong>Çok Satan</strong>
                                <span>Çok satan tur olarak işaretle</span>
                            </div>

                            <label class="switch">
                                <input asp-for="IsBestSeller" type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="switch-item">
                            <div class="switch-text">
                                <strong>Yeni Tur</strong>
                                <span>Yeni tur etiketi göster</span>
                            </div>

                            <label class="switch">
                                <input asp-for="IsNew" type="checkbox" />
                                <span class="slider"></span>
                            </label>
                        </div>

                    </div>
                </div>
            </div>

            <!-- ALT BUTONLAR -->
            <div class="bottom-actions">

                <div class="bottom-left">
                    <a href="@Url.Action("Index", "Tour", new { area = "Admin" })"
                       class="btn-ui btn-danger-ui">
                        İptal
                    </a>
                </div>

                <div class="bottom-right">

                    <button type="button"
                            class="btn-ui btn-secondary-ui"
                            onclick="submitTour('Draft')">
                        Taslak Olarak Kaydet
                    </button>

                    <button type="button"
                            class="btn-ui btn-primary-ui"
                            onclick="submitTour('Active')">
                        Aktif Olarak Yayınla
                    </button>

                </div>

            </div>

        </form>
    </div>
</div>

<div id="toast" class="toast-ui"></div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        let tourDateIndex = 0;
        let dayProgramIndex = 0;

        let listIndexes = {
            includes: 0,
            excludes: 0,
            highlights: 0
        };

        /* ==============================
           TOAST
        ============================== */

        function showToast(message) {
            const toast = document.getElementById("toast");

            toast.textContent = message;
            toast.classList.add("show");

            setTimeout(() => {
                toast.classList.remove("show");
            }, 2500);
        }

        /* ==============================
           TOUR DATE
        ============================== */

        function addTourDate() {

            const container = document.getElementById("tourDatesContainer");

            const index = tourDateIndex++;

            const html = `
                <div class="dynamic-row tour-date-row" data-index="${index}">

                    <div class="dynamic-row-head">
                        <div class="dynamic-row-title">
                            <span class="row-number">${index + 1}</span>
                            Tur Tarihi
                        </div>

                        <button type="button"
                                class="remove-row"
                                title="Bu satırı sil"
                                onclick="removeRow(this)">
                            <i class="fas fa-trash-alt"></i>
                            <span>Sil</span>
                        </button>
                    </div>

                    <div class="section-grid-3">

                        <div class="form-group">
                            <label class="form-label">
                                Başlangıç Tarihi <span class="required">*</span>
                            </label>

                            <input type="date"
                                   class="form-control tour-date-start"
                                   data-field="StartDate" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Bitiş Tarihi
                            </label>

                            <input type="date"
                                   class="form-control tour-date-end"
                                   data-field="EndDate" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Kapasite <span class="required">*</span>
                            </label>

                            <div class="input-group-ui">
                                <input type="number"
                                       class="form-control tour-date-capacity"
                                       data-field="Capacity"
                                       min="1"
                                       placeholder="20" />

                                <span class="input-suffix">Kişi</span>
                            </div>
                        </div>

                    </div>
                </div>
            `;

            container.insertAdjacentHTML("beforeend", html);

            syncTourDateNames();
            updateRowNumbers();
        }

        /* ==============================
           DAY PROGRAM
        ============================== */

        function addDayProgram() {

            const container = document.getElementById("dayProgramsContainer");

            const index = dayProgramIndex++;

            const html = `
                <div class="dynamic-row day-program-row" data-index="${index}">

                    <div class="dynamic-row-head">
                        <div class="dynamic-row-title">
                            <span class="row-number">${index + 1}</span>
                            Gün Programı
                        </div>

                        <button type="button"
                                class="remove-row"
                                title="Bu satırı sil"
                                onclick="removeRow(this)">
                            <i class="fas fa-trash-alt"></i>
                            <span>Sil</span>
                        </button>
                    </div>

                    <input type="hidden"
                           class="day-program-day"
                           data-field="DayNumber" />

                    <div class="section-grid">

                        <div class="form-group">
                            <label class="form-label">
                                Başlık <span class="required">*</span>
                            </label>

                            <input type="text"
                                   class="form-control day-title"
                                   data-field="Title"
                                   placeholder="Örn. İstanbul'dan Kapadokya'ya Hareket" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Şehir
                            </label>

                            <input type="text"
                                   class="form-control day-city"
                                   data-field="City"
                                   placeholder="Örn. Nevşehir" />
                        </div>

                        <div class="form-group full">
                            <label class="form-label">
                                Açıklama <span class="required">*</span>
                            </label>

                            <textarea class="form-control day-description"
                                      data-field="Description"
                                      rows="4"
                                      placeholder="Bu gün yapılacak aktiviteleri açıklayın..."></textarea>
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Konaklama
                            </label>

                            <input type="text"
                                   class="form-control day-accommodation"
                                   data-field="Accommodation"
                                   placeholder="Örn. Kapadokya Cave Hotel" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Ulaşım
                            </label>

                            <input type="text"
                                   class="form-control day-transportation"
                                   data-field="Transportation"
                                   placeholder="Örn. Otobüs" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                Öğün
                            </label>

                            <input type="text"
                                   class="form-control day-meal"
                                   data-field="Meal"
                                   placeholder="Örn. Kahvaltı + Akşam Yemeği" />
                        </div>

                    </div>

                </div>
            `;

            container.insertAdjacentHTML("beforeend", html);

            syncDayProgramNames();
            updateRowNumbers();
        }

        /* ==============================
           REMOVE ROW
        ============================== */

        function removeRow(button) {

            const row = button.closest(".dynamic-row");

            if (!row) {
                return;
            }

            row.remove();

            syncTourDateNames();
            syncDayProgramNames();
            updateRowNumbers();
        }

        /* ==============================
           ROW NUMBERS
        ============================== */

        function updateRowNumbers() {

            document.querySelectorAll(".tour-date-row").forEach((row, index) => {

                const number = row.querySelector(".row-number");

                if (number) {
                    number.textContent = index + 1;
                }
            });

            document.querySelectorAll(".day-program-row").forEach((row, index) => {

                const number = row.querySelector(".row-number");

                if (number) {
                    number.textContent = index + 1;
                }
            });
        }

        /* ==============================
           LIST ITEM
        ============================== */

        function addListItem(type, value = "") {

            const container = document.getElementById(
                type === "includes"
                    ? "includesContainer"
                    : type === "excludes"
                        ? "excludesContainer"
                        : "highlightsContainer"
            );

            if (!container) {
                return;
            }

            const index = listIndexes[type]++;

            const html = `
                <div class="simple-list-item" data-list-type="${type}">

                    <input type="text"
                           class="form-control list-value"
                           value="${escapeHtml(value)}"
                           data-index="${index}"
                           placeholder="${getListPlaceholder(type)}" />

                    <button type="button"
                            class="list-remove"
                            title="Bu satırı sil"
                            onclick="removeListItem(this)">
                        <i class="fas fa-trash-alt"></i>
                        <span>Sil</span>
                    </button>

                </div>
            `;

            container.insertAdjacentHTML("beforeend", html);

            updateListNames(type);
        }

        function getListPlaceholder(type) {

            if (type === "includes") {
                return "Örn. Otel konaklaması";
            }

            if (type === "excludes") {
                return "Örn. Kişisel harcamalar";
            }

            return "Örn. Profesyonel rehber eşliğinde gezi";
        }

        function removeListItem(button) {

            const item = button.closest(".simple-list-item");

            if (!item) {
                return;
            }

            const type = item.dataset.listType;

            item.remove();

            updateListNames(type);
        }

        function updateListNames(type) {

            const container = document.getElementById(
                type === "includes"
                    ? "includesContainer"
                    : type === "excludes"
                        ? "excludesContainer"
                        : "highlightsContainer"
            );

            if (!container) {
                return;
            }

            container.querySelectorAll(".list-value").forEach((input, index) => {

                const prefix =
                    type === "includes"
                        ? "Includes"
                        : type === "excludes"
                            ? "Excludes"
                            : "Highlights";

                input.name = `${prefix}[${index}]`;
            });
        }

        /* ==============================
           NAME SYNC
        ============================== */

        function syncTourDateNames() {

            document.querySelectorAll(".tour-date-row").forEach((row, index) => {

                const start = row.querySelector(".tour-date-start");
                const end = row.querySelector(".tour-date-end");
                const capacity = row.querySelector(".tour-date-capacity");

                if (start) {
                    start.name = `TourDates[${index}].StartDate`;
                }

                if (end) {
                    end.name = `TourDates[${index}].EndDate`;
                }

                if (capacity) {
                    capacity.name = `TourDates[${index}].Capacity`;
                }
            });
        }

        function syncDayProgramNames() {

            document.querySelectorAll(".day-program-row").forEach((row, index) => {

                const title = row.querySelector(".day-title");
                const description = row.querySelector(".day-description");
                const city = row.querySelector(".day-city");
                const accommodation = row.querySelector(".day-accommodation");
                const transportation = row.querySelector(".day-transportation");
                const meal = row.querySelector(".day-meal");
                const dayInput = row.querySelector(".day-program-day");
                const dayNumber = row.querySelector(".row-number");

                if (dayInput) {
                    dayInput.name = `DayPrograms[${index}].DayNumber`;
                    dayInput.value = index + 1;
                }

                if (dayNumber) {
                    dayNumber.textContent = index + 1;
                }

                if (title) {
                    title.name = `DayPrograms[${index}].Title`;
                }

                if (description) {
                    description.name = `DayPrograms[${index}].Description`;
                }

                if (city) {
                    city.name = `DayPrograms[${index}].City`;
                }

                if (accommodation) {
                    accommodation.name = `DayPrograms[${index}].Accommodation`;
                }

                if (transportation) {
                    transportation.name = `DayPrograms[${index}].Transportation`;
                }

                if (meal) {
                    meal.name = `DayPrograms[${index}].Meal`;
                }
            });
        }

        function syncAllDynamicNames() {

            syncTourDateNames();
            syncDayProgramNames();

            updateListNames("includes");
            updateListNames("excludes");
            updateListNames("highlights");
        }

        /* ==============================
           COVER PREVIEW
        ============================== */

        function updateCoverPreview() {

            const input = document.getElementById("coverImageUrl");
            const preview = document.getElementById("coverPreview");

            if (!input || !preview) {
                return;
            }

            const url = input.value.trim();

            if (!url) {

                preview.innerHTML = `
                    <div class="preview-placeholder">
                        Kapak görseli URL'si girildiğinde önizleme burada görünecek.
                    </div>
                `;

                return;
            }

            preview.innerHTML = `
                <img src="${escapeHtml(url)}"
                     alt="Kapak görseli"
                     onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=&quot;preview-placeholder&quot;>Görsel yüklenemedi.</div>';" />
            `;
        }

        /* ==============================
           GALLERY
        ============================== */

        function addGalleryImage() {

            const input = document.getElementById("galleryImages");

            if (!input) {
                return;
            }

            const url = input.value.trim();

            if (!url) {
                showToast("Lütfen bir görsel URL'si girin.");
                return;
            }

            const container = document.getElementById("galleryItems");

            const index = container.querySelectorAll(".gallery-item").length;

            const item = document.createElement("div");

            item.className = "gallery-item";

            item.innerHTML = `
                <img src="${escapeHtml(url)}"
                     alt="Galeri görseli"
                     onerror="this.style.opacity='.35';" />

                <button type="button"
                        class="gallery-remove"
                        title="Görseli kaldır">
                    ×
                </button>

                <input type="hidden"
                       name="GalleryImages[${index}]"
                       value="${escapeHtml(url)}" />
            `;

            item.querySelector(".gallery-remove")
                .addEventListener("click", function () {

                    item.remove();

                    syncGalleryNames();
                });

            container.appendChild(item);

            input.value = "";

            syncGalleryNames();
        }

        function syncGalleryNames() {

            document.querySelectorAll("#galleryItems .gallery-item")
                .forEach((item, index) => {

                    const hidden = item.querySelector("input[type='hidden']");

                    if (hidden) {
                        hidden.name = `GalleryImages[${index}]`;
                    }
                });
        }

        /* ==============================
           VALIDATION
        ============================== */

        function validatePublish() {

            const errors = [];

            const name = document.querySelector("[name='Name']");
            const category = document.querySelector("[name='CategoryId']");
            const destination = document.querySelector("[name='DestinationId']");
            const price = document.querySelector("[name='Price']");
            const durationDays = document.querySelector("[name='DurationDays']");
            const maxCapacity = document.querySelector("[name='MaxCapacity']");
            const minParticipants = document.querySelector("[name='MinParticipants']");

            if (!name || !name.value.trim()) {
                errors.push("Tur adı girilmelidir.");
            }

            if (!category || !category.value) {
                errors.push("Kategori seçilmelidir.");
            }

            if (!destination || !destination.value) {
                errors.push("Destinasyon seçilmelidir.");
            }

            if (!price || parseFloat(price.value) <= 0) {
                errors.push("Fiyat 0'dan büyük olmalıdır.");
            }

            if (!durationDays || parseInt(durationDays.value) < 1) {
                errors.push("Gün sayısı en az 1 olmalıdır.");
            }

            if (!maxCapacity || parseInt(maxCapacity.value) < 1) {
                errors.push("Maksimum kapasite en az 1 olmalıdır.");
            }

            if (!minParticipants || parseInt(minParticipants.value) < 1) {
                errors.push("Minimum katılımcı en az 1 olmalıdır.");
            }

            const tourDates =
                document.querySelectorAll(".tour-date-row");

            if (tourDates.length === 0) {

                errors.push("En az bir tur tarihi eklenmelidir.");

            } else {

                tourDates.forEach((row, index) => {

                    const start = row.querySelector(".tour-date-start");
                    const capacity = row.querySelector(".tour-date-capacity");

                    if (!start || !start.value) {
                        errors.push(`${index + 1}. tur tarihi için başlangıç tarihi girilmelidir.`);
                    }

                    if (!capacity || parseInt(capacity.value) < 1) {
                        errors.push(`${index + 1}. tur tarihi için kapasite girilmelidir.`);
                    }
                });
            }

            const dayPrograms =
                document.querySelectorAll(".day-program-row");

            if (dayPrograms.length === 0) {

                errors.push("En az bir günlük program eklenmelidir.");

            } else {

                dayPrograms.forEach((row, index) => {

                    const title = row.querySelector(".day-title");
                    const description = row.querySelector(".day-description");

                    if (!title || !title.value.trim()) {
                        errors.push(`${index + 1}. gün için başlık girilmelidir.`);
                    }

                    if (!description || !description.value.trim()) {
                        errors.push(`${index + 1}. gün için açıklama girilmelidir.`);
                    }
                });
            }

            return errors;
        }

        function showValidationErrors(errors) {

            const box = document.getElementById("validationBox");
            const list = document.getElementById("validationList");

            list.innerHTML = "";

            errors.forEach(error => {

                const li = document.createElement("li");

                li.textContent = error;

                list.appendChild(li);
            });

            box.classList.add("show");

            window.scrollTo({
                top: box.offsetTop - 20,
                behavior: "smooth"
            });
        }

        function hideValidationErrors() {

            const box = document.getElementById("validationBox");

            if (box) {
                box.classList.remove("show");
            }
        }

        /* ==============================
           SUBMIT
        ============================== */

        function submitTour(status) {

            syncAllDynamicNames();
            syncGalleryNames();

            const statusValue =
                document.getElementById("statusValue");

            if (statusValue) {
                statusValue.value = status;
            }

            /*
             * Taslak kaydında client-side yayınlama
             * validasyonu yapılmaz.
             */
            if (status === "Active") {

                const errors = validatePublish();

                if (errors.length > 0) {

                    showValidationErrors(errors);

                    return;
                }
            }

            hideValidationErrors();

            const form =
                document.getElementById("tourForm");

            if (!form) {
                return;
            }

            form.submit();
        }

        /* ==============================
           HELPERS
        ============================== */

        function escapeHtml(value) {

            if (value === null || value === undefined) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        /* ==============================
           EVENTS
        ============================== */

        document.addEventListener("DOMContentLoaded", function () {

            const coverInput =
                document.getElementById("coverImageUrl");

            if (coverInput) {

                coverInput.addEventListener(
                    "input",
                    updateCoverPreview
                );

                updateCoverPreview();
            }

            const galleryInput =
                document.getElementById("galleryImages");

            if (galleryInput) {

                galleryInput.addEventListener(
                    "keydown",
                    function (event) {

                        if (event.key === "Enter") {

                            event.preventDefault();

                            addGalleryImage();
                        }
                    }
                );
            }

            const galleryButton =
                document.getElementById("addGalleryButton");

            if (galleryButton) {

                galleryButton.addEventListener(
                    "click",
                    addGalleryImage
                );
            }

            /*
             * İlk açılışta boş alanlar
             */
            addTourDate();
            addDayProgram();

            addListItem("includes");
            addListItem("excludes");
            addListItem("highlights");

            /*
             * Varsayılan status
             */
            const statusValue =
                document.getElementById("statusValue");

            if (statusValue && !statusValue.value) {
                statusValue.value = "Draft";
            }

            /*
             * Radio değişiklikleri
             */
            document.querySelectorAll(
                "input[name='statusRadio']"
            ).forEach(radio => {

                radio.addEventListener("change", function () {

                    if (statusValue) {
                        statusValue.value = this.value;
                    }
                });
            });
        });
    </script>
}
