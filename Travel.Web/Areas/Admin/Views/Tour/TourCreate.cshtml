
@model Travel.Web.DTOs.TourDtos.TourCreateDto

@{
    ViewData["Title"] = "Yeni Tur Oluştur";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    :root {
        --navy: #122033;
        --muted: #7b8794;
        --line: #e8edf2;
        --line-2: #dce3ea;
        --teal: #12a594;
        --teal-dark: #087f72;
        --cream: #f7fafb;
        --r: 14px;
        --shadow-sm: 0 2px 8px rgba(18,32,51,.05);
        --shadow-md: 0 10px 30px rgba(18,32,51,.08);
        --cancel-fg: #8b4b4b;
        --cancel-bg: #fff4f4;
        --wait-fg: #946b00;
        --wait-bg: #fff8df;
    }

    .content {
        padding: 28px;
    }

    .page-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .page-title {
        margin: 0;
        color: var(--navy);
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .page-subtitle {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 14px;
    }

    .head-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-ui {
        border: 1px solid var(--line-2);
        background: #fff;
        color: var(--navy);
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        cursor: pointer;
        transition: .2s;
    }

        .btn-ui:hover {
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

    .btn-primary-ui {
        background: var(--teal);
        color: #fff;
        border-color: var(--teal);
    }

        .btn-primary-ui:hover {
            background: var(--teal-dark);
            color: #fff;
        }

    .btn-secondary-ui {
        background: #fff;
    }

    .btn-danger-ui {
        color: #a33f3f;
        background: #fff;
        border-color: #f0d5d5;
    }

    .form-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        margin-bottom: 20px;
        overflow: hidden;
    }

    .card-head {
        padding: 18px 22px;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .card-title {
        margin: 0;
        color: var(--navy);
        font-size: 16px;
        font-weight: 800;
    }

    .card-description {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 12px;
    }

    .card-body {
        padding: 22px;
    }

    .form-label {
        color: var(--navy);
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .required {
        color: #d44;
    }

    .form-control,
    .form-select {
        min-height: 43px;
        border: 1px solid var(--line-2);
        border-radius: 10px;
        font-size: 13px;
        color: var(--navy);
        box-shadow: none !important;
    }

    textarea.form-control {
        min-height: 110px;
        resize: vertical;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--teal);
    }

    .form-help {
        color: var(--muted);
        font-size: 11px;
        margin-top: 5px;
    }

    .field-error {
        color: #c44545;
        font-size: 11px;
        margin-top: 5px;
        display: none;
    }

    .section-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .section-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .full {
        grid-column: 1 / -1;
    }

    /* Upload */
    .upload-box {
        border: 2px dashed var(--line-2);
        border-radius: 13px;
        min-height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 20px;
        cursor: pointer;
        transition: .2s;
        background: #fbfcfd;
    }

        .upload-box:hover {
            border-color: var(--teal);
            background: #f7fffd;
        }

    .upload-icon {
        font-size: 34px;
        color: var(--teal);
        margin-bottom: 7px;
    }

    .upload-title {
        font-size: 13px;
        font-weight: 800;
        color: var(--navy);
    }

    .upload-subtitle {
        color: var(--muted);
        font-size: 11px;
        margin-top: 4px;
    }

    .preview-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-top: 12px;
    }

    .preview-item {
        position: relative;
        height: 100px;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--line);
        background: #f5f7f8;
    }

        .preview-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .preview-remove {
        position: absolute;
        right: 5px;
        top: 5px;
        width: 25px;
        height: 25px;
        border: 0;
        border-radius: 50%;
        background: rgba(0,0,0,.65);
        color: #fff;
        cursor: pointer;
        font-size: 13px;
    }

    /* Dynamic rows */
    .dynamic-row {
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
        background: #fcfdfd;
    }

        .dynamic-row:last-child {
            margin-bottom: 0;
        }

    .dynamic-row-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 13px;
    }

    .row-number {
        color: var(--navy);
        font-size: 13px;
        font-weight: 800;
    }

    .btn-add {
        border: 1px dashed var(--teal);
        color: var(--teal-dark);
        background: #f5fffd;
        border-radius: 9px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

    .btn-remove {
        border: 1px solid #f0d5d5;
        background: var(--cancel-bg);
        color: var(--cancel-fg);
        border-radius: 8px;
        padding: 6px 9px;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
    }

    .list-item {
        display: flex;
        gap: 8px;
        margin-bottom: 9px;
    }

        .list-item:last-child {
            margin-bottom: 0;
        }

        .list-item .form-control {
            min-height: 39px;
        }

    .remove-list-item {
        flex: 0 0 auto;
        width: 39px;
        border: 1px solid #f0d5d5;
        background: var(--cancel-bg);
        color: var(--cancel-fg);
        border-radius: 9px;
        cursor: pointer;
    }

    /* Status */
    .status-options {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .status-option input {
        display: none;
    }

    .status-option label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 1px solid var(--line-2);
        border-radius: 10px;
        padding: 9px 13px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        color: var(--navy);
        background: #fff;
    }

    .status-option input:checked + label {
        border-color: var(--teal);
        color: var(--teal-dark);
        background: #f0fffc;
    }

    .switch-list {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .switch-item {
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 9px 12px;
        font-size: 12px;
        font-weight: 700;
        color: var(--navy);
        background: #fff;
    }

        .switch-item input {
            width: 16px;
            height: 16px;
            accent-color: var(--teal);
        }

    /* Bottom actions */
    .bottom-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 4px;
        padding-bottom: 20px;
    }

    /* Toast */
    .toast-ui {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 9999;
        background: var(--navy);
        color: #fff;
        padding: 13px 17px;
        border-radius: 11px;
        box-shadow: var(--shadow-md);
        font-size: 13px;
        font-weight: 700;
        opacity: 0;
        transform: translateY(15px);
        pointer-events: none;
        transition: .25s;
    }

        .toast-ui.show {
            opacity: 1;
            transform: translateY(0);
        }

    .validation-summary {
        display: none;
        background: #fff3f3;
        color: #a33f3f;
        border: 1px solid #f0d5d5;
        border-radius: 11px;
        padding: 13px 16px;
        margin-bottom: 20px;
        font-size: 12px;
        font-weight: 700;
    }

        .validation-summary ul {
            margin: 7px 0 0 18px;
            padding: 0;
            font-weight: 500;
        }

    @@media (max-width: 992px) {
        .section-grid-3 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .preview-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .content {
            padding: 18px;
        }

        .page-head {
            flex-direction: column;
        }

        .section-grid,
        .section-grid-3 {
            grid-template-columns: 1fr;
        }

        .preview-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575px) {
        .content {
            padding: 14px;
        }

        .card-body,
        .card-head {
            padding: 16px;
        }

        .preview-grid {
            grid-template-columns: 1fr 1fr;
        }

        .bottom-actions {
            flex-direction: column;
        }

            .bottom-actions .btn-ui {
                width: 100%;
            }
    }
</style>

<form id="tourForm"
      asp-area="Admin"
      asp-controller="Tour"
      asp-action="TourCreate"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Status" id="statusValue" />

    <div class="content">

        <!-- PAGE HEADER -->
        <div class="page-head">
            <div>
                <h1 class="page-title">Yeni Tur Oluştur</h1>
                <p class="page-subtitle">
                    Travelio sistemine yeni bir tur ekleyin ve tur detaylarını yönetin.
                </p>
            </div>

            <div class="head-actions">
                <a class="btn-ui btn-secondary-ui"
                   href="@Url.Action("TourIndex", "Tour", new { area = "Admin" })">
                    <span>←</span>
                    Turlara Dön
                </a>
            </div>
        </div>

        <div class="validation-summary" id="validationSummary">
            <strong>Lütfen aşağıdaki alanları kontrol edin:</strong>
            <ul id="validationList"></ul>
        </div>

        <!-- TEMEL BİLGİLER -->
        <section class="form-card">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Temel Bilgiler</h2>
                    <p class="card-description">
                        Turun temel bilgilerini girin.
                    </p>
                </div>
            </div>

            <div class="card-body">
                <div class="section-grid">

                    <div>
                        <label asp-for="Name" class="form-label">
                            Tur Adı <span class="required">*</span>
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Örn: Roma Kültür Turu"
                               maxlength="200" />
                    </div>

                    <div>
                        <label asp-for="TourType" class="form-label">
                            Tur Tipi
                        </label>

                        <select asp-for="TourType" class="form-select">
                            <option value="">Tur tipi seçin</option>
                            <option value="Kültür">Kültür Turu</option>
                            <option value="Yurtdışı">Yurtdışı Turu</option>
                            <option value="Yurtiçi">Yurtiçi Turu</option>
                            <option value="Doğa">Doğa Turu</option>
                            <option value="Deniz">Deniz Turu</option>
                            <option value="Macera">Macera Turu</option>
                            <option value="Gastronomi">Gastronomi Turu</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="CategoryId" class="form-label">
                            Kategori <span class="required">*</span>
                        </label>

                        <select asp-for="CategoryId" class="form-select">
                            <option value="">Kategori seçin</option>
                            <option value="Kultur">Kültür</option>
                            <option value="Yurtdisi">Yurtdışı</option>
                            <option value="Yurtici">Yurtiçi</option>
                            <option value="Doga">Doğa</option>
                            <option value="Macera">Macera</option>
                            <option value="Gastronomi">Gastronomi</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="DestinationId" class="form-label">
                            Destinasyon <span class="required">*</span>
                        </label>

                        <select asp-for="DestinationId" class="form-select">
                            <option value="">Destinasyon seçin</option>
                            <option value="Istanbul">İstanbul</option>
                            <option value="Roma">Roma</option>
                            <option value="Paris">Paris</option>
                            <option value="Londra">Londra</option>
                            <option value="Barcelona">Barcelona</option>
                            <option value="Dubai">Dubai</option>
                            <option value="Amsterdam">Amsterdam</option>
                            <option value="Prag">Prag</option>
                        </select>
                    </div>

                    <div class="full">
                        <label asp-for="ShortDescription" class="form-label">
                            Kısa Açıklama
                        </label>

                        <input asp-for="ShortDescription"
                               class="form-control"
                               placeholder="Turun kısa tanıtımını yazın..."
                               maxlength="500" />
                    </div>

                    <div class="full">
                        <label asp-for="Description" class="form-label">
                            Açıklama
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  placeholder="Tur hakkında detaylı açıklama..."></textarea>
                    </div>

                    <div class="full">
                        <label asp-for="Route" class="form-label">
                            Tur Rotası
                        </label>

                        <input asp-for="Route"
                               class="form-control"
                               placeholder="Örn: Roma → Floransa → Venedik → Milano" />

                        <div class="form-help">
                            Turun genel güzergahını yazabilirsiniz.
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- SÜRE / FİYAT / KAPASİTE -->
        <section class="form-card">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Süre, Fiyat ve Kapasite</h2>
                    <p class="card-description">
                        Turun süresini, fiyatını ve katılımcı limitlerini belirleyin.
                    </p>
                </div>
            </div>

            <div class="card-body">
                <div class="section-grid-3">

                    <div>
                        <label asp-for="Price" class="form-label">
                            Kişi Başı Fiyat <span class="required">*</span>
                        </label>

                        <input asp-for="Price"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01"
                               placeholder="0.00" />
                    </div>

                    <div>
                        <label asp-for="DurationDays" class="form-label">
                            Gün Sayısı <span class="required">*</span>
                        </label>

                        <input asp-for="DurationDays"
                               id="durationDays"
                               class="form-control"
                               type="number"
                               min="1"
                               placeholder="Örn: 6" />
                    </div>

                    <div>
                        <label asp-for="DurationNights" class="form-label">
                            Gece Sayısı
                        </label>

                        <input asp-for="DurationNights"
                               id="durationNights"
                               class="form-control"
                               type="number"
                               min="0"
                               placeholder="Örn: 5" />
                    </div>

                    <div>
                        <label asp-for="MaxCapacity" class="form-label">
                            Maksimum Kapasite <span class="required">*</span>
                        </label>

                        <input asp-for="MaxCapacity"
                               class="form-control"
                               type="number"
                               min="1"
                               placeholder="Örn: 40" />
                    </div>

                    <div>
                        <label asp-for="MinParticipants" class="form-label">
                            Minimum Katılımcı <span class="required">*</span>
                        </label>

                        <input asp-for="MinParticipants"
                               class="form-control"
                               type="number"
                               min="1"
                               placeholder="Örn: 2" />
                    </div>

                    <div>
                        <label asp-for="DepartureCity" class="form-label">
                            Başlangıç Şehri
                        </label>

                        <input asp-for="DepartureCity"
                               class="form-control"
                               placeholder="Örn: İstanbul" />
                    </div>

                    <div>
                        <label asp-for="Transportation" class="form-label">
                            Ulaşım
                        </label>

                        <select asp-for="Transportation" class="form-select">
                            <option value="">Seçin</option>
                            <option value="Uçak">Uçak</option>
                            <option value="Otobüs">Otobüs</option>
                            <option value="Tren">Tren</option>
                            <option value="Gemi">Gemi</option>
                            <option value="Özel Araç">Özel Araç</option>
                            <option value="Karma">Karma</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="Accommodation" class="form-label">
                            Konaklama
                        </label>

                        <input asp-for="Accommodation"
                               class="form-control"
                               placeholder="Örn: 4 yıldızlı otel" />
                    </div>

                    <div>
                        <label asp-for="GuideLanguage" class="form-label">
                            Rehber Dili
                        </label>

                        <input asp-for="GuideLanguage"
                               class="form-control"
                               placeholder="Örn: Türkçe / İngilizce" />
                    </div>

                    <div class="full">
                        <label asp-for="VisaInfo" class="form-label">
                            Vize Bilgisi
                        </label>

                        <textarea asp-for="VisaInfo"
                                  class="form-control"
                                  style="min-height:80px;"
                                  placeholder="Vize gerekliliği ve gerekli bilgiler..."></textarea>
                    </div>

                </div>
            </div>
        </section>

        <!-- KAPAK / GALERİ -->
        <section class="form-card">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Görseller</h2>
                    <p class="card-description">
                        Kapak ve galeri görsellerini ekleyin.
                    </p>
                </div>
            </div>

            <div class="card-body">
                <div class="section-grid">

                    <div>
                        <label asp-for="CoverImageUrl" class="form-label">
                            Kapak Görseli URL
                        </label>

                        <input asp-for="CoverImageUrl"
                               class="form-control"
                               placeholder="https://..." />

                        <div class="form-help">
                            MongoDB'de CoverImageUrl alanında tutulacak görsel adresi.
                        </div>
                    </div>

                    <div>
                        <label class="form-label">
                            Kapak Görseli Önizleme
                        </label>

                        <div id="coverPreview"
                             style="height:43px;border:1px solid var(--line-2);border-radius:10px;display:flex;align-items:center;padding:0 12px;color:var(--muted);font-size:12px;">
                            Görsel URL'si girildiğinde burada görüntülenir.
                        </div>
                    </div>

                    <div class="full">
                        <label class="form-label">
                            Galeri Görselleri
                        </label>

                        <div>
                            <input asp-for="GalleryImages"
                                   id="galleryImages"
                                   type="text"
                                   class="form-control"
                                   placeholder="Görsel URL'sini yazın ve Enter'a basın..." />

                            <div class="form-help">
                                Birden fazla URL ekleyebilirsiniz.
                            </div>
                        </div>

                        <div id="galleryList" class="preview-grid"></div>
                    </div>

                </div>
            </div>
        </section>

        <!-- TUR TARİHLERİ -->
        <section class="form-card">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Tur Tarihleri</h2>
                    <p class="card-description">
                        Her turun tarihinin kendi kapasitesi bulunabilir.
                    </p>
                </div>

                <button type="button"
                        class="btn-add"
                        onclick="addTourDate()">
                    + Tarih Ekle
                </button>
            </div>

            <div class="card-body">
                <div id="tourDatesContainer"></div>
            </div>
        </section>

        <!-- GÜNLÜK PROGRAM -->
        <section class="form-card">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Gün Gün Program</h2>
                    <p class="card-description">
                        Turun her günü için program, şehir, ulaşım ve öğün bilgilerini girin.
                    </p>
                </div>

                <button type="button"
                        class="btn-add"
                        onclick="addDayProgram()">
                    + Gün Ekle
                </button>
            </div>

            <div class="card-body">
                <div id="dayProgramsContainer"></div>
            </div>
        </section>

        <!-- DAHİL / HARİÇ -->
        <section class="form-card">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Dahil / Hariç</h2>
                    <p class="card-description">
                        Tur ücretine dahil olan ve olmayan hizmetleri belirtin.
                    </p>
                </div>
            </div>

            <div class="card-body">
                <div class="section-grid">

                    <div>
                        <label class="form-label">
                            Fiyata Dahil
                        </label>

                        <div id="includesContainer"></div>

                        <button type="button"
                                class="btn-add mt-2"
                                onclick="addListItem('includes')">
                            + Hizmet Ekle
                        </button>
                    </div>

                    <div>
                        <label class="form-label">
                            Fiyata Dahil Değil
                        </label>

                        <div id="excludesContainer"></div>

                        <button type="button"
                                class="btn-add mt-2"
                                onclick="addListItem('excludes')">
                            + Hizmet Ekle
                        </button>
                    </div>

                </div>
            </div>
        </section>

        <!-- ÖNE ÇIKANLAR -->
        <section class="form-card">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Öne Çıkanlar</h2>
                    <p class="card-description">
                        Turun öne çıkan özelliklerini ekleyin.
                    </p>
                </div>

                <button type="button"
                        class="btn-add"
                        onclick="addListItem('highlights')">
                    + Özellik Ekle
                </button>
            </div>

            <div class="card-body">
                <div id="highlightsContainer"></div>
            </div>
        </section>

        <!-- YAYIN AYARLARI -->
        <section class="form-card">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Yayın Ayarları</h2>
                    <p class="card-description">
                        Turun durumunu ve öne çıkarma seçeneklerini belirleyin.
                    </p>
                </div>
            </div>

            <div class="card-body">

                <div class="mb-4">
                    <label class="form-label">
                        Durum
                    </label>

                    <div class="status-options">

                        <div class="status-option">
                            <input type="radio"
                                   id="statusDraft"
                                   name="statusUi"
                                   value="Draft"
                                   checked />

                            <label for="statusDraft">
                                Taslak
                            </label>
                        </div>

                        <div class="status-option">
                            <input type="radio"
                                   id="statusActive"
                                   name="statusUi"
                                   value="Active" />

                            <label for="statusActive">
                                Aktif
                            </label>
                        </div>

                        <div class="status-option">
                            <input type="radio"
                                   id="statusPassive"
                                   name="statusUi"
                                   value="Passive" />

                            <label for="statusPassive">
                                Pasif
                            </label>
                        </div>

                    </div>
                </div>

                <div>
                    <label class="form-label">
                        Etiketler
                    </label>

                    <div class="switch-list">

                        <label class="switch-item">
                            <input asp-for="IsFeatured" />
                            Öne Çıkan
                        </label>

                        <label class="switch-item">
                            <input asp-for="IsBestSeller" />
                            Çok Satan
                        </label>

                        <label class="switch-item">
                            <input asp-for="IsNew" />
                            Yeni Tur
                        </label>

                    </div>
                </div>

            </div>
        </section>

        <!-- ACTIONS -->
        <div class="bottom-actions">

            <a href="@Url.Action("TourIndex", "Tour", new { area = "Admin" })"
               class="btn-ui btn-secondary-ui">
                İptal
            </a>

            <button type="submit"
                    class="btn-ui btn-secondary-ui"
                    onclick="return submitTour('Draft')">
                Taslak Olarak Kaydet
            </button>

            <button type="submit"
                    class="btn-ui btn-primary-ui"
                    onclick="return submitTour('Active')">
                Turu Yayınla
            </button>

        </div>

    </div>
</form>

<div id="toast" class="toast-ui"></div>

<script>
    let tourDateIndex = 0;
    let dayProgramIndex = 0;

    const listIndexes = {
        includes: 0,
        excludes: 0,
        highlights: 0
    };

    /* ----------------------------------------
       TOAST
    ---------------------------------------- */

    function showToast(message) {
        const toast = document.getElementById("toast");

        toast.textContent = message;
        toast.classList.add("show");

        setTimeout(() => {
            toast.classList.remove("show");
        }, 2500);
    }

    /* ----------------------------------------
       TOUR DATES
    ---------------------------------------- */

    function addTourDate() {

        const container = document.getElementById("tourDatesContainer");

        const index = tourDateIndex++;

        const row = document.createElement("div");

        row.className = "dynamic-row tour-date-row";

        row.dataset.index = index;

        row.innerHTML = `
            <div class="dynamic-row-head">
                <div class="row-number">
                    Tur Tarihi #${index + 1}
                </div>

                <button type="button"
                        class="btn-remove"
                        onclick="removeRow(this)">
                    Sil
                </button>
            </div>

            <div class="section-grid-3">

                <div>
                    <label class="form-label">
                        Başlangıç Tarihi <span class="required">*</span>
                    </label>

                    <input type="date"
                           class="form-control date-start" />
                </div>

                <div>
                    <label class="form-label">
                        Bitiş Tarihi
                    </label>

                    <input type="date"
                           class="form-control date-end" />
                </div>

                <div>
                    <label class="form-label">
                        Kapasite <span class="required">*</span>
                    </label>

                    <input type="number"
                           class="form-control date-capacity"
                           min="1"
                           placeholder="Örn: 40" />
                </div>

            </div>
        `;

        container.appendChild(row);

        updateRowNumbers("tour-date-row");
    }

    /* ----------------------------------------
       DAY PROGRAMS
    ---------------------------------------- */

    function addDayProgram() {

        const container = document.getElementById("dayProgramsContainer");

        const index = dayProgramIndex++;

        const row = document.createElement("div");

        row.className = "dynamic-row day-program-row";

        row.dataset.index = index;

        row.innerHTML = `
            <div class="dynamic-row-head">
                <div class="row-number">
                    ${index + 1}. Gün
                </div>

                <button type="button"
                        class="btn-remove"
                        onclick="removeRow(this)">
                    Sil
                </button>
            </div>

            <div class="section-grid">

                <div>
                    <label class="form-label">
                        Gün Başlığı <span class="required">*</span>
                    </label>

                    <input type="text"
                           class="form-control day-title"
                           placeholder="Örn: Roma Şehir Turu" />
                </div>

                <div>
                    <label class="form-label">
                        Şehir
                    </label>

                    <input type="text"
                           class="form-control day-city"
                           placeholder="Örn: Roma" />
                </div>

                <div class="full">
                    <label class="form-label">
                        Program Açıklaması <span class="required">*</span>
                    </label>

                    <textarea class="form-control day-description"
                              placeholder="Bu gün yapılacak aktiviteleri açıklayın..."></textarea>
                </div>

                <div>
                    <label class="form-label">
                        Konaklama
                    </label>

                    <input type="text"
                           class="form-control day-accommodation"
                           placeholder="Örn: Roma Hotel" />
                </div>

                <div>
                    <label class="form-label">
                        Ulaşım
                    </label>

                    <input type="text"
                           class="form-control day-transportation"
                           placeholder="Örn: Otobüs / Yürüyüş" />
                </div>

                <div>
                    <label class="form-label">
                        Öğün
                    </label>

                    <input type="text"
                           class="form-control day-meal"
                           placeholder="Örn: Kahvaltı, Öğle Yemeği" />
                </div>

            </div>
        `;

        container.appendChild(row);

        updateRowNumbers("day-program-row");
    }

    /* ----------------------------------------
       REMOVE DYNAMIC ROW
    ---------------------------------------- */

    function removeRow(button) {

        const row = button.closest(".dynamic-row");

        if (!row) {
            return;
        }

        row.remove();

        updateRowNumbers("tour-date-row");
        updateRowNumbers("day-program-row");
    }

    function updateRowNumbers(className) {

        const rows = document.querySelectorAll("." + className);

        rows.forEach((row, index) => {

            const number = row.querySelector(".row-number");

            if (!number) {
                return;
            }

            if (className === "tour-date-row") {
                number.textContent = `Tur Tarihi #${index + 1}`;
            }
            else {
                number.textContent = `${index + 1}. Gün`;
            }
        });
    }

    /* ----------------------------------------
       LIST ITEMS
    ---------------------------------------- */

    function addListItem(type, value = "") {

        const container = document.getElementById(type + "Container");

        const index = listIndexes[type]++;

        const item = document.createElement("div");

        item.className = "list-item";

        item.dataset.index = index;

        item.innerHTML = `
            <input type="text"
                   class="form-control list-value"
                   value="${escapeHtml(value)}"
                   placeholder="Bilgi girin..." />

            <button type="button"
                    class="remove-list-item"
                    onclick="this.parentElement.remove()">
                ×
            </button>
        `;

        container.appendChild(item);

        updateListNames(type);
    }

    function updateListNames(type) {

        const items = document.querySelectorAll(
            `#${type}Container .list-item`
        );

        items.forEach((item, index) => {

            const input = item.querySelector(".list-value");

            input.name = `${capitalize(type)}[${index}]`;
        });
    }

    function capitalize(value) {

        return value.charAt(0).toUpperCase() + value.slice(1);
    }

    function escapeHtml(value) {

        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    /* ----------------------------------------
       NESTED FIELD NAMES
    ---------------------------------------- */

    function syncTourDateNames() {

        const rows = document.querySelectorAll(".tour-date-row");

        rows.forEach((row, index) => {

            const start = row.querySelector(".date-start");
            const end = row.querySelector(".date-end");
            const capacity = row.querySelector(".date-capacity");

            /*
                TourDateDto property isimleri bilinmediği için
                burada standart ASP.NET nested binding kullanıyoruz.

                Eğer TourDateDto içinde isimler farklıysa
                sadece bu üç property ismini değiştirmen yeterli.
            */

            start.name = `TourDates[${index}].StartDate`;
            end.name = `TourDates[${index}].EndDate`;
            capacity.name = `TourDates[${index}].Capacity`;
        });
    }

    function syncDayProgramNames() {

        const rows = document.querySelectorAll(".day-program-row");

        rows.forEach((row, index) => {

            const title = row.querySelector(".day-title");
            const description = row.querySelector(".day-description");
            const city = row.querySelector(".day-city");
            const accommodation = row.querySelector(".day-accommodation");
            const transportation = row.querySelector(".day-transportation");
            const meal = row.querySelector(".day-meal");

            /*
                DayProgramDto property isimleri bilinmediği için
                standart isimler kullanılıyor.
            */

            title.name = `DayPrograms[${index}].Title`;
            description.name = `DayPrograms[${index}].Description`;
            city.name = `DayPrograms[${index}].City`;
            accommodation.name = `DayPrograms[${index}].Accommodation`;
            transportation.name = `DayPrograms[${index}].Transportation`;
            meal.name = `DayPrograms[${index}].Meal`;
        });
    }

    function syncAllDynamicNames() {

        syncTourDateNames();
        syncDayProgramNames();

        updateListNames("includes");
        updateListNames("excludes");
        updateListNames("highlights");
    }

    /* ----------------------------------------
       VALIDATION
    ---------------------------------------- */

    function validatePublish() {

        const errors = [];

        const name = document.getElementById("Name");

        if (!name || !name.value.trim()) {
            errors.push("Tur adı zorunludur.");
        }

        const category = document.getElementById("CategoryId");

        if (!category || !category.value) {
            errors.push("Kategori seçilmelidir.");
        }

        const destination = document.getElementById("DestinationId");

        if (!destination || !destination.value) {
            errors.push("Destinasyon seçilmelidir.");
        }

        const price = document.getElementById("Price");

        if (!price || Number(price.value) <= 0) {
            errors.push("Fiyat 0'dan büyük olmalıdır.");
        }

        const days = document.getElementById("durationDays");

        if (!days || Number(days.value) < 1) {
            errors.push("Tur süresi en az 1 gün olmalıdır.");
        }

        const maxCapacity = document.getElementById("MaxCapacity");

        if (!maxCapacity || Number(maxCapacity.value) < 1) {
            errors.push("Maksimum kapasite en az 1 olmalıdır.");
        }

        const minParticipants =
            document.getElementById("MinParticipants");

        if (!minParticipants || Number(minParticipants.value) < 1) {
            errors.push("Minimum katılımcı en az 1 olmalıdır.");
        }

        const dateRows =
            document.querySelectorAll(".tour-date-row");

        if (dateRows.length === 0) {
            errors.push("En az bir tur tarihi eklenmelidir.");
        }

        dateRows.forEach((row, index) => {

            const start =
                row.querySelector(".date-start");

            const capacity =
                row.querySelector(".date-capacity");

            if (!start || !start.value) {
                errors.push(
                    `${index + 1}. tur tarihi için başlangıç tarihi girilmelidir.`
                );
            }

            if (!capacity || Number(capacity.value) < 1) {
                errors.push(
                    `${index + 1}. tur tarihi için kapasite girilmelidir.`
                );
            }
        });

        const dayRows =
            document.querySelectorAll(".day-program-row");

        if (dayRows.length === 0) {
            errors.push("En az bir günlük program eklenmelidir.");
        }

        dayRows.forEach((row, index) => {

            const title =
                row.querySelector(".day-title");

            const description =
                row.querySelector(".day-description");

            if (!title || !title.value.trim()) {
                errors.push(
                    `${index + 1}. gün için başlık girilmelidir.`
                );
            }

            if (!description || !description.value.trim()) {
                errors.push(
                    `${index + 1}. gün için program açıklaması girilmelidir.`
                );
            }
        });

        showValidationErrors(errors);

        return errors.length === 0;
    }

    function showValidationErrors(errors) {

        const summary =
            document.getElementById("validationSummary");

        const list =
            document.getElementById("validationList");

        list.innerHTML = "";

        if (errors.length === 0) {

            summary.style.display = "none";

            return;
        }

        errors.forEach(error => {

            const li = document.createElement("li");

            li.textContent = error;

            list.appendChild(li);
        });

        summary.style.display = "block";

        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    }

    /* ----------------------------------------
       SUBMIT
    ---------------------------------------- */

    function submitTour(status) {

        syncAllDynamicNames();

        document.getElementById("statusValue").value = status;

        if (status === "Active") {

            if (!validatePublish()) {
                return false;
            }
        }

        return true;
    }

    /* ----------------------------------------
       COVER IMAGE PREVIEW
    ---------------------------------------- */

    const coverInput =
        document.getElementById("CoverImageUrl");

    if (coverInput) {

        coverInput.addEventListener("input", function () {

            const preview =
                document.getElementById("coverPreview");

            const url = this.value.trim();

            if (!url) {

                preview.innerHTML =
                    "Görsel URL'si girildiğinde burada görüntülenir.";

                preview.style.padding = "0 12px";

                return;
            }

            preview.style.padding = "0";

            preview.innerHTML = `
                <img src="${escapeHtml(url)}"
                     style="width:100%;height:100%;object-fit:cover;border-radius:9px;"
                     onerror="this.style.display='none';" />
            `;
        });
    }

    /* ----------------------------------------
       GALLERY URL
    ---------------------------------------- */

    const galleryInput =
        document.getElementById("galleryImages");

    let galleryUrls = [];

    if (galleryInput) {

        galleryInput.addEventListener("keydown", function (event) {

            if (event.key !== "Enter") {
                return;
            }

            event.preventDefault();

            const url = this.value.trim();

            if (!url) {
                return;
            }

            if (!galleryUrls.includes(url)) {

                galleryUrls.push(url);

                renderGallery();
            }

            this.value = "";
        });
    }

    function renderGallery() {

        const container =
            document.getElementById("galleryList");

        container.innerHTML = "";

        galleryUrls.forEach((url, index) => {

            const item =
                document.createElement("div");

            item.className = "preview-item";

            item.innerHTML = `
                <img src="${escapeHtml(url)}"
                     onerror="this.style.opacity='.3';" />

                <button type="button"
                        class="preview-remove"
                        onclick="removeGalleryImage(${index})">
                    ×
                </button>

                <input type="hidden"
                       name="GalleryImages[${index}]"
                       value="${escapeHtml(url)}" />
            `;

            container.appendChild(item);
        });
    }

    function removeGalleryImage(index) {

        galleryUrls.splice(index, 1);

        renderGallery();
    }

    /* ----------------------------------------
       DEFAULT ROWS
    ---------------------------------------- */

    document.addEventListener("DOMContentLoaded", function () {

        /*
            Create sayfası boş başlar.
            Kullanıcı isterse tarih/gün ekler.
        */

        addTourDate();
        addDayProgram();

        addListItem("includes");
        addListItem("excludes");
        addListItem("highlights");

        syncAllDynamicNames();
    });

</script>

