@model List<Travel.Web.DTOs.AboutPageHeadDtos.AboutPageHeadResultDto>

@{
    ViewData["Title"] = "Hakkımızda Sayfa Başlığı";
    Layout = "~/Views/AdminLayout/Layout.cshtml";


var totalAboutPageHead = Model?.Count ?? 0;
    var hasAboutPageHead = Model != null && Model.Any();
    var aboutPageHead = hasAboutPageHead ? Model.FirstOrDefault() : null;


}

<style>

    /* =========================
                   ABOUT PAGE HEAD INDEX
                   ========================= */

    .crumb {
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

        .crumb a {
            color: var(--muted);
            text-decoration: none;
        }

            .crumb a:hover {
                color: var(--teal-dark);
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600;
        }


    /* =========================
                   PAGE INTRO
                   ========================= */

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            font-weight: 700;
            font-size: 1.7rem;
            color: var(--navy);
            margin: .15rem 0 .3rem;
        }

        .page-intro p {
            color: var(--muted);
            margin: 0;
            font-size: .94rem;
            max-width: 60ch;
        }


    /* =========================
                   BUTTON
                   ========================= */

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .7rem 1.3rem;
        font-size: .9rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        white-space: nowrap;
        text-decoration: none;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            box-shadow: 0 12px 26px rgba(15,163,163,.3);
        }


    /* =========================
                   KPI
                   ========================= */

    .kpi {
        display: flex;
        align-items: center;
        gap: .85rem;
    }

        .kpi .ic {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            flex: none;
        }

        .kpi .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--navy);
            line-height: 1;
        }

        .kpi .lab {
            font-size: .82rem;
            color: var(--muted);
            margin-top: .15rem;
        }


    /* =========================
                   CARD
                   ========================= */

    .about-page-head-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
    }

    .about-page-head-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid var(--line);
    }

        .about-page-head-card-header h5 {
            margin: 0;
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: .95rem;
        }

        .about-page-head-card-header span {
            color: var(--muted);
            font-size: .82rem;
        }


    /* =========================
                   TABLE
                   ========================= */

    .tbl-wrap {
        overflow-x: auto;
    }

    .about-page-head-table {
        width: 100%;
        min-width: 1100px;
        border-collapse: collapse;
    }

        .about-page-head-table th {
            padding: .9rem 1rem;
            background: #fafbfb;
            color: var(--muted);
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .02em;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        .about-page-head-table td {
            padding: .9rem 1rem;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
            color: var(--navy);
            font-size: .88rem;
        }

        .about-page-head-table tbody tr {
            transition: .2s;
        }

            .about-page-head-table tbody tr:hover {
                background: #fcfefe;
            }

            .about-page-head-table tbody tr:last-child td {
                border-bottom: none;
            }


    /* =========================
                   IMAGE
                   ========================= */

    .about-page-head-image {
        width: 180px;
        height: 100px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: var(--cream);
    }

    .about-page-head-image-placeholder {
        width: 180px;
        height: 100px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: var(--cream);
        display: grid;
        place-items: center;
        color: var(--muted);
    }


    /* =========================
                   TEXT
                   ========================= */

    .head-title {
        font-family: 'Sora';
        font-weight: 700;
        color: var(--navy);
        margin-bottom: .25rem;
    }

    .head-eyebrow {
        color: var(--teal-dark);
        font-size: .78rem;
        font-weight: 700;
        margin-bottom: .3rem;
    }

    .head-breadcrumb {
        color: var(--muted);
        font-size: .78rem;
    }

    .head-id {
        color: var(--muted);
        font-size: .72rem;
        margin-top: .35rem;
    }

    .description {
        max-width: 330px;
        color: var(--muted);
        line-height: 1.45;
    }


    /* =========================
                   STATUS
                   ========================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border-radius: 999px;
        padding: .38rem .7rem;
        font-size: .74rem;
        font-weight: 700;
    }

    .status-active {
        color: #13795b;
        background: rgba(25, 135, 84, .1);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }


    /* =========================
                   ACTIONS
                   ========================= */

    .actions {
        display: flex;
        gap: .45rem;
        flex-wrap: wrap;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        background: #fff;
        transition: .2s;
        text-decoration: none;
    }

        .action-btn.edit {
            color: var(--teal-dark);
        }

            .action-btn.edit:hover {
                background: rgba(15,163,163,.08);
                border-color: var(--teal);
            }


    /* =========================
                   EMPTY STATE
                   ========================= */

    .empty {
        text-align: center;
        padding: 4rem 1rem;
    }

        .empty .eic {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            margin: 0 auto 1rem;
        }

        .empty h3 {
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: 1.2rem;
            margin-bottom: .4rem;
        }

        .empty p {
            color: var(--muted);
            margin: 0 0 1.2rem;
        }


    /* =========================
                   RESPONSIVE
                   ========================= */

    @@media (max-width: 768px) {

        .page-intro {
            align-items: flex-start;
            flex-direction: column;
        }

            .page-intro .btn-teal {
                width: 100%;
                justify-content: center;
            }

        .about-page-head-card-header {
            align-items: flex-start;
            gap: .5rem;
            flex-direction: column;
        }
    }

</style>

<!-- =========================
     CONTENT
     ========================= -->

<div class="content">

    
    <!-- =========================
         BREADCRUMB
         ========================= -->

    <div class="crumb">

        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index">

            Dashboard

        </a>

        /

        <span class="cur">
            Hakkımızda Sayfa Başlığı
        </span>

    </div>


    <!-- =========================
         PAGE INTRO
         ========================= -->

    <div class="page-intro">

        <div>

            <h1>
                Hakkımızda Sayfa Başlığı
            </h1>

            <p>
                Hakkımızda sayfasının üst bölümünde kullanılan
                başlık, açıklama ve arka plan görselini yönetebilirsiniz.
                Bu alan sistemde yalnızca bir kez tanımlanabilir.
            </p>

        </div>

    </div>


    <!-- =========================
         KPI
         ========================= -->

    <div class="row g-3 mb-4">


        <!-- TOTAL -->

        <div class="col-12 col-md-4">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="3"
                              y="3"
                              width="18"
                              height="18"
                              rx="2" />

                        <path d="M3 15l5-5 4 4 3-3 6 6" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @totalAboutPageHead
                    </div>

                    <div class="lab">
                        Tanımlı İçerik
                    </div>

                </div>

            </div>

        </div>


        <!-- STATUS -->

        <div class="col-12 col-md-4">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <polyline points="20 6 9 17 4 12" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @(hasAboutPageHead ? "Aktif" : "Pasif")
                    </div>

                    <div class="lab">
                        İçerik Durumu
                    </div>

                </div>

            </div>

        </div>


        <!-- MANAGEMENT -->

        <div class="col-12 col-md-4">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 20h9" />

                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @(hasAboutPageHead ? "Hazır" : "Bekliyor")
                    </div>

                    <div class="lab">
                        Yönetim Durumu
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         CARD
         ========================= -->

    <div class="about-page-head-card">


        <!-- HEADER -->

        <div class="about-page-head-card-header">

            <div>

                <h5>
                    Hakkımızda Sayfa Başlığı
                </h5>

                <span>
                    Sistemde yalnızca bir adet kayıt bulunabilir.
                </span>

            </div>

            <span>
                @totalAboutPageHead kayıt
            </span>

        </div>


        @if (hasAboutPageHead)
        {

            <!-- =========================
                 TABLE
                 ========================= -->

            <div class="tbl-wrap">

                <table class="about-page-head-table">

                    <thead>

                        <tr>

                            <th style="width:60px;">
                                #
                            </th>

                            <th>
                                Görsel
                            </th>

                            <th>
                                İçerik
                            </th>

                            <th>
                                Açıklama
                            </th>

                            <th>
                                Breadcrumb
                            </th>

                            <th>
                                Durum
                            </th>

                            <th style="width:100px;">
                                İşlemler
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int count = 0;
                        }

                        @foreach (var item in Model)
                        {
                            count++;

                            <tr>


                                <!-- NUMBER -->

                                <td>

                                    <span style="font-weight:700;">
                                        @count
                                    </span>

                                </td>


                                <!-- IMAGE -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.BackgroundImage))
                                    {

                                        <img src="@item.BackgroundImage"
                                             class="about-page-head-image"
                                             alt="@item.Title"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />

                                        <div class="about-page-head-image-placeholder"
                                             style="display:none;">

                                            <svg width="24"
                                                 height="24"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <rect x="3"
                                                      y="3"
                                                      width="18"
                                                      height="18"
                                                      rx="2" />

                                                <circle cx="8.5"
                                                        cy="8.5"
                                                        r="1.5" />

                                                <polyline points="21 15 16 10 5 21" />

                                            </svg>

                                        </div>

                                    }
                                    else
                                    {

                                        <div class="about-page-head-image-placeholder">

                                            <svg width="24"
                                                 height="24"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <rect x="3"
                                                      y="3"
                                                      width="18"
                                                      height="18"
                                                      rx="2" />

                                                <circle cx="8.5"
                                                        cy="8.5"
                                                        r="1.5" />

                                                <polyline points="21 15 16 10 5 21" />

                                            </svg>

                                        </div>

                                    }

                                </td>


                                <!-- CONTENT -->

                                <td>

                                    <div class="head-eyebrow">
                                        @item.Eyebrow
                                    </div>

                                    <div class="head-title">
                                        @item.Title
                                    </div>

                                    <div class="head-id">
                                        ID: @item.Id
                                    </div>

                                </td>


                                <!-- DESCRIPTION -->

                                <td>

                                    <div class="description">

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            @(item.Description.Length > 120
                                                                            ? item.Description.Substring(0, 120) + "..."
                                                                            : item.Description)
                                                                }
                                        else
                                        {
                                            <span style="color:var(--muted);">
                                                Açıklama bulunmuyor
                                            </span>
                                        }

                                    </div>

                                </td>


                                <!-- BREADCRUMB -->

                                <td>

                                    <div class="head-breadcrumb">

                                        Ana Sayfa · @item.Breadcrumb

                                    </div>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <span class="status-badge status-active">

                                        <span class="status-dot"></span>

                                        Aktif

                                    </span>

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="actions">

                                        <a asp-area="Admin"
                                           asp-controller="AboutPageHead"
                                           asp-action="Update"
                                           asp-route-id="@item.Id"
                                           class="action-btn edit"
                                           title="Düzenle">

                                            <svg width="16"
                                                 height="16"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />

                                                <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />

                                            </svg>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {

            <!-- =========================
                 EMPTY STATE
                 ========================= -->

            <div class="empty">

                <div class="eic">

                    <svg width="26"
                         height="26"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <rect x="3"
                              y="3"
                              width="18"
                              height="18"
                              rx="2" />

                        <path d="M3 15l5-5 4 4 3-3 6 6" />

                    </svg>

                </div>


                <h3>
                    Hakkımızda sayfa başlığı henüz oluşturulmamış
                </h3>


                <p>
                    Hakkımızda sayfasının üst bölümünü oluşturmak için
                    henüz bir içerik eklenmemiş.
                </p>


                <a asp-area="Admin"
                   asp-controller="AboutPageHead"
                   asp-action="Create"
                   class="btn-teal">

                    <svg width="17"
                         height="17"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2.2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <line x1="12"
                              y1="5"
                              x2="12"
                              y2="19" />

                        <line x1="5"
                              y1="12"
                              x2="19"
                              y2="12" />

                    </svg>

                    İçerik Oluştur

                </a>

            </div>

        }

    </div>
    

</div>
