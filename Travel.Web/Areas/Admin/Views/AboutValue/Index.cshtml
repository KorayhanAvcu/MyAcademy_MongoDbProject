@model List<Travel.Web.DTOs.AboutValueDtos.AboutValueResultDto>

@{
    ViewData["Title"] = "Değerlerimiz";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    :root {
        --navy: #0e2a3b;
        --navy-2: #12384c;
        --teal: #0fa3a3;
        --teal-dark: #0b7f80;
        --white: #ffffff;
        --muted: #64748b;
        --line: #e5e7eb;
    }

    .page-header {
        margin-bottom: 1.5rem;
    }

    .breadcrumb-custom {
        color: var(--muted);
        font-size: .88rem;
        margin-bottom: .45rem;
    }

        .breadcrumb-custom span {
            color: var(--navy);
            font-weight: 600;
        }

    .page-title {
        color: var(--navy);
        font-family: 'Sora', sans-serif;
        font-weight: 800;
        margin: 0;
    }

    .page-description {
        color: var(--muted);
        margin-top: .5rem;
    }

    .content-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: 18px;
        overflow: hidden;
    }

    .content-card-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

        .content-card-header h5 {
            color: var(--navy);
            font-family: 'Sora', sans-serif;
            font-weight: 700;
            margin: 0;
        }

        .content-card-header p {
            color: var(--muted);
            font-size: .85rem;
            margin: .25rem 0 0;
        }

    .btn-create {
        background: var(--teal);
        color: var(--white);
        border: none;
        border-radius: 999px;
        padding: .7rem 1.2rem;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
    }

        .btn-create:hover {
            background: var(--teal-dark);
            color: var(--white);
        }

    .table {
        margin: 0;
    }

        .table thead th {
            background: #f8fafc;
            color: var(--navy);
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .03em;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--line);
        }

        .table tbody td {
            padding: 1rem 1.25rem;
            vertical-align: middle;
            border-bottom: 1px solid var(--line);
            color: #334155;
        }

        .table tbody tr:last-child td {
            border-bottom: none;
        }

    .value-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #e6f7f7;
        color: var(--teal-dark);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .value-icon svg {
            width: 22px;
            height: 22px;
        }

    .value-title {
        color: var(--navy);
        font-weight: 700;
        margin-bottom: .2rem;
    }

    .value-description {
        color: var(--muted);
        font-size: .86rem;
        line-height: 1.5;
        max-width: 550px;
    }

    .btn-edit {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #eef7f7;
        color: var(--teal-dark);
        border: 1px solid #d5eeee;
        border-radius: 999px;
        padding: .5rem .9rem;
        font-size: .82rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: var(--teal);
            color: var(--white);
        }

    .empty-state {
        text-align: center;
        padding: 4rem 1rem;
        color: var(--muted);
    }

        .empty-state h5 {
            color: var(--navy);
            font-family: 'Sora', sans-serif;
            font-weight: 700;
        }
</style>

<div class="container-fluid">

    <div class="page-header">

        <div class="breadcrumb-custom">
            Dashboard / Hakkımızda /
            <span>Değerlerimiz</span>
        </div>

        <h1 class="page-title">
            Değerlerimiz
        </h1>

        <p class="page-description">
            Hakkımızda sayfasında gösterilecek değer kartlarını yönetin.
        </p>

    </div>

    <div class="content-card">

        <div class="content-card-header">

            <div>
                <h5>Değer Kartları</h5>

                <p>
                    Toplam @(Model?.Count ?? 0) değer kartı bulunmaktadır.
                </p>
            </div>

            <a asp-area="Admin"
                   asp-controller="AboutValue"
                   asp-action="Create"
                   class="btn-create">
                + Yeni Değer
            </a>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table">

                    <thead>
                        <tr>
                            <th>İkon</th>
                            <th>Değer</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <div class="value-icon">

                                        @switch (item.Icon)
                                        {
                                            case "clock":
                                                <svg fill="none"
                                                     height="24"
                                                     stroke="currentColor"
                                                     stroke-width="2.2"
                                                     viewBox="0 0 24 24"
                                                     width="24">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <path d="M12 6v6l4 2"></path>
                                                </svg>
                                                break;

                                            case "shield":
                                                <svg fill="none"
                                                     height="24"
                                                     stroke="currentColor"
                                                     stroke-width="2.2"
                                                     viewBox="0 0 24 24"
                                                     width="24">
                                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                                </svg>
                                                break;

                                            case "users":
                                                <svg fill="none"
                                                     height="24"
                                                     stroke="currentColor"
                                                     stroke-width="2.2"
                                                     viewBox="0 0 24 24"
                                                     width="24">
                                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                                    <circle cx="9" cy="7" r="4"></circle>
                                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                                </svg>
                                                break;

                                            case "heart":
                                                <svg fill="none"
                                                     height="24"
                                                     stroke="currentColor"
                                                     stroke-width="2.2"
                                                     viewBox="0 0 24 24"
                                                     width="24">
                                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"></path>
                                                </svg>
                                                break;

                                            case "globe":
                                                <svg fill="none"
                                                     height="24"
                                                     stroke="currentColor"
                                                     stroke-width="2.2"
                                                     viewBox="0 0 24 24"
                                                     width="24">
                                                    <circle cx="12" cy="12" r="10"></circle>
                                                    <line x1="2" y1="12" x2="22" y2="12"></line>
                                                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                                                </svg>
                                                break;

                                            case "star":
                                                <svg fill="none"
                                                     height="24"
                                                     stroke="currentColor"
                                                     stroke-width="2.2"
                                                     viewBox="0 0 24 24"
                                                     width="24">
                                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                </svg>
                                                break;

                                            case "check":
                                                <svg fill="none"
                                                     height="24"
                                                     stroke="currentColor"
                                                     stroke-width="2.2"
                                                     viewBox="0 0 24 24"
                                                     width="24">
                                                    <polyline points="20 6 9 17 4 12"></polyline>
                                                </svg>
                                                break;

                                            case "map":
                                                <svg fill="none"
                                                     height="24"
                                                     stroke="currentColor"
                                                     stroke-width="2.2"
                                                     viewBox="0 0 24 24"
                                                     width="24">
                                                    <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                                                    <line x1="8" y1="2" x2="8" y2="18"></line>
                                                    <line x1="16" y1="6" x2="16" y2="22"></line>
                                                </svg>
                                                break;

                                            case "plane":
                                                <svg fill="none"
                                                     height="24"
                                                     stroke="currentColor"
                                                     stroke-width="2.2"
                                                     viewBox="0 0 24 24"
                                                     width="24">
                                                    <path d="M22 2 11 13"></path>
                                                    <path d="m22 2-7 20-4-9-9-4Z"></path>
                                                </svg>
                                                break;
                                        }

                                    </div>
                                </td>

                                <td>

                                    <div class="value-title">
                                        @item.ValueTitle
                                    </div>

                                    <div class="value-description">
                                        @item.ValueDescription
                                    </div>

                                </td>

                                <td class="text-end">

                                    <a asp-area="Admin"
                                           asp-controller="AboutValue"
                                           asp-action="Update"
                                           asp-route-id="@item.Id"
                                           class="btn-edit">
                                        Düzenle
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <h5>
                    Henüz değer eklenmemiş
                </h5>

                <p>
                    Hakkımızda sayfasına göstermek istediğiniz ilk değeri ekleyebilirsiniz.
                </p>

                <a asp-area="Admin"
                       asp-controller="AboutValue"
                       asp-action="Create"
                       class="btn-create">
                    + İlk Değeri Ekle
                </a>

            </div>
        }

    </div>

</div>