@model Travel.Web.DTOs.AboutValueDtos.AboutValueCreateDto

@{
    ViewData["Title"] = "Yeni Değer";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    :root {
        --navy: #0e2a3b;
        --teal: #0fa3a3;
        --teal-dark: #0b7f80;
        --white: #ffffff;
        --muted: #64748b;
        --line: #e5e7eb;
    }

    .page-header {
        margin-bottom: 1.5rem;
    }

    .breadcrumb-custom {
        color: var(--muted);
        font-size: .88rem;
        margin-bottom: .45rem;
    }

        .breadcrumb-custom span {
            color: var(--navy);
            font-weight: 600;
        }

    .page-title {
        color: var(--navy);
        font-family: 'Sora', sans-serif;
        font-weight: 800;
        margin: 0;
    }

    .page-description {
        color: var(--muted);
        margin-top: .5rem;
    }

    .form-card {
        background: var(--white);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 1.75rem;
    }

    .section-title {
        color: var(--navy);
        font-family: 'Sora', sans-serif;
        font-weight: 700;
        font-size: 1.05rem;
        margin-bottom: 1.25rem;
    }

    .form-label {
        color: var(--navy);
        font-weight: 600;
        font-size: .88rem;
        margin-bottom: .45rem;
    }

    .form-control,
    .form-select {
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: .75rem .9rem;
        color: #334155;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 .2rem rgba(15, 163, 163, .12);
        }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .field-validation-error {
        color: #dc2626;
        font-size: .8rem;
        margin-top: .3rem;
        display: block;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        margin-top: 2rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
    }

    .btn-cancel {
        border: 1px solid var(--line);
        color: var(--navy);
        background: var(--white);
        border-radius: 999px;
        padding: .7rem 1.25rem;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-save {
        border: none;
        background: var(--teal);
        color: var(--white);
        border-radius: 999px;
        padding: .7rem 1.35rem;
        font-weight: 600;
    }

        .btn-save:hover {
            background: var(--teal-dark);
            color: var(--white);
        }
</style>

<div class="container-fluid">

    <div class="page-header">

        <div class="breadcrumb-custom">
            Dashboard / Hakkımızda / Değerlerimiz /
            <span>Yeni Değer</span>
        </div>

        <h1 class="page-title">
            Yeni Değer Ekle
        </h1>

        <p class="page-description">
            Hakkımızda sayfasına yeni bir değer kartı ekleyin.
        </p>

    </div>

    <div class="form-card">

        <form asp-area="Admin"
              asp-controller="AboutValue"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="section-title">
                Değer Kartı
            </div>

            <div class="row g-4">

                <div class="col-md-4">

                    <label asp-for="Icon"
                           class="form-label">
                        İkon
                    </label>

                    <select asp-for="Icon"
                            class="form-select">

                        <option value="">
                            İkon Seçiniz
                        </option>

                        <option value="clock">
                            Saat
                        </option>

                        <option value="shield">
                            Kalkan
                        </option>

                        <option value="users">
                            Kullanıcılar
                        </option>

                        <option value="heart">
                            Kalp
                        </option>

                        <option value="globe">
                            Dünya
                        </option>

                        <option value="star">
                            Yıldız
                        </option>

                        <option value="check">
                            Onay
                        </option>

                        <option value="map">
                            Harita
                        </option>

                        <option value="plane">
                            Uçak
                        </option>

                    </select>

                    <span asp-validation-for="Icon"
                          class="field-validation-error">
                    </span>

                </div>

                <div class="col-md-8">

                    <label asp-for="ValueTitle"
                           class="form-label">
                        Değer Başlığı
                    </label>

                    <input asp-for="ValueTitle"
                           class="form-control"
                           placeholder="Örn: Şeffaf & Sürprizsiz Fiyat" />

                    <span asp-validation-for="ValueTitle"
                          class="field-validation-error">
                    </span>

                </div>

                <div class="col-12">

                    <label asp-for="ValueDescription"
                           class="form-label">
                        Değer Açıklaması
                    </label>

                    <textarea asp-for="ValueDescription"
                              class="form-control"
                              placeholder="Değer hakkında açıklama..."></textarea>

                    <span asp-validation-for="ValueDescription"
                          class="field-validation-error">
                    </span>

                </div>

            </div>

            <div class="form-actions">

                <a asp-area="Admin"
                       asp-controller="AboutValue"
                       asp-action="Index"
                       class="btn-cancel">
                    Vazgeç
                </a>

                <button type="submit"
                        class="btn-save">
                    Kaydet
                </button>

            </div>

        </form>

    </div>

</div>