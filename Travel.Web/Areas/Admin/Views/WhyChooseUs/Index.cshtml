
@using Travel.Web.DTOs.WhyChooseUsDtos
@model List<ResultWhyChooseUsDto>

@{
    ViewData["Title"] = "Neden Biz?";
    Layout = "~/Views/AdminLayout/Layout.cshtml";

    var totalCount = Model?.Count ?? 0;
    var activeCount = Model?.Count(x => x.IsActive) ?? 0;
    var passiveCount = totalCount - activeCount;
    var displayedCount = activeCount;
}

<style>
    .crumb {
        display: flex;
        align-items: center;
        gap: .45rem;
        font-size: .82rem;
        color: var(--muted);
        margin-bottom: 1.2rem;
    }

        .crumb a {
            color: var(--muted);
            text-decoration: none;
        }

            .crumb a:hover {
                color: var(--teal);
            }

    .page-intro {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            margin: 0 0 .35rem;
            font-size: 1.65rem;
            font-weight: 800;
            color: var(--navy);
        }

        .page-intro p {
            margin: 0;
            color: var(--muted);
            font-size: .9rem;
        }

    .btn-teal {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .72rem 1rem;
        border-radius: 12px;
        background: var(--teal);
        color: #fff;
        text-decoration: none;
        font-size: .88rem;
        font-weight: 700;
        border: 1px solid var(--teal);
        transition: .2s;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            border-color: var(--teal-dark);
            color: #fff;
            transform: translateY(-1px);
        }

    /* KPI */

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.2rem;
    }

    .kpi {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.05rem 1.1rem;
        box-shadow: var(--shadow-md);
    }

    .kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: .65rem;
    }

    .kpi-label {
        font-size: .78rem;
        color: var(--muted);
        font-weight: 600;
    }

    .kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: rgba(15,163,163,.08);
        color: var(--teal-dark);
    }

    .kpi-value {
        font-size: 1.45rem;
        line-height: 1;
        font-weight: 800;
        color: var(--navy);
    }

    /* FILTER */

    .filter-bar {
        display: flex;
        align-items: center;
        gap: .75rem;
        flex-wrap: wrap;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: .9rem;
        box-shadow: var(--shadow-md);
        margin-bottom: 1rem;
    }

    .f-search {
        position: relative;
        flex: 1;
        min-width: 240px;
    }

        .f-search svg {
            position: absolute;
            left: .8rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
        }

        .f-search input {
            width: 100%;
            height: 42px;
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 0 1rem 0 2.5rem;
            outline: none;
            color: var(--navy);
            background: #fff;
        }

            .f-search input:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(15,163,163,.08);
            }

    .f-select {
        height: 42px;
        min-width: 150px;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 0 .8rem;
        outline: none;
        color: var(--navy);
        background: #fff;
    }

        .f-select:focus {
            border-color: var(--teal);
        }

    .btn-clear {
        height: 42px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fff;
        color: var(--muted);
        padding: 0 .9rem;
        cursor: pointer;
        font-size: .84rem;
        font-weight: 600;
        transition: .2s;
    }

        .btn-clear:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    .result-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: .8rem .1rem;
        color: var(--muted);
        font-size: .82rem;
    }

    /* TABLE */

    .table-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    table.tx {
        width: 100%;
        border-collapse: collapse;
    }

        table.tx th {
            padding: .95rem 1rem;
            text-align: left;
            font-size: .76rem;
            font-weight: 800;
            color: var(--muted);
            background: #fafafa;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        table.tx td {
            padding: .95rem 1rem;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
            font-size: .86rem;
            color: var(--navy);
        }

        table.tx tbody tr:last-child td {
            border-bottom: none;
        }

        table.tx tbody tr {
            transition: .15s;
        }

            table.tx tbody tr:hover {
                background: rgba(15,163,163,.025);
            }

    .why-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: rgba(15,163,163,.08);
        color: var(--teal-dark);
        font-size: 1rem;
    }

    .why-title {
        font-weight: 800;
        color: var(--navy);
        margin-bottom: .2rem;
    }

    .why-description {
        max-width: 430px;
        color: var(--muted);
        line-height: 1.5;
        font-size: .82rem;
    }

    .order-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 28px;
        padding: 0 .55rem;
        border-radius: 999px;
        background: #f5f7f8;
        color: var(--navy);
        font-size: .78rem;
        font-weight: 800;
    }

    .badge-x {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .38rem .62rem;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 800;
    }

    .b-pasif {
        background: var(--cancel-bg);
        color: var(--cancel-fg);
    }

    .b-ok {
        background: var(--ok-bg);
        color: var(--ok-fg);
    }

    /* ACTION */

    .action-buttons {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid var(--line);
        display: grid;
        place-items: center;
        color: var(--muted);
        cursor: pointer;
        transition: .2s;
        text-decoration: none;
        padding: 0;
    }

        .action-btn:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
            background: rgba(15,163,163,.05);
        }

        .action-btn.delete:hover {
            border-color: var(--cancel-fg);
            color: var(--cancel-fg);
            background: var(--cancel-bg);
        }

    /* EMPTY */

    .empty {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--muted);
    }

    .empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto .9rem;
        border-radius: 16px;
        display: grid;
        place-items: center;
        background: #f5f7f8;
        color: var(--muted);
    }

    .empty h3 {
        margin: 0 0 .35rem;
        color: var(--navy);
        font-size: 1rem;
    }

    .empty p {
        margin: 0;
        font-size: .82rem;
    }

    /* MODAL */

    .delete-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, .5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 1rem;
    }

    .delete-modal {
        width: min(430px, 100%);
        background: #fff;
        border-radius: 18px;
        padding: 1.5rem;
        box-shadow: 0 20px 60px rgba(15, 23, 42, .2);
    }

    .delete-modal-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: var(--cancel-bg);
        color: var(--cancel-fg);
        margin-bottom: 1rem;
    }

    .delete-modal h3 {
        margin: 0 0 .45rem;
        color: var(--navy);
        font-size: 1.1rem;
    }

    .delete-modal p {
        margin: 0;
        color: var(--muted);
        font-size: .86rem;
        line-height: 1.5;
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: .65rem;
        margin-top: 1.3rem;
    }

    .modal-btn {
        height: 40px;
        padding: 0 .95rem;
        border-radius: 10px;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
    }

    .modal-cancel {
        border: 1px solid var(--line);
        background: #fff;
        color: var(--muted);
    }

    .modal-delete {
        border: 1px solid var(--cancel-fg);
        background: var(--cancel-fg);
        color: #fff;
    }

    /* RESPONSIVE */

    @@media (max-width: 1100px) {
        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .page-intro {
            align-items: flex-start;
            flex-direction: column;
        }

        .filter-bar {
            align-items: stretch;
        }

        .f-search {
            min-width: 100%;
        }

        .f-select,
        .btn-clear {
            flex: 1;
        }

        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .why-description {
            max-width: 250px;
        }
    }

    @@media (max-width: 575px) {
        .page-intro h1 {
            font-size: 1.4rem;
        }

        table.tx th,
        table.tx td {
            padding: .75rem;
        }

        .why-description {
            max-width: 200px;
        }
    }
</style>

<div class="content">

    <!-- BREADCRUMB -->
    <div class="crumb">

        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index">
            Dashboard
        </a>

        <span>/</span>

        <span>Neden Biz?</span>

    </div>


    <!-- PAGE INTRO -->
    <div class="page-intro">

        <div>

            <h1>Neden Biz?</h1>

            <p>
                Sitenizde gösterilecek neden bizi tercih etmelisiniz
                özelliklerini buradan yönetebilirsiniz.
            </p>

        </div>

        <a asp-area="Admin"
           asp-controller="WhyChooseUs"
           asp-action="Create"
           class="btn-teal">

            <svg width="17"
                 height="17"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <line x1="12"
                      y1="5"
                      x2="12"
                      y2="19" />

                <line x1="5"
                      y1="12"
                      x2="19"
                      y2="12" />

            </svg>

            Yeni Özellik

        </a>

    </div>


    <!-- KPI -->
    <div class="kpi-grid">

        <!-- TOTAL -->

        <div class="kpi">

            <div class="kpi-top">

                <span class="kpi-label">
                    Toplam Özellik
                </span>

                <div class="kpi-icon">

                    <svg width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M20 7h-9" />

                        <path d="M14 17H5" />

                        <circle cx="17"
                                cy="17"
                                r="3" />

                        <circle cx="7"
                                cy="7"
                                r="3" />

                    </svg>

                </div>

            </div>

            <div class="kpi-value">
                @totalCount
            </div>

        </div>


        <!-- ACTIVE -->

        <div class="kpi">

            <div class="kpi-top">

                <span class="kpi-label">
                    Aktif
                </span>

                <div class="kpi-icon">

                    <svg width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M20 6L9 17l-5-5" />

                    </svg>

                </div>

            </div>

            <div class="kpi-value">
                @activeCount
            </div>

        </div>


        <!-- PASSIVE -->

        <div class="kpi">

            <div class="kpi-top">

                <span class="kpi-label">
                    Pasif
                </span>

                <div class="kpi-icon">

                    <svg width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12"
                                cy="12"
                                r="9" />

                        <line x1="8"
                              y1="8"
                              x2="16"
                              y2="16" />

                        <line x1="16"
                              y1="8"
                              x2="8"
                              y2="16" />

                    </svg>

                </div>

            </div>

            <div class="kpi-value">
                @passiveCount
            </div>

        </div>


        <!-- DISPLAYED -->

        <div class="kpi">

            <div class="kpi-top">

                <span class="kpi-label">
                    Görüntülenen
                </span>

                <div class="kpi-icon">

                    <svg width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M1 12s4-8 11-8
                                 11 8 11 8
                                 -4 8-11 8
                                 -11-8-11-8z" />

                        <circle cx="12"
                                cy="12"
                                r="3" />

                    </svg>

                </div>

            </div>

            <div class="kpi-value">
                @displayedCount
            </div>

        </div>

    </div>


    <!-- FILTER -->
    <div class="filter-bar">

        <div class="f-search">

            <svg width="17"
                 height="17"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <circle cx="11"
                        cy="11"
                        r="8" />

                <line x1="21"
                      y1="21"
                      x2="16.65"
                      y2="16.65" />

            </svg>

            <input type="text"
                   id="fSearch"
                   placeholder="Başlık veya açıklama ara..."
                   autocomplete="off" />

        </div>


        <select id="fStatus"
                class="f-select">

            <option value="">
                Tüm Durumlar
            </option>

            <option value="aktif">
                Aktif
            </option>

            <option value="pasif">
                Pasif
            </option>

        </select>


        <button type="button"
                class="btn-clear"
                onclick="clearFilters()">

            Filtreleri Temizle

        </button>

    </div>


    <!-- RESULT COUNT -->
    <div class="result-line">

        <span>
            Toplam
            <strong id="resultCount">
                @totalCount
            </strong>
            kayıt gösteriliyor.
        </span>

    </div>


    <!-- TABLE -->
    <div class="table-card">

        <div class="table-wrap">

            <table class="tx">

                <thead>

                    <tr>

                        <th style="width:70px">
                            Sıra
                        </th>

                        <th style="width:80px">
                            İkon
                        </th>

                        <th>
                            Özellik
                        </th>

                        <th>
                            Açıklama
                        </th>

                        <th style="width:110px">
                            Durum
                        </th>

                        <th style="width:100px; text-align:center">
                            İşlemler
                        </th>

                    </tr>

                </thead>


                <tbody id="whyTableBody">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model.OrderBy(x => x.Order))
                        {
                            var title = item.Title ?? "";
                            var fullDescription = item.Description ?? "";
                            var description = fullDescription;

                            if (description.Length > 100)
                            {
                                description =
                                description.Substring(0, 100) + "...";
                            }

                            var icon = item.Icon ?? "";

                            <tr class="why-row"
                                data-title="@title"
                                data-description="@fullDescription"
                                data-status="@(item.IsActive ? "aktif" : "pasif")">

                                <!-- ORDER -->
                                <td>

                                    <span class="order-pill">
                                        @item.Order
                                    </span>

                                </td>


                                <!-- ICON -->
                                <td>

                                    <div class="why-icon">

                                        @if (icon == "map-pin")
                                        {
                                            <svg width="19"
                                                 height="19"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" />

                                                <circle cx="12"
                                                        cy="10"
                                                        r="3" />

                                            </svg>
                                        }
                                        else if (icon == "check-circle")
                                        {
                                            <svg width="19"
                                                 height="19"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />

                                                <polyline points="22 4 12 14.01 9 11.01" />

                                            </svg>
                                        }
                                        else if (icon == "coffee")
                                        {
                                            <svg width="19"
                                                 height="19"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <path d="M18 8h1a4 4 0 0 1 0 8h-1" />

                                                <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4Z" />

                                                <line x1="6"
                                                      y1="1"
                                                      x2="6"
                                                      y2="4" />

                                                <line x1="10"
                                                      y1="1"
                                                      x2="10"
                                                      y2="4" />

                                                <line x1="14"
                                                      y1="1"
                                                      x2="14"
                                                      y2="4" />

                                            </svg>
                                        }
                                        else
                                        {
                                            <span>
                                                @icon
                                            </span>
                                        }

                                    </div>

                                </td>


                                <!-- TITLE -->
                                <td>

                                    <div class="why-title">
                                        @title
                                    </div>

                                </td>


                                <!-- DESCRIPTION -->
                                <td>

                                    <div class="why-description">
                                        @description
                                    </div>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge-x b-ok">

                                            <svg width="13"
                                                 height="13"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <path d="M20 6L9 17l-5-5" />

                                            </svg>

                                            Aktif

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-x b-pasif">

                                            <svg width="13"
                                                 height="13"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <circle cx="12"
                                                        cy="12"
                                                        r="9" />

                                                <line x1="8"
                                                      y1="8"
                                                      x2="16"
                                                      y2="16" />

                                                <line x1="16"
                                                      y1="8"
                                                      x2="8"
                                                      y2="16" />

                                            </svg>

                                            Pasif

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td>

                                    <div class="action-buttons">

                                        <!-- UPDATE -->
                                        <a asp-area="Admin"
                                           asp-controller="WhyChooseUs"
                                           asp-action="Update"
                                           asp-route-id="@item.Id"
                                           class="action-btn"
                                           title="Düzenle"
                                           aria-label="Düzenle">

                                            <svg width="16"
                                                 height="16"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />

                                                <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />

                                            </svg>

                                        </a>


                                        <!-- DELETE -->
                                        <button type="button"
                                                class="action-btn delete"
                                                title="Sil"
                                                aria-label="Sil"
                                                data-id="@item.Id"
                                                data-title="@title">

                                            <svg width="16"
                                                 height="16"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <polyline points="3 6 5 6 21 6" />

                                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />

                                                <path d="M10 11v6" />

                                                <path d="M14 11v6" />

                                                <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />

                                            </svg>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6">

                                <div class="empty">

                                    <div class="empty-icon">

                                        <svg width="26"
                                             height="26"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="1.8"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9" />

                                            <line x1="8"
                                                  y1="8"
                                                  x2="16"
                                                  y2="16" />

                                            <line x1="16"
                                                  y1="8"
                                                  x2="8"
                                                  y2="16" />

                                        </svg>

                                    </div>

                                    <h3>
                                        Henüz özellik bulunmuyor
                                    </h3>

                                    <p>
                                        Yeni bir neden biz özelliği ekleyerek başlayabilirsiniz.
                                    </p>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- DELETE MODAL -->

<div id="delModal"
     class="delete-modal-backdrop">

    <div class="delete-modal">

        <div class="delete-modal-icon">

            <svg width="22"
                 height="22"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <polyline points="3 6 5 6 21 6" />

                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />

                <path d="M10 11v6" />

                <path d="M14 11v6" />

                <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />

            </svg>

        </div>

        <h3>
            Özellik silinsin mi?
        </h3>

        <p id="delMsg">
            Bu kayıt kalıcı olarak silinecektir.
        </p>


        <form id="deleteForm"
              asp-area="Admin"
              asp-controller="WhyChooseUs"
              asp-action="Delete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="deleteId"
                   name="id" />

            <div class="modal-actions">

                <button type="button"
                        class="modal-btn modal-cancel"
                        onclick="closeDeleteModal()">

                    Vazgeç

                </button>

                <button type="submit"
                        class="modal-btn modal-delete">

                    Sil

                </button>

            </div>

        </form>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("fSearch");

        const statusSelect =
            document.getElementById("fStatus");

        const resultCount =
            document.getElementById("resultCount");

        const deleteModal =
            document.getElementById("delModal");

        const deleteId =
            document.getElementById("deleteId");

        const deleteMessage =
            document.getElementById("delMsg");


        /*
         * FILTER
         */

        function filterRows() {

            const searchValue =
                (searchInput?.value || "")
                    .toLowerCase()
                    .trim();

            const statusValue =
                (statusSelect?.value || "")
                    .toLowerCase();

            const rows =
                document.querySelectorAll(".why-row");

            let visibleCount = 0;

            rows.forEach(row => {

                const title =
                    (row.dataset.title || "")
                        .toLowerCase();

                const description =
                    (row.dataset.description || "")
                        .toLowerCase();

                const status =
                    (row.dataset.status || "")
                        .toLowerCase();


                const matchesSearch =
                    !searchValue ||
                    title.includes(searchValue) ||
                    description.includes(searchValue);


                const matchesStatus =
                    !statusValue ||
                    status === statusValue;


                if (matchesSearch && matchesStatus) {

                    row.style.display = "";
                    visibleCount++;

                }
                else {

                    row.style.display = "none";

                }

            });


            if (resultCount) {

                resultCount.textContent =
                    visibleCount;

            }

        }


        /*
         * CLEAR FILTERS
         */

        window.clearFilters = function () {

            if (searchInput) {
                searchInput.value = "";
            }

            if (statusSelect) {
                statusSelect.value = "";
            }

            filterRows();

        };


        /*
         * SEARCH
         */

        if (searchInput) {

            searchInput.addEventListener(
                "input",
                filterRows
            );

        }


        /*
         * STATUS
         */

        if (statusSelect) {

            statusSelect.addEventListener(
                "change",
                filterRows
            );

        }


        /*
         * DELETE MODAL
         */

        function openDeleteModal(id, title) {

            if (!deleteModal || !deleteId) {
                return;
            }

            deleteId.value = id;

            if (deleteMessage) {

                deleteMessage.textContent =
                    '"' +
                    title +
                    '" adlı özellik kalıcı olarak silinecektir.';

            }

            deleteModal.style.display = "flex";

        }


        window.closeDeleteModal = function () {

            if (deleteModal) {

                deleteModal.style.display = "none";

            }

        };


        /*
         * DELETE BUTTONS
         */

        document
            .querySelectorAll(".action-btn.delete")
            .forEach(button => {

                button.addEventListener(
                    "click",
                    function () {

                        const id =
                            this.dataset.id || "";

                        const title =
                            this.dataset.title || "Bu özellik";

                        openDeleteModal(
                            id,
                            title
                        );

                    }
                );

            });


        /*
         * CLOSE MODAL
         * CLICK OUTSIDE
         */

        if (deleteModal) {

            deleteModal.addEventListener(
                "click",
                function (event) {

                    if (event.target === deleteModal) {

                        closeDeleteModal();

                    }

                }
            );

        }


        /*
         * ESC
         */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape" &&
                    deleteModal &&
                    deleteModal.style.display === "flex"
                ) {

                    closeDeleteModal();

                }

            }
        );

    });

</script>

