@model Travel.Web.DTOs.StatisticDtos.DashboardDto
@using Travel.Web.DTOs.ReservationDtos
@using Travel.Web.DTOs.ReviewDtos
@using Travel.Web.DTOs.QuestionDtos
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/AdminLayout/Layout.cshtml";

    var tr = new CultureInfo("tr-TR");
    var reservations = (List<ReservationListDto>)ViewBag.RecentReservations;
    var reviews = (List<ReviewListDto>)ViewBag.RecentReviews;
    var questions = (List<QuestionListDto>)ViewBag.PendingQuestions;

    string Badge(string s) => s switch { "Approved" => "b-ok", "Cancelled" => "b-cancel", _ => "b-wait" };
    string StatusText(string s) => s switch { "Approved" => L["Onaylandı"].Value, "Cancelled" => L["İptal Edildi"].Value, _ => L["Bekliyor"].Value };
    string Initials(string? n) => string.Concat((n ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpper(x[0])));
}

<div class="content">

    <div class="page-intro">
        <div>
            <div class="eyebrow">@L["Genel Bakış"]</div>
            <h1>@L["Hoş Geldiniz"] 👋</h1>
            <p>@L["Travelio platformundaki son gelişmeleri ve önemli verileri buradan takip edebilirsiniz."]</p>
        </div>
        <div class="date-pill">📅 @DateTime.Now.ToString("d MMMM yyyy")</div>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="kpi">
                <div class="num">@Model.TotalTours</div>
                <div class="lab">@L["Toplam Tur"]</div>
                <div class="sub"><span class="up">@Model.ActiveTours @L["aktif"]</span> · @Model.PassiveTours @L["pasif / taslak"]</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi">
                <div class="num">@Model.TotalReservations.ToString("N0", tr)</div>
                <div class="lab">@L["Toplam Rezervasyon"]</div>
                <div class="sub"><span class="up">@L["Bu ay"] +@Model.ThisMonthReservations</span></div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi">
                <div class="num">@Model.TotalUsers.ToString("N0", tr)</div>
                <div class="lab">@L["Toplam Kullanıcı"]</div>
                <div class="sub">@Model.TotalDestinations @L["destinasyon"] · ★ @Model.AverageTourRating.ToString("0.0") @L["ort. puan"]</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="kpi">
                <div class="num">@Model.PendingQuestions</div>
                <div class="lab">@L["Bekleyen Sorular"]</div>
                <div class="sub warn"><a asp-area="Admin" asp-controller="Question" asp-action="Index">@L["Yanıtla"] →</a></div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="kpi">
                <div class="lab">🏆 @L["En çok rezervasyon alan tur"]</div>
                <div class="num" style="font-size:1.2rem;margin-top:.4rem">@(Model.MostReservedTour?.Name ?? "–")</div>
                <div class="sub">@(Model.MostReservedTour?.Value ?? 0) @L["rezervasyon"]</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="kpi">
                <div class="lab">💰 @L["En yüksek gelir sağlayan tur"]</div>
                <div class="num" style="font-size:1.2rem;margin-top:.4rem">@(Model.TopRevenueTour?.Name ?? "–")</div>
                <div class="sub">@((Model.TopRevenueTour?.Value ?? 0).ToString("N0", tr)) TL</div>
            </div>
        </div>
    </div>

    <!-- CHART + TOP 5 -->
    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="card-x h-100">
                <div class="card-head"><h3>@L["Son 6 Aylık Rezervasyonlar"]</h3></div>
                <div class="card-body"><div class="chart-wrap"><canvas id="dashChart"></canvas></div></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-x h-100">
                <div class="card-head"><h3>@L["En Çok Rezervasyon Alan 5 Tur"]</h3></div>
                <div class="card-body pt-2">
                    @if (!Model.TopTours.Any()) { <p class="text-muted">@L["Henüz rezervasyon yok."]</p> }
                    @for (var i = 0; i < Model.TopTours.Count; i++)
                    {
                        var t = Model.TopTours[i];
                        <div class="pt-item">
                            <span class="rank">@(i + 1)</span>
                            @if (!string.IsNullOrWhiteSpace(t.ImageUrl)) { <img src="@t.ImageUrl" alt="@t.Name"> }
                            <div class="nm"><b>@t.Name</b><span>@t.Value @L["rezervasyon"]</span></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- CATEGORY / DESTINATION AGGREGATIONS -->
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card-x h-100">
                <div class="card-head"><h3>@L["Kategori Bazında Tur Sayısı"]</h3></div>
                <div class="card-body"><div class="chart-wrap" style="height:240px"><canvas id="catChart"></canvas></div></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card-x h-100">
                <div class="card-head"><h3>@L["Destinasyon Bazında Rezervasyon"]</h3></div>
                <div class="card-body"><div class="chart-wrap" style="height:240px"><canvas id="destChart"></canvas></div></div>
            </div>
        </div>
    </div>

    <!-- RECENT BOOKINGS -->
    <div class="card-x mb-3">
        <div class="card-head">
            <h3>@L["Son Rezervasyonlar"]</h3>
            <a class="btn-soft" asp-area="Admin" asp-controller="Reservation" asp-action="Index">@L["Tümünü Gör"]</a>
        </div>
        <div class="card-body pt-2">
            <div class="tbl-wrap">
                <table class="tx">
                    <thead>
                        <tr><th>@L["Misafir"]</th><th>@L["Tur"]</th><th>@L["Tur Tarihi"]</th><th>@L["Kişi"]</th><th>@L["Tutar"]</th><th>@L["Durum"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in reservations)
                        {
                            <tr>
                                <td>@r.FullName</td>
                                <td>@r.TourName</td>
                                <td>@r.TourStartDate.ToString("d MMM yyyy")</td>
                                <td>@r.TotalPerson</td>
                                <td><span class="amount">@r.TotalPrice.ToString("N0", tr) TL</span></td>
                                <td><span class="badge-x @Badge(r.Status)">@StatusText(r.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card-x h-100">
                <div class="card-head"><h3>@L["Son Yorumlar"]</h3></div>
                <div class="card-body pt-2">
                    @foreach (var r in reviews)
                    {
                        <div class="rv">
                            <div class="h">
                                <span class="av">@Initials(r.UserName)</span>
                                <div><b>@r.UserName</b><span>@r.TourName</span></div>
                                <span class="stars">@(new string('★', r.Rating))</span>
                            </div>
                            <p>@r.Comment</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card-x h-100">
                <div class="card-head"><h3>@L["Yanıt Bekleyen Sorular"]</h3></div>
                <div class="card-body pt-2">
                    @foreach (var q in questions)
                    {
                        <div class="qz">
                            <div class="body">
                                <div class="tour">@q.TourName</div>
                                <div class="q">@q.QuestionText</div>
                                <div class="time">@q.CreatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                            <a class="btn-soft" asp-area="Admin" asp-controller="Question" asp-action="Index">@L["Cevapla"]</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            if (typeof Chart === "undefined") return;
            const teal = "#0fa3a3";

            new Chart(document.getElementById("dashChart"), {
                type: "line",
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyReservations.Select(x => x.Name))),
                    datasets: [{ label: "Rezervasyon", data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyReservations.Select(x => x.Value))),
                        borderColor: teal, backgroundColor: "rgba(15,163,163,.15)", fill: true, tension: .38, borderWidth: 3, pointBackgroundColor: "#fff", pointBorderColor: teal }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
            });

            const bar = (id, items) => new Chart(document.getElementById(id), {
                type: "bar",
                data: { labels: items.map(x => x.Name), datasets: [{ data: items.map(x => x.Value), backgroundColor: teal, borderRadius: 6 }] },
                options: { responsive: true, maintainAspectRatio: false, indexAxis: "y", plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { precision: 0 } } } }
            });

            bar("catChart", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ToursByCategory)));
            bar("destChart", @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReservationsByDestination)));
        })();
    </script>
}
