@using Travel.Web.DTOs.DestinationDtos
@model List<ResultRouteDto>

@{
    ViewData["Title"] = "Rotalar";
    Layout = "~/Views/AdminLayout/_Layout.cshtml";

    var destinations = ViewBag.Destinations as List<ResultDestinationDto>;
}

<h1>Rotalar</h1>

<table class="table table-bordered table-hover">

    @{
        int count = 0;
    }

    <tr>
        <th>#</th>
        <th>Görsel</th>
        <th>Ülke</th>
        <th>Şehir</th>
        <th>Tur Süresi</th>
        <th>Fiyat</th>
        <th>İşlemler</th>
    </tr>

    @foreach (var item in Model)
    {
        count++;

        var destination = destinations?
        .FirstOrDefault(x => x.Id == item.DestinationId);

        <tr>
            <th>@count</th>

            <td>
                <img src="@item.ImageUrl"
                     style="width:100px; height:100px; object-fit:cover;"
                     alt="@(destination?.City ?? "Destination")" />
            </td>

            <td>
                @(destination?.Country ?? "-")
            </td>

            <td>
                @(destination?.City ?? "-")
            </td>

            <td>
                @item.Duration
            </td>

            <td>
                @item.Price ₺
            </td>

            <td>
                <a onclick="return confirm('Silmek istediğinize emin misiniz?')"
                   asp-controller="Route"
                   asp-action="Delete"
                   asp-route-id="@item.Id"
                   class="btn btn-outline-danger">
                    Sil
                </a>

                <a asp-controller="Route"
                   asp-action="Update"
                   asp-route-id="@item.Id"
                   class="btn btn-outline-info">
                    Güncelle
                </a>
            </td>
        </tr>
    }

</table>

<a asp-controller="Route"
   asp-action="Create"
   class="btn btn-outline-dark">
    Yeni Rota Ekle
</a>