@using Travel.Web.DTOs.DestinationDtos
@model UpdateRouteDto

@{
    ViewData["Title"] = "Rota Güncelle";
    Layout = "~/Views/AdminLayout/_Layout.cshtml";

    var destinations = ViewBag.Destinations as List<ResultDestinationDto>;
}

<h1>Rota Güncelle</h1>

<form method="post">

    <input type="hidden" asp-for="Id" />

    <label>Destinasyon</label>

    <select asp-for="DestinationId" class="form-control">

        <option value="">
            Destinasyon Seçiniz
        </option>

        @if (destinations != null)
        {
            foreach (var destination in destinations)
            {
                <option value="@destination.Id">
                    @destination.City - @destination.Country
                </option>
            }
        }

    </select>

    <span class="text-danger"
          asp-validation-for="DestinationId">
    </span>

    <br />

    <label>Görsel Url</label>

    <input type="text"
           asp-for="ImageUrl"
           class="form-control" />

    <span class="text-danger"
          asp-validation-for="ImageUrl">
    </span>

    <br />

    <label>Tur Süresi</label>

    <input type="text"
           asp-for="Duration"
           class="form-control" />

    <span class="text-danger"
          asp-validation-for="Duration">
    </span>

    <br />

    <label>Fiyat</label>

    <input type="number"
           asp-for="Price"
           class="form-control"
           step="0.01" />

    <span class="text-danger"
          asp-validation-for="Price">
    </span>

    <br />

    <button type="submit"
            class="btn btn-outline-dark">
        Güncelle
    </button>

</form>