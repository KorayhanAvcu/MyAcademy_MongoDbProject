@model List<Travel.Web.DTOs.AboutTimelineDtos.AboutTimelineResultDto>

@{
    ViewData["Title"] = "Timeline Yönetimi";
    Layout = "~/Views/AdminLayout/Layout.cshtml";

    var totalTimeline = Model?.Count ?? 0;
    var hasTimeline = Model != null && Model.Any();
    var latestTimeline = hasTimeline
        ? Model.OrderByDescending(x => x.Year).FirstOrDefault()
        : null;
}

<style>

    /* =========================
       TIMELINE INDEX
       ========================= */

    .crumb {
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

    .crumb a {
        color: var(--muted);
        text-decoration: none;
    }

    .crumb a:hover {
        color: var(--teal-dark);
    }

    .crumb .cur {
        color: var(--navy);
        font-weight: 600;
    }


    /* =========================
       PAGE INTRO
       ========================= */

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .page-intro h1 {
        font-weight: 700;
        font-size: 1.7rem;
        color: var(--navy);
        margin: .15rem 0 .3rem;
    }

    .page-intro p {
        color: var(--muted);
        margin: 0;
        font-size: .94rem;
        max-width: 60ch;
    }


    /* =========================
       BUTTON
       ========================= */

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .7rem 1.3rem;
        font-size: .9rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        white-space: nowrap;
        text-decoration: none;
    }

    .btn-teal:hover {
        background: var(--teal-dark);
        color: #fff;
        box-shadow: 0 12px 26px rgba(15,163,163,.3);
    }


    /* =========================
       KPI
       ========================= */

    .kpi {
        display: flex;
        align-items: center;
        gap: .85rem;
    }

    .kpi .ic {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: grid;
        place-items: center;
        background: rgba(15,163,163,.1);
        color: var(--teal-dark);
        flex: none;
    }

    .kpi .num {
        font-family: 'Sora';
        font-weight: 800;
        font-size: 1.4rem;
        color: var(--navy);
        line-height: 1;
    }

    .kpi .lab {
        font-size: .82rem;
        color: var(--muted);
        margin-top: .15rem;
    }


    /* =========================
       TIMELINE CARD
       ========================= */

    .timeline-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
    }

    .timeline-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid var(--line);
    }

    .timeline-card-header h5 {
        margin: 0;
        font-family: 'Sora';
        font-weight: 700;
        color: var(--navy);
        font-size: .95rem;
    }

    .timeline-card-header span {
        color: var(--muted);
        font-size: .82rem;
    }


    /* =========================
       TABLE
       ========================= */

    .tbl-wrap {
        overflow-x: auto;
    }

    .timeline-table {
        width: 100%;
        min-width: 900px;
        border-collapse: collapse;
    }

    .timeline-table th {
        padding: .9rem 1rem;
        background: #fafbfb;
        color: var(--muted);
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .02em;
        border-bottom: 1px solid var(--line);
        white-space: nowrap;
    }

    .timeline-table td {
        padding: .9rem 1rem;
        border-bottom: 1px solid var(--line);
        vertical-align: middle;
        color: var(--navy);
        font-size: .88rem;
    }

    .timeline-table tbody tr {
        transition: .2s;
    }

    .timeline-table tbody tr:hover {
        background: #fcfefe;
    }

    .timeline-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================
       YEAR
       ========================= */

    .year-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 70px;
        padding: .4rem .7rem;
        border-radius: 999px;
        background: rgba(15,163,163,.1);
        color: var(--teal-dark);
        font-size: .78rem;
        font-weight: 800;
    }


    /* =========================
       TITLE
       ========================= */

    .timeline-title {
        font-family: 'Sora';
        font-weight: 700;
        color: var(--navy);
        margin-bottom: .2rem;
    }

    .timeline-id {
        color: var(--muted);
        font-size: .72rem;
        margin-top: .35rem;
    }


    /* =========================
       DESCRIPTION
       ========================= */

    .description {
        max-width: 480px;
        color: var(--muted);
        line-height: 1.5;
    }


    /* =========================
       STATUS
       ========================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border-radius: 999px;
        padding: .38rem .7rem;
        font-size: .74rem;
        font-weight: 700;
    }

    .status-active {
        color: #13795b;
        background: rgba(25, 135, 84, .1);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }


    /* =========================
       ACTIONS
       ========================= */

    .actions {
        display: flex;
        gap: .45rem;
        flex-wrap: wrap;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        background: #fff;
        transition: .2s;
        text-decoration: none;
    }

    .action-btn.edit {
        color: var(--teal-dark);
    }

    .action-btn.edit:hover {
        background: rgba(15,163,163,.08);
        border-color: var(--teal);
    }


    /* =========================
       EMPTY STATE
       ========================= */

    .empty {
        text-align: center;
        padding: 4rem 1rem;
    }

    .empty .eic {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: rgba(15,163,163,.1);
        color: var(--teal-dark);
        display: grid;
        place-items: center;
        margin: 0 auto 1rem;
    }

    .empty h3 {
        font-family: 'Sora';
        font-weight: 700;
        color: var(--navy);
        font-size: 1.2rem;
        margin-bottom: .4rem;
    }

    .empty p {
        color: var(--muted);
        margin: 0 0 1.2rem;
    }


    /* =========================
       RESPONSIVE
       ========================= */

    @@media (max-width: 768px) {

        .page-intro {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-intro .btn-teal {
            width: 100%;
            justify-content: center;
        }

        .timeline-card-header {
            align-items: flex-start;
            gap: .5rem;
            flex-direction: column;
        }
    }

</style>


<!-- =========================
     CONTENT
     ========================= -->

<div class="content">


    <!-- =========================
         BREADCRUMB
         ========================= -->

    <div class="crumb">

        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index">

            Dashboard

        </a>

        /

        <span class="cur">
            Timeline
        </span>

    </div>


    <!-- =========================
         PAGE INTRO
         ========================= -->

    <div class="page-intro">

        <div>

            <h1>
                Timeline Yönetimi
            </h1>

            <p>
                Travelio'nun gelişim yolculuğunda yer alan dönemleri
                görüntüleyebilir ve yönetebilirsiniz.
            </p>

        </div>


        <!-- CREATE -->

        <a asp-area="Admin"
           asp-controller="AboutTimeline"
           asp-action="Create"
           class="btn-teal">

            <svg width="17"
                 height="17"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <line x1="12"
                      y1="5"
                      x2="12"
                      y2="19" />

                <line x1="5"
                      y1="12"
                      x2="19"
                      y2="12" />

            </svg>

            Yeni Timeline

        </a>

    </div>


    <!-- =========================
         KPI
         ========================= -->

    <div class="row g-3 mb-4">


        <!-- TOTAL -->

        <div class="col-12 col-md-4">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12"
                                cy="12"
                                r="9" />

                        <polyline points="12 7 12 12 15 14" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @totalTimeline
                    </div>

                    <div class="lab">
                        Toplam Timeline
                    </div>

                </div>

            </div>

        </div>


        <!-- LATEST YEAR -->

        <div class="col-12 col-md-4">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M3 12h18" />

                        <path d="M12 3v18" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @(latestTimeline?.Year.ToString() ?? "-")
                    </div>

                    <div class="lab">
                        Son Eklenen Yıl
                    </div>

                </div>

            </div>

        </div>


        <!-- CONTENT STATUS -->

        <div class="col-12 col-md-4">

            <div class="kpi">

                <div class="ic">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <polyline points="20 6 9 17 4 12" />

                    </svg>

                </div>

                <div>

                    <div class="num">
                        @(hasTimeline ? "Hazır" : "Bekliyor")
                    </div>

                    <div class="lab">
                        İçerik Durumu
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         TIMELINE CARD
         ========================= -->

    <div class="timeline-card">


        <!-- HEADER -->

        <div class="timeline-card-header">

            <div>

                <h5>
                    Timeline Listesi
                </h5>

                <span>
                    Travelio'nun gelişim sürecindeki dönemler.
                </span>

            </div>

            <span>
                @totalTimeline kayıt
            </span>

        </div>


        @if (hasTimeline)
        {

            <!-- =========================
                 TABLE
                 ========================= -->

            <div class="tbl-wrap">

                <table class="timeline-table">

                    <thead>

                        <tr>

                            <th style="width:100px;">
                                Yıl
                            </th>

                            <th>
                                Başlık
                            </th>

                            <th>
                                Açıklama
                            </th>

                            <th>
                                Durum
                            </th>

                            <th style="width:100px;">
                                İşlemler
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model.OrderBy(x => x.Year))
                        {

                            <tr>


                                <!-- YEAR -->

                                <td>

                                    <span class="year-badge">
                                        @item.Year
                                    </span>

                                </td>


                                <!-- TITLE -->

                                <td>

                                    <div class="timeline-title">
                                        @item.Title
                                    </div>

                                    <div class="timeline-id">
                                        ID: @item.Id
                                    </div>

                                </td>


                                <!-- DESCRIPTION -->

                                <td>

                                    <div class="description">

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            @(item.Description.Length > 150
                                                ? item.Description.Substring(0, 150) + "..."
                                                : item.Description)
                                        }
                                        else
                                        {
                                            <span style="color:var(--muted);">
                                                Açıklama bulunmuyor
                                            </span>
                                        }

                                    </div>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    <span class="status-badge status-active">

                                        <span class="status-dot"></span>

                                        Aktif

                                    </span>

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="actions">

                                        <a asp-area="Admin"
                                           asp-controller="AboutTimeline"
                                           asp-action="Update"
                                           asp-route-id="@item.Id"
                                           class="action-btn edit"
                                           title="Düzenle">

                                            <svg width="16"
                                                 height="16"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />

                                                <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1-1-4z" />

                                            </svg>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {

            <!-- =========================
                 EMPTY STATE
                 ========================= -->

            <div class="empty">

                <div class="eic">

                    <svg width="26"
                         height="26"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12"
                                cy="12"
                                r="9" />

                        <polyline points="12 7 12 12 15 14" />

                    </svg>

                </div>


                <h3>
                    Henüz Timeline bulunmuyor
                </h3>


                <p>
                    Travelio'nun gelişim yolculuğunu oluşturmak için
                    henüz bir Timeline kaydı eklenmemiş.
                </p>


                <a asp-area="Admin"
                   asp-controller="AboutTimeline"
                   asp-action="Create"
                   class="btn-teal">

                    <svg width="17"
                         height="17"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2.2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <line x1="12"
                              y1="5"
                              x2="12"
                              y2="19" />

                        <line x1="5"
                              y1="12"
                              x2="19"
                              y2="12" />

                    </svg>

                    Yeni Timeline Oluştur

                </a>

            </div>

        }

    </div>

</div>