@model List<ResultBannerDto>

@{
    ViewData["Title"] = "Banner Yönetimi";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    /* =========================
               BANNER INDEX
               ========================= */

    .crumb {
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

        .crumb a {
            color: var(--muted);
            text-decoration: none;
        }

            .crumb a:hover {
                color: var(--teal-dark);
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600;
        }

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            font-weight: 700;
            font-size: 1.7rem;
            color: var(--navy);
            margin: .15rem 0 .3rem;
        }

        .page-intro p {
            color: var(--muted);
            margin: 0;
            font-size: .94rem;
            max-width: 60ch;
        }

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .7rem 1.3rem;
        font-size: .9rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        white-space: nowrap;
        text-decoration: none;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            box-shadow: 0 12px 26px rgba(15,163,163,.3);
        }

    /* KPI */

    .kpi {
        display: flex;
        align-items: center;
        gap: .85rem;
    }

        .kpi .ic {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            flex: none;
        }

        .kpi .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 1.4rem;
            color: var(--navy);
            line-height: 1;
        }

        .kpi .lab {
            font-size: .82rem;
            color: var(--muted);
            margin-top: .15rem;
        }

    /* CARD */

    .banner-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
    }

    .banner-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid var(--line);
    }

        .banner-card-header h5 {
            margin: 0;
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: .95rem;
        }

        .banner-card-header span {
            color: var(--muted);
            font-size: .82rem;
        }

    /* TABLE */

    .banner-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
    }

        .banner-table th {
            padding: .9rem 1rem;
            background: #fafbfb;
            color: var(--muted);
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .02em;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        .banner-table td {
            padding: .9rem 1rem;
            border-bottom: 1px solid var(--line);
            vertical-align: middle;
            color: var(--navy);
            font-size: .88rem;
        }

        .banner-table tbody tr {
            transition: .2s;
        }

            .banner-table tbody tr:hover {
                background: #fcfefe;
            }

            .banner-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* IMAGE */

    .banner-image {
        width: 110px;
        height: 65px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: var(--cream);
    }

    /* TITLE */

    .banner-title {
        font-family: 'Sora';
        font-weight: 600;
        color: var(--navy);
        margin-bottom: .2rem;
    }

    .banner-id {
        color: var(--muted);
        font-size: .74rem;
    }

    /* DESCRIPTION */

    .description {
        max-width: 350px;
        color: var(--muted);
        line-height: 1.45;
    }

    /* ACTIONS */

    .actions {
        display: flex;
        gap: .45rem;
        flex-wrap: wrap;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        background: #fff;
        transition: .2s;
        text-decoration: none;
    }

        .action-btn.edit {
            color: var(--teal-dark);
        }

            .action-btn.edit:hover {
                background: rgba(15,163,163,.08);
                border-color: var(--teal);
            }

        .action-btn.delete {
            color: var(--cancel-fg);
        }

            .action-btn.delete:hover {
                background: var(--cancel-bg);
                border-color: var(--cancel-fg);
            }

    /* EMPTY */

    .empty {
        text-align: center;
        padding: 4rem 1rem;
    }

        .empty .eic {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            margin: 0 auto 1rem;
        }

        .empty h3 {
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: 1.2rem;
            margin-bottom: .4rem;
        }

        .empty p {
            color: var(--muted);
            margin: 0 0 1.2rem;
        }

    /* RESPONSIVE */

    .tbl-wrap {
        overflow-x: auto;
    }

    @@media (max-width: 768px) {
        .page-intro {
            align-items: flex-start;
            flex-direction: column;
        }

            .page-intro .btn-teal {
                width: 100%;
                justify-content: center;
            }
    }
</style>

<!-- BREADCRUMB -->

<div class="crumb">

    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
        Dashboard
    </a>

    /

    <span class="cur">
        Bannerlar
    </span>

</div>


<!-- INTRO -->

<div class="page-intro">

    <div>

        <h1>Banner Yönetimi</h1>

        <p>
            Travelio ana sayfasında kullanılan bannerları
            görüntüleyebilir, düzenleyebilir ve yönetebilirsiniz.
        </p>

    </div>

    <a asp-area="Admin"
       asp-controller="Banner"
       asp-action="Create"
       class="btn-teal">

        <svg width="17"
             height="17"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2.2"
             stroke-linecap="round"
             stroke-linejoin="round">

            <line x1="12"
                  y1="5"
                  x2="12"
                  y2="19" />

            <line x1="5"
                  y1="12"
                  x2="19"
                  y2="12" />

        </svg>

        Yeni Banner Ekle

    </a>

</div>


<!-- KPI -->

<div class="row g-3 mb-4">

    <div class="col-12 col-md-4">

        <div class="kpi">

            <div class="ic">

                <svg width="20"
                     height="20"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <rect x="3"
                          y="3"
                          width="18"
                          height="18"
                          rx="2" />

                    <circle cx="8.5"
                            cy="8.5"
                            r="1.5" />

                    <polyline points="21 15 16 10 5 21" />

                </svg>

            </div>

            <div>

                <div class="num">
                    @(Model?.Count ?? 0)
                </div>

                <div class="lab">
                    Toplam Banner
                </div>

            </div>

        </div>

    </div>

    <div class="col-12 col-md-4">

        <div class="kpi">

            <div class="ic">

                <svg width="20"
                     height="20"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <polyline points="20 6 9 17 4 12" />

                </svg>

            </div>

            <div>

                <div class="num">
                    @(Model?.Count ?? 0)
                </div>

                <div class="lab">
                    Yayındaki Banner
                </div>

            </div>

        </div>

    </div>

    <div class="col-12 col-md-4">

        <div class="kpi">

            <div class="ic">

                <svg width="20"
                     height="20"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M12 20V10" />
                    <path d="M18 20V4" />
                    <path d="M6 20v-4" />

                </svg>

            </div>

            <div>

                <div class="num">
                    @(Model?.Count ?? 0)
                </div>

                <div class="lab">
                    Görüntülenebilir Banner
                </div>

            </div>

        </div>

    </div>

</div>


<!-- BANNER TABLE -->

<div class="banner-card">

    <div class="banner-card-header">

        <div>

            <h5>
                Banner Listesi
            </h5>

            <span>
                Sistemde kayıtlı bannerlar
            </span>

        </div>

        <span>
            @(Model?.Count ?? 0) kayıt
        </span>

    </div>


    @if (Model != null && Model.Any())
    {

        <div class="tbl-wrap">

            <table class="banner-table">

                <thead>

                    <tr>

                        <th style="width:70px;">
                            #
                        </th>

                        <th>
                            Görsel
                        </th>
                        <th>
                            Üst Başlık
                        </th>
                        <th>
                            Başlık
                        </th>

                        <th>
                            Açıklama
                        </th>

                        <th style="width:130px;">
                            İşlemler
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @{
                        int count = 0;
                    }

                    @foreach (var item in Model)
                    {

                        count++;

                        <tr>

                            <td>

                                <span style="font-weight:700;">
                                    @count
                                </span>

                            </td>


                            <td>

                                <img src="@item.ImageUrl"
                                     class="banner-image"
                                     alt="@item.Title"
                                     onerror="this.src='https://via.placeholder.com/220x130?text=Banner';" />

                            </td>
                            <td>

                                <div class="banner-title">
                                    @item.TopTitle
                                </div>



                            </td>

                            <td>

                                <div class="banner-title">
                                    @item.Title
                                </div>

                                <div class="banner-id">
                                    ID: @item.Id
                                </div>

                            </td>


                            <td>

                                <div class="description">

                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        @(item.Description.Length > 90
                                                                    ? item.Description.Substring(0, 90) + "..."
                                                                    : item.Description)
                                                        }
                                    else
                                    {
                                        <span style="color:var(--muted);">
                                            Açıklama bulunmuyor
                                        </span>
                                    }

                                </div>

                            </td>


                            <td>

                                <div class="actions">

                                    <!-- UPDATE -->

                                    <a asp-area="Admin"
                                       asp-controller="Banner"
                                       asp-action="Update"
                                       asp-route-id="@item.Id"
                                       class="action-btn edit"
                                       title="Düzenle">

                                        <svg width="16"
                                             height="16"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />

                                            <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z" />

                                        </svg>

                                    </a>


                                    <!-- DELETE -->

                                    <a asp-area="Admin"
                                       asp-controller="Banner"
                                       asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="action-btn delete"
                                       title="Sil"
                                       onclick="return confirm('Bu bannerı silmek istediğinize emin misiniz?');">

                                        <svg width="16"
                                             height="16"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <polyline points="3 6 5 6 21 6" />

                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />

                                            <path d="M10 11v6" />
                                            <path d="M14 11v6" />

                                        </svg>

                                    </a>

                                </div>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    }
    else
    {

        <!-- EMPTY STATE -->

        <div class="empty">

            <div class="eic">

                <svg width="26"
                     height="26"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <rect x="3"
                          y="3"
                          width="18"
                          height="18"
                          rx="2" />

                    <circle cx="8.5"
                            cy="8.5"
                            r="1.5" />

                    <polyline points="21 15 16 10 5 21" />

                </svg>

            </div>

            <h3>
                Henüz banner bulunmuyor
            </h3>

            <p>
                Sisteme henüz bir banner eklenmemiş.
            </p>

            <a asp-area="Admin"
               asp-controller="Banner"
               asp-action="Create"
               class="btn-teal">

                <svg width="17"
                     height="17"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <line x1="12"
                          y1="5"
                          x2="12"
                          y2="19" />

                    <line x1="5"
                          y1="12"
                          x2="19"
                          y2="12" />

                </svg>

                İlk Bannerı Ekle

            </a>

        </div>

    }

</div>