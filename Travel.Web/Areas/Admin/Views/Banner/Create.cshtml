@model CreateBannerDto

@{
    ViewData["Title"] = "Yeni Banner Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    /* =========================================
               PAGE INTRO
               ========================================= */

    .page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

        .page-intro h1 {
            font-weight: 700;
            font-size: 1.7rem;
            color: var(--navy);
            margin: .15rem 0 .3rem;
        }

        .page-intro p {
            color: var(--muted);
            margin: 0;
            font-size: .94rem;
            max-width: 64ch;
        }

    /* =========================================
               BREADCRUMB
               ========================================= */

    .crumb {
        font-size: .8rem;
        color: var(--muted);
        margin-bottom: .4rem;
    }

        .crumb a {
            color: var(--muted);
            text-decoration: none;
        }

            .crumb a:hover {
                color: var(--teal-dark);
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600;
        }

    /* =========================================
               SECTION CARD
               ========================================= */

    .sec {
        background: #fff;
        border: 1px solid var(--line-2);
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        padding: 1.5rem 1.6rem;
        margin-bottom: 1.3rem;
    }

    .sec-head {
        margin-bottom: 1.2rem;
    }

        .sec-head h2 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.12rem;
            color: var(--navy);
            margin: 0;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .sec-head .sec-ic {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            flex: none;
        }

        .sec-head p {
            color: var(--muted);
            font-size: .86rem;
            margin: .4rem 0 0;
        }

    /* =========================================
               FORM FIELDS
               ========================================= */

    .field {
        margin-bottom: 1.1rem;
    }

        .field label {
            display: block;
            font-size: .8rem;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: .35rem;
        }

    .req {
        color: var(--cancel-fg);
    }

    .ctrl {
        width: 100%;
        border: 1px solid var(--line);
        background: var(--cream);
        border-radius: 11px;
        padding: .68rem .9rem;
        font-size: .9rem;
        color: var(--navy);
        outline: none;
        transition: .2s;
        font-family: inherit;
    }

        .ctrl::placeholder {
            color: #a7b2ba;
        }

        .ctrl:focus {
            border-color: var(--teal);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(15,163,163,.12);
        }

    textarea.ctrl {
        resize: vertical;
        min-height: 110px;
        line-height: 1.6;
    }

    .validation {
        color: var(--cancel-fg);
        font-size: .76rem;
        margin-top: .35rem;
        display: block;
    }

    /* =========================================
               IMAGE PREVIEW
               ========================================= */

    .image-preview-box {
        margin-top: .8rem;
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
        background: var(--cream);
        display: none;
    }

        .image-preview-box img {
            width: 100%;
            max-height: 260px;
            object-fit: cover;
            display: block;
        }

    .image-preview-info {
        padding: .65rem .8rem;
        font-size: .75rem;
        color: var(--muted);
        background: #fff;
    }

    /* =========================================
               INFO BOX
               ========================================= */

    .info-box {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        padding: .85rem 1rem;
        border-radius: 12px;
        background: rgba(15,163,163,.06);
        border: 1px solid rgba(15,163,163,.15);
        margin-top: .5rem;
    }

        .info-box .info-icon {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            flex: none;
        }

        .info-box b {
            display: block;
            color: var(--navy);
            font-size: .82rem;
            margin-bottom: .15rem;
        }

        .info-box span {
            color: var(--muted);
            font-size: .76rem;
            line-height: 1.5;
        }

    /* =========================================
               BUTTONS
               ========================================= */

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .7rem 1.3rem;
        font-size: .9rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        white-space: nowrap;
        cursor: pointer;
        text-decoration: none;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            box-shadow: 0 12px 26px rgba(15,163,163,.3);
        }

    .btn-ghost {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-weight: 600;
        padding: .65rem 1.2rem;
        font-size: .88rem;
        color: var(--navy);
        transition: .2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        white-space: nowrap;
        cursor: pointer;
        text-decoration: none;
    }

        .btn-ghost:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    /* =========================================
               ACTION BAR
               ========================================= */

    .action-bar {
        position: sticky;
        bottom: 0;
        background: rgba(255,255,255,.92);
        backdrop-filter: blur(10px);
        border: 1px solid var(--line-2);
        border-radius: 14px;
        box-shadow: var(--shadow-md);
        padding: .9rem 1.2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: .4rem;
        margin-bottom: .4rem;
    }

        .action-bar .saved {
            font-size: .83rem;
            color: var(--muted);
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .action-bar .btns {
            display: flex;
            gap: .6rem;
            flex-wrap: wrap;
        }

    /* =========================================
               RESPONSIVE
               ========================================= */

    @@media (max-width: 575px) {
        .page-intro {
            align-items: flex-start;
        }

        .action-bar {
            padding: .8rem;
        }

            .action-bar .btns {
                width: 100%;
            }

                .action-bar .btns a,
                .action-bar .btns button {
                    flex: 1;
                }
    }
</style>


<!-- BREADCRUMB -->
<div class="crumb">

    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
    /
    <a asp-area="Admin" asp-controller="Banner" asp-action="Index">Bannerlar</a>
    /
    <span class="cur">Yeni Banner Ekle</span>

</div>


<!-- PAGE INTRO -->
<div class="page-intro">

    <div>

        <h1>Yeni Banner Ekle</h1>

        <p>
            Ana sayfada veya ilgili alanlarda gösterilecek yeni banner
            içeriğini oluşturun.
        </p>

    </div>

    <a href="javascript:history.back()"
       class="btn-ghost">

        <svg width="16"
             height="16"
             viewBox="0 0 24 24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             stroke-linejoin="round">

            <line x1="19"
                  y1="12"
                  x2="5"
                  y2="12" />

            <polyline points="12 19 5 12 12 5" />

        </svg>

        Bannerlara Dön

    </a>

</div>


<form method="post">

    @Html.AntiForgeryToken()


    <!-- TEMEL BİLGİLER -->
    <div class="sec">

        <div class="sec-head">

            <h2>

                <span class="sec-ic">

                    <svg width="17"
                         height="17"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />

                    </svg>

                </span>

                Banner Bilgileri

            </h2>

            <p>
                Banner üzerinde gösterilecek başlık, açıklama ve görsel
                bilgilerini girin.
            </p>

        </div>


        <div class="row g-3">

            <!-- TOP TITLE -->
            <div class="col-12 field">

                <label>
                    Üst Başlık
                    <span class="req">*</span>
                </label>

                <input type="text"
                       asp-for="TopTitle"
                       class="ctrl"
                       placeholder="TRAVELİO İLE KEŞFET" />

                <span asp-validation-for="TopTitle"
                      class="validation"></span>

            </div>
            <!-- TITLE -->
            <div class="col-12 field">

                <label>
                    Başlık
                    <span class="req">*</span>
                </label>

                <input type="text"
                       asp-for="Title"
                       class="ctrl"
                       placeholder="Örn. Avrupa'nın En Güzel Rotalarını Keşfedin" />

                <span asp-validation-for="Title"
                      class="validation"></span>

            </div>


            <!-- DESCRIPTION -->
            <div class="col-12 field">

                <label>
                    Açıklama
                    <span class="req">*</span>
                </label>

                <textarea asp-for="Description"
                          class="ctrl"
                          rows="4"
                          placeholder="Banner için kısa ve dikkat çekici bir açıklama yazın..."></textarea>

                <span asp-validation-for="Description"
                      class="validation"></span>

            </div>


            <!-- IMAGE URL -->
            <div class="col-12 field">

                <label>
                    Görsel URL
                    <span class="req">*</span>
                </label>

                <input type="text"
                       asp-for="ImageUrl"
                       id="imageUrl"
                       class="ctrl"
                       placeholder="https://example.com/images/banner.jpg"
                       oninput="previewImage(this.value)" />

                <span asp-validation-for="ImageUrl"
                      class="validation"></span>


                <!-- IMAGE PREVIEW -->
                <div class="image-preview-box"
                     id="imagePreviewBox">

                    <img id="imagePreview"
                         alt="Banner önizleme" />

                    <div class="image-preview-info">
                        Banner görseli önizlemesi
                    </div>

                </div>

            </div>

        </div>


        <!-- INFO -->
        <div class="info-box">

            <div class="info-icon">

                <svg width="16"
                     height="16"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="12"
                            cy="12"
                            r="10" />

                    <line x1="12"
                          y1="16"
                          x2="12"
                          y2="12" />

                    <line x1="12"
                          y1="8"
                          x2="12.01"
                          y2="8" />

                </svg>

            </div>

            <div>

                <b>Görsel önerisi</b>

                <span>
                    Banner görsellerinde yatay ve yüksek çözünürlüklü
                    görseller kullanmanız önerilir. İdeal oran 16:9'dur.
                </span>

            </div>

        </div>

    </div>


    <!-- ACTION BAR -->
    <div class="action-bar">

        <div class="saved">

            <svg width="15"
                 height="15"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <circle cx="12"
                        cy="12"
                        r="10" />

                <polyline points="12 6 12 12 16 14" />

            </svg>

            Yeni banner oluşturuluyor

        </div>


        <div class="btns">

            <a href="javascript:history.back()"
               class="btn-ghost">

                İptal

            </a>

            <button type="submit"
                    class="btn-teal">

                <svg width="16"
                     height="16"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />

                    <polyline points="17 21 17 13 7 13 7 21" />

                    <polyline points="7 3 7 8 15 8" />

                </svg>

                Bannerı Kaydet

            </button>

        </div>

    </div>

</form>

@section Scripts {
    <script>

        function previewImage(url) {

            const previewBox =
                document.getElementById("imagePreviewBox");

            const preview =
                document.getElementById("imagePreview");

            if (!url || !url.trim()) {

                previewBox.style.display = "none";
                preview.removeAttribute("src");

                return;
            }

            preview.src = url;
            previewBox.style.display = "block";

            preview.onerror = function () {

                previewBox.style.display = "none";

            };

        }

    </script>
}