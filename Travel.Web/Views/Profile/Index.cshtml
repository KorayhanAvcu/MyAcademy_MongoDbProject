
@model Travel.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = L["Profilim"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* PAGE HEAD */
    .prof-head {
        padding: 2rem 0 1.2rem;
    }

    .crumb {
        font-size: .85rem;
        color: var(--muted);
        margin-bottom: 1rem;
    }

        .crumb a {
            color: var(--muted);
        }

            .crumb a:hover {
                color: var(--teal-dark);
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600;
        }

    .prof-head h1 {
        font-weight: 800;
        font-size: clamp(1.8rem, 3.2vw, 2.5rem);
        letter-spacing: -.5px;
        color: var(--navy);
        margin: .35rem 0 .5rem;
    }

    .prof-head p {
        color: var(--muted);
        max-width: 56ch;
        margin: 0;
    }


    /* SIDEBAR */
    .side-card {
        background: #fff;
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        overflow: hidden;
    }

    .side-user {
        padding: 1.5rem 1.4rem;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        gap: .9rem;
    }

        .side-user .av {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: var(--navy);
            color: #fff;
            display: grid;
            place-items: center;
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.15rem;
            flex: none;
        }

        .side-user b {
            display: block;
            font-family: 'Sora';
            color: var(--navy);
            font-size: 1rem;
        }

        .side-user span {
            font-size: .8rem;
            color: var(--muted);
            word-break: break-all;
        }

    .side-menu {
        padding: .7rem;
    }

    .side-link {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: .7rem .9rem;
        border-radius: 12px;
        color: var(--navy);
        font-weight: 500;
        font-size: .94rem;
        cursor: pointer;
        transition: .18s;
        margin-bottom: .15rem;
        border: none;
        background: none;
        width: 100%;
        text-align: left;
    }

        .side-link svg {
            color: var(--muted);
            flex: none;
            transition: .18s;
        }

        .side-link:hover {
            background: var(--cream);
        }

        .side-link.active {
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            font-weight: 600;
        }

            .side-link.active svg {
                color: var(--teal-dark);
            }

    .side-sep {
        height: 1px;
        background: var(--line);
        margin: .5rem .5rem;
    }

    .side-link.logout {
        color: #c0554f;
    }

        .side-link.logout svg {
            color: #c0554f;
        }

        .side-link.logout:hover {
            background: rgba(192,85,79,.08);
        }

    .side-sticky {
        position: sticky;
        top: 90px;
    }

    .menu-btn-mobile {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: .85rem 1.1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        font-weight: 600;
        color: var(--navy);
        box-shadow: var(--shadow-sm);
    }


    /* CONTENT / PANES */
    .pane {
        display: none;
    }

        .pane.active {
            display: block;
            animation: fade .3s ease;
        }

    @@keyframes fade {
        from

    {
        opacity: 0;
        transform: translateY(6px);
    }

    to {
        opacity: 1;
        transform: none;
    }

    }

    .pane-head {
        margin-bottom: 1.4rem;
    }

        .pane-head h1 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.6rem;
            color: var(--navy);
            margin-bottom: .3rem;
        }

        .pane-head p {
            color: var(--muted);
            margin: 0;
        }

    .card-soft {
        background: #fff;
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.6rem;
    }


    /* STAT CARDS */
    .stat-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.2rem 1.3rem;
        height: 100%;
    }

        .stat-card .ico {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            margin-bottom: .7rem;
        }

        .stat-card .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 1.7rem;
            color: var(--navy);
            line-height: 1;
        }

        .stat-card .lab {
            font-size: .84rem;
            color: var(--muted);
            margin-top: .2rem;
        }


    /* UPCOMING FEATURE */
    .upcoming {
        position: relative;
        border-radius: var(--r);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        color: #fff;
        min-height: 250px;
        display: flex;
        align-items: flex-end;
    }

        .upcoming img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .upcoming::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 115deg, rgba(14,42,59,.9) 0%, rgba(14,42,59,.55) 55%, rgba(11,127,128,.35) 100% );
        }

        .upcoming .inner {
            position: relative;
            z-index: 2;
            padding: 1.8rem;
        }

    .up-badge {
        display: inline-block;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.28);
        font-size: .72rem;
        font-weight: 600;
        padding: .3rem .75rem;
        border-radius: 999px;
        margin-bottom: .7rem;
        backdrop-filter: blur(4px);
    }

    .upcoming h3 {
        font-weight: 700;
        font-size: 1.4rem;
        margin: 0 0 .2rem;
    }

    .upcoming .sub {
        color: rgba(255,255,255,.82);
        font-size: .9rem;
    }

    .up-meta {
        display: flex;
        flex-wrap: wrap;
        gap: .6rem 1.4rem;
        margin: 1rem 0 1.2rem;
        font-size: .88rem;
        color: rgba(255,255,255,.92);
    }

        .up-meta b {
            color: #fff;
            font-family: 'Sora';
            font-weight: 600;
        }

    .status-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-size: .78rem;
        font-weight: 600;
        padding: .3rem .75rem;
        border-radius: 999px;
    }

    .status-ok {
        background: rgba(15,163,163,.16);
        color: #8ce7e7;
        border: 1px solid rgba(143,231,231,.3);
    }

    .up-btns .btn-white {
        background: #fff;
        color: var(--navy);
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .6rem 1.2rem;
        font-size: .88rem;
        transition: .2s;
    }

        .up-btns .btn-white:hover {
            background: var(--teal);
            color: #fff;
        }

    .up-btns .btn-linewhite {
        background: transparent;
        color: #fff;
        border: 1px solid rgba(255,255,255,.5);
        border-radius: 999px;
        font-weight: 600;
        padding: .6rem 1.2rem;
        font-size: .88rem;
        transition: .2s;
    }

        .up-btns .btn-linewhite:hover {
            background: #fff;
            color: var(--navy);
        }


    /* ACTIVITY */
    .act-item {
        display: flex;
        align-items: flex-start;
        gap: .85rem;
        padding: .85rem 0;
        border-top: 1px solid var(--line);
    }

        .act-item:first-child {
            border-top: none;
            padding-top: 0;
        }

    .act-ico {
        flex: none;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: var(--cream);
        display: grid;
        place-items: center;
        color: var(--teal-dark);
    }

    .act-item .t {
        color: var(--navy);
        font-size: .93rem;
    }

    .act-item .time {
        color: var(--muted);
        font-size: .78rem;
        margin-top: .1rem;
    }


    /* FORM */
    .field label {
        font-size: .8rem;
        font-weight: 600;
        color: var(--navy);
        margin-bottom: .35rem;
        display: block;
    }

    .field input,
    .field select {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: .7rem .9rem;
        font-size: .93rem;
        color: var(--navy);
        background: var(--cream);
        outline: none;
        transition: .2s;
    }

        .field input:focus,
        .field select:focus {
            border-color: var(--teal);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(15,163,163,.12);
        }


    /* TABS */
    .subtabs {
        display: inline-flex;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .25rem;
        margin-bottom: 1.4rem;
    }

    .subtab {
        border: none;
        background: none;
        border-radius: 999px;
        padding: .45rem 1.1rem;
        font-weight: 600;
        font-size: .88rem;
        color: var(--muted);
        cursor: pointer;
        transition: .2s;
    }

        .subtab.active {
            background: var(--navy);
            color: #fff;
        }


    /* BOOKING ROW CARD */
    .trip-card {
        display: flex;
        gap: 1.1rem;
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: .9rem;
        margin-bottom: 1rem;
        align-items: center;
    }

        .trip-card img {
            width: 120px;
            height: 92px;
            border-radius: 12px;
            object-fit: cover;
            flex: none;
        }

    .trip-info {
        flex: 1;
        min-width: 0;
    }

        .trip-info .country {
            font-size: .76rem;
            color: var(--teal-dark);
            font-weight: 600;
        }

        .trip-info h4 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--navy);
            margin: .1rem 0 .3rem;
        }

        .trip-info .meta {
            font-size: .84rem;
            color: var(--muted);
            display: flex;
            flex-wrap: wrap;
            gap: .3rem 1rem;
        }

        .trip-info .resno {
            font-size: .78rem;
            color: var(--muted);
            margin-top: .2rem;
        }

    .trip-right {
        flex: none;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: .6rem;
    }

    .badge-soft {
        font-size: .74rem;
        font-weight: 600;
        padding: .3rem .7rem;
        border-radius: 999px;
    }

    .badge-ok {
        background: rgba(15,163,163,.12);
        color: var(--teal-dark);
    }

    .badge-done {
        background: rgba(14,42,59,.08);
        color: var(--navy);
    }

    .trip-right .acts {
        display: flex;
        gap: .4rem;
    }

    .mini-btn {
        font-size: .8rem;
        font-weight: 600;
        padding: .4rem .8rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--navy);
        cursor: pointer;
        transition: .2s;
    }

        .mini-btn:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

        .mini-btn.solid {
            background: var(--navy);
            color: #fff;
            border-color: var(--navy);
        }

            .mini-btn.solid:hover {
                background: var(--teal-dark);
                border-color: var(--teal-dark);
                color: #fff;
            }


    /* FAVORITE TOUR CARD */
    .tour-card {
        background: #fff;
        border-radius: var(--r);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: .3s;
        height: 100%;
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(231,226,216,.7);
    }

        .tour-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
        }

    .tour-media {
        position: relative;
        height: 180px;
        overflow: hidden;
    }

        .tour-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: .5s;
        }

    .tour-card:hover .tour-media img {
        transform: scale(1.07);
    }

    .fav {
        position: absolute;
        top: .7rem;
        right: .75rem;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(255,255,255,.94);
        display: grid;
        place-items: center;
        color: #e0575b;
        cursor: pointer;
        border: none;
        transition: .2s;
    }

        .fav svg {
            fill: currentColor;
        }

        .fav:hover {
            transform: scale(1.1);
        }

    .tour-body {
        padding: 1.05rem 1.15rem 1.2rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .tour-country {
        font-size: .76rem;
        color: var(--teal-dark);
        font-weight: 600;
    }

    .tour-title {
        font-family: 'Sora';
        font-weight: 700;
        font-size: 1.05rem;
        margin: .15rem 0 .45rem;
        color: var(--navy);
    }

    .tour-meta {
        display: flex;
        align-items: center;
        gap: .8rem;
        font-size: .82rem;
        color: var(--muted);
        margin-bottom: .8rem;
    }

    .tour-foot {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-top: auto;
        padding-top: .5rem;
        border-top: 1px solid var(--line);
    }

    .price small {
        color: var(--muted);
        font-size: .72rem;
        display: block;
    }

    .price b {
        font-family: 'Sora';
        font-size: 1.18rem;
        color: var(--navy);
    }

        .price b span {
            font-size: .82rem;
            font-weight: 600;
            color: var(--muted);
        }

    .btn-incele {
        background: var(--navy);
        color: #fff;
        border-radius: 999px;
        font-size: .82rem;
        font-weight: 600;
        padding: .5rem 1rem;
        border: none;
        transition: .25s;
    }

        .btn-incele:hover {
            background: var(--teal-dark);
            color: #fff;
        }


    /* MY REVIEWS */
    .rev-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.3rem 1.4rem;
        margin-bottom: 1rem;
    }

        .rev-card .top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .rev-card h4 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--navy);
            margin: 0;
        }

    .rev-stars {
        color: #f4a92c;
        font-size: .9rem;
    }

        .rev-stars .off {
            color: #d8cfc0;
        }

    .rev-date {
        font-size: .78rem;
        color: var(--muted);
    }

    .rev-card p {
        color: var(--navy);
        line-height: 1.6;
        margin: .7rem 0 .9rem;
        font-size: .93rem;
    }

    .rev-acts {
        display: flex;
        gap: .5rem;
    }


    /* QUESTIONS */
    .q-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.3rem 1.4rem;
        margin-bottom: 1rem;
    }

        .q-card .top {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .q-card .tour-name {
            font-size: .78rem;
            color: var(--teal-dark);
            font-weight: 600;
        }

        .q-card .q-txt {
            font-family: 'Sora';
            font-weight: 600;
            color: var(--navy);
            margin: .35rem 0 .2rem;
            font-size: 1rem;
        }

        .q-card .q-date {
            font-size: .78rem;
            color: var(--muted);
        }

    .badge-wait {
        background: rgba(214,158,46,.15);
        color: #a9741a;
    }

    .q-answer {
        background: rgba(15,163,163,.06);
        border-radius: 12px;
        padding: .8rem 1rem;
        margin-top: .9rem;
        display: flex;
        gap: .7rem;
    }

        .q-answer .who {
            font-family: 'Sora';
            font-weight: 700;
            color: var(--teal-dark);
            font-size: .82rem;
            white-space: nowrap;
        }

        .q-answer .txt {
            color: var(--muted);
            font-size: .9rem;
            line-height: 1.55;
        }

    .q-wait-note {
        color: var(--muted);
        font-size: .85rem;
        margin-top: .8rem;
        font-style: italic;
    }


    /* RATINGS */
    .rate-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.2rem 1.3rem;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .rate-card .country {
            font-size: .76rem;
            color: var(--teal-dark);
            font-weight: 600;
        }

        .rate-card h4 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.02rem;
            color: var(--navy);
            margin: .15rem 0 .5rem;
        }

        .rate-card .stars {
            color: #f4a92c;
            font-size: 1.15rem;
            letter-spacing: 2px;
        }

            .rate-card .stars .off {
                color: #d8cfc0;
            }

        .rate-card .score {
            font-family: 'Sora';
            font-weight: 600;
            color: var(--navy);
            font-size: .9rem;
            margin-top: .3rem;
        }

        .rate-card .date {
            font-size: .76rem;
            color: var(--muted);
            margin-top: .15rem;
        }

        .rate-card .mini-btn {
            margin-top: auto;
            align-self: flex-start;
        }


    /* EMPTY STATE */
    .empty {
        text-align: center;
        padding: 3rem 1rem;
    }

        .empty .ico {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            margin: 0 auto 1rem;
        }

        .empty h3 {
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: 1.2rem;
        }

        .empty p {
            color: var(--muted);
            margin: .3rem 0 1.2rem;
        }


    /* TOAST */
    .toast-ok {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: var(--navy);
        color: #fff;
        padding: .9rem 1.3rem;
        border-radius: 14px;
        box-shadow: var(--shadow-md);
        font-size: .9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: .6rem;
        z-index: 1080;
        opacity: 0;
        transform: translateY(12px);
        transition: .3s;
        pointer-events: none;
    }

        .toast-ok.show {
            opacity: 1;
            transform: none;
        }

        .toast-ok svg {
            color: #7fe3e3;
        }


    /* RATING MODAL */
    .star-pick {
        font-size: 1.7rem;
        color: #d8cfc0;
        cursor: pointer;
        transition: .15s;
    }

        .star-pick.on {
            color: #f4a92c;
        }


    /* RESPONSIVE */
    @@media (max-width: 991px) {
        .side-sticky

    {
        position: static;
    }

    }
</style>

<style>
    .badge-cancel { background: rgba(180,90,79,.12); color: #b45a4f }
    .trip-card form { display: inline }
    .side-link { text-decoration: none }
    .btn-outline { background:#fff;border:1px solid var(--line);color:var(--navy);border-radius:999px;font-weight:600;padding:.55rem 1.15rem;font-size:.88rem }
</style>

@{
    var tr = new CultureInfo("tr-TR");

    var menu = new[]
    {
        ("overview", "Genel Bakış", "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"),
        ("profile", "Profil Bilgilerim", "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c0-4 4-6 8-6s8 2 8 6"),
        ("trips", "Rezervasyonlarım", "M3 7h18v12H3zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"),
        ("favorites", "Favori Turlarım", "M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"),
        ("reviews", "Yorumlarım", "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"),
        ("questions", "Sorularım", "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01")
    };

    string StatusBadge(string status) => status switch
    {
        "Approved" => "badge-ok",
        "Cancelled" => "badge-cancel",
        _ => "badge-wait"
    };

    string StatusText(string status) => status switch
    {
        "Approved" => L["Onaylandı"].Value,
        "Cancelled" => L["İptal Edildi"].Value,
        _ => L["Bekliyor"].Value
    };

    var next = Model.UpcomingReservations.FirstOrDefault();
}

@functions {
    private static string Stars(int n) =>
        string.Concat(Enumerable.Range(1, 5).Select(i => i <= n ? "★" : "<span class='off'>★</span>"));
}

<!-- PAGE HEAD -->
<div class="container prof-head">
    <div class="crumb"><a asp-controller="Default" asp-action="Index">@L["Ana Sayfa"]</a> / <span class="cur">@L["Profilim"]</span></div>
    <div class="eyebrow">@L["Hesabım"]</div>
    <h1>@L["Profilim"]</h1>
    <p>@L["Seyahatlerini, favorilerini ve Travelio deneyimini buradan yönetebilirsin."]</p>
</div>

<div class="container pb-2">
    <div class="d-lg-none mb-3">
        <button class="menu-btn-mobile" type="button" data-bs-toggle="offcanvas" data-bs-target="#accountMenu">
            <span>@L["Hesap Menüsü"]</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
        </button>
    </div>

    <div class="row g-4">
        <!-- SIDEBAR -->
        <div class="col-lg-3 d-none d-lg-block">
            <div class="side-sticky">
                <div class="side-card">
                    <div class="side-user">
                        <div class="av">@Model.Initials</div>
                        <div style="min-width:0"><b>@Model.FirstName @Model.LastName</b><span>@Model.Email</span></div>
                    </div>
                    <div class="side-menu">
                        @foreach (var (id, label, icon) in menu)
                        {
                            <button type="button" class="side-link @(Model.ActiveTab == id ? "active" : "")" data-pane="@id" onclick="go('@id')">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="@icon" /></svg>
                                @L[label]
                            </button>
                        }
                        <div class="side-sep"></div>
                        <button type="button" class="side-link logout" data-bs-toggle="modal" data-bs-target="#logoutModal">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                            @L["Çıkış Yap"]
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="col-lg-9">

            <!-- OVERVIEW -->
            <div class="pane" data-pane="overview">
                <div class="pane-head">
                    <h1>@L["Merhaba"] @Model.FirstName 👋</h1>
                    <p>@L["Bir sonraki maceranın detaylarına göz atabilir, geçmiş seyahatlerini ve favorilerini yönetebilirsin."]</p>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3"><div class="stat-card"><div class="num">@Model.UpcomingReservations.Count</div><div class="lab">@L["Yaklaşan Tur"]</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-card"><div class="num">@Model.Reservations.Count(x => x.Status != "Cancelled")</div><div class="lab">@L["Rezervasyon"]</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-card"><div class="num">@Model.Favorites.Count</div><div class="lab">@L["Favori Tur"]</div></div></div>
                    <div class="col-6 col-md-3"><div class="stat-card"><div class="num">@Model.Reviews.Count</div><div class="lab">@L["Yorum"]</div></div></div>
                </div>

                @if (next != null)
                {
                    <h2 style="font-family:'Sora';font-weight:700;font-size:1.25rem;color:var(--navy);margin-bottom:1rem">@L["Yaklaşan Seyahatin"]</h2>
                    <div class="upcoming mb-4">
                        <img src="@next.TourImage" alt="@next.TourName">
                        <div class="inner">
                            <h3>@next.TourName</h3>
                            <div class="up-meta">
                                <span>📅 <b>@next.TourStartDate.ToString("d MMMM yyyy")</b></span>
                                <span>👥 <b>@next.TotalPerson @L["kişi"]</b></span>
                                <span>⌛ @L["Kalan"]: <b>@((next.TourStartDate.Date - DateTime.Today).Days) @L["gün"]</b></span>
                                <span class="status-chip status-ok">● @StatusText(next.Status)</span>
                            </div>
                            <div class="up-btns d-flex gap-2 flex-wrap">
                                <a asp-controller="Tours" asp-action="TourDetail" asp-route-id="@next.TourId" class="btn-white">@L["Tur Detayı"]</a>
                                <button type="button" class="btn-linewhite" onclick="go('trips')">@L["Rezervasyonu Gör"]</button>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-soft mb-4">
                        <div class="empty">
                            <h3>@L["Yaklaşan bir seyahatin yok."]</h3>
                            <p>@L["Yeni rotalar keşfetmeye ne dersin?"]</p>
                            <a asp-controller="Tours" asp-action="Index" class="btn-teal">@L["Turları Keşfet"]</a>
                        </div>
                    </div>
                }
            </div>

            <!-- PROFILE -->
            <div class="pane" data-pane="profile">
                <div class="pane-head"><h1>@L["Profil Bilgilerim"]</h1><p>@L["Kişisel bilgilerini buradan güncelleyebilirsin."]</p></div>
                <form class="card-soft" asp-controller="Profile" asp-action="UpdateProfile" method="post">
                    <div class="row g-3">
                        <div class="col-md-6 field"><label>@L["Ad"]</label><input name="FirstName" value="@Model.FirstName" required></div>
                        <div class="col-md-6 field"><label>@L["Soyad"]</label><input name="LastName" value="@Model.LastName" required></div>
                        <div class="col-md-6 field"><label>@L["E-posta"]</label><input type="email" value="@Model.Email" disabled></div>
                        <div class="col-md-6 field"><label>@L["Telefon"]</label><input name="PhoneNumber" value="@Model.PhoneNumber"></div>
                    </div>
                    <button type="submit" class="btn-teal mt-4">@L["Bilgileri Güncelle"]</button>
                </form>
            </div>

            <!-- RESERVATIONS -->
            <div class="pane" data-pane="trips">
                <div class="pane-head"><h1>@L["Rezervasyonlarım"]</h1><p>@L["Yaklaşan ve geçmiş tüm seyahatlerin."]</p></div>

                @if (!Model.Reservations.Any())
                {
                    <div class="card-soft"><div class="empty">
                        <h3>@L["Henüz rezervasyonun yok."]</h3>
                        <a asp-controller="Tours" asp-action="Index" class="btn-teal">@L["Turları Keşfet"]</a>
                    </div></div>
                }

                @foreach (var group in new[] { (L["Yaklaşan"].Value, Model.UpcomingReservations), (L["Geçmiş / İptal"].Value, Model.PastReservations) })
                {
                    if (!group.Item2.Any()) { continue; }

                    <h3 style="font-family:'Sora';font-weight:600;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin:1.2rem 0 .9rem">@group.Item1</h3>

                    @foreach (var r in group.Item2)
                    {
                        <div class="trip-card">
                            <img src="@r.TourImage" alt="@r.TourName">
                            <div class="trip-info">
                                <h4>@r.TourName</h4>
                                <div class="meta">
                                    <span>📅 @r.TourStartDate.ToString("d MMM yyyy")@(r.TourEndDate.HasValue ? " - " + r.TourEndDate.Value.ToString("d MMM yyyy") : "")</span>
                                    <span>👥 @r.AdultCount @L["Yetişkin"]@(r.ChildCount > 0 ? $", {r.ChildCount} {L["Çocuk"].Value}" : "")</span>
                                    <span>💳 @r.TotalPrice.ToString("N0", tr) TL</span>
                                </div>
                                <div class="resno">@L["Rezervasyon tarihi"]: @r.CreatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                            <div class="trip-right">
                                <span class="badge-soft @StatusBadge(r.Status)">@StatusText(r.Status)</span>
                                <div class="acts">
                                    <a asp-controller="Tours" asp-action="TourDetail" asp-route-id="@r.TourId" class="mini-btn">@L["Tur Detayı"]</a>
                                    @if (r.Status != "Cancelled" && r.TourStartDate.Date > DateTime.Today)
                                    {
                                        <form asp-controller="Profile" asp-action="CancelReservation" method="post" onsubmit="return confirm('@L["Rezervasyonu iptal etmek istediğine emin misin?"]')">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="mini-btn">@L["İptal Et"]</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- FAVORITES -->
            <div class="pane" data-pane="favorites">
                <div class="pane-head"><h1>@L["Favori Turlarım"]</h1><p>@L["Daha sonra incelemek için kaydettiğin turlar."]</p></div>

                @if (!Model.Favorites.Any())
                {
                    <div class="card-soft"><div class="empty">
                        <h3>@L["Henüz favori turun yok."]</h3>
                        <p>@L["Yeni rotalar keşfetmeye ne dersin?"]</p>
                        <a asp-controller="Tours" asp-action="Index" class="btn-teal">@L["Turları Keşfet"]</a>
                    </div></div>
                }

                <div class="row g-4">
                    @foreach (var t in Model.Favorites)
                    {
                        <div class="col-sm-6 col-lg-4">
                            <article class="tour-card">
                                <div class="tour-media">
                                    <img src="@t.CoverImageUrl" alt="@t.Name">
                                    <form asp-controller="Profile" asp-action="RemoveFavorite" method="post">
                                        <input type="hidden" name="tourId" value="@t.Id" />
                                        <button type="submit" class="fav" title="@L["Favoriden kaldır"]">
                                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" /></svg>
                                        </button>
                                    </form>
                                </div>
                                <div class="tour-body">
                                    <div class="tour-country">@t.DestinationName</div>
                                    <h3 class="tour-title">@t.Name</h3>
                                    <div class="tour-meta"><span>🗓️ @t.DurationDays @L["Gün"]</span>@if (t.ReviewCount > 0) {<span><span style="color:#f4a92c">★</span> @t.AverageRating.ToString("0.0")</span>}</div>
                                    <div class="tour-foot">
                                        <div class="price"><small>@L["Kişi başı"]</small><b>@t.Price.ToString("N0", tr) <span>TL</span></b></div>
                                        <a asp-controller="Tours" asp-action="TourDetail" asp-route-id="@t.Id" class="btn-incele">@L["Turu İncele"]</a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            </div>

            <!-- REVIEWS -->
            <div class="pane" data-pane="reviews">
                <div class="pane-head"><h1>@L["Yorumlarım"]</h1><p>@L["Turlar hakkında paylaştığın değerlendirmeler."]</p></div>

                @if (!Model.Reviews.Any())
                {
                    <div class="card-soft"><div class="empty">
                        <h3>@L["Henüz yorumun yok."]</h3>
                        <p>@L["Katıldığın turlar hakkında deneyimini paylaşabilirsin."]</p>
                    </div></div>
                }

                @foreach (var r in Model.Reviews)
                {
                    <div class="rev-card">
                        <div class="top">
                            <div><h4>@r.TourName</h4><span class="rev-date">@r.CreatedAt?.ToLocalTime().ToString("d MMMM yyyy")</span></div>
                            <span class="rev-stars">@Html.Raw(Stars(r.Rating))</span>
                        </div>
                        <p>@r.Comment</p>
                        <div class="rev-acts">
                            <a asp-controller="Tours" asp-action="TourDetail" asp-route-id="@r.TourId" asp-fragment="yorumlar" class="mini-btn">@L["Tura Git"]</a>
                            <form asp-controller="Profile" asp-action="DeleteReview" method="post" onsubmit="return confirm('@L["Yorumu silmek istiyor musun?"]')">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="mini-btn">@L["Sil"]</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <!-- QUESTIONS -->
            <div class="pane" data-pane="questions">
                <div class="pane-head"><h1>@L["Sorularım"]</h1><p>@L["Tur detay sayfalarında sorduğun sorular ve yanıtları."]</p></div>

                @if (!Model.Questions.Any())
                {
                    <div class="card-soft"><div class="empty"><h3>@L["Henüz soru sormadın."]</h3></div></div>
                }

                @foreach (var q in Model.Questions)
                {
                    <div class="q-card">
                        <div class="top">
                            <div>
                                <div class="tour-name">@q.TourName</div>
                                <div class="q-txt">@q.QuestionText</div>
                                <div class="q-date">@q.CreatedAt?.ToLocalTime().ToString("d MMMM yyyy")</div>
                            </div>
                            <span class="badge-soft @(q.IsAnswered ? "badge-ok" : "badge-wait")">@(q.IsAnswered ? L["Cevaplandı"] : L["Cevap Bekliyor"])</span>
                        </div>
                        @if (q.IsAnswered)
                        {
                            <div class="q-answer"><span class="who">Travelio</span><span class="txt">@q.Answer</span></div>
                        }
                        else
                        {
                            <div class="q-wait-note">@L["Ekibimiz sorunu en kısa sürede yanıtlayacak."]</div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<!-- OFFCANVAS (mobile menu) -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="accountMenu" style="width:300px;background:var(--cream)">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" style="font-family:'Sora';font-weight:700;color:var(--navy)">@L["Hesap Menüsü"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-2">
        <div class="side-card">
            <div class="side-menu">
                @foreach (var (id, label, icon) in menu)
                {
                    <button type="button" class="side-link @(Model.ActiveTab == id ? "active" : "")" data-pane="@id" onclick="go('@id')">@L[label]</button>
                }
                <div class="side-sep"></div>
                <a class="side-link logout" asp-controller="Auth" asp-action="SignOut">@L["Çıkış Yap"]</a>
            </div>
        </div>
    </div>
</div>

<!-- LOGOUT MODAL -->
<div class="modal fade" id="logoutModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <h5 style="font-family:'Sora';font-weight:700;color:var(--navy)">@L["Çıkış yapmak istediğine emin misin?"]</h5>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button class="btn-outline" data-bs-dismiss="modal">@L["Vazgeç"]</button>
                    <a asp-controller="Auth" asp-action="SignOut" class="btn-teal" style="background:#c0554f">@L["Çıkış Yap"]</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Sekmeler sunucuda render edilir; JS yalnızca görünürlüğü değiştirir.
    function go(id){
      document.querySelectorAll(".pane").forEach(p => p.classList.toggle("active", p.dataset.pane === id));
      document.querySelectorAll(".side-link[data-pane]").forEach(b => b.classList.toggle("active", b.dataset.pane === id));
      const url = new URL(location.href); url.searchParams.set("tab", id); history.replaceState(null, "", url);
      const oc = document.getElementById("accountMenu");
      const inst = window.bootstrap ? bootstrap.Offcanvas.getInstance(oc) : null;
      if(inst) inst.hide();
    }
    go(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveTab)));
</script>
