@{
    ViewData["Title"] = "Destinasyonlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --navy: #0e2a3b;
        --navy-2: #12384c;
        --teal: #0fa3a3;
        --teal-dark: #0b7f80;
        --teal-light: #e6f7f7;
        --cream: #f7f5f0;
        --white: #ffffff;
        --ink: #0e2a3b;
        --muted: #5d7180;
        --line: #e7e2d8;
        --shadow-sm: 0 4px 18px rgba(14, 42, 59, .06);
        --shadow-md: 0 18px 50px rgba(14, 42, 59, .12);
        --shadow-floating: 0 20px 45px -10px rgba(14, 42, 59, .15);
        --r: 20px;
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--ink);
        background: var(--cream);
        -webkit-font-smoothing: antialiased;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    .brand,
    .display-font {
        font-family: 'Sora', sans-serif;
    }

    .eyebrow {
        font-family: 'Sora', sans-serif;
        text-transform: uppercase;
        letter-spacing: .22em;
        font-size: .72rem;
        font-weight: 700;
        color: var(--teal-dark);
    }

    a {
        text-decoration: none;
    }

    /* BUTTONS */

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .8rem 1.6rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        gap: .5rem;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(15, 163, 163, .32);
        }

    .btn-outline {
        background: #fff;
        border: 1px solid var(--line);
        color: var(--navy);
        border-radius: 999px;
        font-weight: 600;
        padding: .55rem 1.2rem;
        font-size: .88rem;
        transition: .2s;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

        .btn-outline:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
        }

    /* NAVBAR */

    .navbar {
        background: rgba(247, 245, 240, .9);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
        padding: .9rem 0;
    }

    .brand {
        font-weight: 800;
        font-size: 1.5rem;
        color: var(--navy);
        letter-spacing: -.5px;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .brand .dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: var(--teal);
            display: inline-block;
            box-shadow: 0 0 0 4px rgba(15, 163, 163, .18);
        }

    .navbar .nav-link {
        color: var(--navy);
        font-weight: 500;
        margin: 0 .35rem;
        position: relative;
    }

        .navbar .nav-link:hover {
            color: var(--teal-dark);
        }

        .navbar .nav-link.active {
            color: var(--teal-dark);
        }

            .navbar .nav-link.active::after {
                content: "";
                position: absolute;
                left: .7rem;
                right: .7rem;
                bottom: -2px;
                height: 2px;
                background: var(--teal);
                border-radius: 2px;
            }

    .profile-pill {
        display: flex;
        align-items: center;
        gap: .55rem;
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 999px;
        padding: .35rem .35rem .35rem .95rem;
        font-weight: 600;
        color: var(--navy);
        transition: .2s;
    }

        .profile-pill:hover {
            box-shadow: var(--shadow-sm);
            color: var(--navy);
            border-color: var(--teal);
        }

        .profile-pill .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--navy);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: .85rem;
            font-weight: 700;
        }

    /* PAGE HEADER */

    .page-head {
        position: relative;
        overflow: hidden;
        color: #fff;
        background: linear-gradient( 120deg, rgba(14, 42, 59, .92) 0%, rgba(18, 56, 76, .85) 55%, rgba(11, 127, 128, .78) 100% ), url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=2000&q=80') center / cover;
        padding: 4.5rem 0;
    }

        .page-head .eyebrow {
            color: #7fe3e3;
        }

        .page-head h1 {
            font-weight: 800;
            font-size: clamp(2.1rem, 4vw, 3.2rem);
            letter-spacing: -.5px;
            margin-top: .5rem;
        }

        .page-head p {
            color: rgba(255, 255, 255, .9);
            max-width: 58ch;
            margin-top: .7rem;
            font-size: 1.05rem;
        }

    .breadcrumbz {
        font-size: .85rem;
        color: rgba(255, 255, 255, .7);
    }

        .breadcrumbz a {
            color: rgba(255, 255, 255, .7);
        }

            .breadcrumbz a:hover {
                color: #fff;
            }

    /* FILTER */

    .filter-wrapper {
        margin-top: -2.2rem;
        position: relative;
        z-index: 20;
    }

    .smart-filter-bar {
        background: #fff;
        border-radius: 22px;
        border: 1px solid rgba(231, 226, 216, .9);
        box-shadow: var(--shadow-floating);
        padding: 1rem 1.4rem;
    }

    .filter-input-group {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: .4rem .7rem;
        border-right: 1px solid var(--line);
        min-height: 54px;
    }

        .filter-input-group:last-child {
            border-right: none;
        }

    .filter-icon-box {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--teal-light);
        color: var(--teal-dark);
        display: grid;
        place-items: center;
        flex-shrink: 0;
    }

    .filter-label {
        display: block;
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 700;
        color: var(--muted);
        margin-bottom: 2px;
    }

    .filter-select,
    .filter-search-input {
        border: none;
        background: transparent;
        font-size: .92rem;
        font-weight: 600;
        color: var(--navy);
        width: 100%;
        outline: none;
        padding: 0;
        cursor: pointer;
    }

        .filter-search-input::placeholder {
            color: #9baab5;
            font-weight: 400;
        }

    /* SEASON CHIPS */

    .season-chips-container {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
        padding-top: 1.2rem;
    }

    .season-chip {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .42rem 1rem;
        font-size: .84rem;
        font-weight: 600;
        color: var(--navy);
        cursor: pointer;
        transition: .2s;
    }

        .season-chip:hover {
            border-color: var(--teal);
            color: var(--teal-dark);
            background: #faf9f6;
        }

        .season-chip.active {
            background: var(--navy);
            color: #fff;
            border-color: var(--navy);
            box-shadow: 0 4px 12px rgba(14, 42, 59, .15);
        }

            .season-chip.active .chip-icon {
                filter: brightness(2);
            }

    /* RESULTS */

    .results-meta-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1.4rem 0 .8rem;
    }

    .results-counter {
        font-size: .92rem;
        color: var(--muted);
    }

        .results-counter strong {
            color: var(--navy);
            font-weight: 700;
        }

    .active-filter-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .25rem .75rem;
        font-size: .78rem;
        color: var(--navy);
        font-weight: 600;
    }

        .active-filter-badge button {
            border: none;
            background: transparent;
            color: var(--muted);
            font-size: .9rem;
            line-height: 1;
            cursor: pointer;
            padding: 0;
        }

            .active-filter-badge button:hover {
                color: #d9534f;
            }

    .reset-filters-btn {
        font-size: .82rem;
        color: var(--teal-dark);
        font-weight: 600;
        background: none;
        border: none;
        cursor: pointer;
        text-decoration: underline;
        padding: 0;
    }

    /* DESTINATION CARD */

    .dest-card-lg {
        position: relative;
        border-radius: var(--r);
        overflow: hidden;
        height: 390px;
        box-shadow: var(--shadow-sm);
        transition: .4s cubic-bezier(.16, 1, .3, 1);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 1.8rem;
        text-decoration: none;
    }

        .dest-card-lg:hover {
            transform: translateY(-7px);
            box-shadow: var(--shadow-md);
        }

        .dest-card-lg img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .7s cubic-bezier(.16, 1, .3, 1);
        }

        .dest-card-lg:hover img {
            transform: scale(1.08);
        }

        .dest-card-lg::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 180deg, rgba(14, 42, 59, .05) 15%, rgba(14, 42, 59, .4) 50%, rgba(14, 42, 59, .92) 100% );
        }

    .dest-card-top-badges {
        position: absolute;
        top: 1.2rem;
        left: 1.2rem;
        right: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 3;
    }

    .badge-country {
        background: rgba(14, 42, 59, .7);
        backdrop-filter: blur(8px);
        color: #fff;
        font-size: .75rem;
        font-weight: 700;
        padding: .32rem .8rem;
        border-radius: 999px;
        letter-spacing: .02em;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border: 1px solid rgba(255, 255, 255, .15);
    }

    .badge-season {
        background: rgba(255, 255, 255, .9);
        color: var(--navy);
        font-size: .72rem;
        font-weight: 700;
        padding: .3rem .75rem;
        border-radius: 999px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .12);
    }

    .dest-content {
        position: relative;
        z-index: 2;
        color: #fff;
    }

    .dest-tag {
        display: inline-block;
        background: rgba(15, 163, 163, .35);
        border: 1px solid rgba(127, 227, 227, .4);
        backdrop-filter: blur(6px);
        color: #7fe3e3;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .12em;
        padding: .22rem .7rem;
        border-radius: 999px;
        margin-bottom: .45rem;
    }

    .dest-content h3 {
        font-family: 'Sora', sans-serif;
        font-weight: 800;
        font-size: 1.6rem;
        margin: 0 0 .3rem;
        color: #fff;
        letter-spacing: -.4px;
    }

    .dest-content p {
        font-size: .88rem;
        color: rgba(255, 255, 255, .86);
        margin: 0 0 1rem;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .dest-meta-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid rgba(255, 255, 255, .2);
        padding-top: .75rem;
        font-size: .82rem;
        color: rgba(255, 255, 255, .9);
    }

        .dest-meta-line b {
            color: #7fe3e3;
            font-family: 'Sora';
            font-size: .95rem;
        }

    .btn-dest-explore {
        background: rgba(255, 255, 255, .92);
        color: var(--navy);
        font-size: .78rem;
        font-weight: 700;
        padding: .4rem .9rem;
        border-radius: 999px;
        transition: .2s;
    }

    .dest-card-lg:hover .btn-dest-explore {
        background: var(--teal);
        color: #fff;
    }

    /* EMPTY STATE */

    #empty-state {
        background: #fff;
        border-radius: var(--r);
        padding: 3.5rem 1.5rem;
        text-align: center;
        border: 1px dashed var(--line);
        display: none;
    }

    /* CURATED BANNER */

    .curated-banner {
        background: linear-gradient(135deg, var(--navy) 0%, #164660 100%);
        border-radius: 24px;
        padding: 2.8rem 3rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        margin-top: 4rem;
    }

        .curated-banner::before {
            content: "";
            position: absolute;
            right: -40px;
            bottom: -40px;
            width: 260px;
            height: 260px;
            background: radial-gradient( circle, rgba(15, 163, 163, .3) 0%, rgba(15, 163, 163, 0) 70% );
            border-radius: 50%;
        }

    /* REGION HIGHLIGHT */

    .region-box {
        background: #fff;
        border-radius: var(--r);
        border: 1px solid rgba(231, 226, 216, .7);
        padding: 2.5rem;
        box-shadow: var(--shadow-sm);
        margin-top: 3.5rem;
    }

    .region-stat {
        border-right: 1px solid var(--line);
        padding: 1rem 1.5rem;
        text-align: center;
    }

        .region-stat:last-child {
            border-right: none;
        }

        .region-stat .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 2.2rem;
            color: var(--navy);
            line-height: 1;
        }

        .region-stat .label {
            font-size: .85rem;
            color: var(--muted);
            margin-top: .3rem;
        }

    /* FOOTER */

    footer {
        background: var(--navy);
        color: rgba(255, 255, 255, .72);
        padding: 4rem 0 2rem;
        margin-top: 4.5rem;
    }

        footer .brand {
            color: #fff;
        }

        footer h6 {
            color: #fff;
            font-family: 'Sora';
            font-weight: 600;
            letter-spacing: .02em;
            margin-bottom: 1rem;
        }

        footer a {
            color: rgba(255, 255, 255, .72);
            display: block;
            margin-bottom: .55rem;
            font-size: .92rem;
        }

            footer a:hover {
                color: #7fe3e3;
            }

    .foot-social a {
        display: inline-grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .08);
        margin-right: .5rem;
    }

        .foot-social a:hover {
            background: var(--teal);
        }

    .foot-bottom {
        border-top: 1px solid rgba(255, 255, 255, .12);
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        font-size: .85rem;
    }

    /* RESPONSIVE */

    @@media (max-width: 991px) {
        .filter-input-group {
            border-right: none;
            border-bottom: 1px solid var(--line);
            padding: .7rem 0;
        }

        .dest-card-lg {
            height: 330px;
        }

        .region-stat {
            border-right: none;
            border-bottom: 1px solid var(--line);
            padding: 1rem;
        }

            .region-stat:last-child {
                border-bottom: none;
            }

        .curated-banner {
            padding: 2rem;
        }
    }
</style>

@await Component.InvokeAsync("_DestinationPageHead")
@await Component.InvokeAsync("_DestinationFilter")


<!-- DESTINATIONS GRID -->

<section class="py-4">

    <div class="container">
        @await Component.InvokeAsync("_DestinationDestinations")

        @await Component.InvokeAsync("_DestinationEmptyState")

       
        @await Component.InvokeAsync("_DestinationCuratedSeasonalPromotion")
       
        @await Component.InvokeAsync("_DestinationStats")
        

    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    let currentSeason = 'all';

    function selectSeason(season, element) {
    currentSeason = season;

    document
    .querySelectorAll('.season-chip')
    .forEach(el => el.classList.remove('active'));

    element.classList.add('active');

    applyAllFilters();
    }

    function applyAllFilters() {
    const searchQuery = document
    .getElementById('searchInput')
    .value
    .trim()
    .toLowerCase();

    const selectedCountry =
    document.getElementById('countrySelect').value;

    const selectedTheme =
    document.getElementById('themeSelect').value;

    const items = document.querySelectorAll('.dest-item');

    let visibleCount = 0;

    items.forEach(item => {
    const itemCountry =
    item.getAttribute('data-country');

    const itemTheme =
    item.getAttribute('data-theme').split(',');

    const itemSeason =
    item.getAttribute('data-season').split(',');

    const itemName =
    item.getAttribute('data-name').toLowerCase();

    const matchesSearch =
    !searchQuery || itemName.includes(searchQuery);

    const matchesCountry =
    selectedCountry === 'all' ||
    itemCountry === selectedCountry;

    const matchesTheme =
    selectedTheme === 'all' ||
    itemTheme.includes(selectedTheme);

    const matchesSeason =
    currentSeason === 'all' ||
    itemSeason.includes(currentSeason);

    if (
    matchesSearch &&
    matchesCountry &&
    matchesTheme &&
    matchesSeason
    ) {
    item.style.display = 'block';
    visibleCount++;
    } else {
    item.style.display = 'none';
    }
    });

    // Update counter & empty state

    document.getElementById('matchCount').innerText = visibleCount;

    const emptyState =
    document.getElementById('empty-state');

    if (visibleCount === 0) {
    emptyState.style.display = 'block';
    } else {
    emptyState.style.display = 'none';
    }

    updateBadges(
    selectedCountry,
    selectedTheme,
    searchQuery
    );
    }

    function updateBadges(country, theme, query) {
    const badgesRow =
    document.getElementById('activeBadgesRow');

    badgesRow.innerHTML = '';

    if (query) {
    badgesRow.innerHTML += `
    <span class="active-filter-badge">
    Ara: "${query}"
    <button onclick="clearSearch()">×</button>
    </span>
    `;
    }

    if (country !== 'all') {
    const select =
    document.getElementById('countrySelect');

    const label =
    select.options[select.selectedIndex].text;

    badgesRow.innerHTML += `
    <span class="active-filter-badge">
    Ülke: ${label}
    <button onclick="clearCountry()">×</button>
    </span>
    `;
    }

    if (theme !== 'all') {
    const select =
    document.getElementById('themeSelect');

    const label =
    select.options[select.selectedIndex].text;

    badgesRow.innerHTML += `
    <span class="active-filter-badge">
    Tarz: ${label}
    <button onclick="clearTheme()">×</button>
    </span>
    `;
    }

    if (currentSeason !== 'all') {
    const seasonNames = {
    ilkbahar: '🌸 İlkbahar',
    yaz: '☀️ Yaz',
    sonbahar: '🍂 Sonbahar',
    kis: '❄️ Kış'
    };

    badgesRow.innerHTML += `
    <span class="active-filter-badge">
    ${seasonNames[currentSeason]}
    <button onclick="clearSeason()">×</button>
    </span>
    `;
    }

    if (badgesRow.innerHTML !== '') {
    badgesRow.innerHTML += `
    <button class="reset-filters-btn ms-2"
    onclick="resetFilters()">
    Tümünü Sıfırla
    </button>
    `;
    }
    }

    function clearSearch() {
    document.getElementById('searchInput').value = '';
    applyAllFilters();
    }

    function clearCountry() {
    document.getElementById('countrySelect').value = 'all';
    applyAllFilters();
    }

    function clearTheme() {
    document.getElementById('themeSelect').value = 'all';
    applyAllFilters();
    }

    function clearSeason() {
    currentSeason = 'all';

    document
    .querySelectorAll('.season-chip')
    .forEach(el => {
    if (el.getAttribute('data-season') === 'all') {
    el.classList.add('active');
    } else {
    el.classList.remove('active');
    }
    });

    applyAllFilters();
    }

    function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('countrySelect').value = 'all';
    document.getElementById('themeSelect').value = 'all';

    clearSeason();
    }
</script>