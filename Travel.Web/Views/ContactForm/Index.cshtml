@model List<Travel.Web.DTOs.ContactFormDtos.ResultContactFormDto>

@{
    ViewData["Title"] = "İletişim Formu";
    Layout = "~/Views/AdminLayout/Layout.cshtml";

    var total = Model?.Count ?? 0;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">İletişim Formu</h2>
            <p class="text-muted mb-0">
                İletişim sayfasındaki form alanlarını yönetin.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="ContactForm"
           asp-action="Create"
           class="btn btn-primary">
            + Yeni Form İçeriği
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Eyebrow</th>
                                <th>Başlık</th>
                                <th>Buton</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.Eyebrow
                                    </td>

                                    <td>
                                        @item.Title
                                    </td>

                                    <td>
                                        @item.ButtonText
                                    </td>

                                    <td>

                                        <a asp-action="Update"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Düzenle
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Silmek istediğinize emin misiniz?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Sil
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <p class="text-muted">
                        Henüz iletişim formu içeriği oluşturulmamış.
                    </p>
                </div>
            }

        </div>

    </div>

</div>