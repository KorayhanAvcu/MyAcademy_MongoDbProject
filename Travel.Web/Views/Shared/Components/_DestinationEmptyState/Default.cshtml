
@{
    Layout = null;
}

<!-- EMPTY STATE -->

<div id="empty-state">

    <div style="font-size: 2.8rem; margin-bottom: 1rem;">
        🧭
    </div>

    <h4 class="fw-bold mb-2">
        Aradığınız kriterlere uygun destinasyon bulunamadı
    </h4>

    <p class="text-muted mb-4"
           style="max-width: 44ch; margin: 0 auto;">
        Seçtiğiniz filtre kombinasyonu için şu anda tur bulunmuyor.
        Farklı bir sezon, ülke veya arama terimi deneyebilirsiniz.
    </p>

    <button class="btn-teal"
            onclick="resetFilters()">
        Filtreleri Temizle
    </button>

</div>