@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    Layout = null;
    var tr = new CultureInfo("tr-TR");
}

@if (Model.SimilarTours.Any())
{
    <!-- SIMILAR TOURS -->
    <div class="mt-4">
        <h2 style="font-family:'Sora';font-weight:700;font-size:1.6rem;color:var(--navy);margin-bottom:1.4rem">@L["Bunları da Beğenebilirsin"]</h2>
        <div class="row g-4">
            @foreach (var t in Model.SimilarTours)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="tour-card">
                        <div class="tour-media">
                            <img src="@t.CoverImageUrl" alt="@t.Name" loading="lazy" />
                            @if (t.IsBestSeller)
                            {
                                <span class="tour-badge">@L["Çok Satan"]</span>
                            }
                            else if (t.IsNew)
                            {
                                <span class="tour-badge">@L["Yeni"]</span>
                            }
                        </div>
                        <div class="tour-body">
                            <div class="tour-country">@t.DestinationName</div>
                            <h3 class="tour-title">@t.Name</h3>
                            <div class="tour-meta">
                                <span>🗓️ @t.DurationDays @L["Gün"] / @t.DurationNights @L["Gece"]</span>
                                @if (t.ReviewCount > 0)
                                {
                                    <span><span class="star">★</span> @t.AverageRating.ToString("0.0") <span style="color:var(--muted)">(@t.ReviewCount)</span></span>
                                }
                            </div>
                            <div class="tour-foot">
                                <div class="price"><small>@L["Kişi başı"]</small><b>@t.Price.ToString("N0", tr) <span>TL</span></b></div>
                                <a asp-controller="Tours" asp-action="TourDetail" asp-route-id="@t.Id" class="btn-incele">@L["Turu İncele"]</a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    </div>
}
