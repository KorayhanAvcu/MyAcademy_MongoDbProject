@model Travel.Web.DTOs.ContactPageHeadDtos.ResultContactPageHeadDto

@{
    Layout = null;
}

@if (Model != null)
{
    <!-- PAGE HEAD -->

    <header class="page-head">

        <div class="container">

            <!-- BREADCRUMB -->

            <div class="breadcrumbz mb-3">

                <a href="/">
                    Ana Sayfa
                </a>

                · @Model.Breadcrumb

            </div>


            <!-- EYEBROW -->

            <div class="eyebrow">
                @Model.Eyebrow
            </div>


            <!-- TITLE -->

            <h1>
                @Model.Title
            </h1>


            <!-- DESCRIPTION -->

            <p>
                @Model.Description
            </p>

        </div>

    </header>
}