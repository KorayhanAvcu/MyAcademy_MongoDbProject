@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    Layout = null;
    var paragraphs = (Model.Description ?? Model.ShortDescription ?? "")
        .Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
}

<!-- ABOUT -->
<div class="content-block">
    <h2>@L["Tur Hakkında"]</h2>

    @if (!string.IsNullOrWhiteSpace(Model.ShortDescription) && Model.ShortDescription != Model.Description)
    {
        <p><b>@Model.ShortDescription</b></p>
    }

    @foreach (var paragraph in paragraphs)
    {
        <p>@paragraph</p>
    }
</div>
