@model List<Travel.Web.DTOs.AboutStatDtos.AboutStatResultDto>

@{
    Layout = null;
}

@if (Model != null && Model.Any())
{
    <div class="stats-grid">

        @foreach (var item in Model)
        {
            <div class="stat-box">

                <div class="num">
                    @item.Number
                </div>

                <div class="desc">
                    @item.Description
                </div>

            </div>
        }

    </div>
}