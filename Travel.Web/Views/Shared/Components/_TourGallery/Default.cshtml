        <div class="col-lg-6">

            <div class="row">

                <!-- IMAGE 1 -->
                <div class="col-6">

                    <div class="g-wrap">

                        <img class="g-img g-small"
                             src="https://images.unsplash.com/photo-1523906834658-6e24ef2386f9?auto=format&fit=crop&w=600&q=80"
