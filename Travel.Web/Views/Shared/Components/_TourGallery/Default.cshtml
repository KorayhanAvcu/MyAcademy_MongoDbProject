@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    Layout = null;

    // Kapak görseli + galeri; boş olanlar elenir.
    var images = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl)) images.Add(Model.CoverImageUrl);
    images.AddRange(Model.GalleryImages.Where(x => !string.IsNullOrWhiteSpace(x) && x != Model.CoverImageUrl));

    var main = images.FirstOrDefault();
    var small = images.Skip(1).Take(4).ToList();
    var more = images.Count - 1 - small.Count;
}

@if (main != null)
{
    <!-- GALLERY -->
    <div class="gallery">
        <div class="row">
            <div class="@(small.Any() ? "col-lg-6" : "col-12")">
                <div class="g-wrap">
                    <img class="g-img g-main" src="@main" alt="@Model.Name" />
                </div>
            </div>

            @if (small.Any())
            {
                <div class="col-lg-6">
                    <div class="row">
                        @for (var i = 0; i < small.Count; i++)
                        {
                            <div class="col-6">
                                <div class="g-wrap">
                                    <img class="g-img g-small" src="@small[i]" alt="@Model.Name" loading="lazy" />
                                    @if (i == small.Count - 1 && more > 0)
                                    {
                                        <span class="g-more">+@more @L["fotoğraf"]</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
