
@{
    Layout = null;
}

<!-- TEAM -->
<div class="mb-5">
    <div class="text-center max-w-600 mx-auto mb-4">
        <div class="eyebrow">Yönetim &amp; Rehber Kadrosu</div>
        <h2 style="font-family:'Sora';font-weight:700;font-size:2rem;color:var(--navy);margin-top:.4rem">Arkasındaki Ekip</h2>
        <p style="color:var(--muted);font-size:.95rem">Seyahatlerinizin kusursuz geçmesi için 7/24 çalışan tecrübeli uzmanlarımız.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="team-member">
                <img alt="Murat Yücedağ" src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg" />
                <div class="team-info">
                    <h5>Murat Yücedağ</h5>
                    <div class="role">Kurucu &amp; Operasyon Direktörü</div>
                    <p>15 yıllık uluslararası turizm deneyimiyle operasyon süreçlerini yönetiyor.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="team-member">
                <img alt="Selin Karaca" src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg" />
                <div class="team-info">
                    <h5>Selin Karaca</h5>
                    <div class="role">Rota &amp; Deneyim Tasarımcısı</div>
                    <p>Gastronomi ve kültür rotalarını yerinde deneyimleyerek tasarlar.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="team-member">
                <img alt="Emre Demir" src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg" />
                <div class="team-info">
                    <h5>Emre Demir</h5>
                    <div class="role">Baş Rehber (İtalya &amp; Fransa)</div>
                    <p>Sanat tarihi uzmanı ve 10 yıldır İtalya rotalarının daimi rehberi.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="team-member">
                <img alt="Melis Arda" src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg" />
                <div class="team-info">
                    <h5>Melis Arda</h5>
                    <div class="role">Misafir İlişkileri Yöneticisi</div>
                    <p>Tur öncesi ve seyahat boyunca misafirlerimizin tüm sorularını yanıtlar.</p>
                </div>
            </div>
        </div>
    </div>
</div>