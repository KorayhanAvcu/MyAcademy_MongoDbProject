@model List<Travel.Web.DTOs.AboutTeamMemberDtos.AboutTeamMemberResultDto>

@{
    Layout = null;
}

<!-- TEAM -->
<div class="mb-5">

    <div class="text-center max-w-600 mx-auto mb-4">

        <div class="eyebrow">
            Yönetim &amp; Rehber Kadrosu
        </div>

        <h2 style="font-family:'Sora';font-weight:700;font-size:2rem;color:var(--navy);margin-top:.4rem">
            Arkasındaki Ekip
        </h2>

        <p style="color:var(--muted);font-size:.95rem">
            Seyahatlerinizin kusursuz geçmesi için 7/24 çalışan tecrübeli uzmanlarımız.
        </p>

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-3">

                    <div class="team-member">

                        <img src="@item.ImageUrl"
                             alt="@item.Name" />

                        <div class="team-info">

                            <h5>
                                @item.Name
                            </h5>

                            <div class="role">
                                @item.Role
                            </div>

                            <p>
                                @item.MemberDescription
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>