
@{
    Layout = null;
}

<!-- DETAIL HEADER -->
<div class="detail-head">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

        <div>

            <div class="cat-line">
                İtalya · Kültür Turu
            </div>

            <h1>
                Roma & Toskana Keşfi
            </h1>

            <div class="head-meta">

                <span class="rating">
                    <span class="star">★</span>
                    4.8
                </span>

                <span>
                    1.687 değerlendirme
                </span>

                <span class="dot-sep"></span>

                <span>
                    6 Gün / 5 Gece
                </span>

                <span class="dot-sep"></span>

                <span>
                    Roma · Floransa · Pisa · Toskana
                </span>

            </div>

        </div>


        <!-- ACTIONS -->
        <div class="head-actions">

            <button class="icon-btn"
                    id="favBtn"
                    onclick="this.classList.toggle('on')">

                <svg width="17"
                     height="17"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" />

                </svg>

                Kaydet

            </button>


            <button class="icon-btn"
                    onclick="sharePage()">

                <svg width="17"
                     height="17"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <circle cx="18" cy="5" r="3" />

                    <circle cx="6" cy="12" r="3" />

                    <circle cx="18" cy="19" r="3" />

                    <line x1="8.6"
                          y1="13.5"
                          x2="15.4"
                          y2="17.5" />

                    <line x1="15.4"
                          y1="6.5"
                          x2="8.6"
                          y2="10.5" />

                </svg>

                Paylaş

            </button>

        </div>

    </div>

</div>