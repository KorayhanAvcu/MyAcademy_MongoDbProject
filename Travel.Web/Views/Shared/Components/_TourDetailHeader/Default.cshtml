@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    Layout = null;
    var location = string.Join(" · ", new[] { Model.CountryName, Model.CategoryName }.Where(x => !string.IsNullOrWhiteSpace(x)));
}

<!-- DETAIL HEADER -->
<div class="detail-head">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <div class="cat-line">@location</div>

            <h1>@Model.Name</h1>

            <div class="head-meta">
                <span class="rating">
                    <span class="star">★</span>
                    @(Model.ReviewCount > 0 ? Model.AverageRating.ToString("0.0") : "–")
                </span>
                <span>@Model.ReviewCount @L["değerlendirme"]</span>

                <span class="dot-sep"></span>
                <span>@Model.DurationDays @L["Gün"] / @Model.DurationNights @L["Gece"]</span>

                @if (!string.IsNullOrWhiteSpace(Model.RouteText))
                {
                    <span class="dot-sep"></span>
                    <span>@Model.RouteText</span>
                }
            </div>
        </div>

        <!-- ACTIONS -->
        <div class="head-actions">
            <button type="button"
                    class="icon-btn @(Model.IsFavorite ? "on" : "")"
                    id="favBtn"
                    data-tour-id="@Model.Id"
                    onclick="toggleFavorite(this)">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" />
                </svg>
                <span class="fav-label">@(Model.IsFavorite ? L["Favorilerde"] : L["Kaydet"])</span>
            </button>

            <button type="button" class="icon-btn" onclick="sharePage()">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="18" cy="5" r="3" />
                    <circle cx="6" cy="12" r="3" />
                    <circle cx="18" cy="19" r="3" />
                    <line x1="8.6" y1="13.5" x2="15.4" y2="17.5" />
                    <line x1="15.4" y1="6.5" x2="8.6" y2="10.5" />
                </svg>
                @L["Paylaş"]
            </button>
        </div>
    </div>
</div>
