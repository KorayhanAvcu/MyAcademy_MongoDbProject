@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    Layout = null;
    var isAuth = User.Identity?.IsAuthenticated == true;

    string Initials(string? name) => string.Concat((string.IsNullOrWhiteSpace(name) ? "M" : name)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpper(x[0])));
}

<!-- Q&A -->
<div class="content-block" id="sorular">
    <h2>@L["Tur Hakkında Sorular"]</h2>

    @if (!Model.Questions.Any())
    {
        <p>@L["Henüz cevaplanmış bir soru yok."]</p>
    }

    @foreach (var q in Model.Questions)
    {
        <div class="qa-item">
            <div class="qa-q">
                <span class="qa-avatar">@Initials(q.UserName)</span>
                <div>
                    <div class="who">@(string.IsNullOrWhiteSpace(q.UserName) ? L["Misafir"] : q.UserName)</div>
                    <div class="txt">@q.QuestionText</div>
                </div>
            </div>
            <div class="qa-a">
                <span class="brand-mini">Travelio</span>
                <span class="txt">@q.Answer</span>
            </div>
        </div>
    }

    <div class="ask-box">
        <div class="book-label" style="margin-top:0">@L["Bu tur hakkında merak ettiğin bir şey mi var?"]</div>

        @if (isAuth)
        {
            <form asp-controller="Tours" asp-action="AskQuestion" method="post">
                <input type="hidden" name="TourId" value="@Model.Id" />
                <textarea name="QuestionText" placeholder="@L["Sorunu yaz..."]" required minlength="5" maxlength="500"></textarea>
                <button type="submit" class="btn-teal mt-3">@L["Soru Gönder"]</button>
            </form>
        }
        else
        {
            <a class="btn-teal" asp-controller="Auth" asp-action="SignIn">@L["Soru sormak için giriş yap"]</a>
        }
    </div>
</div>
