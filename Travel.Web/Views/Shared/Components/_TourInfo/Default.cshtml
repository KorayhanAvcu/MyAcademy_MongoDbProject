@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    Layout = null;

    var cells = new List<(string Key, string? Value)>
    {
        ("Tur Süresi", $"{Model.DurationDays} {L["Gün"].Value} / {Model.DurationNights} {L["Gece"].Value}"),
        ("Destinasyon", string.Join(", ", new[] { Model.CityName, Model.CountryName }.Where(x => !string.IsNullOrWhiteSpace(x)))),
        ("Başlangıç Şehri", Model.DepartureCity),
        ("Ulaşım", Model.Transportation),
        ("Konaklama", Model.Accommodation),
        ("Rehber Dili", Model.GuideLanguage),
        ("Grup Büyüklüğü", Model.MaxCapacity > 0 ? $"{L["Maks."].Value} {Model.MaxCapacity} {L["Kişi"].Value}" : null),
        ("Vize", Model.VisaInfo)
    };
}

<!-- INFO -->
<div class="content-block">
    <h2>@L["Tur Bilgileri"]</h2>

    <div class="info-grid">
        @foreach (var cell in cells.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
        {
            <div class="info-cell">
                <div class="k">@L[cell.Key]</div>
                <div class="v">@cell.Value</div>
            </div>
        }
    </div>
</div>
