@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    Layout = null;
    var includes = Model.Includes.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
    var excludes = Model.Excludes.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
}

@if (includes.Any() || excludes.Any())
{
    <!-- INCLUDES -->
    <div class="content-block">
        <div class="row g-4">
            <div class="col-md-6">
                <h2>@L["Fiyata Dahil Olanlar"]</h2>
                <ul class="inc-list">
                    @foreach (var item in includes)
                    {
                        <li>
                            <span class="inc-yes">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                            </span>
                            @item
                        </li>
                    }
                </ul>
            </div>

            <div class="col-md-6">
                <h2>@L["Fiyata Dahil Olmayanlar"]</h2>
                <ul class="inc-list">
                    @foreach (var item in excludes)
                    {
                        <li>
                            <span class="inc-no">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                            </span>
                            @item
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}
