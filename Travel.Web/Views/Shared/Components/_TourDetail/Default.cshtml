@{
    Layout = null;
}

<div class="container">

    <!-- BREADCRUMB -->
    <div class="crumb">

        <a href="index.html">
            Ana Sayfa
        </a>

        /

        <a href="tours.html">
            Turlar
        </a>

        /

        <span class="cur">
            Roma & Toskana Keşfi
        </span>

    </div>


    @await Component.InvokeAsync("_TourDetailHeader")

    @await Component.InvokeAsync("_TourGallery")
    

</div>


