@model Travel.Web.DTOs.TourDtos.TourDetailDto

@{
    Layout = null;
}

<div class="container">

    @await Component.InvokeAsync("_TourBreadcrumb", new { model = Model })

    @await Component.InvokeAsync("_TourDetailHeader", new { model = Model })

    @await Component.InvokeAsync("_TourGallery", new { model = Model })

</div>

<div class="container body-section">

    <div class="row g-4">

        <div class="col-lg-8">

            @await Component.InvokeAsync("_TourAbout", new { model = Model })

            @await Component.InvokeAsync("_TourHighlights", new { model = Model })

            @await Component.InvokeAsync("_TourItinerary", new { model = Model })

            @await Component.InvokeAsync("_TourIncludes", new { model = Model })

            @await Component.InvokeAsync("_TourInfo", new { model = Model })

            @await Component.InvokeAsync("_TourComments", new { model = Model })

            @await Component.InvokeAsync("_TourQuestions", new { model = Model })

        </div>

        <div class="col-lg-4">

            @await Component.InvokeAsync("_TourBooking", new { model = Model })

        </div>

    </div>

    @await Component.InvokeAsync("_TourSimilar", new { model = Model })

</div>