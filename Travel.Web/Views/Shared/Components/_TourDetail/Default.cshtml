@{
    Layout = null;
}

<div class="container">

    @await Component.InvokeAsync("_TourBreadcrumb")

    @await Component.InvokeAsync("_TourDetailHeader")

    @await Component.InvokeAsync("_TourGallery")
    
</div>


<!-- BODY -->
<div class="container body-section">

    <div class="row g-4">

        <!-- LEFT -->
        <div class="col-lg-8">
            @await Component.InvokeAsync("_TourAbout")

            @await Component.InvokeAsync("_TourHighlights")
            
            @await Component.InvokeAsync("_TourItinerary")

            @await Component.InvokeAsync("_TourIncludes")

            @await Component.InvokeAsync("_TourInfo")
            
            <!-- COMMENTS -->
            @await Component.InvokeAsync("_TourComments")

            <!-- QUESTIONS -->
            @await Component.InvokeAsync("_TourQuestions")

        </div>

        <!-- BOOKING -->
        @await Component.InvokeAsync("_TourBooking")

    </div>

</div>