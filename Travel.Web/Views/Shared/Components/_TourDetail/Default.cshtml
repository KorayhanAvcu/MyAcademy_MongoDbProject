@model Travel.Web.DTOs.TourDtos.TourDetailDto

@{
    Layout = null;
}

<div class="container">

    @await Component.InvokeAsync("_TourBreadcrumb", Model)

    @await Component.InvokeAsync("_TourDetailHeader", Model)

    @await Component.InvokeAsync("_TourGallery", Model)

</div>

<div class="container body-section">

    <div class="row g-4">

        <div class="col-lg-8">

            @await Component.InvokeAsync("_TourAbout", Model)

            @await Component.InvokeAsync("_TourHighlights", Model)

            @await Component.InvokeAsync("_TourItinerary", Model)

            @await Component.InvokeAsync("_TourIncludes", Model)

            @await Component.InvokeAsync("_TourInfo", Model)

            @await Component.InvokeAsync("_TourComments", Model)

            @await Component.InvokeAsync("_TourQuestions", Model)

        </div>

        <div class="col-lg-4">

            @await Component.InvokeAsync("_TourBooking", Model)

        </div>

    </div>

</div>