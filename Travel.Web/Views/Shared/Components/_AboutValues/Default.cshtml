@model List<Travel.Web.DTOs.AboutValueDtos.AboutValueResultDto>

@{
    Layout = null;
}

<!-- VALUES -->
<div class="mb-5">

    <div class="text-center max-w-600 mx-auto mb-4">

        <div class="eyebrow">
            İlkelerimiz
        </div>

        <h2 style="font-family:'Sora';font-weight:700;font-size:2rem;color:var(--navy);margin-top:.4rem">
            Bizi Farklı Kılan Değerlerimiz
        </h2>

        <p style="color:var(--muted);font-size:.95rem">
            Misafirlerimize her adımda güven veren çalışma prensiplerimiz.
        </p>

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-4">

                    <div class="value-card">

                        <div class="value-ico">

                            @switch (item.Icon)
                            {
                                case "clock":
                                    <svg fill="none"
                                         height="24"
                                         stroke="currentColor"
                                         stroke-width="2.2"
                                         viewBox="0 0 24 24"
                                         width="24">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <path d="M12 6v6l4 2"></path>
                                    </svg>
                                    break;

                                case "shield":
                                    <svg fill="none"
                                         height="24"
                                         stroke="currentColor"
                                         stroke-width="2.2"
                                         viewBox="0 0 24 24"
                                         width="24">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    </svg>
                                    break;

                                case "users":
                                    <svg fill="none"
                                         height="24"
                                         stroke="currentColor"
                                         stroke-width="2.2"
                                         viewBox="0 0 24 24"
                                         width="24">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    break;

                                case "heart":
                                    <svg fill="none"
                                         height="24"
                                         stroke="currentColor"
                                         stroke-width="2.2"
                                         viewBox="0 0 24 24"
                                         width="24">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"></path>
                                    </svg>
                                    break;

                                case "globe":
                                    <svg fill="none"
                                         height="24"
                                         stroke="currentColor"
                                         stroke-width="2.2"
                                         viewBox="0 0 24 24"
                                         width="24">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="2" y1="12" x2="22" y2="12"></line>
                                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                                    </svg>
                                    break;

                                case "star":
                                    <svg fill="none"
                                         height="24"
                                         stroke="currentColor"
                                         stroke-width="2.2"
                                         viewBox="0 0 24 24"
                                         width="24">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                    </svg>
                                    break;

                                case "check":
                                    <svg fill="none"
                                         height="24"
                                         stroke="currentColor"
                                         stroke-width="2.2"
                                         viewBox="0 0 24 24"
                                         width="24">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    break;

                                case "map":
                                    <svg fill="none"
                                         height="24"
                                         stroke="currentColor"
                                         stroke-width="2.2"
                                         viewBox="0 0 24 24"
                                         width="24">
                                        <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                                        <line x1="8" y1="2" x2="8" y2="18"></line>
                                        <line x1="16" y1="6" x2="16" y2="22"></line>
                                    </svg>
                                    break;

                                case "plane":
                                    <svg fill="none"
                                         height="24"
                                         stroke="currentColor"
                                         stroke-width="2.2"
                                         viewBox="0 0 24 24"
                                         width="24">
                                        <path d="M22 2 11 13"></path>
                                        <path d="m22 2-7 20-4-9-9-4Z"></path>
                                    </svg>
                                    break;
                            }

                        </div>

                        <h4>
                            @item.ValueTitle
                        </h4>

                        <p>
                            @item.ValueDescription
                        </p>

                    </div>

                </div>
            }

        </div>
    }

</div>