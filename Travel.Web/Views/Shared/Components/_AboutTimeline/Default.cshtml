
@model List<Travel.Web.DTOs.AboutTimelineDtos.AboutTimelineResultDto>

@{
    Layout = null;
}

<!-- TIMELINE -->
<div class="timeline-wrap">

    <div class="eyebrow mb-2">
        Gelişim Yolculuğumuz
    </div>

    <h2 style="font-family:'Sora';font-weight:700;font-size:1.8rem;color:var(--navy);margin-bottom:2rem">
        Dünden Bugüne Travelio
    </h2>

    @foreach (var item in Model.OrderBy(x => x.Year))
    {
        <div class="tline-item">

            <div class="tline-year">
                @item.Year
            </div>

            <div class="tline-content">

                <h5>
                    @item.Title
                </h5>

                <p>
                    @item.Description
                </p>

            </div>

        </div>
    }

</div>

