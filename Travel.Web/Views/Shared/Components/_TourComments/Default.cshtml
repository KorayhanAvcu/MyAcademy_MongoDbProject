@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    Layout = null;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var fullStars = (int)Math.Round(Model.AverageRating);

    string Initials(string? name) => string.Concat((name ?? "?")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpper(x[0])));
}

<!-- REVIEWS -->
<div class="content-block" id="yorumlar">
    <h2>@L["Misafir Yorumları"]</h2>

    <div class="rev-summary mb-3">
        <div class="rev-score">
            <div class="num">@(Model.ReviewCount > 0 ? Model.AverageRating.ToString("0.0") : "–")</div>
            <div class="stars">
                @for (var i = 1; i <= 5; i++)
                {
                    if (i <= fullStars) { <text>★</text> } else { <span style="color:#d8cfc0">★</span> }
                }
            </div>
            <div class="cnt">@Model.ReviewCount @L["değerlendirme"]</div>
        </div>

        <div class="rev-bars">
            @for (var star = 5; star >= 1; star--)
            {
                var pct = Model.RatingDistribution[star - 1];
                <div class="bar-row">
                    <span class="lab">@star @L["yıldız"]</span>
                    <div class="bar-track"><div class="bar-fill" style="width:@pct%"></div></div>
                    <span class="pct">%@pct</span>
                </div>
            }
        </div>
    </div>

    @if (!Model.Reviews.Any())
    {
        <p>@L["Bu tur için henüz yorum yapılmadı. İlk yorumu sen yap!"]</p>
    }

    @foreach (var review in Model.Reviews)
    {
        <div class="review-card">
            <div class="rev-user">
                @if (!string.IsNullOrWhiteSpace(review.UserImageUrl))
                {
                    <img src="@review.UserImageUrl" alt="" />
                }
                else
                {
                    <span class="qa-avatar" style="width:44px;height:44px">@Initials(review.UserName)</span>
                }
                <div>
                    <b>@review.UserName</b>
                    <span class="sub">@review.CreatedAt?.ToLocalTime().ToString("d MMMM yyyy")</span>
                </div>
                <span class="rev-stars">
                    @for (var i = 1; i <= 5; i++)
                    {
                        if (i <= review.Rating) { <text>★</text> } else { <span class="off">★</span> }
                    }
                </span>
            </div>
            <p>@review.Comment</p>
        </div>
    }

    <div class="write-box">
        <div>
            <b>@L["Bu Tura Katıldın mı?"]</b>
            <p>@L["Deneyimini diğer gezginlerle paylaş."]</p>
        </div>

        @if (!isAuth)
        {
            <a class="btn-teal" asp-controller="Auth" asp-action="SignIn">@L["Yorum için giriş yap"]</a>
        }
        else if (Model.HasReviewed)
        {
            <span class="btn-teal" style="opacity:.6;cursor:default">@L["Yorumun alındı"]</span>
        }
        else
        {
            <button type="button" class="btn-teal" data-bs-toggle="modal" data-bs-target="#reviewModal">@L["Yorum Yaz"]</button>
        }
    </div>
</div>
