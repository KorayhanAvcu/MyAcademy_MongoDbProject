@model List<Travel.Web.DTOs.ContactCardDtos.ResultContactCardDto>

@{
    Layout = null;
}

<div class="contact-cards-row">

    <div class="row g-4">

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-3">

                    <div class="c-box">

                        <div class="c-ico">

                            @if (item.Icon == "phone")
                            {
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2
                                                         19.79 19.79 0 0 1-8.63-3.07
                                                         19.5 19.5 0 0 1-6-6
                                                         19.79 19.79 0 0 1-3.07-8.67
                                                         A2 2 0 0 1 4.11 2h3a2 2 0 0 1
                                                         2 1.72 12.84 12.84 0 0 0 .7 2.81
                                                         2 2 0 0 1-.45 2.11L8.09 9.91
                                                         a16 16 0 0 0 6 6l1.27-1.27
                                                         a2 2 0 0 1 2.11-.45
                                                         12.84 12.84 0 0 0 2.81.7
                                                         A2 2 0 0 1 22 16.92z">
                                    </path>
                                </svg>
                            }
                            else if (item.Icon == "email")
                            {
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12
                                                         c0 1.1-.9 2-2 2H4
                                                         c-1.1 0-2-.9-2-2V6
                                                         c0-1.1.9-2 2-2z">
                                    </path>

                                    <polyline points="22,6 12,13 2,6">
                                    </polyline>
                                </svg>
                            }
                            else if (item.Icon == "whatsapp")
                            {
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">
                                    <path d="M21 11.5a8.38 8.38 0 0 1-9
                                                         8.5 8.3 8.3 0 0 1-4-.9
                                                         L3 21l1.9-4.6A8.35 8.35 0 0 1
                                                         3 11.5 8.5 8.5 0 1 1 21 11.5z">
                                    </path>

                                    <path d="M8 9.5c.2 2 2.2 4 4.2 4.5
                                                         .7.2 1.4-.1 1.8-.6l.5-.7
                                                         c.2-.3.1-.7-.2-.9l-1.4-.7
                                                         c-.3-.2-.7-.1-.9.2l-.4.5
                                                         c-.9-.4-1.6-1.1-2-2l.5-.4
                                                         c.3-.2.4-.6.2-.9l-.7-1.4
                                                         c-.2-.3-.6-.4-.9-.2l-.7.5
                                                         c-.4.4-.6.9-.5 1.4z">
                                    </path>
                                </svg>
                            }
                            else if (item.Icon == "location")
                            {
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8">
                                    <path d="M21 10c0 7-9 12-9 12
                                                         S3 17 3 10a9 9 0 1 1 18 0z">
                                    </path>

                                    <circle cx="12"
                                            cy="10"
                                            r="3">
                                    </circle>
                                </svg>
                            }

                        </div>

                        <h4>
                            @item.Title
                        </h4>

                        <p>
                            @item.Description
                        </p>

                        <a href="@item.LinkUrl"
                           class="c-link">
                            @item.LinkText
                        </a>

                    </div>

                </div>
            }
        }

    </div>

</div>