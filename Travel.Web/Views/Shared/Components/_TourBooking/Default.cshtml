@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    Layout = null;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var firstAvailable = Model.TourDates.FirstOrDefault(x => x.RemainingCapacity > 0);
}

<!-- RIGHT: BOOKING -->
<div class="book-sticky">
    <div class="book-card">
        <div class="price-top">
            <small>@L["Kişi başı"]</small>
            <div class="big">@Model.Price.ToString("N0", new CultureInfo("tr-TR")) <span>TL</span></div>
            <div class="price-note">@L["Çocuk (2-11 yaş)"]: @Model.ChildPrice.ToString("N0", new CultureInfo("tr-TR")) TL</div>
        </div>

        <form asp-controller="Tours" asp-action="Reserve" method="post" id="reserveForm">
            <input type="hidden" name="TourId" value="@Model.Id" />
            <input type="hidden" name="AdultCount" id="adultInput" value="2" />
            <input type="hidden" name="ChildCount" id="childInput" value="0" />

            <div class="book-label">@L["Tur Tarihi"]</div>

            <div id="dateOptions">
                @if (!Model.TourDates.Any())
                {
                    <p style="color:var(--muted);font-size:.9rem">@L["Şu anda satışta tarih bulunmuyor."]</p>
                }

                @foreach (var date in Model.TourDates)
                {
                    var full = date.RemainingCapacity <= 0;
                    var selected = firstAvailable != null && date.Id == firstAvailable.Id;

                    <label class="date-opt @(selected ? "sel" : "") @(full ? "full" : "")"
                           data-remaining="@date.RemainingCapacity"
                           style="@(full ? "opacity:.5;cursor:not-allowed" : "")">
                        <span class="d">@date.StartDate.ToString("d MMM") - @date.EndDate.ToString("d MMM yyyy")</span>
                        <input type="radio" name="TourDateId" value="@date.Id" @(selected ? "checked" : "") @(full ? "disabled" : "") />
                        @if (full)
                        {
                            <span class="left">@L["Kontenjan Doldu"]</span>
                        }
                        else if (date.RemainingCapacity <= 10)
                        {
                            <span class="left">@L["Son"] @date.RemainingCapacity @L["Kontenjan"]</span>
                        }
                        else
                        {
                            <span class="left" style="color:var(--muted);font-weight:500">@date.RemainingCapacity @L["kişilik yer"]</span>
                        }
                    </label>
                }
            </div>

            <div class="book-label">@L["Kişi Sayısı"]</div>
            <div class="counter-row">
                <div class="cl"><b>@L["Yetişkin"]</b><span>@L["12 yaş ve üzeri"]</span></div>
                <div class="counter">
                    <button type="button" onclick="changeCount('adult',-1)" id="adultMinus">−</button>
                    <span class="val" id="adultVal">2</span>
                    <button type="button" onclick="changeCount('adult',1)" id="adultPlus">+</button>
                </div>
            </div>
            <div class="counter-row">
                <div class="cl"><b>@L["Çocuk"]</b><span>@L["2 - 11 yaş"]</span></div>
                <div class="counter">
                    <button type="button" onclick="changeCount('child',-1)" id="childMinus">−</button>
                    <span class="val" id="childVal">0</span>
                    <button type="button" onclick="changeCount('child',1)" id="childPlus">+</button>
                </div>
            </div>

            <div class="summary">
                <div class="row-line"><span id="adultLine"></span><b id="adultSum"></b></div>
                <div class="row-line" id="childRow" style="display:none"><span id="childLine"></span><b id="childSum"></b></div>
                <div class="total"><span>@L["Toplam"]</span><b id="grandTotal"></b></div>
                <div id="capWarn" style="display:none;color:#c26a45;font-size:.8rem;font-weight:600;margin-top:.5rem"></div>
            </div>

            @if (!isAuth)
            {
                <a class="btn-teal d-block text-center" asp-controller="Auth" asp-action="SignIn">@L["Rezervasyon için giriş yap"]</a>
            }
            else if (firstAvailable == null)
            {
                <button type="button" class="btn-teal" disabled style="opacity:.5">@L["Kontenjan Yok"]</button>
            }
            else
            {
                <button type="submit" class="btn-teal" id="reserveBtn">@L["Rezervasyon Yap"]</button>
            }
        </form>

        <div class="trust">
            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg> @L["Güvenli rezervasyon"]</span>
            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg> @L["Ücretsiz ön rezervasyon"]</span>
        </div>
    </div>
</div>
