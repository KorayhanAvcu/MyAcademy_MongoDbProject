@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    Layout = null;
    var items = Model.Highlights.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
}

@if (items.Any())
{
    <!-- HIGHLIGHTS -->
    <div class="content-block">
        <h2>@L["Turun Öne Çıkanları"]</h2>

        <ul class="hl-list">
            @foreach (var item in items)
            {
                <li>
                    <span class="hl-ico">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    </span>
                    @item
                </li>
            }
        </ul>
    </div>
}
