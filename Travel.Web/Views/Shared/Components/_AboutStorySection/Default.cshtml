@model Travel.Web.DTOs.AboutStorySectionDtos.AboutStorySectionResultDto

@{
    Layout = null;
}

@if (Model != null)
{
    <div class="story-card">

        <div class="row g-4 align-items-center">

            <div class="col-lg-6">

                <span class="story-badge">

                    <svg fill="none"
                         height="15"
                         stroke="currentColor"
                         stroke-width="2.5"
                         viewbox="0 0 24 24"
                         width="15">

                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>

                    </svg>

                    @Model.Badge

                </span>

                <h2 style="font-family:'Sora';font-weight:800;font-size:clamp(1.7rem,2.8vw,2.4rem);color:var(--navy);margin-bottom:1rem;line-height:1.2">
                    @Model.Title
                </h2>

                <p style="color:var(--muted);line-height:1.75;font-size:.98rem">
                    @Model.Description
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.Description2))
                {
                    <p style="color:var(--muted);line-height:1.75;font-size:.98rem">
                        @Model.Description2
                    </p>
                }

                <div class="d-flex gap-3 mt-4">

                    @if (!string.IsNullOrWhiteSpace(Model.PrimaryButtonText))
                    {
                        <a class="btn-teal"
                           href="@Model.PrimaryButtonUrl">
                            @Model.PrimaryButtonText →
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SecondaryButtonText))
                    {
                        <a class="btn"
                           href="@Model.SecondaryButtonUrl"
                           style="border:1px solid var(--line);border-radius:999px;font-weight:600;padding:.8rem 1.4rem;color:var(--navy)">
                            @Model.SecondaryButtonText
                        </a>
                    }

                </div>

            </div>

            <div class="col-lg-6">

                <img alt="@Model.Title"
                     class="story-img"
                     src="@Model.ImageUrl" />

            </div>

        </div>

    </div>
}