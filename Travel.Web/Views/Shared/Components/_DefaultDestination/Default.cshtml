@using Travel.Web.DTOs.DestinationDtos
@model List<ResultDestinationDto>

@{
    Layout = null;
}

<!-- DESTINATIONS -->
<section id="destinasyonlar" class="dest-section">
    <div class="container">

        <div class="section-head mb-5">
            <div class="eyebrow">İlham veren şehirler</div>

            <h2>Popüler Destinasyonlar</h2>

            <p>
                Milyonlarca gezginin tekrar tekrar dönmek istediği rüya şehirler.
            </p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                <!-- 1. BÜYÜK DESTİNASYON -->
                @if (Model.Count > 0)
                {
                    <div class="col-lg-6">

                        <a class="dest-card tall" href="#">

                            <img src="@Model[0].ImageUrl"
                                 alt="@Model[0].City" />

                            <div class="dest-cap">
                                <h3>@Model[0].City</h3>

                                <span>
                                    @Model[0].Country · Keşfet
                                </span>
                            </div>

                        </a>

                    </div>
                }

                <!-- SAĞ TARAF -->
                <div class="col-lg-6">

                    <div class="row g-4">

                        <!-- 2. DESTİNASYON -->
                        @if (Model.Count > 1)
                        {
                            <div class="col-12">

                                <a class="dest-card" href="#">

                                    <img src="@Model[1].ImageUrl"
                                         alt="@Model[1].City" />

                                    <div class="dest-cap">

                                        <h3>@Model[1].City</h3>

                                        <span>
                                            @Model[1].Country · Keşfet
                                        </span>

                                    </div>

                                </a>

                            </div>
                        }

                        <!-- 3. DESTİNASYON -->
                        @if (Model.Count > 2)
                        {
                            <div class="col-md-6">

                                <a class="dest-card" href="#">

                                    <img src="@Model[2].ImageUrl"
                                         alt="@Model[2].City" />

                                    <div class="dest-cap">

                                        <h3>@Model[2].City</h3>

                                        <span>
                                            @Model[2].Country · Keşfet
                                        </span>

                                    </div>

                                </a>

                            </div>
                        }

                        <!-- 4. DESTİNASYON -->
                        @if (Model.Count > 3)
                        {
                            <div class="col-md-6">

                                <a class="dest-card" href="#">

                                    <img src="@Model[3].ImageUrl"
                                         alt="@Model[3].City" />

                                    <div class="dest-cap">

                                        <h3>@Model[3].City</h3>

                                        <span>
                                            @Model[3].Country · Keşfet
                                        </span>

                                    </div>

                                </a>

                            </div>
                        }

                        <!-- 5. DESTİNASYON -->
                        @if (Model.Count > 4)
                        {
                            <div class="col-12">

                                <a class="dest-card" href="#">

                                    <img src="@Model[4].ImageUrl"
                                         alt="@Model[4].City" />

                                    <div class="dest-cap">

                                        <h3>@Model[4].City</h3>

                                        <span>
                                            @Model[4].Country · Keşfet
                                        </span>

                                    </div>

                                </a>

                            </div>
                        }

                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p>Henüz aktif destinasyon bulunmamaktadır.</p>
            </div>
        }

    </div>
</section>