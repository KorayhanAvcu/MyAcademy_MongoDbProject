
@{
    Layout = null;
}

<div class="row g-4"
     id="destinationsContainer">

    <!-- Roma -->

    <div class="col-md-6 col-lg-4 dest-item"
         data-country="italya"
         data-name="roma italy antik kolezyum vatican"
         data-season="ilkbahar,sonbahar"
         data-theme="kultur">

        <a class="dest-card-lg"
               href="destinations-detail.html">

            <img src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg"
                 alt="Roma, İtalya" />

            <div class="dest-card-top-badges">

                <span class="badge-country">
                    🇮🇹 İtalya
                </span>

                <span class="badge-season">
                    🌸 İlkbahar / Sonbahar
                </span>

            </div>

            <div class="dest-content">

                <span class="dest-tag">
                    Tarih &amp; Yaşam
                </span>

                <h3>
                    Roma &amp; Vatikan
                </h3>

                <p>
                    Antik Roma kalıntıları, sanatla harmanlanmış sokaklar
                    ve eşsiz İtalyan lezzetleriyle yaşayan bir açık hava müzesi.
                </p>

                <div class="dest-meta-line">

                    <span>
                        <b>18 Aktif Tur</b>
                        · 4-7 Günlük
                    </span>

                    <span class="btn-dest-explore">
                        Rotaları Gör →
                    </span>

                </div>

            </div>

        </a>

    </div>

    <!-- Kyoto -->

    <div class="col-md-6 col-lg-4 dest-item"
         data-country="japonya"
         data-name="kyoto japonya sakura tapinak bahce"
         data-season="ilkbahar,sonbahar"
         data-theme="kultur">

        <a class="dest-card-lg"
               href="destinations-detail.html">

            <img src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg"
                 alt="Kyoto, Japonya" />

            <div class="dest-card-top-badges">

                <span class="badge-country">
                    🇯🇵 Japonya
                </span>

                <span class="badge-season">
                    🌸 İlkbahar (Sakura)
                </span>

            </div>

            <div class="dest-content">

                <span class="dest-tag">
                    Gelenek &amp; Doğa
                </span>

                <h3>
                    Kyoto &amp; Nara
                </h3>

                <p>
                    Bin yıllık tapınaklar, bambu ormanları ve kiraz çiçeklerinin
                    büyüleyici atmosferinde dingin bir Doğu masalı.
                </p>

                <div class="dest-meta-line">

                    <span>
                        <b>12 Aktif Tur</b>
                        · 8-12 Günlük
                    </span>

                    <span class="btn-dest-explore">
                        Rotaları Gör →
                    </span>

                </div>

            </div>

        </a>

    </div>

    <!-- Tromsø -->

    <div class="col-md-6 col-lg-4 dest-item"
         data-country="norvec"
         data-name="tromso norvec kuzey isiklari fiyort kutup"
         data-season="kis"
         data-theme="doga,kis">

        <a class="dest-card-lg"
               href="destinations-detail.html">

            <img src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg"
                 alt="Tromsø, Norveç" />

            <div class="dest-card-top-badges">

                <span class="badge-country">
                    🇳🇴 Norveç
                </span>

                <span class="badge-season">
                    ❄️ Kış (Aurora)
                </span>

            </div>

            <div class="dest-content">

                <span class="dest-tag">
                    Kutup Macerası
                </span>

                <h3>
                    Tromsø &amp; Fiyortlar
                </h3>

                <p>
                    Kuzey Işıkları'nın büyülü dansı, husky safarileri ve
                    buzullarla çevrili fiyort vadilerinde unutulmaz deneyim.
                </p>

                <div class="dest-meta-line">

                    <span>
                        <b>9 Aktif Tur</b>
                        · 5-7 Günlük
                    </span>

                    <span class="btn-dest-explore">
                        Rotaları Gör →
                    </span>

                </div>

            </div>

        </a>

    </div>

    <!-- Bali -->

    <div class="col-md-6 col-lg-4 dest-item"
         data-country="endonezya"
         data-name="bali endonezya tropik ada komodo plaj ubud"
         data-season="yaz,ilkbahar"
         data-theme="deniz,doga">

        <a class="dest-card-lg"
               href="destinations-detail.html">

            <img src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg"
                 alt="Bali, Endonezya" />

            <div class="dest-card-top-badges">

                <span class="badge-country">
                    🇮🇩 Endonezya
                </span>

                <span class="badge-season">
                    ☀️ Yaz &amp; Kuru Sezon
                </span>

            </div>

            <div class="dest-content">

                <span class="dest-tag">
                    Tropik &amp; Ruhsal
                </span>

                <h3>
                    Bali &amp; Komodo Adaları
                </h3>

                <p>
                    Ubud'un teraslı pirinç tarlaları, masmavi mercan resifleri
                    ve ejderhalar diyarı Komodo'da egzotik bir kaçış.
                </p>

                <div class="dest-meta-line">

                    <span>
                        <b>15 Aktif Tur</b>
                        · 9-14 Günlük
                    </span>

                    <span class="btn-dest-explore">
                        Rotaları Gör →
                    </span>

                </div>

            </div>

        </a>

    </div>

    <!-- Kapadokya -->

    <div class="col-md-6 col-lg-4 dest-item"
         data-country="turkiye"
         data-name="kapadokya turkiye balon peribacalari goreme nevsehir"
         data-season="ilkbahar,sonbahar"
         data-theme="kultur,doga">

        <a class="dest-card-lg"
               href="destinations-detail.html">

            <img src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg"
                 alt="Kapadokya, Türkiye" />

            <div class="dest-card-top-badges">

                <span class="badge-country">
                    🇹🇷 Türkiye
                </span>

                <span class="badge-season">
                    🍂 Sonbahar &amp; İlkbahar
                </span>

            </div>

            <div class="dest-content">

                <span class="dest-tag">
                    Büyüleyici Miras
                </span>

                <h3>
                    Kapadokya &amp; Göreme
                </h3>

                <p>
                    Gündoğumunda gökyüzünü süsleyen rengarenk sıcak hava
                    balonları ve yeraltı şehirleriyle masalsı bir coğrafya.
                </p>

                <div class="dest-meta-line">

                    <span>
                        <b>24 Aktif Tur</b>
                        · 3-5 Günlük
                    </span>

                    <span class="btn-dest-explore">
                        Rotaları Gör →
                    </span>

                </div>

            </div>

        </a>

    </div>

    <!-- Zermatt -->

    <div class="col-md-6 col-lg-4 dest-item"
         data-country="isvicre"
         data-name="zermatt isvicre matterhorn alpler kayak trekking"
         data-season="kis,yaz"
         data-theme="kis,doga">

        <a class="dest-card-lg"
               href="destinations-detail.html">

            <img src="https://www.gstatic.com/labs-code/stitch/stitch-placeholder-300x300.svg"
                 alt="Zermatt, İsviçre" />

            <div class="dest-card-top-badges">

                <span class="badge-country">
                    🇨🇭 İsviçre
                </span>

                <span class="badge-season">
                    ❄️ Kış / ☀️ Yaz
                </span>

            </div>

            <div class="dest-content">

                <span class="dest-tag">
                    Alp Zirveleri
                </span>

                <h3>
                    Zermatt &amp; Matterhorn
                </h3>

                <p>
                    Efsanevi Matterhorn dağının gölgesinde birinci sınıf
                    kayak pistleri, buzul trenleri ve panoramik manzaralar.
                </p>

                <div class="dest-meta-line">

                    <span>
                        <b>11 Aktif Tur</b>
                        · 6-8 Günlük
                    </span>

                    <span class="btn-dest-explore">
                        Rotaları Gör →
                    </span>

                </div>

            </div>

        </a>

    </div>

</div>