@using System.Globalization
@model List<Travel.Web.DTOs.TourDtos.TourListItemDto>

@{
    ViewData["Title"] = L["Turlar"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<style>

    /* =========================
           PAGE HEADER
        ========================== */

    .page-head {
        position: relative;
        overflow: hidden;
        color: #fff;
        background: linear-gradient( 120deg, rgba(14,42,59,.92) 0%, rgba(18,56,76,.85) 55%, rgba(11,127,128,.78) 100% ), url('https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=2000&q=80') center/cover;
        padding: 4rem 0 4.6rem;
    }

        .page-head .eyebrow {
            color: #7fe3e3;
        }

        .page-head h1 {
            font-weight: 800;
            font-size: clamp(2rem,4vw,3.1rem);
            letter-spacing: -.5px;
            margin-top: .5rem;
        }

        .page-head p {
            color: rgba(255,255,255,.9);
            max-width: 56ch;
            margin-top: .7rem;
        }

    .breadcrumbz {
        font-size: .85rem;
        color: rgba(255,255,255,.7);
    }

        .breadcrumbz a {
            color: rgba(255,255,255,.7);
            text-decoration: none;
        }

            .breadcrumbz a:hover {
                color: #fff;
            }


    /* =========================
           LAYOUT
        ========================== */

    .listing {
        padding: 3rem 0 4rem;
    }


    /* =========================
           SIDEBAR
        ========================== */

    .filter-card {
        background: #fff;
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.5rem 1.4rem;
    }

        .filter-card h2 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--navy);
            margin-bottom: .2rem;
        }

    .filter-sub {
        font-size: .82rem;
        color: var(--muted);
        margin-bottom: 1.3rem;
    }

    .filter-group {
        padding: 1.1rem 0;
        border-top: 1px solid var(--line);
    }

        .filter-group:first-of-type {
            border-top: none;
            padding-top: .3rem;
        }

        .filter-group h3 {
            font-family: 'Sora';
            font-weight: 600;
            font-size: .82rem;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--navy);
            margin-bottom: .85rem;
        }


    /* SEARCH */

    .search-wrap {
        position: relative;
    }

        .search-wrap svg {
            position: absolute;
            left: .85rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
        }

        .search-wrap input {
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: .65rem .9rem .65rem 2.4rem;
            font-size: .9rem;
            color: var(--navy);
            outline: none;
            background: var(--cream);
            transition: .2s;
        }

            .search-wrap input:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.12);
            }


    /* CHECKBOX */

    .fcheck {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: .6rem;
        cursor: pointer;
    }

        .fcheck:last-child {
            margin-bottom: 0;
        }

        .fcheck .lbl {
            display: flex;
            align-items: center;
            gap: .6rem;
            font-size: .92rem;
            color: var(--navy);
        }

        .fcheck input {
            width: 17px;
            height: 17px;
            accent-color: var(--teal-dark);
            cursor: pointer;
        }

        .fcheck .cnt {
            font-size: .78rem;
            color: var(--muted);
        }


    /* FILTER BUTTON */

    .filter-actions {
        padding-top: 1.2rem;
        border-top: 1px solid var(--line);
        margin-top: .3rem;
    }

        .filter-actions .btn-teal {
            width: 100%;
        }

    .clear-link {
        display: block;
        text-align: center;
        margin-top: .8rem;
        font-size: .88rem;
        color: var(--muted);
        font-weight: 600;
        background: none;
        border: none;
        width: 100%;
    }

        .clear-link:hover {
            color: var(--teal-dark);
        }


    /* =========================
           TOOLBAR
        ========================== */

    .toolbar {
        background: #fff;
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1rem 1.3rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.4rem;
    }

        .toolbar h2 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--navy);
            margin: 0;
        }

        .toolbar .count {
            font-size: .86rem;
            color: var(--muted);
            margin-top: .1rem;
        }


    /* SORT */

    .sort-wrap {
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .sort-wrap label {
            font-size: .85rem;
            color: var(--muted);
            font-weight: 600;
        }

        .sort-wrap select {
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: .5rem 2rem .5rem 1rem;
            font-size: .88rem;
            font-weight: 600;
            color: var(--navy);
            background: #fff;
            outline: none;
            cursor: pointer;
        }

            .sort-wrap select:focus {
                border-color: var(--teal);
            }


    /* MOBILE FILTER */

    .btn-filter-mobile {
        background: var(--navy);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .55rem 1.1rem;
        font-size: .88rem;
    }


    /* =========================
           ACTIVE CHIPS
        ========================== */

    .active-chips {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin-bottom: 1.2rem;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(15,163,163,.1);
        color: var(--teal-dark);
        font-size: .82rem;
        font-weight: 600;
        padding: .35rem .8rem;
        border-radius: 999px;
        cursor: pointer;
        transition: .2s;
    }

        .chip:hover {
            background: rgba(15,163,163,.2);
        }

        .chip .x {
            font-weight: 700;
        }


    /* =========================
           TOUR CARD
        ========================== */

    .tour-card {
        background: #fff;
        border-radius: var(--r);
        border: 1px solid rgba(231,226,216,.7);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        height: 100%;
    }

    .tour-media {
        position: relative;
        height: 210px;
        overflow: hidden;
    }

        .tour-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .35s ease;
        }

    .tour-card:hover .tour-media img {
        transform: scale(1.04);
    }


    /* IMAGE PLACEHOLDER */

    .tour-image-placeholder {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        background: linear-gradient( 135deg, #e8f5f5, #f5f7f7 );
        color: var(--teal);
        font-size: 2.5rem;
    }


    /* BADGE */

    .tour-badge {
        position: absolute;
        left: 1rem;
        top: 1rem;
        padding: .35rem .7rem;
        border-radius: 999px;
        background: #fff;
        color: var(--navy);
        font-size: .72rem;
        font-weight: 700;
        box-shadow: 0 5px 15px rgba(0,0,0,.12);
    }


    /* FAVORITE */

    .fav {
        position: absolute;
        right: 1rem;
        top: 1rem;
        width: 38px;
        height: 38px;
        border: none;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: rgba(255,255,255,.94);
        color: var(--navy);
        cursor: pointer;
        transition: .2s;
    }

        .fav:hover {
            transform: scale(1.05);
        }

        .fav.on {
            color: #e55353;
        }


    /* BODY */

    .tour-body {
        padding: 1.2rem 1.3rem 1.35rem;
    }

    .tour-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        margin-bottom: .15rem;
    }

    .tour-country {
        font-size: .78rem;
        color: var(--muted);
    }

    .tour-cat {
        font-size: .72rem;
        color: var(--muted);
        background: var(--cream);
        border: 1px solid var(--line);
        padding: .15rem .55rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .tour-title {
        font-family: 'Sora';
        font-size: 1.12rem;
        font-weight: 700;
        color: var(--navy);
        margin: .15rem 0 .5rem;
        line-height: 1.35;
    }

    .tour-description {
        color: var(--muted);
        font-size: .85rem;
        line-height: 1.5;
        margin-bottom: .8rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }


    /* META */

    .tour-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        margin-bottom: .95rem;
        flex-wrap: wrap;
    }

    .tour-meta-item {
        font-size: .82rem;
        color: var(--muted);
    }

    .rating {
        font-weight: 600;
        color: var(--navy);
    }

    .star {
        color: #f4a92c;
    }


    /* FOOT */

    .tour-foot {
        padding-top: .8rem;
        border-top: 1px solid var(--line);
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
    }

    .price {
        display: flex;
        flex-direction: column;
    }

        .price small {
            color: var(--muted);
            font-size: .72rem;
        }

        .price b {
            color: var(--navy);
            font-size: 1.28rem;
            font-family: 'Sora';
            font-weight: 800;
        }

            .price b span {
                font-size: .78rem;
                font-weight: 600;
            }


    /* BUTTON */

    .btn-incele {
        border: 1px solid var(--teal);
        background: transparent;
        color: var(--teal-dark);
        border-radius: 999px;
        padding: .55rem 1rem;
        font-size: .82rem;
        font-weight: 700;
        transition: .2s;
    }

        .btn-incele:hover {
            background: var(--teal);
            color: #fff;
        }


    /* =========================
           EMPTY
        ========================== */

    .empty-state {
        background: #fff;
        border-radius: var(--r);
        border: 1px solid rgba(231,226,216,.7);
        box-shadow: var(--shadow-sm);
        padding: 3.5rem 2rem;
        text-align: center;
    }

        .empty-state .ico {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            margin: 0 auto 1.2rem;
        }

        .empty-state h3 {
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: 1.3rem;
        }

        .empty-state p {
            color: var(--muted);
            max-width: 40ch;
            margin: .4rem auto 1.4rem;
        }


    /* =========================
           PAGINATION
        ========================== */

    .pager {
        display: flex;
        justify-content: center;
        gap: .4rem;
        margin-top: 2.6rem;
    }

        .pager button {
            min-width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: #fff;
            border: 1px solid var(--line);
            color: var(--navy);
            font-weight: 600;
            font-size: .92rem;
            transition: .2s;
            padding: 0 .4rem;
        }

            .pager button:hover {
                border-color: var(--teal);
                color: var(--teal-dark);
            }

            .pager button.active {
                background: var(--navy);
                color: #fff;
                border-color: var(--navy);
            }


    /* =========================
           MINI CTA
        ========================== */

    .mini-cta {
        background: var(--navy);
        border-radius: 24px;
        padding: 2.8rem 2rem;
        text-align: center;
        color: #fff;
        margin-top: 3.5rem;
    }

        .mini-cta .eyebrow {
            color: #7fe3e3;
        }

        .mini-cta h2 {
            font-weight: 700;
            font-size: clamp(1.5rem,2.6vw,2.1rem);
            letter-spacing: -.5px;
            margin-top: .5rem;
        }

        .mini-cta p {
            color: rgba(255,255,255,.82);
            max-width: 50ch;
            margin: .8rem auto 1.5rem;
        }


    /* =========================
           OFFCANVAS
        ========================== */

    .offcanvas {
        background: var(--cream);
    }

    .sticky-side {
        position: sticky;
        top: 90px;
    }


    @@media (max-width: 991px) {

        .sticky-side {
            position: static;
        }
    }

</style>

<style>
    .fav.on { color: #e0575b }
    .fav.on svg { fill: currentColor }
    .date-row { display: flex; gap: .5rem }
    .date-row input, .pax-select { width: 100%; border: 1px solid var(--line); border-radius: 12px; padding: .55rem .7rem; font-size: .85rem; color: var(--navy); background: var(--cream); outline: none }
    .date-row label { font-size: .72rem; color: var(--muted); font-weight: 600; display: block; margin-bottom: .2rem }
    .tour-item.hide { display: none }
</style>

@{
    var favoriteIds = (ViewBag.FavoriteIds as List<string>) ?? new List<string>();
    var tr = new CultureInfo("tr-TR");

}

<!-- PAGE HEADER -->
<header class="page-head">
    <div class="container">
        <div class="breadcrumbz mb-3">
            <a asp-controller="Default" asp-action="Index">@L["Ana Sayfa"]</a> · @L["Turlar"]
        </div>
        <div class="eyebrow">@L["Dünyayı keşfet"]</div>
        <h1>@L["Hayalindeki Turu Bul"]</h1>
        <p>@L["Avrupa'nın ikonik şehirlerinden Uzak Doğu'nun büyüleyici rotalarına kadar sana uygun seyahati keşfet."]</p>
    </div>
</header>

<!-- LISTING -->
<section class="listing">
    <div class="container">
        <div class="row g-4">

            <!-- SIDEBAR (desktop) -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="sticky-side">
                    <div class="filter-card">
                        <partial name="_TourFilterPanel" model="Model" />
                    </div>
                </div>
            </div>

            <!-- RESULTS -->
            <div class="col-lg-9">
                <div class="toolbar">
                    <div>
                        <h2>@L["Turlar"]</h2>
                        <div class="count"><span id="resultCount">@Model.Count</span> @L["tur bulundu"]</div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn-filter-mobile d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterOffcanvas">
                            @L["Filtrele"]
                        </button>
                        <div class="sort-wrap">
                            <label for="sortSelect" class="d-none d-sm-block">@L["Sırala:"]</label>
                            <select id="sortSelect">
                                <option value="onerilen">@L["Önerilen"]</option>
                                <option value="populer">@L["En Çok Rezervasyon"]</option>
                                <option value="puan">@L["En Yüksek Puan"]</option>
                                <option value="fiyat-artan">@L["Fiyat: Düşükten Yükseğe"]</option>
                                <option value="fiyat-azalan">@L["Fiyat: Yüksekten Düşüğe"]</option>
                                <option value="tarih">@L["En Yakın Tarih"]</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="active-chips" id="activeChips"></div>

                <div class="row g-4" id="tourGrid">
                    @foreach (var tour in Model)
                    {
                        var isFav = favoriteIds.Contains(tour.Id);

                        <div class="col-md-6 tour-item"
                             data-name="@tour.Name.ToLower(tr)"
                             data-text="@((tour.Name + " " + tour.ShortDescription + " " + tour.DestinationName).ToLower(tr))"
                             data-category="@tour.CategoryName"
                             data-destination="@tour.DestinationName"
                             data-duration="@tour.DurationDays"
                             data-price="@tour.Price.ToString(CultureInfo.InvariantCulture)"
                             data-rating="@tour.AverageRating.ToString(CultureInfo.InvariantCulture)"
                             data-reservations="@tour.ReservationCount"
                             data-dates="@string.Join(",", tour.DateKeys)">
                            <article class="tour-card">
                                <div class="tour-media">
                                    @if (!string.IsNullOrWhiteSpace(tour.CoverImageUrl))
                                    {
                                        <img src="@tour.CoverImageUrl" alt="@tour.Name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="tour-image-placeholder"></div>
                                    }

                                    @if (tour.IsBestSeller)
                                    {
                                        <span class="tour-badge">@L["Çok Satan"]</span>
                                    }
                                    else if (tour.IsNew)
                                    {
                                        <span class="tour-badge">@L["Yeni"]</span>
                                    }
                                    else if (tour.RemainingCapacity > 0 && tour.RemainingCapacity <= 10)
                                    {
                                        <span class="tour-badge">@L["Son"] @tour.RemainingCapacity @L["Kontenjan"]</span>
                                    }
                                    else if (tour.DateKeys.Count == 0)
                                    {
                                        <span class="tour-badge">@L["Tarih Bekleniyor"]</span>
                                    }

                                    <button class="fav @(isFav ? "on" : "")" type="button" aria-label="@L["Favorilere ekle"]"
                                            data-tour-id="@tour.Id" onclick="toggleFav(this)">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" />
                                        </svg>
                                    </button>
                                </div>

                                <div class="tour-body">
                                    <div class="tour-topline">
                                        <span class="tour-country">@(tour.DestinationName ?? L["Destinasyon"].Value)</span>
                                        <span class="tour-cat">@(tour.CategoryName ?? L["Tur"].Value)</span>
                                    </div>

                                    <h3 class="tour-title">@tour.Name</h3>

                                    @if (!string.IsNullOrWhiteSpace(tour.ShortDescription))
                                    {
                                        <p class="tour-description">@tour.ShortDescription</p>
                                    }

                                    <div class="tour-meta">
                                        <span>🗓️ @tour.DurationDays @L["Gün"] / @tour.DurationNights @L["Gece"]</span>
                                        @if (tour.ReviewCount > 0)
                                        {
                                            <span class="rating"><span class="star">★</span> @tour.AverageRating.ToString("0.0") <span style="color:var(--muted);font-weight:400">(@tour.ReviewCount)</span></span>
                                        }
                                        @if (tour.UpcomingDate.HasValue)
                                        {
                                            <span>✈️ @tour.UpcomingDate.Value.ToString("d MMM yyyy")</span>
                                        }
                                    </div>

                                    <div class="tour-foot">
                                        <div class="price"><small>@L["Kişi başı"]</small><b>@tour.Price.ToString("N0", tr) <span>TL</span></b></div>
                                        <a asp-controller="Tours" asp-action="TourDetail" asp-route-id="@tour.Id" class="btn-incele">@L["Turu İncele"]</a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>

                <!-- EMPTY -->
                <div id="emptyState" style="@(Model.Any() ? "display:none" : "")">
                    <div class="empty-state">
                        <h3>@L["Aradığın kriterlere uygun tur bulunamadı."]</h3>
                        <p>@L["Filtreleri biraz gevşetmeyi dene ya da tümünü temizleyerek yeniden başla."]</p>
                        <button class="btn-teal" type="button" onclick="clearFilters()">@L["Filtreleri Temizle"]</button>
                    </div>
                </div>

                <!-- MINI CTA -->
                <div class="mini-cta">
                    <div class="eyebrow">@L["Yardımcı olalım"]</div>
                    <h2>@L["Aradığın Rotayı Bulamadın mı?"]</h2>
                    <p>@L["Hayalindeki destinasyonu bize söyle, sana uygun seyahat seçeneklerini birlikte bulalım."]</p>
                    <a asp-controller="Contact" asp-action="Index" class="btn-teal">@L["Bize Ulaş"]</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MOBILE FILTER -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="filterOffcanvas" style="width:320px">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" style="font-family:'Sora';font-weight:700;color:var(--navy)">@L["Filtrele"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="filter-card" style="box-shadow:none;border:none;padding:0">
            <partial name="_TourFilterPanel" model="Model" />
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
    /* Filtre panelleri (masaüstü + mobil) aynı class'ları kullanır.
       Değer içeren alanlar (arama, tarih, kişi) değiştiğinde diğer panele kopyalanır. */

    const PRICE = { p1: [0, 25000], p2: [25000, 40000], p3: [40000, 60000], p4: [60000, 1e12] };
    const DUR = { "1-3": [1, 3], "4-5": [4, 5], "6-7": [6, 7], "8+": [8, 999] };

    function checked(cls){ return [...new Set([...document.querySelectorAll("." + cls + ":checked")].map(x => x.value))]; }
    function val(cls){ const el = document.querySelector("." + cls); return el ? el.value : ""; }
    function mirror(el){
      const cls = [...el.classList].find(c => c.startsWith("f-"));
      if(!cls) return;
      document.querySelectorAll("." + cls).forEach(x => {
        if(x === el) return;
        if(x.type === "checkbox" || x.type === "radio"){ if(x.value === el.value) x.checked = el.checked; }
        else x.value = el.value;
      });
    }

    function readState(){
      return {
        q: val("f-search").trim().toLocaleLowerCase("tr-TR"),
        dest: checked("f-dest"),
        cat: checked("f-cat"),
        price: checked("f-price"),
        dur: checked("f-dur"),
        from: val("f-from"),
        to: val("f-to"),
        pax: parseInt(val("f-pax") || "1", 10)
      };
    }

    function matches(item, s){
      const d = item.dataset;
      if(s.q && !d.text.includes(s.q)) return false;
      if(s.dest.length && !s.dest.includes(d.destination)) return false;
      if(s.cat.length && !s.cat.includes(d.category)) return false;

      const price = parseFloat(d.price);
      if(s.price.length && !s.price.some(k => price >= PRICE[k][0] && price < PRICE[k][1])) return false;

      const dur = parseInt(d.duration, 10);
      if(s.dur.length && !s.dur.some(k => dur >= DUR[k][0] && dur <= DUR[k][1])) return false;

      // Tarih + kişi: seçilen aralıkta, istenen kişi kadar yeri olan bir kalkış olmalı
      if(s.from || s.to || s.pax > 1){
        const dates = (d.dates || "").split(",").filter(Boolean).map(x => x.split("|"));
        const ok = dates.some(([date, remaining]) =>
          (!s.from || date >= s.from) && (!s.to || date <= s.to) && parseInt(remaining, 10) >= s.pax);
        if(!ok) return false;
      }
      return true;
    }

    function firstDate(item){ return (item.dataset.dates || "9999").split(",")[0].split("|")[0] || "9999"; }

    function render(){
      const s = readState();
      const grid = document.getElementById("tourGrid");
      const items = [...grid.querySelectorAll(".tour-item")];
      let count = 0;

      items.forEach(item => {
        const ok = matches(item, s);
        item.classList.toggle("hide", !ok);
        if(ok) count++;
      });

      const sort = document.getElementById("sortSelect").value;
      const by = {
        "populer": (a, b) => b.dataset.reservations - a.dataset.reservations,
        "puan": (a, b) => b.dataset.rating - a.dataset.rating,
        "fiyat-artan": (a, b) => a.dataset.price - b.dataset.price,
        "fiyat-azalan": (a, b) => b.dataset.price - a.dataset.price,
        "tarih": (a, b) => firstDate(a).localeCompare(firstDate(b))
      }[sort];
      if(by) items.sort(by).forEach(x => grid.appendChild(x));

      document.getElementById("resultCount").textContent = count;
      document.getElementById("emptyState").style.display = count ? "none" : "block";
      renderChips(s);
    }

    function renderChips(s){
      const chips = [];
      s.dest.forEach(v => chips.push(["f-dest", v, v]));
      s.cat.forEach(v => chips.push(["f-cat", v, v]));
      s.price.forEach(v => chips.push(["f-price", v, document.querySelector('.f-price[value="' + v + '"]').dataset.label]));
      s.dur.forEach(v => chips.push(["f-dur", v, document.querySelector('.f-dur[value="' + v + '"]').dataset.label]));
      if(s.from) chips.push(["f-from", "", "≥ " + s.from]);
      if(s.to) chips.push(["f-to", "", "≤ " + s.to]);
      if(s.pax > 1) chips.push(["f-pax", "", s.pax + " 👤"]);
      if(s.q) chips.push(["f-search", "", '"' + s.q + '"']);

      const wrap = document.getElementById("activeChips");
      wrap.innerHTML = "";
      chips.forEach(([cls, value, text]) => {
        const chip = document.createElement("span");
        chip.className = "chip";
        chip.textContent = text + " ×";
        chip.onclick = () => {
          document.querySelectorAll("." + cls).forEach(x => {
            if(x.type === "checkbox"){ if(x.value === value) x.checked = false; }
            else if(cls === "f-pax") x.value = "1";
            else x.value = "";
          });
          render();
        };
        wrap.appendChild(chip);
      });
    }

    function clearFilters(){
      document.querySelectorAll(".f-dest,.f-cat,.f-price,.f-dur").forEach(x => x.checked = false);
      document.querySelectorAll(".f-search,.f-from,.f-to").forEach(x => x.value = "");
      document.querySelectorAll(".f-pax").forEach(x => x.value = "1");
      document.getElementById("sortSelect").value = "onerilen";
      render();
    }

    function applyFromButton(){
      render();
      const inst = bootstrap.Offcanvas.getInstance(document.getElementById("filterOffcanvas"));
      if(inst) inst.hide();
    }

    document.addEventListener("input", e => {
      if(e.target.matches(".f-search,.f-dest,.f-cat,.f-price,.f-dur,.f-from,.f-to,.f-pax")){ mirror(e.target); render(); }
    });
    document.getElementById("sortSelect").addEventListener("change", render);

    /* Ana sayfadaki arama kutusundan gelen parametreler: ?dest=&cat=&date=&pax=&q= */
    (function initFromQuery(){
      const p = new URLSearchParams(location.search);
      const setCheck = (cls, v) => document.querySelectorAll("." + cls).forEach(x => { if(x.value === v) x.checked = true; });
      if(p.get("dest")) setCheck("f-dest", p.get("dest"));
      if(p.get("cat")) setCheck("f-cat", p.get("cat"));
      if(p.get("date")) document.querySelectorAll(".f-from").forEach(x => x.value = p.get("date"));
      if(p.get("pax")) document.querySelectorAll(".f-pax").forEach(x => x.value = p.get("pax"));
      if(p.get("q")) document.querySelectorAll(".f-search").forEach(x => x.value = p.get("q"));
      render();
    })();

    /* Favori */
    async function toggleFav(btn){
      const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
      const res = await fetch("/Tours/ToggleFavorite", {
        method: "POST",
        body: new URLSearchParams({ tourId: btn.dataset.tourId, __RequestVerificationToken: token })
      });
      if(res.status === 401){ location.href = "/Auth/SignIn"; return; }
      if(res.ok){ const data = await res.json(); btn.classList.toggle("on", data.isFavorite); }
    }
</script>
