@using System.Globalization
@model List<Travel.Web.DTOs.TourDtos.TourListItemDto>

@{
    ViewData["Title"] = "Turlar";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var destinations = Model
        .Where(x => !string.IsNullOrWhiteSpace(x.DestinationName))
        .Select(x => x.DestinationName!)
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    var categories = Model
        .Where(x => !string.IsNullOrWhiteSpace(x.CategoryName))
        .Select(x => x.CategoryName!)
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<style>

    /* =========================
           PAGE HEADER
        ========================== */

    .page-head {
        position: relative;
        overflow: hidden;
        color: #fff;
        background: linear-gradient( 120deg, rgba(14,42,59,.92) 0%, rgba(18,56,76,.85) 55%, rgba(11,127,128,.78) 100% ), url('https://images.unsplash.com/photo-1488646953014-85cb44e25828?auto=format&fit=crop&w=2000&q=80') center/cover;
        padding: 4rem 0 4.6rem;
    }

        .page-head .eyebrow {
            color: #7fe3e3;
        }

        .page-head h1 {
            font-weight: 800;
            font-size: clamp(2rem,4vw,3.1rem);
            letter-spacing: -.5px;
            margin-top: .5rem;
        }

        .page-head p {
            color: rgba(255,255,255,.9);
            max-width: 56ch;
            margin-top: .7rem;
        }

    .breadcrumbz {
        font-size: .85rem;
        color: rgba(255,255,255,.7);
    }

        .breadcrumbz a {
            color: rgba(255,255,255,.7);
            text-decoration: none;
        }

            .breadcrumbz a:hover {
                color: #fff;
            }


    /* =========================
           LAYOUT
        ========================== */

    .listing {
        padding: 3rem 0 4rem;
    }


    /* =========================
           SIDEBAR
        ========================== */

    .filter-card {
        background: #fff;
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.5rem 1.4rem;
    }

        .filter-card h2 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--navy);
            margin-bottom: .2rem;
        }

    .filter-sub {
        font-size: .82rem;
        color: var(--muted);
        margin-bottom: 1.3rem;
    }

    .filter-group {
        padding: 1.1rem 0;
        border-top: 1px solid var(--line);
    }

        .filter-group:first-of-type {
            border-top: none;
            padding-top: .3rem;
        }

        .filter-group h3 {
            font-family: 'Sora';
            font-weight: 600;
            font-size: .82rem;
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--navy);
            margin-bottom: .85rem;
        }


    /* SEARCH */

    .search-wrap {
        position: relative;
    }

        .search-wrap svg {
            position: absolute;
            left: .85rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
        }

        .search-wrap input {
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: .65rem .9rem .65rem 2.4rem;
            font-size: .9rem;
            color: var(--navy);
            outline: none;
            background: var(--cream);
            transition: .2s;
        }

            .search-wrap input:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.12);
            }


    /* CHECKBOX */

    .fcheck {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: .6rem;
        cursor: pointer;
    }

        .fcheck:last-child {
            margin-bottom: 0;
        }

        .fcheck .lbl {
            display: flex;
            align-items: center;
            gap: .6rem;
            font-size: .92rem;
            color: var(--navy);
        }

        .fcheck input {
            width: 17px;
            height: 17px;
            accent-color: var(--teal-dark);
            cursor: pointer;
        }

        .fcheck .cnt {
            font-size: .78rem;
            color: var(--muted);
        }


    /* FILTER BUTTON */

    .filter-actions {
        padding-top: 1.2rem;
        border-top: 1px solid var(--line);
        margin-top: .3rem;
    }

        .filter-actions .btn-teal {
            width: 100%;
        }

    .clear-link {
        display: block;
        text-align: center;
        margin-top: .8rem;
        font-size: .88rem;
        color: var(--muted);
        font-weight: 600;
        background: none;
        border: none;
        width: 100%;
    }

        .clear-link:hover {
            color: var(--teal-dark);
        }


    /* =========================
           TOOLBAR
        ========================== */

    .toolbar {
        background: #fff;
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1rem 1.3rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.4rem;
    }

        .toolbar h2 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--navy);
            margin: 0;
        }

        .toolbar .count {
            font-size: .86rem;
            color: var(--muted);
            margin-top: .1rem;
        }


    /* SORT */

    .sort-wrap {
        display: flex;
        align-items: center;
        gap: .6rem;
    }

        .sort-wrap label {
            font-size: .85rem;
            color: var(--muted);
            font-weight: 600;
        }

        .sort-wrap select {
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: .5rem 2rem .5rem 1rem;
            font-size: .88rem;
            font-weight: 600;
            color: var(--navy);
            background: #fff;
            outline: none;
            cursor: pointer;
        }

            .sort-wrap select:focus {
                border-color: var(--teal);
            }


    /* MOBILE FILTER */

    .btn-filter-mobile {
        background: var(--navy);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .55rem 1.1rem;
        font-size: .88rem;
    }


    /* =========================
           ACTIVE CHIPS
        ========================== */

    .active-chips {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin-bottom: 1.2rem;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(15,163,163,.1);
        color: var(--teal-dark);
        font-size: .82rem;
        font-weight: 600;
        padding: .35rem .8rem;
        border-radius: 999px;
        cursor: pointer;
        transition: .2s;
    }

        .chip:hover {
            background: rgba(15,163,163,.2);
        }

        .chip .x {
            font-weight: 700;
        }


    /* =========================
           TOUR CARD
        ========================== */

    .tour-card {
        background: #fff;
        border-radius: var(--r);
        border: 1px solid rgba(231,226,216,.7);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        height: 100%;
    }

    .tour-media {
        position: relative;
        height: 210px;
        overflow: hidden;
    }

        .tour-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .35s ease;
        }

    .tour-card:hover .tour-media img {
        transform: scale(1.04);
    }


    /* IMAGE PLACEHOLDER */

    .tour-image-placeholder {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        background: linear-gradient( 135deg, #e8f5f5, #f5f7f7 );
        color: var(--teal);
        font-size: 2.5rem;
    }


    /* BADGE */

    .tour-badge {
        position: absolute;
        left: 1rem;
        top: 1rem;
        padding: .35rem .7rem;
        border-radius: 999px;
        background: #fff;
        color: var(--navy);
        font-size: .72rem;
        font-weight: 700;
        box-shadow: 0 5px 15px rgba(0,0,0,.12);
    }


    /* FAVORITE */

    .fav {
        position: absolute;
        right: 1rem;
        top: 1rem;
        width: 38px;
        height: 38px;
        border: none;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: rgba(255,255,255,.94);
        color: var(--navy);
        cursor: pointer;
        transition: .2s;
    }

        .fav:hover {
            transform: scale(1.05);
        }

        .fav.on {
            color: #e55353;
        }


    /* BODY */

    .tour-body {
        padding: 1.2rem 1.3rem 1.35rem;
    }

    .tour-topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        margin-bottom: .15rem;
    }

    .tour-country {
        font-size: .78rem;
        color: var(--muted);
    }

    .tour-cat {
        font-size: .72rem;
        color: var(--muted);
        background: var(--cream);
        border: 1px solid var(--line);
        padding: .15rem .55rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .tour-title {
        font-family: 'Sora';
        font-size: 1.12rem;
        font-weight: 700;
        color: var(--navy);
        margin: .15rem 0 .5rem;
        line-height: 1.35;
    }

    .tour-description {
        color: var(--muted);
        font-size: .85rem;
        line-height: 1.5;
        margin-bottom: .8rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }


    /* META */

    .tour-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        margin-bottom: .95rem;
        flex-wrap: wrap;
    }

    .tour-meta-item {
        font-size: .82rem;
        color: var(--muted);
    }

    .rating {
        font-weight: 600;
        color: var(--navy);
    }

    .star {
        color: #f4a92c;
    }


    /* FOOT */

    .tour-foot {
        padding-top: .8rem;
        border-top: 1px solid var(--line);
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
    }

    .price {
        display: flex;
        flex-direction: column;
    }

        .price small {
            color: var(--muted);
            font-size: .72rem;
        }

        .price b {
            color: var(--navy);
            font-size: 1.28rem;
            font-family: 'Sora';
            font-weight: 800;
        }

            .price b span {
                font-size: .78rem;
                font-weight: 600;
            }


    /* BUTTON */

    .btn-incele {
        border: 1px solid var(--teal);
        background: transparent;
        color: var(--teal-dark);
        border-radius: 999px;
        padding: .55rem 1rem;
        font-size: .82rem;
        font-weight: 700;
        transition: .2s;
    }

        .btn-incele:hover {
            background: var(--teal);
            color: #fff;
        }


    /* =========================
           EMPTY
        ========================== */

    .empty-state {
        background: #fff;
        border-radius: var(--r);
        border: 1px solid rgba(231,226,216,.7);
        box-shadow: var(--shadow-sm);
        padding: 3.5rem 2rem;
        text-align: center;
    }

        .empty-state .ico {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            background: rgba(15,163,163,.1);
            color: var(--teal-dark);
            display: grid;
            place-items: center;
            margin: 0 auto 1.2rem;
        }

        .empty-state h3 {
            font-family: 'Sora';
            font-weight: 700;
            color: var(--navy);
            font-size: 1.3rem;
        }

        .empty-state p {
            color: var(--muted);
            max-width: 40ch;
            margin: .4rem auto 1.4rem;
        }


    /* =========================
           PAGINATION
        ========================== */

    .pager {
        display: flex;
        justify-content: center;
        gap: .4rem;
        margin-top: 2.6rem;
    }

        .pager button {
            min-width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: #fff;
            border: 1px solid var(--line);
            color: var(--navy);
            font-weight: 600;
            font-size: .92rem;
            transition: .2s;
            padding: 0 .4rem;
        }

            .pager button:hover {
                border-color: var(--teal);
                color: var(--teal-dark);
            }

            .pager button.active {
                background: var(--navy);
                color: #fff;
                border-color: var(--navy);
            }


    /* =========================
           MINI CTA
        ========================== */

    .mini-cta {
        background: var(--navy);
        border-radius: 24px;
        padding: 2.8rem 2rem;
        text-align: center;
        color: #fff;
        margin-top: 3.5rem;
    }

        .mini-cta .eyebrow {
            color: #7fe3e3;
        }

        .mini-cta h2 {
            font-weight: 700;
            font-size: clamp(1.5rem,2.6vw,2.1rem);
            letter-spacing: -.5px;
            margin-top: .5rem;
        }

        .mini-cta p {
            color: rgba(255,255,255,.82);
            max-width: 50ch;
            margin: .8rem auto 1.5rem;
        }


    /* =========================
           OFFCANVAS
        ========================== */

    .offcanvas {
        background: var(--cream);
    }

    .sticky-side {
        position: sticky;
        top: 90px;
    }


    @@media (max-width: 991px) {

        .sticky-side {
            position: static;
        }
    }

</style>


<!-- =========================
     PAGE HEADER
========================== -->

<header class="page-head">

    <div class="container">

        <div class="breadcrumbz mb-3">

            <a asp-controller="Home"
               asp-action="Index">

                Ana Sayfa

            </a>

            · Turlar

        </div>

        <div class="eyebrow">
            Dünyayı keşfet
        </div>

        <h1>
            Hayalindeki Turu Bul
        </h1>

        <p>
            Avrupa'nın ikonik şehirlerinden Uzak Doğu'nun
            büyüleyici rotalarına kadar sana uygun seyahati keşfet.
        </p>

    </div>

</header>


<!-- =========================
     LISTING
========================== -->

<section class="listing">

    <div class="container">

        <div class="row g-4">


            <!-- =========================
                 SIDEBAR
            ========================== -->

            <div class="col-lg-3 d-none d-lg-block">

                <div class="sticky-side">

                    <div class="filter-card"
                         id="filterCardDesktop">
                    </div>

                </div>

            </div>


            <!-- =========================
                 RESULTS
            ========================== -->

            <div class="col-lg-9">


                <!-- TOOLBAR -->

                <div class="toolbar">

                    <div>

                        <h2>
                            Turlar
                        </h2>

                        <div class="count">

                            <span id="resultCount">
                                @Model.Count
                            </span>

                            tur bulundu

                        </div>

                    </div>


                    <div class="d-flex align-items-center gap-2">

                        <button class="btn-filter-mobile d-lg-none"
                                type="button"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#filterOffcanvas">

                            Filtrele

                        </button>


                        <div class="sort-wrap">

                            <label for="sortSelect"
                                   class="d-none d-sm-block">

                                Sırala:

                            </label>

                            <select id="sortSelect">

                                <option value="onerilen">
                                    Önerilen
                                </option>

                                <option value="puan">
                                    En Yüksek Puan
                                </option>

                                <option value="fiyat-artan">
                                    Fiyat: Düşükten Yükseğe
                                </option>

                                <option value="fiyat-azalan">
                                    Fiyat: Yüksekten Düşüğe
                                </option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- ACTIVE CHIPS -->

                <div class="active-chips"
                     id="activeChips">
                </div>


                <!-- TOUR GRID -->

                <div class="row g-4"
                     id="tourGrid">

                    @foreach (var tour in Model)
                    {
                        <div class="col-md-6 tour-item"
                             data-name="@tour.Name"
                             data-description="@tour.ShortDescription"
                             data-category="@tour.CategoryName"
                             data-destination="@tour.DestinationName"
                             data-duration="@tour.DurationDays"
                             data-price="@tour.Price"
                             data-rating="@tour.ReservationCount">

                            <article class="tour-card">


                                <!-- IMAGE -->

                                <div class="tour-media">

                                    @if (!string.IsNullOrWhiteSpace(tour.CoverImageUrl))
                                    {
                                        <img src="@tour.CoverImageUrl"
                                             alt="@tour.Name"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="tour-image-placeholder">

                                            <i class="bi bi-image"></i>

                                        </div>
                                    }


                                    @if (tour.ReservationCount > 10)
                                    {
                                        <span class="tour-badge">
                                            Popüler
                                        </span>
                                    }


                                <button class="fav"
                                        type="button"
                                        aria-label="Favorilere ekle"
                                        onclick="this.classList.toggle('on')">

                                    <svg width="18"
                                         height="18"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" />

                                    </svg>

                                </button>

                            </div>


                            <!-- BODY -->

                            <div class="tour-body">


                                <div class="tour-topline">

                                    <span class="tour-country">

                                        @(string.IsNullOrWhiteSpace(tour.DestinationName)
                                                                                ? "Destinasyon"
                                                                                : tour.DestinationName)

                                    </span>


                                    <span class="tour-cat">

                                        @(string.IsNullOrWhiteSpace(tour.CategoryName)
                                                                                ? "Tur"
                                                                                : tour.CategoryName)

                                    </span>

                                    </div>


                                    <h3 class="tour-title">

                                        @tour.Name

                                    </h3>


                                @if (!string.IsNullOrWhiteSpace(tour.ShortDescription))
                                    {
                                        <div class="tour-description">

                                            @tour.ShortDescription

                                        </div>
                                    }


                                    <div class="tour-meta">

                                        <span class="tour-meta-item">

                                            <i class="bi bi-calendar3 me-1"></i>

                                            @tour.DurationDays gün

                                            @if (tour.DurationNights > 0)
                                            {
                                                <span>
                                                    / @tour.DurationNights gece
                                                </span>
                                            }

                                        </span>


                                        @if (tour.UpcomingDate.HasValue)
                                        {
                                            <span class="tour-meta-item">

                                                <i class="bi bi-clock me-1"></i>

                                                @tour.UpcomingDate.Value.ToString(
                                                "dd.MM.yyyy",
                                                                                CultureInfo.GetCultureInfo("tr-TR"))

                                    </span>
                                                                        }

                                    </div>


                                    <div class="tour-foot">

                                        <div class="price">

                                            <small>
                                                Kişi başı
                                            </small>

                                            <b>

                                                @tour.Price.ToString(
                                                "N0",
                                                                                        CultureInfo.GetCultureInfo("tr-TR"))

                                            <span>
                                                TL
                                            </span>

                                        </b>

                                    </div>


                                    <a asp-controller="Tours"
                                       asp-action="TourDetail"
                                       asp-route-id="@tour.Id"
                                       class="btn-incele">

                                        Turu İncele

                                    </a>

                                </div>

                            </div>

                        </article>

                    </div>
                                        }

                </div>


                <!-- =========================
                     EMPTY STATE
                ========================== -->

                <div id="emptyState"
                     style="display:@(Model.Any() ? "none" : "block")">

                    <div class="empty-state">

                        <div class="ico">

                            <svg width="28"
                                 height="28"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <circle cx="11"
                                        cy="11"
                                        r="8" />

                                <line x1="21"
                                      y1="21"
                                      x2="16.65"
                                      y2="16.65" />

                            </svg>

                        </div>


                        <h3>
                            Aradığın kriterlere uygun tur bulunamadı.
                        </h3>

                        <p>
                            Filtreleri biraz gevşetmeyi dene
                            ya da tümünü temizleyerek yeniden başla.
                        </p>


                        <button class="btn-teal"
                                type="button"
                                onclick="clearFilters()">

                            Filtreleri Temizle

                        </button>

                    </div>

                </div>


                <!-- =========================
                     MINI CTA
                ========================== -->

                <div class="mini-cta">

                    <div class="eyebrow">
                        Yardımcı olalım
                    </div>

                    <h2>
                        Aradığın Rotayı Bulamadın mı?
                    </h2>

                    <p>
                        Hayalindeki destinasyonu bize söyle,
                        sana uygun seyahat seçeneklerini birlikte bulalım.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="iletisim"
                       class="btn-teal">

                        Bize Ulaş

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     MOBILE FILTER
========================== -->

<div class="offcanvas offcanvas-start"
     tabindex="-1"
     id="filterOffcanvas"
     style="width:320px">

    <div class="offcanvas-header">

        <h5 class="offcanvas-title"
            style="font-family:'Sora';font-weight:700;color:var(--navy)">

            Filtrele

        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas">
        </button>

    </div>


    <div class="offcanvas-body">

        <div class="filter-card"
             id="filterCardMobile"
             style="box-shadow:none;border:none;padding:0">
        </div>

    </div>

</div>


<script>

    /* =========================
       DATA
    ========================== */

    const TOURS = [

        @foreach (var tour in Model)
        {
                <text>
                {
                    id: "@tour.Id",
                    title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tour.Name)),
                    description: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tour.ShortDescription ?? "")),
                    destination: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tour.DestinationName ?? "")),
                    category: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tour.CategoryName ?? "")),
                    duration: @tour.DurationDays,
                    nights: @tour.DurationNights,
                    price: @tour.Price.ToString(CultureInfo.InvariantCulture),
                    reservations: @tour.ReservationCount,
                    image: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tour.CoverImageUrl ?? ""))
                },
                </text>
        }

    ];


    /* =========================
       FILTER OPTIONS
    ========================== */

    const DUR_OPTS = [
        {
            key: "1-3",
            label: "1 - 3 Gün",
            min: 1,
            max: 3
        },
        {
            key: "4-5",
            label: "4 - 5 Gün",
            min: 4,
            max: 5
        },
        {
            key: "6-7",
            label: "6 - 7 Gün",
            min: 6,
            max: 7
        },
        {
            key: "8+",
            label: "8 Gün ve Üzeri",
            min: 8,
            max: 999
        }
    ];


    const PRICE_OPTS = [
        {
            key: "p1",
            label: "0 - 25.000 ₺",
            min: 0,
            max: 25000
        },
        {
            key: "p2",
            label: "25.000 - 40.000 ₺",
            min: 25000,
            max: 40000
        },
        {
            key: "p3",
            label: "40.000 - 60.000 ₺",
            min: 40000,
            max: 60000
        },
        {
            key: "p4",
            label: "60.000 ₺ ve üzeri",
            min: 60000,
            max: 999999999
        }
    ];


    const DEST_OPTS = [

        @foreach (var destination in destinations)
        {
                <text>
                {
                    key: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(destination)),
                    label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(destination))
                },
                </text>
        }

    ];


    const TYPE_OPTS = [

        @foreach (var category in categories)
        {
                <text>
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(category)),
                </text>
        }

    ];


    /* =========================
       STATE
    ========================== */

    const state = {

        q: "",

        dest: [],

        dur: [],

        price: [],

        type: [],

        sort: "onerilen"

    };


    /* =========================
       DESTINATION COUNT
    ========================== */

    function destCount(key) {

        return TOURS.filter(
            t => t.destination === key
        ).length;

    }


    /* =========================
       SIDEBAR
    ========================== */

    function sidebarHTML() {

        return `

        <h2>
            Turları Filtrele
        </h2>

        <p class="filter-sub">
            Sana en uygun rotayı bulmak için daralt.
        </p>


        <div class="filter-group">

            <h3>
                Tur Ara
            </h3>

            <div class="search-wrap">

                <svg width="16"
                     height="16"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <circle cx="11"
                            cy="11"
                            r="8"/>

                    <line x1="21"
                          y1="21"
                          x2="16.65"
                          y2="16.65"/>

                </svg>


                <input type="text"
                       class="f-search"
                       placeholder="Tur veya destinasyon ara" />

            </div>

        </div>


        <div class="filter-group">

            <h3>
                Destinasyon
            </h3>

            ${DEST_OPTS.map(o => `

                <label class="fcheck">

                    <span class="lbl">

                        <input type="checkbox"
                               class="f-dest"
                               value="${o.key}">

                        ${o.label}

                    </span>

                    <span class="cnt">
                        (${destCount(o.key)})
                    </span>

                </label>

            `).join("")}

        </div>


        <div class="filter-group">

            <h3>
                Tur Süresi
            </h3>

            ${DUR_OPTS.map(o => `

                <label class="fcheck">

                    <span class="lbl">

                        <input type="checkbox"
                               class="f-dur"
                               value="${o.key}">

                        ${o.label}

                    </span>

                </label>

            `).join("")}

        </div>


        <div class="filter-group">

            <h3>
                Fiyat Aralığı
            </h3>

            ${PRICE_OPTS.map(o => `

                <label class="fcheck">

                    <span class="lbl">

                        <input type="checkbox"
                               class="f-price"
                               value="${o.key}">

                        ${o.label}

                    </span>

                </label>

            `).join("")}

        </div>


        <div class="filter-group">

            <h3>
                Tur Tipi
            </h3>

            ${TYPE_OPTS.map(o => `

                <label class="fcheck">

                    <span class="lbl">

                        <input type="checkbox"
                               class="f-type"
                               value="${o}">

                        ${o}

                    </span>

                </label>

            `).join("")}

        </div>


        <div class="filter-actions">

            <button class="btn-teal"
                    type="button"
                    onclick="applyFromButton()">

                Filtreleri Uygula

            </button>


            <button class="clear-link"
                    type="button"
                    onclick="clearFilters()">

                Filtreleri Temizle

            </button>

        </div>

        `;

    }


    document.getElementById(
        "filterCardDesktop"
    ).innerHTML = sidebarHTML();


    document.getElementById(
        "filterCardMobile"
    ).innerHTML = sidebarHTML();


    /* =========================
       SYNC STATE
    ========================== */

    function syncState() {

        const search =
            document.querySelector(".f-search")?.value
                .trim()
                .toLowerCase() || "";


        state.q = search;


        state.dest =
            [
                ...document.querySelectorAll(
                    ".f-dest:checked"
                )
            ].map(i => i.value);


        state.dur =
            [
                ...document.querySelectorAll(
                    ".f-dur:checked"
                )
            ].map(i => i.value);


        state.price =
            [
                ...document.querySelectorAll(
                    ".f-price:checked"
                )
            ].map(i => i.value);


        state.type =
            [
                ...document.querySelectorAll(
                    ".f-type:checked"
                )
            ].map(i => i.value);


        state.dest =
            [...new Set(state.dest)];

        state.dur =
            [...new Set(state.dur)];

        state.price =
            [...new Set(state.price)];

        state.type =
            [...new Set(state.type)];

    }


    /* =========================
       FILTER
    ========================== */

    function getFiltered() {

        let list = TOURS.filter(t => {

            if (state.q) {

                const hay =
                    (
                        t.title +
                        " " +
                        t.description +
                        " " +
                        t.destination +
                        " " +
                        t.category
                    ).toLowerCase();


                if (!hay.includes(state.q)) {

                    return false;

                }

            }


            if (
                state.dest.length &&
                !state.dest.includes(t.destination)
            ) {

                return false;

            }


            if (state.dur.length) {

                const ok =
                    state.dur.some(k => {

                        const o =
                            DUR_OPTS.find(
                                d => d.key === k
                            );

                        return (
                            t.duration >= o.min &&
                            t.duration <= o.max
                        );

                    });


                if (!ok) {

                    return false;

                }

            }


            if (state.price.length) {

                const ok =
                    state.price.some(k => {

                        const o =
                            PRICE_OPTS.find(
                                p => p.key === k
                            );

                        return (
                            t.price >= o.min &&
                            t.price < o.max
                        );

                    });


                if (!ok) {

                    return false;

                }

            }


            if (
                state.type.length &&
                !state.type.includes(t.category)
            ) {

                return false;

            }


            return true;

        });


        /* SORT */

        switch (state.sort) {

            case "fiyat-artan":

                list.sort(
                    (a, b) =>
                        a.price - b.price
                );

                break;


            case "fiyat-azalan":

                list.sort(
                    (a, b) =>
                        b.price - a.price
                );

                break;


            case "puan":

                list.sort(
                    (a, b) =>
                        b.reservations -
                        a.reservations
                );

                break;

        }


        return list;

    }


    /* =========================
       FORMAT
    ========================== */

    function fmt(number) {

        return Number(number)
            .toLocaleString("tr-TR");

    }


    /* =========================
       CARD
    ========================== */

    function cardHTML(t) {

        const image =
            t.image
                ? `
                    <img src="${t.image}"
                         alt="${t.title}"
                         loading="lazy" />
                  `
                : `
                    <div class="tour-image-placeholder">

                        <i class="bi bi-image"></i>

                    </div>
                  `;


        const badge =
            t.reservations > 10
                ? `<span class="tour-badge">Popüler</span>`
                : "";


        return `

        <div class="col-md-6">

            <article class="tour-card">


                <div class="tour-media">

                    ${image}

                    ${badge}


                    <button class="fav"
                            type="button"
                            aria-label="Favorilere ekle"
                            onclick="this.classList.toggle('on')">

                        <svg width="18"
                             height="18"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">

                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>

                        </svg>

                    </button>

                </div>


                <div class="tour-body">


                    <div class="tour-topline">

                        <span class="tour-country">
                            ${t.destination || "Destinasyon"}
                        </span>

                        <span class="tour-cat">
                            ${t.category || "Tur"}
                        </span>

                    </div>


                    <h3 class="tour-title">
                        ${t.title}
                    </h3>


                    ${
                        t.description
                            ? `
                                <div class="tour-description">
                                    ${t.description}
                                </div>
                              `
                            : ""
                    }


                    <div class="tour-meta">

                        <span class="tour-meta-item">

                            <i class="bi bi-calendar3 me-1"></i>

                            ${t.duration} gün

                            ${
                                t.nights > 0
                                    ? ` / ${t.nights} gece`
                                    : ""
                            }

                        </span>


                        <span class="tour-meta-item">

                            <i class="bi bi-people me-1"></i>

                            ${t.reservations}
                            rezervasyon

                        </span>

                    </div>


                    <div class="tour-foot">

                        <div class="price">

                            <small>
                                Kişi başı
                            </small>

                            <b>

                                ${fmt(t.price)}

                                <span>
                                    TL
                                </span>

                            </b>

                        </div>


                        <a href="/Tours/TourDetail?id=${t.id}"
                           class="btn-incele">

                            Turu İncele

                        </a>

                    </div>

                </div>

            </article>

        </div>

        `;

    }


    /* =========================
       CHIPS
    ========================== */

    function chipsHTML() {

        const chips = [];


        state.dest.forEach(k => {

            const o =
                DEST_OPTS.find(
                    d => d.key === k
                );

            if (o) {

                chips.push({
                    text: o.label,
                    kind: "dest",
                    value: k
                });

            }

        });


        state.dur.forEach(k => {

            const o =
                DUR_OPTS.find(
                    d => d.key === k
                );

            if (o) {

                chips.push({
                    text: o.label,
                    kind: "dur",
                    value: k
                });

            }

        });


        state.price.forEach(k => {

            const o =
                PRICE_OPTS.find(
                    p => p.key === k
                );

            if (o) {

                chips.push({
                    text: o.label,
                    kind: "price",
                    value: k
                });

            }

        });


        state.type.forEach(v => {

            chips.push({
                text: v,
                kind: "type",
                value: v
            });

        });


        if (state.q) {

            chips.push({
                text: '"' + state.q + '"',
                kind: "q",
                value: state.q
            });

        }


        return chips
            .map(c => `

                <span class="chip"
                      onclick="removeChip(
                          '${c.kind}',
                          '${c.value.replace(/'/g, "\\'")}'
                      )">

                    ${c.text}

                    <span class="x">
                        ×
                    </span>

                </span>

            `)
            .join("");

    }


    /* =========================
       REMOVE CHIP
    ========================== */

    function removeChip(kind, value) {

        const uncheck =
            (selector, val) => {

                document
                    .querySelectorAll(selector)
                    .forEach(input => {

                        if (input.value === val) {

                            input.checked = false;

                        }

                    });

            };


        if (kind === "dest") {

            uncheck(".f-dest", value);

        }


        if (kind === "dur") {

            uncheck(".f-dur", value);

        }


        if (kind === "price") {

            uncheck(".f-price", value);

        }


        if (kind === "type") {

            uncheck(".f-type", value);

        }


        if (kind === "q") {

            document
                .querySelectorAll(".f-search")
                .forEach(i => {

                    i.value = "";

                });

        }


        syncState();

        render();

    }


    /* =========================
       RENDER
    ========================== */

    function render() {

        const list =
            getFiltered();


        const grid =
            document.getElementById(
                "tourGrid"
            );


        const empty =
            document.getElementById(
                "emptyState"
            );


        const resultCount =
            document.getElementById(
                "resultCount"
            );


        resultCount.textContent =
            list.length;


        document.getElementById(
            "activeChips"
        ).innerHTML =
            chipsHTML();


        if (list.length === 0) {

            grid.innerHTML = "";

            empty.style.display =
                "block";

            return;

        }


        grid.innerHTML =
            list.map(cardHTML).join("");


        empty.style.display =
            "none";

    }


    /* =========================
       EVENTS
    ========================== */

    document.addEventListener(
        "input",
        function (e) {

            if (
                e.target.matches(
                    ".f-search, .f-dest, .f-dur, .f-price, .f-type"
                )
            ) {

                syncState();

                render();

            }

        }
    );


    document.getElementById(
        "sortSelect"
    ).addEventListener(
        "change",
        function (e) {

            state.sort =
                e.target.value;

            render();

        }
    );


    /* =========================
       APPLY
    ========================== */

    function applyFromButton() {

        syncState();

        render();


        const offcanvas =
            document.getElementById(
                "filterOffcanvas"
            );


        const instance =
            bootstrap.Offcanvas
                .getInstance(offcanvas);


        if (instance) {

            instance.hide();

        }

    }


    /* =========================
       CLEAR
    ========================== */

    function clearFilters() {

        document
            .querySelectorAll(".f-search")
            .forEach(i => {

                i.value = "";

            });


        document
            .querySelectorAll(
                ".f-dest, .f-dur, .f-price, .f-type"
            )
            .forEach(i => {

                i.checked = false;

            });


        state.q = "";

        state.dest = [];

        state.dur = [];

        state.price = [];

        state.type = [];

        state.sort =
            "onerilen";


        document.getElementById(
            "sortSelect"
        ).value =
            "onerilen";


        syncState();

        render();

    }


    /* =========================
       INITIAL
    ========================== */

    syncState();

    render();

</script>