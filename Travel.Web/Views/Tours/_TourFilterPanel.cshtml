@model List<Travel.Web.DTOs.TourDtos.TourListItemDto>
@{
    // Masaüstü sidebar ve mobil offcanvas aynı partial'ı kullanır.
    var destinations = Model
        .Where(x => !string.IsNullOrWhiteSpace(x.DestinationName))
        .GroupBy(x => x.DestinationName!)
        .OrderBy(x => x.Key)
        .ToList();

    var categories = Model
        .Where(x => !string.IsNullOrWhiteSpace(x.CategoryName))
        .GroupBy(x => x.CategoryName!)
        .OrderBy(x => x.Key)
        .ToList();

    var priceOptions = new[]
    {
        ("p1", "0 - 25.000 ₺"),
        ("p2", "25.000 - 40.000 ₺"),
        ("p3", "40.000 - 60.000 ₺"),
        ("p4", "60.000 ₺ +")
    };

    var durationOptions = new[] { "1-3", "4-5", "6-7", "8+" };
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<h2>@L["Turları Filtrele"]</h2>
<p class="filter-sub">@L["Sana en uygun rotayı bulmak için daralt."]</p>

<div class="filter-group">
    <h3>@L["Tur Ara"]</h3>
    <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
        <input type="text" class="f-search" placeholder="@L["Tur veya destinasyon ara"]" />
    </div>
</div>

<div class="filter-group">
    <h3>@L["Tarih"]</h3>
    <div class="date-row">
        <div style="flex:1">
            <label>@L["En erken"]</label>
            <input type="date" class="f-from" min="@today" />
        </div>
        <div style="flex:1">
            <label>@L["En geç"]</label>
            <input type="date" class="f-to" min="@today" />
        </div>
    </div>
    <div class="mt-2">
        <label style="font-size:.72rem;color:var(--muted);font-weight:600">@L["Kişi Sayısı"]</label>
        <select class="pax-select f-pax">
            @for (var i = 1; i <= 8; i++)
            {
                <option value="@i">@i @L["kişi"]</option>
            }
        </select>
    </div>
</div>

<div class="filter-group">
    <h3>@L["Destinasyon"]</h3>
    @foreach (var group in destinations)
    {
        <label class="fcheck">
            <span class="lbl"><input type="checkbox" class="f-dest" value="@group.Key" /> @group.Key</span>
            <span class="cnt">(@group.Count())</span>
        </label>
    }
</div>

<div class="filter-group">
    <h3>@L["Kategori"]</h3>
    @foreach (var group in categories)
    {
        <label class="fcheck">
            <span class="lbl"><input type="checkbox" class="f-cat" value="@group.Key" /> @group.Key</span>
            <span class="cnt">(@group.Count())</span>
        </label>
    }
</div>

<div class="filter-group">
    <h3>@L["Fiyat Aralığı"]</h3>
    @foreach (var (key, label) in priceOptions)
    {
        <label class="fcheck">
            <span class="lbl"><input type="checkbox" class="f-price" value="@key" data-label="@label" /> @label</span>
        </label>
    }
</div>

<div class="filter-group">
    <h3>@L["Tur Süresi"]</h3>
    @foreach (var key in durationOptions)
    {
        var label = $"{key} {L["Gün"].Value}";
        <label class="fcheck">
            <span class="lbl"><input type="checkbox" class="f-dur" value="@key" data-label="@label" /> @label</span>
        </label>
    }
</div>

<div class="filter-actions">
    <button type="button" class="btn-teal" onclick="applyFromButton()">@L["Filtreleri Uygula"]</button>
    <button type="button" class="clear-link" onclick="clearFilters()">@L["Filtreleri Temizle"]</button>
</div>
