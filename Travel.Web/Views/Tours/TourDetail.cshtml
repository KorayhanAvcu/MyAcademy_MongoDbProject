@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* BREADCRUMB */
    .crumb {
        padding: 1.6rem 0 .2rem;
        font-size: .85rem;
        color: var(--muted)
    }

        .crumb a {
            color: var(--muted)
        }

            .crumb a:hover {
                color: var(--teal-dark)
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600
        }

    /* DETAIL HEADER */
    .detail-head {
        padding: 1rem 0 1.6rem
    }

    .cat-line {
        font-size: .82rem;
        color: var(--teal-dark);
        font-weight: 600;
        letter-spacing: .02em
    }

    .detail-head h1 {
        font-weight: 800;
        font-size: clamp(1.9rem,3.5vw,2.8rem);
        letter-spacing: -.6px;
        color: var(--navy);
        margin: .4rem 0 .7rem
    }

    .head-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .6rem 1.3rem;
        color: var(--muted);
        font-size: .92rem
    }

        .head-meta .rating {
            color: var(--navy);
            font-weight: 600
        }

        .head-meta .star {
            color: #f4a92c
        }

        .head-meta .dot-sep {
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: var(--line);
            display: inline-block
        }

    .head-actions {
        display: flex;
        gap: .6rem
    }

    .icon-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 999px;
        padding: .6rem 1.1rem;
        font-weight: 600;
        color: var(--navy);
        font-size: .9rem;
        transition: .2s;
        cursor: pointer
    }

        .icon-btn:hover {
            box-shadow: var(--shadow-sm);
            color: var(--teal-dark);
            border-color: var(--teal)
        }

        .icon-btn.on {
            color: #e0575b;
            border-color: #f0c5c7
        }

            .icon-btn.on svg {
                fill: currentColor
            }

    /* GALLERY */
    .gallery {
        padding-bottom: 2.4rem
    }

        .gallery .row {
            --bs-gutter-x: .9rem;
            --bs-gutter-y: .9rem
        }

    .g-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 16px;
        display: block;
        cursor: pointer;
        transition: .35s
    }

    .g-main {
        height: 434px
    }

    .g-small {
        height: 209px
    }

    .g-img:hover {
        filter: brightness(.94)
    }

    .g-wrap {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        height: 100%
    }

    .g-more {
        position: absolute;
        right: .7rem;
        bottom: .7rem;
        background: rgba(14,42,59,.82);
        color: #fff;
        font-size: .8rem;
        font-weight: 600;
        padding: .4rem .8rem;
        border-radius: 999px
    }

    /* LAYOUT */
    .body-section {
        padding-bottom: 4rem
    }

    .content-block {
        background: #fff;
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.9rem 1.9rem;
        margin-bottom: 1.5rem
    }

        .content-block h2 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.35rem;
            color: var(--navy);
            margin-bottom: 1rem
        }

        .content-block p {
            color: var(--muted);
            line-height: 1.75;
            margin-bottom: 1rem
        }

            .content-block p:last-child {
                margin-bottom: 0
            }

    /* HIGHLIGHTS */
    .hl-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .9rem
    }

        .hl-list li {
            display: flex;
            align-items: flex-start;
            gap: .7rem;
            color: var(--navy);
            font-size: .95rem;
            font-weight: 500
        }

    .hl-ico {
        flex: none;
        width: 26px;
        height: 26px;
        border-radius: 8px;
        background: rgba(15,163,163,.12);
        color: var(--teal-dark);
        display: grid;
        place-items: center;
        margin-top: 1px
    }

    /* ITINERARY */
    .itin-item {
        border: 1px solid var(--line);
        border-radius: 14px;
        margin-bottom: .8rem;
        overflow: hidden;
        background: #fff;
        transition: .25s
    }

        .itin-item.open {
            box-shadow: var(--shadow-sm);
            border-color: rgba(15,163,163,.4)
        }

    .itin-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.05rem 1.2rem;
        cursor: pointer;
        user-select: none
    }

    .day-tag {
        flex: none;
        font-family: 'Sora';
        font-weight: 700;
        font-size: .74rem;
        letter-spacing: .03em;
        color: var(--teal-dark);
        background: rgba(15,163,163,.1);
        padding: .35rem .7rem;
        border-radius: 999px;
        white-space: nowrap
    }

    .itin-title {
        font-family: 'Sora';
        font-weight: 600;
        color: var(--navy);
        font-size: 1rem;
        flex: 1
    }

    .itin-toggle {
        flex: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--cream);
        display: grid;
        place-items: center;
        color: var(--navy);
        transition: .3s
    }

    .itin-item.open .itin-toggle {
        background: var(--navy);
        color: #fff;
        transform: rotate(180deg)
    }

    .itin-body {
        max-height: 0;
        overflow: hidden;
        transition: max-height .35s ease
    }

    .itin-inner {
        padding: 0 1.2rem 1.2rem 1.2rem;
        color: var(--muted);
        line-height: 1.7;
        font-size: .94rem
    }

        .itin-inner ul {
            margin: .4rem 0 .8rem;
            padding-left: 1.1rem
        }

        .itin-inner li {
            margin-bottom: .25rem
        }

    .itin-tags {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin-top: .6rem
    }

        .itin-tags span {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            font-size: .78rem;
            color: var(--navy);
            background: var(--cream);
            border: 1px solid var(--line);
            padding: .28rem .7rem;
            border-radius: 999px
        }

    /* INCLUDES */
    .inc-list {
        list-style: none;
        margin: 0;
        padding: 0
    }

        .inc-list li {
            display: flex;
            align-items: flex-start;
            gap: .65rem;
            color: var(--navy);
            font-size: .94rem;
            padding: .42rem 0
        }

    .inc-yes {
        color: var(--teal-dark);
        flex: none;
        margin-top: 1px
    }

    .inc-no {
        color: #c26060;
        flex: none;
        margin-top: 1px
    }

    /* INFO GRID */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1.2rem
    }

    .info-cell {
        padding: .2rem 0
    }

        .info-cell .k {
            font-size: .76rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--muted);
            font-weight: 600;
            margin-bottom: .2rem
        }

        .info-cell .v {
            font-family: 'Sora';
            font-weight: 600;
            color: var(--navy);
            font-size: .98rem
        }

    .meet-note {
        background: var(--cream);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 1rem 1.2rem;
        margin-top: 1.2rem
    }

        .meet-note b {
            color: var(--navy);
            font-family: 'Sora'
        }

        .meet-note p {
            margin: .3rem 0 0;
            font-size: .9rem
        }

    /* BOOKING CARD */
    .book-card {
        background: #fff;
        border-radius: var(--r);
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.6rem 1.5rem
    }

    .book-sticky {
        position: sticky;
        top: 90px
    }

    .price-top small {
        color: var(--muted);
        font-size: .82rem
    }

    .price-top .big {
        font-family: 'Sora';
        font-weight: 800;
        font-size: 2rem;
        color: var(--navy);
        line-height: 1.1
    }

        .price-top .big span {
            font-size: 1rem;
            color: var(--muted);
            font-weight: 600
        }

    .price-note {
        font-size: .78rem;
        color: var(--muted);
        margin-top: .2rem
    }

    .book-label {
        font-family: 'Sora';
        font-weight: 600;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--navy);
        margin: 1.3rem 0 .7rem
    }

    .date-opt {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: .7rem .9rem;
        margin-bottom: .55rem;
        cursor: pointer;
        transition: .2s
    }

        .date-opt:hover {
            border-color: var(--teal)
        }

        .date-opt.sel {
            border-color: var(--teal);
            background: rgba(15,163,163,.06);
            box-shadow: 0 0 0 2px rgba(15,163,163,.12)
        }

        .date-opt .d {
            font-weight: 600;
            color: var(--navy);
            font-size: .92rem
        }

        .date-opt .left {
            font-size: .72rem;
            color: #c26a45;
            font-weight: 600
        }

        .date-opt input {
            display: none
        }

    .counter-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .55rem 0
    }

        .counter-row .cl b {
            display: block;
            color: var(--navy);
            font-size: .94rem;
            font-family: 'Sora'
        }

        .counter-row .cl span {
            font-size: .78rem;
            color: var(--muted)
        }

    .counter {
        display: flex;
        align-items: center;
        gap: .8rem
    }

        .counter button {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid var(--line);
            background: #fff;
            color: var(--navy);
            font-size: 1.1rem;
            font-weight: 600;
            display: grid;
            place-items: center;
            cursor: pointer;
            transition: .2s;
            line-height: 1
        }

            .counter button:hover {
                border-color: var(--teal);
                color: var(--teal-dark)
            }

            .counter button:disabled {
                opacity: .4;
                cursor: not-allowed
            }

        .counter .val {
            min-width: 20px;
            text-align: center;
            font-weight: 700;
            color: var(--navy)
        }

    .summary {
        border-top: 1px solid var(--line);
        margin-top: 1rem;
        padding-top: 1rem
    }

        .summary .row-line {
            display: flex;
            justify-content: space-between;
            font-size: .9rem;
            color: var(--muted);
            margin-bottom: .45rem
        }

            .summary .row-line b {
                color: var(--navy);
                font-weight: 600
            }

        .summary .total {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--line);
            margin-top: .6rem;
            padding-top: .8rem
        }

            .summary .total span {
                font-family: 'Sora';
                font-weight: 600;
                color: var(--navy)
            }

            .summary .total b {
                font-family: 'Sora';
                font-weight: 800;
                font-size: 1.5rem;
                color: var(--navy)
            }

    .book-card .btn-teal {
        width: 100%;
        margin-top: 1.1rem
    }

    .trust {
        display: flex;
        justify-content: center;
        gap: 1.2rem;
        margin-top: .9rem;
        font-size: .78rem;
        color: var(--muted)
    }

        .trust span {
            display: inline-flex;
            align-items: center;
            gap: .35rem
        }

    /* REVIEWS */
    .rev-summary {
        display: flex;
        gap: 2.4rem;
        flex-wrap: wrap;
        align-items: center
    }

    .rev-score {
        text-align: center
    }

        .rev-score .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 3rem;
            color: var(--navy);
            line-height: 1
        }

        .rev-score .stars {
            color: #f4a92c;
            margin: .3rem 0
        }

        .rev-score .cnt {
            font-size: .82rem;
            color: var(--muted)
        }

    .rev-bars {
        flex: 1;
        min-width: 220px
    }

    .bar-row {
        display: flex;
        align-items: center;
        gap: .7rem;
        margin-bottom: .5rem
    }

        .bar-row .lab {
            font-size: .82rem;
            color: var(--muted);
            width: 52px
        }

    .bar-track {
        flex: 1;
        height: 8px;
        background: var(--cream);
        border-radius: 999px;
        overflow: hidden
    }

    .bar-fill {
        height: 100%;
        background: var(--teal);
        border-radius: 999px
    }

    .bar-row .pct {
        font-size: .8rem;
        color: var(--muted);
        width: 36px;
        text-align: right
    }

    .review-card {
        border-top: 1px solid var(--line);
        padding: 1.3rem 0
    }

        .review-card:first-of-type {
            border-top: none
        }

    .rev-user {
        display: flex;
        align-items: center;
        gap: .8rem;
        margin-bottom: .5rem
    }

        .rev-user img {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover
        }

        .rev-user b {
            display: block;
            color: var(--navy);
            font-size: .95rem;
            font-family: 'Sora'
        }

        .rev-user .sub {
            color: var(--muted);
            font-size: .8rem
        }

    .rev-stars {
        color: #f4a92c;
        font-size: .85rem;
        margin-left: auto
    }

        .rev-stars .off {
            color: #d8cfc0
        }

    .review-card p {
        color: var(--navy);
        line-height: 1.65;
        margin: 0;
        font-size: .95rem
    }

    .write-box {
        background: var(--cream);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.4rem 1.5rem;
        margin-top: 1.4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap
    }

        .write-box b {
            font-family: 'Sora';
            color: var(--navy);
            font-size: 1.05rem
        }

        .write-box p {
            margin: .2rem 0 0;
            color: var(--muted);
            font-size: .88rem
        }

    /* Q&A */
    .qa-item {
        border-top: 1px solid var(--line);
        padding: 1.2rem 0
    }

        .qa-item:first-of-type {
            border-top: none
        }

    .qa-q {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        margin-bottom: .7rem
    }

    .qa-avatar {
        flex: none;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--navy);
        color: #fff;
        display: grid;
        place-items: center;
        font-size: .82rem;
        font-weight: 700;
        font-family: 'Sora'
    }

    .qa-q .who {
        font-family: 'Sora';
        font-weight: 600;
        color: var(--navy);
        font-size: .92rem
    }

    .qa-q .txt {
        color: var(--navy);
        font-size: .94rem;
        margin-top: .1rem
    }

    .qa-a {
        display: flex;
        gap: .7rem;
        margin-left: 2.1rem;
        background: rgba(15,163,163,.06);
        border-radius: 12px;
        padding: .8rem 1rem
    }

        .qa-a .brand-mini {
            flex: none;
            font-family: 'Sora';
            font-weight: 700;
            color: var(--teal-dark);
            font-size: .82rem;
            white-space: nowrap
        }

        .qa-a .txt {
            color: var(--muted);
            font-size: .9rem;
            line-height: 1.6
        }

    .ask-box {
        margin-top: 1.4rem
    }

        .ask-box textarea {
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: .9rem 1rem;
            font-size: .92rem;
            color: var(--navy);
            outline: none;
            background: var(--cream);
            resize: vertical;
            min-height: 90px
        }

            .ask-box textarea:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.12)
            }

    /* SIMILAR TOURS */
    .tour-card {
        background: #fff;
        border-radius: var(--r);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: .3s;
        height: 100%;
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(231,226,216,.7);
    }

        .tour-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md)
        }

    .tour-media {
        position: relative;
        height: 200px;
        overflow: hidden
    }

        .tour-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: .5s
        }

    .tour-card:hover .tour-media img {
        transform: scale(1.07)
    }

    .tour-badge {
        position: absolute;
        top: .85rem;
        left: .85rem;
        background: rgba(255,255,255,.94);
        color: var(--navy);
        font-weight: 600;
        font-size: .75rem;
        padding: .32rem .7rem;
        border-radius: 999px;
    }

    .tour-body {
        padding: 1.15rem 1.25rem 1.3rem;
        display: flex;
        flex-direction: column;
        flex: 1
    }

    .tour-country {
        font-size: .78rem;
        color: var(--teal-dark);
        font-weight: 600
    }

    .tour-title {
        font-family: 'Sora';
        font-weight: 700;
        font-size: 1.1rem;
        margin: .15rem 0 .5rem;
        color: var(--navy)
    }

    .tour-meta {
        display: flex;
        align-items: center;
        gap: .9rem;
        font-size: .84rem;
        color: var(--muted);
        margin-bottom: .9rem
    }

        .tour-meta .star {
            color: #f4a92c
        }

    .tour-foot {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-top: auto;
        padding-top: .5rem;
        border-top: 1px solid var(--line)
    }

    .price small {
        color: var(--muted);
        font-size: .72rem;
        display: block
    }

    .price b {
        font-family: 'Sora';
        font-size: 1.24rem;
        color: var(--navy)
    }

        .price b span {
            font-size: .85rem;
            font-weight: 600;
            color: var(--muted)
        }

    .btn-incele {
        background: var(--navy);
        color: #fff;
        border-radius: 999px;
        font-size: .85rem;
        font-weight: 600;
        padding: .55rem 1.1rem;
        border: none;
        transition: .25s
    }

        .btn-incele:hover {
            background: var(--teal-dark);
            color: #fff
        }

    /* MODAL */
    .modal-content {
        border-radius: var(--r);
        border: none
    }

    .star-pick {
        font-size: 1.7rem;
        color: #d8cfc0;
        cursor: pointer;
        transition: .15s
    }

        .star-pick.on {
            color: #f4a92c
        }

    /* RESPONSIVE */
    @@media(max - width:991px) {
        .book-sticky {
            position: static;
            margin-top: 1.5rem
        }

        .g-main {
            height: 280px
        }

        .g-small {
            height: 150px
        }

        .info-grid {
            grid-template-columns: 1fr 1fr
        }

        .hl-list {
            grid-template-columns: 1fr
        }
    }

    @@media(max - width:575px) {
        .info-grid {
            grid-template-columns: 1fr
        }

        .rev-summary {
            gap: 1.4rem
        }
    }
</style>

@await Component.InvokeAsync("_TourDetail", new { model = Model })
<!-- REVIEW MODAL -->
@if (User.Identity?.IsAuthenticated == true && !Model.HasReviewed)
{
    <div class="modal fade" id="reviewModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" asp-controller="Tours" asp-action="AddReview" method="post" onsubmit="return validateReview()">
                <input type="hidden" name="TourId" value="@Model.Id" />
                <input type="hidden" name="Rating" id="ratingInput" value="0" />
                <div class="modal-header border-0">
                    <h5 class="modal-title" style="font-family:'Sora';font-weight:700;color:var(--navy)">@L["Deneyimini Paylaş"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="book-label" style="margin-top:0">@L["Puanın"]</div>
                    <div id="starPicker" class="mb-3">
                        <span class="star-pick" data-v="1">★</span><span class="star-pick" data-v="2">★</span><span class="star-pick" data-v="3">★</span><span class="star-pick" data-v="4">★</span><span class="star-pick" data-v="5">★</span>
                    </div>
                    <div class="book-label" style="margin-top:0">@L["Yorumun"]</div>
                    <textarea name="Comment" id="reviewText" class="form-control" style="border-radius:14px;border-color:var(--line);min-height:110px" minlength="10" maxlength="1000" placeholder="@L["Tur deneyimini birkaç cümleyle anlat..."]"></textarea>
                    <div id="reviewErr" style="display:none;color:#b45a4f;font-size:.85rem;margin-top:.5rem"></div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn-teal">@L["Yorumu Gönder"]</button>
                </div>
            </form>
        </div>
    </div>
}

@Html.AntiForgeryToken()

@{
    string Js(string key) => System.Text.Json.JsonSerializer.Serialize(L[key].Value);
}

<script>
    const I18N = {
        adult: @Html.Raw(Js("Yetişkin")),
        child: @Html.Raw(Js("Çocuk")),
        capLeft: @Html.Raw(Js("Seçilen tarihte kalan kontenjan:")),
        pickStar: @Html.Raw(Js("Lütfen bir puan seç.")),
        writeReview: @Html.Raw(Js("Yorum en az 10 karakter olmalıdır.")),
        saved: @Html.Raw(Js("Favorilerde")),
        save: @Html.Raw(Js("Kaydet")),
        copied: @Html.Raw(Js("Bağlantı panoya kopyalandı."))
    };

    /* ---------- ITINERARY (accordion) ---------- */
    function toggleDay(head){
      const item = head.parentElement;
      const body = item.querySelector(".itin-body");
      if(item.classList.contains("open")){ item.classList.remove("open"); body.style.maxHeight = "0"; }
      else { item.classList.add("open"); body.style.maxHeight = body.scrollHeight + 40 + "px"; }
    }

    /* ---------- BOOKING ---------- */
    const UNIT = @Model.Price.ToString(CultureInfo.InvariantCulture);
    const CHILD_UNIT = @Model.ChildPrice.ToString(CultureInfo.InvariantCulture);
    let adult = 2, child = 0;

    function fmt(n){ return Math.round(n).toLocaleString("tr-TR") + " TL"; }

    function selectedRemaining(){
      const sel = document.querySelector(".date-opt.sel");
      return sel ? parseInt(sel.dataset.remaining || "0", 10) : 0;
    }

    function changeCount(type, delta){
      const remaining = selectedRemaining();
      if(type === "adult"){
        const next = Math.max(1, adult + delta);
        if(delta > 0 && next + child > remaining) return;
        adult = next;
      } else {
        const next = Math.max(0, child + delta);
        if(delta > 0 && adult + next > remaining) return;
        child = next;
      }
      updateSummary();
    }

    function updateSummary(){
      const remaining = selectedRemaining();
      // Seçilen tarih değiştiğinde kişi sayısını kontenjana sığdır.
      if(remaining > 0 && adult + child > remaining){ adult = Math.min(adult, remaining); child = Math.max(0, remaining - adult); }

      document.getElementById("adultVal").textContent = adult;
      document.getElementById("childVal").textContent = child;
      document.getElementById("adultInput").value = adult;
      document.getElementById("childInput").value = child;
      document.getElementById("adultMinus").disabled = adult <= 1;
      document.getElementById("childMinus").disabled = child <= 0;
      document.getElementById("adultPlus").disabled = adult + child >= remaining;
      document.getElementById("childPlus").disabled = adult + child >= remaining;

      const adultSum = adult * UNIT, childSum = child * CHILD_UNIT;
      document.getElementById("adultLine").textContent = adult + " " + I18N.adult + " (" + fmt(UNIT) + ")";
      document.getElementById("adultSum").textContent = fmt(adultSum);

      const childRow = document.getElementById("childRow");
      if(child > 0){
        childRow.style.display = "flex";
        document.getElementById("childLine").textContent = child + " " + I18N.child + " (" + fmt(CHILD_UNIT) + ")";
        document.getElementById("childSum").textContent = fmt(childSum);
      } else { childRow.style.display = "none"; }

      document.getElementById("grandTotal").textContent = fmt(adultSum + childSum);

      const warn = document.getElementById("capWarn");
      if(remaining > 0 && remaining <= 10){ warn.style.display = "block"; warn.textContent = I18N.capLeft + " " + remaining; }
      else { warn.style.display = "none"; }
    }

    document.querySelectorAll(".date-opt").forEach(opt => {
      opt.addEventListener("click", () => {
        if(opt.classList.contains("full")) return;
        document.querySelectorAll(".date-opt").forEach(o => o.classList.remove("sel"));
        opt.classList.add("sel");
        opt.querySelector("input").checked = true;
        updateSummary();
      });
    });

    if(document.getElementById("adultVal")) updateSummary();

    /* ---------- FAVORITE ---------- */
    async function toggleFavorite(btn){
      const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
      const body = new URLSearchParams({ tourId: btn.dataset.tourId, __RequestVerificationToken: token });
      const res = await fetch("/Tours/ToggleFavorite", { method: "POST", body });
      if(res.status === 401){ window.location.href = "/Auth/SignIn"; return; }
      if(!res.ok) return;
      const data = await res.json();
      btn.classList.toggle("on", data.isFavorite);
      btn.querySelector(".fav-label").textContent = data.isFavorite ? I18N.saved : I18N.save;
    }

    function sharePage(){
      if(navigator.share){ navigator.share({ title: document.title, url: location.href }).catch(() => {}); }
      else { navigator.clipboard?.writeText(location.href); alert(I18N.copied); }
    }

    /* ---------- REVIEW MODAL ---------- */
    let pickedStars = 0;
    document.querySelectorAll(".star-pick").forEach(s => {
      s.addEventListener("click", () => {
        pickedStars = +s.dataset.v;
        document.getElementById("ratingInput").value = pickedStars;
        document.querySelectorAll(".star-pick").forEach(x => x.classList.toggle("on", +x.dataset.v <= pickedStars));
      });
    });

    function validateReview(){
      const err = document.getElementById("reviewErr");
      const txt = document.getElementById("reviewText").value.trim();
      if(!pickedStars){ err.textContent = I18N.pickStar; err.style.display = "block"; return false; }
      if(txt.length < 10){ err.textContent = I18N.writeReview; err.style.display = "block"; return false; }
      return true;
    }
</script>
