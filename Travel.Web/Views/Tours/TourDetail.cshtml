@model Travel.Web.DTOs.TourDtos.TourDetailDto
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* BREADCRUMB */
    .crumb {
        padding: 1.6rem 0 .2rem;
        font-size: .85rem;
        color: var(--muted)
    }

        .crumb a {
            color: var(--muted)
        }

            .crumb a:hover {
                color: var(--teal-dark)
            }

        .crumb .cur {
            color: var(--navy);
            font-weight: 600
        }

    /* DETAIL HEADER */
    .detail-head {
        padding: 1rem 0 1.6rem
    }

    .cat-line {
        font-size: .82rem;
        color: var(--teal-dark);
        font-weight: 600;
        letter-spacing: .02em
    }

    .detail-head h1 {
        font-weight: 800;
        font-size: clamp(1.9rem,3.5vw,2.8rem);
        letter-spacing: -.6px;
        color: var(--navy);
        margin: .4rem 0 .7rem
    }

    .head-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .6rem 1.3rem;
        color: var(--muted);
        font-size: .92rem
    }

        .head-meta .rating {
            color: var(--navy);
            font-weight: 600
        }

        .head-meta .star {
            color: #f4a92c
        }

        .head-meta .dot-sep {
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: var(--line);
            display: inline-block
        }

    .head-actions {
        display: flex;
        gap: .6rem
    }

    .icon-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 999px;
        padding: .6rem 1.1rem;
        font-weight: 600;
        color: var(--navy);
        font-size: .9rem;
        transition: .2s;
        cursor: pointer
    }

        .icon-btn:hover {
            box-shadow: var(--shadow-sm);
            color: var(--teal-dark);
            border-color: var(--teal)
        }

        .icon-btn.on {
            color: #e0575b;
            border-color: #f0c5c7
        }

            .icon-btn.on svg {
                fill: currentColor
            }

    /* GALLERY */
    .gallery {
        padding-bottom: 2.4rem
    }

        .gallery .row {
            --bs-gutter-x: .9rem;
            --bs-gutter-y: .9rem
        }

    .g-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 16px;
        display: block;
        cursor: pointer;
        transition: .35s
    }

    .g-main {
        height: 434px
    }

    .g-small {
        height: 209px
    }

    .g-img:hover {
        filter: brightness(.94)
    }

    .g-wrap {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        height: 100%
    }

    .g-more {
        position: absolute;
        right: .7rem;
        bottom: .7rem;
        background: rgba(14,42,59,.82);
        color: #fff;
        font-size: .8rem;
        font-weight: 600;
        padding: .4rem .8rem;
        border-radius: 999px
    }

    /* LAYOUT */
    .body-section {
        padding-bottom: 4rem
    }

    .content-block {
        background: #fff;
        border-radius: var(--r);
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.9rem 1.9rem;
        margin-bottom: 1.5rem
    }

        .content-block h2 {
            font-family: 'Sora';
            font-weight: 700;
            font-size: 1.35rem;
            color: var(--navy);
            margin-bottom: 1rem
        }

        .content-block p {
            color: var(--muted);
            line-height: 1.75;
            margin-bottom: 1rem
        }

            .content-block p:last-child {
                margin-bottom: 0
            }

    /* HIGHLIGHTS */
    .hl-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .9rem
    }

        .hl-list li {
            display: flex;
            align-items: flex-start;
            gap: .7rem;
            color: var(--navy);
            font-size: .95rem;
            font-weight: 500
        }

    .hl-ico {
        flex: none;
        width: 26px;
        height: 26px;
        border-radius: 8px;
        background: rgba(15,163,163,.12);
        color: var(--teal-dark);
        display: grid;
        place-items: center;
        margin-top: 1px
    }

    /* ITINERARY */
    .itin-item {
        border: 1px solid var(--line);
        border-radius: 14px;
        margin-bottom: .8rem;
        overflow: hidden;
        background: #fff;
        transition: .25s
    }

        .itin-item.open {
            box-shadow: var(--shadow-sm);
            border-color: rgba(15,163,163,.4)
        }

    .itin-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.05rem 1.2rem;
        cursor: pointer;
        user-select: none
    }

    .day-tag {
        flex: none;
        font-family: 'Sora';
        font-weight: 700;
        font-size: .74rem;
        letter-spacing: .03em;
        color: var(--teal-dark);
        background: rgba(15,163,163,.1);
        padding: .35rem .7rem;
        border-radius: 999px;
        white-space: nowrap
    }

    .itin-title {
        font-family: 'Sora';
        font-weight: 600;
        color: var(--navy);
        font-size: 1rem;
        flex: 1
    }

    .itin-toggle {
        flex: none;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--cream);
        display: grid;
        place-items: center;
        color: var(--navy);
        transition: .3s
    }

    .itin-item.open .itin-toggle {
        background: var(--navy);
        color: #fff;
        transform: rotate(180deg)
    }

    .itin-body {
        max-height: 0;
        overflow: hidden;
        transition: max-height .35s ease
    }

    .itin-inner {
        padding: 0 1.2rem 1.2rem 1.2rem;
        color: var(--muted);
        line-height: 1.7;
        font-size: .94rem
    }

        .itin-inner ul {
            margin: .4rem 0 .8rem;
            padding-left: 1.1rem
        }

        .itin-inner li {
            margin-bottom: .25rem
        }

    .itin-tags {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin-top: .6rem
    }

        .itin-tags span {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            font-size: .78rem;
            color: var(--navy);
            background: var(--cream);
            border: 1px solid var(--line);
            padding: .28rem .7rem;
            border-radius: 999px
        }

    /* INCLUDES */
    .inc-list {
        list-style: none;
        margin: 0;
        padding: 0
    }

        .inc-list li {
            display: flex;
            align-items: flex-start;
            gap: .65rem;
            color: var(--navy);
            font-size: .94rem;
            padding: .42rem 0
        }

    .inc-yes {
        color: var(--teal-dark);
        flex: none;
        margin-top: 1px
    }

    .inc-no {
        color: #c26060;
        flex: none;
        margin-top: 1px
    }

    /* INFO GRID */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 1.2rem
    }

    .info-cell {
        padding: .2rem 0
    }

        .info-cell .k {
            font-size: .76rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--muted);
            font-weight: 600;
            margin-bottom: .2rem
        }

        .info-cell .v {
            font-family: 'Sora';
            font-weight: 600;
            color: var(--navy);
            font-size: .98rem
        }

    .meet-note {
        background: var(--cream);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 1rem 1.2rem;
        margin-top: 1.2rem
    }

        .meet-note b {
            color: var(--navy);
            font-family: 'Sora'
        }

        .meet-note p {
            margin: .3rem 0 0;
            font-size: .9rem
        }

    /* BOOKING CARD */
    .book-card {
        background: #fff;
        border-radius: var(--r);
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(231,226,216,.7);
        padding: 1.6rem 1.5rem
    }

    .book-sticky {
        position: sticky;
        top: 90px
    }

    .price-top small {
        color: var(--muted);
        font-size: .82rem
    }

    .price-top .big {
        font-family: 'Sora';
        font-weight: 800;
        font-size: 2rem;
        color: var(--navy);
        line-height: 1.1
    }

        .price-top .big span {
            font-size: 1rem;
            color: var(--muted);
            font-weight: 600
        }

    .price-note {
        font-size: .78rem;
        color: var(--muted);
        margin-top: .2rem
    }

    .book-label {
        font-family: 'Sora';
        font-weight: 600;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--navy);
        margin: 1.3rem 0 .7rem
    }

    .date-opt {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: .7rem .9rem;
        margin-bottom: .55rem;
        cursor: pointer;
        transition: .2s
    }

        .date-opt:hover {
            border-color: var(--teal)
        }

        .date-opt.sel {
            border-color: var(--teal);
            background: rgba(15,163,163,.06);
            box-shadow: 0 0 0 2px rgba(15,163,163,.12)
        }

        .date-opt .d {
            font-weight: 600;
            color: var(--navy);
            font-size: .92rem
        }

        .date-opt .left {
            font-size: .72rem;
            color: #c26a45;
            font-weight: 600
        }

        .date-opt input {
            display: none
        }

    .counter-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .55rem 0
    }

        .counter-row .cl b {
            display: block;
            color: var(--navy);
            font-size: .94rem;
            font-family: 'Sora'
        }

        .counter-row .cl span {
            font-size: .78rem;
            color: var(--muted)
        }

    .counter {
        display: flex;
        align-items: center;
        gap: .8rem
    }

        .counter button {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid var(--line);
            background: #fff;
            color: var(--navy);
            font-size: 1.1rem;
            font-weight: 600;
            display: grid;
            place-items: center;
            cursor: pointer;
            transition: .2s;
            line-height: 1
        }

            .counter button:hover {
                border-color: var(--teal);
                color: var(--teal-dark)
            }

            .counter button:disabled {
                opacity: .4;
                cursor: not-allowed
            }

        .counter .val {
            min-width: 20px;
            text-align: center;
            font-weight: 700;
            color: var(--navy)
        }

    .summary {
        border-top: 1px solid var(--line);
        margin-top: 1rem;
        padding-top: 1rem
    }

        .summary .row-line {
            display: flex;
            justify-content: space-between;
            font-size: .9rem;
            color: var(--muted);
            margin-bottom: .45rem
        }

            .summary .row-line b {
                color: var(--navy);
                font-weight: 600
            }

        .summary .total {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--line);
            margin-top: .6rem;
            padding-top: .8rem
        }

            .summary .total span {
                font-family: 'Sora';
                font-weight: 600;
                color: var(--navy)
            }

            .summary .total b {
                font-family: 'Sora';
                font-weight: 800;
                font-size: 1.5rem;
                color: var(--navy)
            }

    .book-card .btn-teal {
        width: 100%;
        margin-top: 1.1rem
    }

    .trust {
        display: flex;
        justify-content: center;
        gap: 1.2rem;
        margin-top: .9rem;
        font-size: .78rem;
        color: var(--muted)
    }

        .trust span {
            display: inline-flex;
            align-items: center;
            gap: .35rem
        }

    /* REVIEWS */
    .rev-summary {
        display: flex;
        gap: 2.4rem;
        flex-wrap: wrap;
        align-items: center
    }

    .rev-score {
        text-align: center
    }

        .rev-score .num {
            font-family: 'Sora';
            font-weight: 800;
            font-size: 3rem;
            color: var(--navy);
            line-height: 1
        }

        .rev-score .stars {
            color: #f4a92c;
            margin: .3rem 0
        }

        .rev-score .cnt {
            font-size: .82rem;
            color: var(--muted)
        }

    .rev-bars {
        flex: 1;
        min-width: 220px
    }

    .bar-row {
        display: flex;
        align-items: center;
        gap: .7rem;
        margin-bottom: .5rem
    }

        .bar-row .lab {
            font-size: .82rem;
            color: var(--muted);
            width: 52px
        }

    .bar-track {
        flex: 1;
        height: 8px;
        background: var(--cream);
        border-radius: 999px;
        overflow: hidden
    }

    .bar-fill {
        height: 100%;
        background: var(--teal);
        border-radius: 999px
    }

    .bar-row .pct {
        font-size: .8rem;
        color: var(--muted);
        width: 36px;
        text-align: right
    }

    .review-card {
        border-top: 1px solid var(--line);
        padding: 1.3rem 0
    }

        .review-card:first-of-type {
            border-top: none
        }

    .rev-user {
        display: flex;
        align-items: center;
        gap: .8rem;
        margin-bottom: .5rem
    }

        .rev-user img {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover
        }

        .rev-user b {
            display: block;
            color: var(--navy);
            font-size: .95rem;
            font-family: 'Sora'
        }

        .rev-user .sub {
            color: var(--muted);
            font-size: .8rem
        }

    .rev-stars {
        color: #f4a92c;
        font-size: .85rem;
        margin-left: auto
    }

        .rev-stars .off {
            color: #d8cfc0
        }

    .review-card p {
        color: var(--navy);
        line-height: 1.65;
        margin: 0;
        font-size: .95rem
    }

    .write-box {
        background: var(--cream);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.4rem 1.5rem;
        margin-top: 1.4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap
    }

        .write-box b {
            font-family: 'Sora';
            color: var(--navy);
            font-size: 1.05rem
        }

        .write-box p {
            margin: .2rem 0 0;
            color: var(--muted);
            font-size: .88rem
        }

    /* Q&A */
    .qa-item {
        border-top: 1px solid var(--line);
        padding: 1.2rem 0
    }

        .qa-item:first-of-type {
            border-top: none
        }

    .qa-q {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        margin-bottom: .7rem
    }

    .qa-avatar {
        flex: none;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--navy);
        color: #fff;
        display: grid;
        place-items: center;
        font-size: .82rem;
        font-weight: 700;
        font-family: 'Sora'
    }

    .qa-q .who {
        font-family: 'Sora';
        font-weight: 600;
        color: var(--navy);
        font-size: .92rem
    }

    .qa-q .txt {
        color: var(--navy);
        font-size: .94rem;
        margin-top: .1rem
    }

    .qa-a {
        display: flex;
        gap: .7rem;
        margin-left: 2.1rem;
        background: rgba(15,163,163,.06);
        border-radius: 12px;
        padding: .8rem 1rem
    }

        .qa-a .brand-mini {
            flex: none;
            font-family: 'Sora';
            font-weight: 700;
            color: var(--teal-dark);
            font-size: .82rem;
            white-space: nowrap
        }

        .qa-a .txt {
            color: var(--muted);
            font-size: .9rem;
            line-height: 1.6
        }

    .ask-box {
        margin-top: 1.4rem
    }

        .ask-box textarea {
            width: 100%;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: .9rem 1rem;
            font-size: .92rem;
            color: var(--navy);
            outline: none;
            background: var(--cream);
            resize: vertical;
            min-height: 90px
        }

            .ask-box textarea:focus {
                border-color: var(--teal);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(15,163,163,.12)
            }

    /* SIMILAR TOURS */
    .tour-card {
        background: #fff;
        border-radius: var(--r);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: .3s;
        height: 100%;
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(231,226,216,.7);
    }

        .tour-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md)
        }

    .tour-media {
        position: relative;
        height: 200px;
        overflow: hidden
    }

        .tour-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: .5s
        }

    .tour-card:hover .tour-media img {
        transform: scale(1.07)
    }

    .tour-badge {
        position: absolute;
        top: .85rem;
        left: .85rem;
        background: rgba(255,255,255,.94);
        color: var(--navy);
        font-weight: 600;
        font-size: .75rem;
        padding: .32rem .7rem;
        border-radius: 999px;
    }

    .tour-body {
        padding: 1.15rem 1.25rem 1.3rem;
        display: flex;
        flex-direction: column;
        flex: 1
    }

    .tour-country {
        font-size: .78rem;
        color: var(--teal-dark);
        font-weight: 600
    }

    .tour-title {
        font-family: 'Sora';
        font-weight: 700;
        font-size: 1.1rem;
        margin: .15rem 0 .5rem;
        color: var(--navy)
    }

    .tour-meta {
        display: flex;
        align-items: center;
        gap: .9rem;
        font-size: .84rem;
        color: var(--muted);
        margin-bottom: .9rem
    }

        .tour-meta .star {
            color: #f4a92c
        }

    .tour-foot {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-top: auto;
        padding-top: .5rem;
        border-top: 1px solid var(--line)
    }

    .price small {
        color: var(--muted);
        font-size: .72rem;
        display: block
    }

    .price b {
        font-family: 'Sora';
        font-size: 1.24rem;
        color: var(--navy)
    }

        .price b span {
            font-size: .85rem;
            font-weight: 600;
            color: var(--muted)
        }

    .btn-incele {
        background: var(--navy);
        color: #fff;
        border-radius: 999px;
        font-size: .85rem;
        font-weight: 600;
        padding: .55rem 1.1rem;
        border: none;
        transition: .25s
    }

        .btn-incele:hover {
            background: var(--teal-dark);
            color: #fff
        }

    /* MODAL */
    .modal-content {
        border-radius: var(--r);
        border: none
    }

    .star-pick {
        font-size: 1.7rem;
        color: #d8cfc0;
        cursor: pointer;
        transition: .15s
    }

        .star-pick.on {
            color: #f4a92c
        }

    /* RESPONSIVE */
    @@media(max - width:991px) {
        .book-sticky {
            position: static;
            margin-top: 1.5rem
        }

        .g-main {
            height: 280px
        }

        .g-small {
            height: 150px
        }

        .info-grid {
            grid-template-columns: 1fr 1fr
        }

        .hl-list {
            grid-template-columns: 1fr
        }
    }

    @@media(max - width:575px) {
        .info-grid {
            grid-template-columns: 1fr
        }

        .rev-summary {
            gap: 1.4rem
        }
    }
</style>

@await Component.InvokeAsync("_TourDetail", Model)
<!-- REVIEW MODAL -->
<div class="modal fade" id="reviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" style="font-family:'Sora';font-weight:700;color:var(--navy)">Deneyimini Paylaş</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="book-label" style="margin-top:0">Puanın</div>
                <div id="starPicker" class="mb-3">
                    <span class="star-pick" data-v="1">★</span><span class="star-pick" data-v="2">★</span><span class="star-pick" data-v="3">★</span><span class="star-pick" data-v="4">★</span><span class="star-pick" data-v="5">★</span>
                </div>
                <div class="book-label" style="margin-top:0">Yorumun</div>
                <textarea id="reviewText" class="form-control" style="border-radius:14px;border-color:var(--line);min-height:110px" placeholder="Tur deneyimini birkaç cümleyle anlat..."></textarea>
            </div>
            <div class="modal-footer border-0">
                <button class="btn-teal" onclick="submitReview()">Yorumu Gönder</button>
            </div>
        </div>
    </div>
</div>
<script>
    /* ---------- ITINERARY ---------- */
    const ITIN = [
      {day:"1. Gün", title:"İstanbul → Roma", stay:"Roma", trans:"Uçak + Transfer", meal:"—",
        body:`İstanbul Havalimanı'nda buluşma ve Roma uçuşu. Havalimanında profesyonel tur rehberimiz tarafından karşılanıp otele transfer. Otele yerleşmenin ardından şehir merkezinde kısa bir tanışma yürüyüşü ve akşam serbest zaman.`},
      {day:"2. Gün", title:"Antik Roma", stay:"Roma", trans:"Yürüyüş", meal:"Kahvaltı",
        body:`Kahvaltının ardından kapsamlı Roma şehir turu. Gün boyu gezilecek başlıca noktalar:`,
        list:["Kolezyum","Roma Forumu","Palatino Tepesi","Trevi Çeşmesi","İspanyol Merdivenleri","Piazza Navona"], after:`Turun ardından akşam serbest zaman.`},
      {day:"3. Gün", title:"Vatikan & Roma", stay:"Roma", trans:"Yürüyüş", meal:"Kahvaltı",
        body:`Sabah Vatikan turu. Gezilecek yerler:`,
        list:["Vatikan Müzeleri","Sistine Şapeli","Aziz Petrus Bazilikası","Castel Sant'Angelo çevresi"], after:`Öğleden sonra serbest zaman.`},
      {day:"4. Gün", title:"Roma → Floransa", stay:"Floransa", trans:"Otobüs", meal:"Kahvaltı",
        body:`Kahvaltı sonrası Floransa'ya hareket ve şehir yürüyüş turu:`,
        list:["Duomo","Piazza della Signoria","Ponte Vecchio","Santa Croce","Michelangelo Meydanı"], after:`Akşam Floransa'da serbest zaman.`},
      {day:"5. Gün", title:"Pisa & Toskana", stay:"Floransa", trans:"Otobüs", meal:"Kahvaltı",
        body:`Sabah Pisa'ya hareket; Pisa Kulesi ve Mucizeler Meydanı gezisi. Ardından Toskana bölgesine geçiş; panoramik kasabalar, üzüm bağları ve manzaralar eşliğinde keyifli bir gün. Akşam Floransa'ya dönüş.`},
      {day:"6. Gün", title:"Floransa → İstanbul", stay:"—", trans:"Transfer + Uçak", meal:"Kahvaltı",
        body:`Kahvaltı sonrası serbest zaman ve alışveriş imkanı. Belirlenen saatte havalimanına transfer, İstanbul uçuşu ve turumuzun sona ermesi.`}
    ];

    const itinEl = document.getElementById("itinerary");
    itinEl.innerHTML = ITIN.map((d,i)=>`
      <div class="itin-item ${i===0?'open':''}">
        <div class="itin-head" onclick="toggleDay(this)">
          <span class="day-tag">${d.day}</span>
          <span class="itin-title">${d.title}</span>
          <span class="itin-toggle"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
        </div>
        <div class="itin-body">
          <div class="itin-inner">
            <p style="margin-bottom:.4rem">${d.body}</p>
            ${d.list?`<ul>${d.list.map(x=>`<li>${x}</li>`).join("")}</ul>`:""}
            ${d.after?`<p style="margin:0">${d.after}</p>`:""}
            <div class="itin-tags">
              <span>🏨 ${d.stay}</span>
              <span>🚌 ${d.trans}</span>
              <span>🍽️ ${d.meal}</span>
            </div>
          </div>
        </div>
      </div>`).join("");

    // open first
    itinEl.querySelector(".itin-item.open .itin-body").style.maxHeight = "600px";

    function toggleDay(head){
      const item = head.parentElement;
      const body = item.querySelector(".itin-body");
      const isOpen = item.classList.contains("open");
      if(isOpen){ item.classList.remove("open"); body.style.maxHeight = "0"; }
      else { item.classList.add("open"); body.style.maxHeight = body.scrollHeight + 40 + "px"; }
    }

    /* ---------- BOOKING ---------- */
    const UNIT = 42500;
    let adult = 2, child = 0;
    const childPrice = () => Math.round(UNIT * 0.6); // çocuk %40 indirimli

    function fmt(n){ return n.toLocaleString("tr-TR") + " TL"; }

    function changeCount(type, delta){
      if(type==="adult"){ adult = Math.max(1, adult + delta); }
      else { child = Math.max(0, child + delta); }
      updateSummary();
    }

    function updateSummary(){
      document.getElementById("adultVal").textContent = adult;
      document.getElementById("childVal").textContent = child;
      document.getElementById("adultMinus").disabled = adult<=1;
      document.getElementById("childMinus").disabled = child<=0;

      const adultSum = adult * UNIT;
      const childSum = child * childPrice();
      const sub = adultSum + childSum;

      document.getElementById("adultLine").textContent = adult + " Yetişkin (" + fmt(UNIT) + ")";
      document.getElementById("adultSum").textContent = fmt(adultSum);

      const childRow = document.getElementById("childRow");
      if(child>0){
        childRow.style.display = "flex";
        document.getElementById("childLine").textContent = child + " Çocuk (" + fmt(childPrice()) + ")";
        document.getElementById("childSum").textContent = fmt(childSum);
      } else { childRow.style.display = "none"; }

      document.getElementById("subtotal").textContent = fmt(sub);
      document.getElementById("grandTotal").textContent = fmt(sub);
    }
    updateSummary();

    // date selection
    document.querySelectorAll(".date-opt").forEach(opt=>{
      opt.addEventListener("click", ()=>{
        document.querySelectorAll(".date-opt").forEach(o=>o.classList.remove("sel"));
        opt.classList.add("sel");
        opt.querySelector("input").checked = true;
      });
    });

    function reserve(){
      const date = document.querySelector(".date-opt.sel .d").textContent;
      const total = document.getElementById("grandTotal").textContent;
      alert("Ön rezervasyonun alındı!\n\nTur: Roma & Toskana Keşfi\nTarih: " + date + "\nKişi: " + adult + " yetişkin" + (child? ", " + child + " çocuk":"") + "\nToplam: " + total + "\n\nBu bir demo sayfasıdır.");
    }

    function sharePage(){
      if(navigator.share){ navigator.share({title:"Roma & Toskana Keşfi — Travelio", url:location.href}).catch(()=>{}); }
      else { alert("Bağlantı panoya kopyalandı (demo)."); }
    }

    /* ---------- REVIEW MODAL ---------- */
    let pickedStars = 0;
    document.querySelectorAll(".star-pick").forEach(s=>{
      s.addEventListener("click", ()=>{
        pickedStars = +s.dataset.v;
        document.querySelectorAll(".star-pick").forEach(x=> x.classList.toggle("on", +x.dataset.v <= pickedStars));
      });
    });
    function submitReview(){
      const txt = document.getElementById("reviewText").value.trim();
      if(!pickedStars){ alert("Lütfen bir puan seç."); return; }
      if(!txt){ alert("Lütfen yorumunu yaz."); return; }
      bootstrap.Modal.getInstance(document.getElementById("reviewModal")).hide();
      alert("Yorumun için teşekkürler! (demo)");
      document.getElementById("reviewText").value = "";
      pickedStars = 0;
      document.querySelectorAll(".star-pick").forEach(x=>x.classList.remove("on"));
    }

    /* ---------- ASK ---------- */
    function sendQuestion(){
      const v = document.getElementById("askInput").value.trim();
      if(!v){ return; }
      document.getElementById("askInput").value = "";
      document.getElementById("askOk").style.display = "block";
    }

    /* ---------- SIMILAR ---------- */
    const SIMILAR = [
      {title:"Amalfi & Napoli", country:"İtalya", dur:"6 Gün / 5 Gece", rating:4.9, reviews:886, price:"49.500", badge:"Popüler", img:"https://images.unsplash.com/photo-1533105079780-92b9be482077?auto=format&fit=crop&w=800&q=80"},
      {title:"Paris & Alsace", country:"Fransa", dur:"7 Gün / 6 Gece", rating:4.8, reviews:721, price:"47.900", badge:"", img:"https://images.unsplash.com/photo-1499856871958-5b9627545d1a?auto=format&fit=crop&w=800&q=80"},
      {title:"Prag & Viyana Kültür Turu", country:"Çekya · Avusturya", dur:"6 Gün / 5 Gece", rating:4.8, reviews:1421, price:"36.400", badge:"", img:"https://images.unsplash.com/photo-1541849546-216549ae216d?auto=format&fit=crop&w=800&q=80"}
    ];
    document.getElementById("similarGrid").innerHTML = SIMILAR.map(t=>`
      <div class="col-md-6 col-lg-4">
        <article class="tour-card">
          <div class="tour-media">
            <img src="${t.img}" alt="${t.title}" loading="lazy" />
            ${t.badge?`<span class="tour-badge">${t.badge}</span>`:''}
          </div>
          <div class="tour-body">
            <div class="tour-country">${t.country}</div>
            <h3 class="tour-title">${t.title}</h3>
            <div class="tour-meta">
              <span>🗓️ ${t.dur}</span>
              <span><span class="star">★</span> ${t.rating.toFixed(1)} <span style="color:var(--muted)">(${t.reviews.toLocaleString("tr-TR")})</span></span>
            </div>
            <div class="tour-foot">
              <div class="price"><small>Kişi başı</small><b>${t.price} <span>TL</span></b></div>
              <a href="tour-detail.html" class="btn-incele">Turu İncele</a>
            </div>
          </div>
        </article>
      </div>`).join("");
</script>