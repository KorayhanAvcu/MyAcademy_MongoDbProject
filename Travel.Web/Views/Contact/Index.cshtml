
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    :root {
        --navy: #0e2a3b;
        --navy-2: #12384c;
        --teal: #0fa3a3;
        --teal-dark: #0b7f80;
        --cream: #f7f5f0;
        --white: #ffffff;
        --ink: #0e2a3b;
        --muted: #5d7180;
        --line: #e7e2d8;
        --shadow-sm: 0 4px 18px rgba(14,42,59,.06);
        --shadow-md: 0 18px 50px rgba(14,42,59,.12);
        --r: 18px;
    }

    * {
        box-sizing: border-box
    }

    html {
        scroll-behavior: smooth
    }

    body {
        font-family: 'Inter',system-ui,sans-serif;
        color: var(--ink);
        background: var(--cream);
        -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, .brand, .display-font {
        font-family: 'Sora',sans-serif;
    }

    .eyebrow {
        font-family: 'Sora',sans-serif;
        text-transform: uppercase;
        letter-spacing: .22em;
        font-size: .72rem;
        font-weight: 700;
        color: var(--teal-dark);
    }

    a {
        text-decoration: none
    }

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .85rem 1.8rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(15,163,163,.32)
        }

    /* NAV */
    .navbar {
        background: rgba(247,245,240,.85);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
        padding: .9rem 0;
    }

    .brand {
        font-weight: 800;
        font-size: 1.5rem;
        color: var(--navy);
        letter-spacing: -.5px;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .brand .dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: var(--teal);
            display: inline-block;
            box-shadow: 0 0 0 4px rgba(15,163,163,.18)
        }

    .navbar .nav-link {
        color: var(--navy);
        font-weight: 500;
        margin: 0 .35rem;
        position: relative
    }

        .navbar .nav-link:hover {
            color: var(--teal-dark)
        }

        .navbar .nav-link.active {
            color: var(--teal-dark)
        }

            .navbar .nav-link.active::after {
                content: "";
                position: absolute;
                left: .7rem;
                right: .7rem;
                bottom: -2px;
                height: 2px;
                background: var(--teal);
                border-radius: 2px
            }

    .profile-pill {
        display: flex;
        align-items: center;
        gap: .55rem;
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 999px;
        padding: .35rem .35rem .35rem .95rem;
        font-weight: 600;
        color: var(--navy);
        transition: .2s
    }

        .profile-pill:hover {
            box-shadow: var(--shadow-sm);
            color: var(--navy);
            border-color: var(--teal)
        }

        .profile-pill .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--navy);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: .85rem;
            font-weight: 700
        }

    /* PAGE HEAD */
    .page-head {
        position: relative;
        overflow: hidden;
        color: #fff;
        background: linear-gradient(120deg,rgba(14,42,59,.92) 0%,rgba(18,56,76,.85) 55%,rgba(11,127,128,.78) 100%), url('https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=2000&q=80') center/cover;
        padding: 4.5rem 0 5rem;
    }

        .page-head .eyebrow {
            color: #7fe3e3
        }

        .page-head h1 {
            font-weight: 800;
            font-size: clamp(2rem,4vw,3.1rem);
            letter-spacing: -.5px;
            margin-top: .5rem
        }

        .page-head p {
            color: rgba(255,255,255,.9);
            max-width: 58ch;
            margin-top: .7rem;
            font-size: 1.05rem
        }

    .breadcrumbz {
        font-size: .85rem;
        color: rgba(255,255,255,.7)
    }

        .breadcrumbz a {
            color: rgba(255,255,255,.7)
        }

            .breadcrumbz a:hover {
                color: #fff
            }

    /* CONTACT CARDS */
    .contact-cards-row {
        margin-top: -2.5rem;
        position: relative;
        z-index: 10;
    }

    .c-box {
        background: #fff;
        border-radius: var(--r);
        padding: 1.8rem 1.6rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        height: 100%;
        transition: .25s;
    }

        .c-box:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md)
        }

    .c-ico {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        background: rgba(15,163,163,.1);
        color: var(--teal-dark);
        display: grid;
        place-items: center;
        margin-bottom: 1.1rem;
    }

    .c-box h4 {
        font-family: 'Sora';
        font-weight: 700;
        color: var(--navy);
        font-size: 1.1rem;
        margin-bottom: .35rem;
    }

    .c-box p {
        color: var(--muted);
        font-size: .88rem;
        margin: 0 0 .8rem;
    }

    .c-box a.c-link {
        color: var(--teal-dark);
        font-weight: 600;
        font-size: .92rem;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

        .c-box a.c-link:hover {
            color: var(--navy)
        }

    /* FORM & MAP CARD */
    .main-form-card {
        background: #fff;
        border-radius: var(--r);
        border: 1px solid rgba(231,226,216,.7);
        padding: 2.6rem;
        box-shadow: var(--shadow-sm);
        margin-top: 2.5rem;
    }

    .field-label {
        font-size: .82rem;
        font-weight: 600;
        color: var(--navy);
        margin-bottom: .4rem;
        display: block;
    }

    .form-control-custom {
        width: 100%;
        border: 1px solid var(--line);
        background: var(--cream);
        border-radius: 12px;
        padding: .75rem 1rem;
        font-size: .92rem;
        color: var(--navy);
        outline: none;
        transition: .2s;
    }

        .form-control-custom:focus {
            border-color: var(--teal);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(15,163,163,.12);
        }

    textarea.form-control-custom {
        resize: vertical;
        min-height: 130px;
    }

    /* FAQ ACCORDION */
    .faq-wrap {
        margin-top: 4rem;
    }

    .accordion-item {
        border: 1px solid var(--line);
        border-radius: 14px !important;
        margin-bottom: .8rem;
        overflow: hidden;
        background: #fff;
    }

    .accordion-button {
        font-family: 'Sora';
        font-weight: 600;
        font-size: .98rem;
        color: var(--navy);
        padding: 1.1rem 1.3rem;
        background: #fff;
        box-shadow: none !important;
    }

        .accordion-button:not(.collapsed) {
            color: var(--teal-dark);
            background: rgba(15,163,163,.04);
        }

    .accordion-body {
        color: var(--muted);
        line-height: 1.65;
        font-size: .92rem;
        padding: 1rem 1.3rem 1.3rem;
    }

    /* MAP MOCKUP */
    .map-box {
        border-radius: 16px;
        overflow: hidden;
        height: 100%;
        min-height: 360px;
        background: #e5e3df;
        position: relative;
        border: 1px solid var(--line);
    }

        .map-box iframe {
            width: 100%;
            height: 100%;
            border: none;
            filter: saturate(.85);
        }

    .map-overlay-info {
        position: absolute;
        bottom: 1rem;
        left: 1rem;
        right: 1rem;
        background: rgba(255,255,255,.94);
        backdrop-filter: blur(8px);
        border-radius: 12px;
        padding: .9rem 1.1rem;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-sm);
    }

        .map-overlay-info b {
            font-family: 'Sora';
            font-size: .88rem;
            color: var(--navy);
            display: block
        }

        .map-overlay-info span {
            font-size: .78rem;
            color: var(--muted)
        }

    /* FOOTER */
    footer {
        background: var(--navy);
        color: rgba(255,255,255,.72);
        padding: 4rem 0 2rem;
        margin-top: 4.5rem
    }

        footer .brand {
            color: #fff
        }

        footer h6 {
            color: #fff;
            font-family: 'Sora';
            font-weight: 600;
            letter-spacing: .02em;
            margin-bottom: 1rem
        }

        footer a {
            color: rgba(255,255,255,.72);
            display: block;
            margin-bottom: .55rem;
            font-size: .92rem
        }

            footer a:hover {
                color: #7fe3e3
            }

    .foot-social a {
        display: inline-grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(255,255,255,.08);
        margin-right: .5rem
    }

        .foot-social a:hover {
            background: var(--teal)
        }

    .foot-bottom {
        border-top: 1px solid rgba(255,255,255,.12);
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        font-size: .85rem
    }

    /* SUCCESS TOAST */
    .toast-ok {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: var(--navy);
        color: #fff;
        padding: .9rem 1.3rem;
        border-radius: 14px;
        box-shadow: var(--shadow-md);
        font-size: .9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: .6rem;
        z-index: 1080;
        opacity: 0;
        transform: translateY(12px);
        transition: .3s;
        pointer-events: none
    }

        .toast-ok.show {
            opacity: 1;
            transform: none
        }

        .toast-ok svg {
            color: #7fe3e3
        }

    @@media(max - width:991px) {
        .main-form-card

    {
        padding: 1.8rem 1.4rem
    }

    .contact-cards-row {
        margin-top: 1.5rem
    }

    }
</style>

@await Component.InvokeAsync("_ContactPageHead")


<main class="container">
    @await Component.InvokeAsync("_ContactCards")
    

    <!-- FORM + MAP -->
    <div class="main-form-card" id="mapSection">
        <div class="row g-4">
            @await Component.InvokeAsync("_ContactForm")
            @await Component.InvokeAsync("_ContactMap")
           
        </div>
    </div>
    @await Component.InvokeAsync("_ContactFAQ")
    
</main>

<!-- TOAST NOTIFICATION -->
<div class="toast-ok" id="toast">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
    <span>Mesajınız başarıyla iletildi! En kısa sürede döneceğiz.</span>
</div>

