
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    :root {
        --navy: #0e2a3b;
        --navy-2: #12384c;
        --teal: #0fa3a3;
        --teal-dark: #0b7f80;
        --cream: #f7f5f0;
        --white: #ffffff;
        --ink: #0e2a3b;
        --muted: #5d7180;
        --line: #e7e2d8;
        --shadow-sm: 0 4px 18px rgba(14,42,59,.06);
        --shadow-md: 0 18px 50px rgba(14,42,59,.12);
        --r: 18px;
    }

    * {
        box-sizing: border-box
    }

    html {
        scroll-behavior: smooth
    }

    body {
        font-family: 'Inter',system-ui,sans-serif;
        color: var(--ink);
        background: var(--cream);
        -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, .brand, .display-font {
        font-family: 'Sora',sans-serif;
    }

    .eyebrow {
        font-family: 'Sora',sans-serif;
        text-transform: uppercase;
        letter-spacing: .22em;
        font-size: .72rem;
        font-weight: 700;
        color: var(--teal-dark);
    }

    a {
        text-decoration: none
    }

    .btn-teal {
        background: var(--teal);
        color: #fff;
        border: none;
        border-radius: 999px;
        font-weight: 600;
        padding: .85rem 1.8rem;
        transition: .25s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
    }

        .btn-teal:hover {
            background: var(--teal-dark);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(15,163,163,.32)
        }

    /* NAV */
    .navbar {
        background: rgba(247,245,240,.85);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
        padding: .9rem 0;
    }

    .brand {
        font-weight: 800;
        font-size: 1.5rem;
        color: var(--navy);
        letter-spacing: -.5px;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .brand .dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: var(--teal);
            display: inline-block;
            box-shadow: 0 0 0 4px rgba(15,163,163,.18)
        }

    .navbar .nav-link {
        color: var(--navy);
        font-weight: 500;
        margin: 0 .35rem;
        position: relative
    }

        .navbar .nav-link:hover {
            color: var(--teal-dark)
        }

        .navbar .nav-link.active {
            color: var(--teal-dark)
        }

            .navbar .nav-link.active::after {
                content: "";
                position: absolute;
                left: .7rem;
                right: .7rem;
                bottom: -2px;
                height: 2px;
                background: var(--teal);
                border-radius: 2px
            }

    .profile-pill {
        display: flex;
        align-items: center;
        gap: .55rem;
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 999px;
        padding: .35rem .35rem .35rem .95rem;
        font-weight: 600;
        color: var(--navy);
        transition: .2s
    }

        .profile-pill:hover {
            box-shadow: var(--shadow-sm);
            color: var(--navy);
            border-color: var(--teal)
        }

        .profile-pill .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--navy);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: .85rem;
            font-weight: 700
        }

    /* PAGE HEAD */
    .page-head {
        position: relative;
        overflow: hidden;
        color: #fff;
        background: linear-gradient(120deg,rgba(14,42,59,.92) 0%,rgba(18,56,76,.85) 55%,rgba(11,127,128,.78) 100%), url('https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?auto=format&fit=crop&w=2000&q=80') center/cover;
        padding: 4.5rem 0 5rem;
    }

        .page-head .eyebrow {
            color: #7fe3e3
        }

        .page-head h1 {
            font-weight: 800;
            font-size: clamp(2rem,4vw,3.1rem);
            letter-spacing: -.5px;
            margin-top: .5rem
        }

        .page-head p {
            color: rgba(255,255,255,.9);
            max-width: 58ch;
            margin-top: .7rem;
            font-size: 1.05rem
        }

    .breadcrumbz {
        font-size: .85rem;
        color: rgba(255,255,255,.7)
    }

        .breadcrumbz a {
            color: rgba(255,255,255,.7)
        }

            .breadcrumbz a:hover {
                color: #fff
            }

    /* CONTACT CARDS */
    .contact-cards-row {
        margin-top: -2.5rem;
        position: relative;
        z-index: 10;
    }

    .c-box {
        background: #fff;
        border-radius: var(--r);
        padding: 1.8rem 1.6rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(231,226,216,.7);
        height: 100%;
        transition: .25s;
    }

        .c-box:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md)
        }

    .c-ico {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        background: rgba(15,163,163,.1);
        color: var(--teal-dark);
        display: grid;
        place-items: center;
        margin-bottom: 1.1rem;
    }

    .c-box h4 {
        font-family: 'Sora';
        font-weight: 700;
        color: var(--navy);
        font-size: 1.1rem;
        margin-bottom: .35rem;
    }

    .c-box p {
        color: var(--muted);
        font-size: .88rem;
        margin: 0 0 .8rem;
    }

    .c-box a.c-link {
        color: var(--teal-dark);
        font-weight: 600;
        font-size: .92rem;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

        .c-box a.c-link:hover {
            color: var(--navy)
        }

    /* FORM & MAP CARD */
    .main-form-card {
        background: #fff;
        border-radius: var(--r);
        border: 1px solid rgba(231,226,216,.7);
        padding: 2.6rem;
        box-shadow: var(--shadow-sm);
        margin-top: 2.5rem;
    }

    .field-label {
        font-size: .82rem;
        font-weight: 600;
        color: var(--navy);
        margin-bottom: .4rem;
        display: block;
    }

    .form-control-custom {
        width: 100%;
        border: 1px solid var(--line);
        background: var(--cream);
        border-radius: 12px;
        padding: .75rem 1rem;
        font-size: .92rem;
        color: var(--navy);
        outline: none;
        transition: .2s;
    }

        .form-control-custom:focus {
            border-color: var(--teal);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(15,163,163,.12);
        }

    textarea.form-control-custom {
        resize: vertical;
        min-height: 130px;
    }

    /* FAQ ACCORDION */
    .faq-wrap {
        margin-top: 4rem;
    }

    .accordion-item {
        border: 1px solid var(--line);
        border-radius: 14px !important;
        margin-bottom: .8rem;
        overflow: hidden;
        background: #fff;
    }

    .accordion-button {
        font-family: 'Sora';
        font-weight: 600;
        font-size: .98rem;
        color: var(--navy);
        padding: 1.1rem 1.3rem;
        background: #fff;
        box-shadow: none !important;
    }

        .accordion-button:not(.collapsed) {
            color: var(--teal-dark);
            background: rgba(15,163,163,.04);
        }

    .accordion-body {
        color: var(--muted);
        line-height: 1.65;
        font-size: .92rem;
        padding: 1rem 1.3rem 1.3rem;
    }

    /* MAP MOCKUP */
    .map-box {
        border-radius: 16px;
        overflow: hidden;
        height: 100%;
        min-height: 360px;
        background: #e5e3df;
        position: relative;
        border: 1px solid var(--line);
    }

        .map-box iframe {
            width: 100%;
            height: 100%;
            border: none;
            filter: saturate(.85);
        }

    .map-overlay-info {
        position: absolute;
        bottom: 1rem;
        left: 1rem;
        right: 1rem;
        background: rgba(255,255,255,.94);
        backdrop-filter: blur(8px);
        border-radius: 12px;
        padding: .9rem 1.1rem;
        border: 1px solid var(--line);
        box-shadow: var(--shadow-sm);
    }

        .map-overlay-info b {
            font-family: 'Sora';
            font-size: .88rem;
            color: var(--navy);
            display: block
        }

        .map-overlay-info span {
            font-size: .78rem;
            color: var(--muted)
        }

    /* FOOTER */
    footer {
        background: var(--navy);
        color: rgba(255,255,255,.72);
        padding: 4rem 0 2rem;
        margin-top: 4.5rem
    }

        footer .brand {
            color: #fff
        }

        footer h6 {
            color: #fff;
            font-family: 'Sora';
            font-weight: 600;
            letter-spacing: .02em;
            margin-bottom: 1rem
        }

        footer a {
            color: rgba(255,255,255,.72);
            display: block;
            margin-bottom: .55rem;
            font-size: .92rem
        }

            footer a:hover {
                color: #7fe3e3
            }

    .foot-social a {
        display: inline-grid;
        place-items: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(255,255,255,.08);
        margin-right: .5rem
    }

        .foot-social a:hover {
            background: var(--teal)
        }

    .foot-bottom {
        border-top: 1px solid rgba(255,255,255,.12);
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        font-size: .85rem
    }

    /* SUCCESS TOAST */
    .toast-ok {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: var(--navy);
        color: #fff;
        padding: .9rem 1.3rem;
        border-radius: 14px;
        box-shadow: var(--shadow-md);
        font-size: .9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: .6rem;
        z-index: 1080;
        opacity: 0;
        transform: translateY(12px);
        transition: .3s;
        pointer-events: none
    }

        .toast-ok.show {
            opacity: 1;
            transform: none
        }

        .toast-ok svg {
            color: #7fe3e3
        }

    @@media(max - width:991px) {
        .main-form-card

    {
        padding: 1.8rem 1.4rem
    }

    .contact-cards-row {
        margin-top: 1.5rem
    }

    }
</style>
<!-- PAGE HEAD -->
<header class="page-head">
    <div class="container">
        <div class="breadcrumbz mb-3"><a href="index.html">Ana Sayfa</a> · İletişim</div>
        <div class="eyebrow">Bizimle İletişime Geçin</div>
        <h1>Sorularınız İçin Yanınızdayız</h1>
        <p>Tur programları, vize süreçleri veya özel grup talepleriniz için seyahat danışmanlarımızla 7/24 iletişime geçebilirsiniz.</p>
    </div>
</header>

<main class="container">
    <!-- CONTACT CARDS ROW -->
    <div class="contact-cards-row">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="c-box">
                    <div class="c-ico">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                    </div>
                    <h4>Telefonla Destek</h4>
                    <p>Hafta içi ve hafta sonu 09:00 - 20:00 arası canlı destek.</p>
                    <a href="tel:+908503004050" class="c-link">0850 300 40 50 →</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="c-box">
                    <div class="c-ico">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                    </div>
                    <h4>E-posta</h4>
                    <p>Tüm soru, teklif ve iş birliği talepleriniz için bize yazın.</p>
                    <a href="mailto:info@travelio.com" class="c-link">info@travelio.com →</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="c-box">
                    <div class="c-ico">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
                    </div>
                    <h4>WhatsApp Hattı</h4>
                    <p>Hızlı bilgi alma ve evrak danışmanlığı için anında mesajlaşın.</p>
                    <a href="#" class="c-link">+90 532 100 20 30 →</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="c-box">
                    <div class="c-ico">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                    </div>
                    <h4>Merkez Ofis</h4>
                    <p>Büyükdere Cad. No:142 Levent, Beşiktaş / İstanbul</p>
                    <a href="#mapSection" class="c-link">Haritada Gör →</a>
                </div>
            </div>
        </div>
    </div>

    <!-- FORM + MAP -->
    <div class="main-form-card" id="mapSection">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="eyebrow">Mesaj Gönderin</div>
                <h2 style="font-family:'Sora';font-weight:700;font-size:1.8rem;color:var(--navy);margin:.3rem 0 1.2rem">Seyahat Planınızı Birlikte Yapalım</h2>

                <form id="contactForm" onsubmit="handleSend(event)">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="field-label">Adınız Soyadınız *</label>
                            <input type="text" class="form-control-custom" required placeholder="Örn. Zeynep Kaya">
                        </div>
                        <div class="col-md-6">
                            <label class="field-label">E-posta Adresiniz *</label>
                            <input type="email" class="form-control-custom" required placeholder="ornek@email.com">
                        </div>
                        <div class="col-md-6">
                            <label class="field-label">Telefon Numaranız</label>
                            <input type="tel" class="form-control-custom" placeholder="+90 5XX XXX XX XX">
                        </div>
                        <div class="col-md-6">
                            <label class="field-label">İlgilendiğiniz Tur / Konu</label>
                            <select class="form-control-custom">
                                <option selected>Genel Bilgi & Rezervasyon</option>
                                <option>Roma & Toskana Keşfi</option>
                                <option>Paris & Disneyland</option>
                                <option>İsviçre Alpleri</option>
                                <option>Kuzey Işıkları Norveç</option>
                                <option>Tokyo & Kyoto</option>
                                <option>Özel Grup / Kurumsal Tur Talebi</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="field-label">Mesajınız *</label>
                            <textarea class="form-control-custom" required placeholder="Merak ettiğiniz tarih, kişi sayısı ve diğer detayları belirtebilirsiniz..."></textarea>
                        </div>
                    </div>
                    <button type="submit" class="btn-teal">
                        <span>Mesajı Gönder</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                    </button>
                </form>
            </div>

            <div class="col-lg-5">
                <div class="map-box">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3007.8228308425257!2d29.00984857647248!3d41.07289567134185!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cab65d447d216f%3A0xe9bb6c4db67f7ffb!2sLevent%2C%20B%C3%BCy%C3%BCkdere%20Cd.%2C%20Be%C5%9Fikta%C5%9F%2F%C4%B0stanbul!5e0!3m2!1str!2str!4v1710000000000!5m2!1str!2str" loading="lazy"></iframe>
                    <div class="map-overlay-info">
                        <b>Travelio Genel Merkez</b>
                        <span>Levent, Büyükdere Cd. No:142 Beşiktaş / İstanbul · Ziyaret için randevu alabilirsiniz.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SSS / FAQ -->
    <div class="faq-wrap">
        <div class="text-center max-w-600 mx-auto mb-4">
            <div class="eyebrow">Sıkça Sorulan Sorular</div>
            <h2 style="font-family:'Sora';font-weight:700;font-size:1.8rem;color:var(--navy);margin-top:.4rem">Aklınıza Takılanlar</h2>
            <p style="color:var(--muted);font-size:.95rem">Rezervasyon ve vize süreçleri ile ilgili en sık sorulan soruların yanıtları.</p>
        </div>

        <div class="accordion" id="faqAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#f1">
                        Ön rezervasyon yaptıktan sonra ödeme nasıl gerçekleşiyor?
                    </button>
                </h2>
                <div id="f1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Web sitemiz üzerinden yaptığınız ön rezervasyon sonrasında kontenjanınız 48 saat boyunca adınıza bloke edilir. Seyahat danışmanımız sizi arayarak tur sözleşmesi ve kredi kartı / havale ödeme seçeneklerini güvenle tamamlamanıza yardımcı olur.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#f2">
                        Schengen vizesi alımında danışmanlık hizmeti veriyor musunuz?
                    </button>
                </h2>
                <div id="f2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Evet, tur rezervasyonu yapan misafirlerimize konsolosluk onaylı otel/uçak rezervasyon belgeleri ve eksiksiz vize başvuru evrak dosyası hazırlanması konusunda ücretsiz rehberlik sunuyoruz.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#f3">
                        Tur iptal ve iade koşulları nelerdir?
                    </button>
                </h2>
                <div id="f3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body">
                        Tur kalkış tarihine 30 gün kalana kadar yapılan iptallerde uçak bileti kuralları haricindeki tüm tur ücreti kesintisiz iade edilir. İsteğe bağlı seyahat iptal sigortası ile vize reddi durumunda tam iade güvencesi de sunulmaktadır.
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- TOAST NOTIFICATION -->
<div class="toast-ok" id="toast">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12" /></svg>
    <span>Mesajınız başarıyla iletildi! En kısa sürede döneceğiz.</span>
</div>

